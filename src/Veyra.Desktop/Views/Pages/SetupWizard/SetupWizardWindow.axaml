<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Veyra.Desktop.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:Veyra.Desktop.ViewModels.Pages.SetupWizard"
        xmlns:pages="clr-namespace:Veyra.Desktop.Views.Pages.SetupWizard"
        xmlns:conv="clr-namespace:Veyra.Desktop.Converters"
        x:Class="Veyra.Desktop.Views.Pages.SetupWizard.SetupWizardWindow"
        x:DataType="vm:SetupWizardViewModel"
        Width="980" Height="680" Title="{loc:Tr setup_wizard.window_title}"
        Background="#0E1014" Foreground="#EEEEEE" CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20" ColumnDefinitions="260,*" ColumnSpacing="14">
        <Border Grid.Column="0" Background="#121823" CornerRadius="12" Padding="18">
            <StackPanel Spacing="10">
                <TextBlock Text="{loc:Tr setup_wizard.title}" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="{loc:Tr setup_wizard.subtitle}" Opacity="0.75" TextWrapping="Wrap"/>

                <Border Background="#18273A" CornerRadius="10" Padding="12" Margin="0,10,0,0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{loc:Tr setup_wizard.steps}" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:Tr setup_wizard.step1}"/>
                        <TextBlock Text="{loc:Tr setup_wizard.step2}"/>
                        <TextBlock Text="{loc:Tr setup_wizard.step3}"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding StepInfo}" Opacity="0.7" Margin="0,10,0,0"/>
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#F87171" TextWrapping="Wrap"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </Border>

        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Bottom" Background="#131313" CornerRadius="10" Padding="12" Margin="0,14,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="{loc:Tr common.back}" Width="120" Command="{Binding BackCommand}"/>
                    <Button Content="{Binding NextButtonText}" Width="170"
                            Command="{Binding NextCommand}" IsEnabled="{Binding CanGoNext}"/>
                </StackPanel>
            </Border>

            <Border Background="#131313" CornerRadius="12" Padding="18">
                <ContentControl Content="{Binding CurrentStep}">
                    <ContentControl.DataTemplates>
                        <DataTemplate DataType="vm:SelectDirectoriesViewModel">
                            <pages:SelectDirectoriesPage/>
                        </DataTemplate>
                        <DataTemplate DataType="vm:SelectFormatsViewModel">
                            <pages:SelectFormatsPage/>
                        </DataTemplate>
                        <DataTemplate DataType="vm:RepositoryNameViewModel">
                            <pages:RepositoryNamePage/>
                        </DataTemplate>
                    </ContentControl.DataTemplates>
                </ContentControl>
            </Border>
        </DockPanel>
    </Grid>
</Window>
