<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:explorer="clr-namespace:Veyra.Desktop.ViewModels.Pages.Explorer"
             x:Class="Veyra.Desktop.Views.Pages.Explorer.RepositoryExplorerView"
             x:Name="Root"
             x:DataType="explorer:RepositoryExplorerViewModel"
             Background="#0D0D0D">

    <DockPanel Margin="20,16">
        <Border DockPanel.Dock="Top" Background="#121212" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                <Button Grid.Column="0" Content="← Назад" Command="{Binding BackCommand}" Padding="12,8"/>

                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="{Binding RepositoryName}" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding RepositoryPath}" Opacity="0.7" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="Live sync включен"
                               Opacity="0.7"
                               FontSize="11"
                               IsVisible="{Binding IsLiveSyncActive}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="Синхронизировать"
                            Command="{Binding RescanCommand}"
                            IsEnabled="{Binding CanRunScanActions}"/>
                    <Button Content="Снимок версии"
                            Command="{Binding CreateSnapshotCommand}"
                            IsEnabled="{Binding CanRunScanActions}"/>
                    <Button Content="Настройки" Command="{Binding OpenSettingsCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top"
                Background="#131820"
                BorderBrush="#1F2937"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12"
                Margin="0,0,0,10"
                IsVisible="{Binding IsScanRunning}">
            <Grid ColumnDefinitions="*,100,40" ColumnSpacing="10" VerticalAlignment="Center">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="{Binding ScanMessage}" FontWeight="SemiBold"/>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding ScanPercent}" Height="8" IsIndeterminate="{Binding ScanIsIndeterminate}"/>
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="{Binding ScanPercent, StringFormat='{}{0}%'}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           FontWeight="SemiBold"/>
            </Grid>
        </Border>

        <TextBlock DockPanel.Dock="Top"
                   Margin="0,0,0,8"
                   Text="{Binding ErrorMessage}"
                   Foreground="#F87171"
                   IsVisible="{Binding HasErrorMessage}"/>

        <Grid ColumnDefinitions="260,*,360" ColumnSpacing="12">
            <Border Grid.Column="0" Background="#121212" CornerRadius="10" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Структура папок" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TreeView ItemsSource="{Binding TreeNodes}"
                              SelectedItem="{Binding SelectedTreeNode, Mode=TwoWay}">
                        <TreeView.DataTemplates>
                            <TreeDataTemplate DataType="explorer:ExplorerTreeNodeViewModel" ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding Name}"/>
                            </TreeDataTemplate>
                        </TreeView.DataTemplates>
                    </TreeView>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="#121212" CornerRadius="10" Padding="12">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                    <TextBox Grid.Row="0" Text="{Binding SearchQuery, Mode=TwoWay}" Watermark="Поиск по текущей папке"/>

                    <Grid Grid.Row="1" ColumnDefinitions="40,*,120,100,120,100" Margin="0,6,0,2">
                        <TextBlock Grid.Column="1" Text="Имя" FontWeight="SemiBold" Opacity="0.8"/>
                        <TextBlock Grid.Column="2" Text="Тип" FontWeight="SemiBold" Opacity="0.8"/>
                        <TextBlock Grid.Column="3" Text="Размер" FontWeight="SemiBold" Opacity="0.8"/>
                        <TextBlock Grid.Column="4" Text="Изменено" FontWeight="SemiBold" Opacity="0.8"/>
                        <TextBlock Grid.Column="5" Text="Действие" FontWeight="SemiBold" Opacity="0.8"/>
                    </Grid>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="explorer:ExplorerItemViewModel">
                                    <Border Background="#161616" CornerRadius="8" Padding="8" Margin="0,0,0,6">
                                        <Grid ColumnDefinitions="40,*,120,100,120,100" ColumnSpacing="6">
                                            <Button Grid.Column="0" Content="{Binding Icon}" FontSize="14"
                                                    Command="{Binding #Root.((explorer:RepositoryExplorerViewModel)DataContext).SelectItemCommand}"
                                                    CommandParameter="{Binding .}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Type}" VerticalAlignment="Center" Opacity="0.8"/>
                                            <TextBlock Grid.Column="3" Text="{Binding SizeDisplay}" VerticalAlignment="Center" Opacity="0.8"/>
                                            <TextBlock Grid.Column="4" Text="{Binding ModifiedDisplay}" VerticalAlignment="Center" Opacity="0.8"/>
                                            <Button Grid.Column="5" Content="Открыть" IsVisible="{Binding CanOpenDirectory}"
                                                    Command="{Binding #Root.((explorer:RepositoryExplorerViewModel)DataContext).OpenItemCommand}"
                                                    CommandParameter="{Binding .}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="#121212" CornerRadius="10" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Текущие изменения" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding LastSnapshotLabel}" Opacity="0.75"/>
                        <TextBlock Text="{Binding PendingChangesSummary}" Opacity="0.85" TextWrapping="Wrap"/>

                        <ListBox ItemsSource="{Binding PendingChanges}" MaxHeight="220" IsVisible="{Binding HasPendingChanges}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="explorer:RepositoryPendingChangeViewModel">
                                    <Border Background="#161616" CornerRadius="8" Padding="8" Margin="0,0,0,6">
                                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" RowSpacing="2">
                                            <TextBlock Grid.Row="0" Grid.Column="0"
                                                       Text="{Binding ChangeKindLabel}"
                                                       Foreground="{Binding ChangeKindColor}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding SizeDeltaLabel}" Opacity="0.75"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                                       Text="{Binding RelativePath}"
                                                       Opacity="0.65"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="Нет изменений для фиксации" Opacity="0.7" IsVisible="{Binding HasNoPendingChanges}"/>

                        <Border Height="1" Background="#1E1E1E" Margin="0,4"/>

                        <TextBlock Text="Детали файла" FontSize="13" FontWeight="SemiBold"/>

                        <StackPanel IsVisible="{Binding HasSelectedItem}" Spacing="8">
                            <TextBlock Text="{Binding SelectedItem.Name}" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedItem.RelativePath}" Opacity="0.75" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedItem.Type}"/>
                            <TextBlock Text="{Binding SelectedItem.SizeDisplay}"/>
                            <TextBlock Text="{Binding SelectedItem.ModifiedDisplay}"/>
                            <TextBlock Text="{Binding SelectedItem.HashSha256}" TextWrapping="Wrap" Opacity="0.7"/>

                            <Border Height="1" Background="#1E1E1E" Margin="0,4"/>

                            <TextBlock Text="Версии файла" FontWeight="SemiBold"/>
                            <TextBlock Text="Загрузка версий..." Opacity="0.7" IsVisible="{Binding IsVersionLoading}"/>

                            <ListBox ItemsSource="{Binding FileVersions}"
                                     SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                                     MaxHeight="180">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="explorer:ExplorerFileVersionViewModel">
                                        <StackPanel Margin="2" Spacing="2">
                                            <TextBlock Text="{Binding Title}"/>
                                            <TextBlock Text="{Binding SizeDisplay}" Opacity="0.7" FontSize="11"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="Для выбранной версии нет блоков содержимого. Восстановление и diff недоступны."
                                       Foreground="#FBBF24"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding SelectedVersionHasNoContentBlocks}"/>

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="В новый файл"
                                        Command="{Binding RestoreVersionAsCopyCommand}"
                                        IsEnabled="{Binding CanRestoreSelectedVersion}"/>
                                <Button Content="Поверх текущего"
                                        Command="{Binding RestoreVersionOverwriteCommand}"
                                        IsEnabled="{Binding CanRestoreSelectedVersion}"/>
                            </StackPanel>

                            <Button Content="Diff с предыдущей"
                                    Command="{Binding CompareSelectedWithPreviousCommand}"
                                    IsEnabled="{Binding CanRunDiffForSelectedVersion}"/>

                            <TextBlock Text="{Binding VersionActionMessage}"
                                       TextWrapping="Wrap"
                                       Opacity="0.9"
                                       IsVisible="{Binding HasVersionActionMessage}"/>

                            <TextBox Text="{Binding DiffPreview}"
                                     AcceptsReturn="True"
                                     IsReadOnly="True"
                                     Height="220"
                                     IsVisible="{Binding HasDiffPreview}"/>
                        </StackPanel>

                        <StackPanel IsVisible="{Binding HasNoSelectedItem}" Spacing="6">
                            <TextBlock Text="Выберите файл или папку" Opacity="0.75"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>

