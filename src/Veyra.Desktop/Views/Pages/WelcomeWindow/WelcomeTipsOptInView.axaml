<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Veyra.Desktop.Views.Pages.WelcomeWindow.WelcomeTipsOptInView"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Veyra.Desktop.ViewModels.Pages.WelcomeWindow"
             d:DataContext="{d:DesignInstance vm:WelcomeTipsOptInViewModel, IsDesignTimeCreatable=True}"
             x:DataType="vm:WelcomeTipsOptInViewModel">
    <Border Padding="24">
        <StackPanel Spacing="16" HorizontalAlignment="Center" Width="520">

            <StackPanel Spacing="6" HorizontalAlignment="Center">
                <TextBlock Text="Показывать обучающие подсказки?" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="Мы можем показывать интерактивные подсказки и туры по интерфейсу, чтобы помочь вам быстрее освоить приложение."
                           TextWrapping="Wrap" Opacity="0.85"/>
            </StackPanel>

            <StackPanel>
                <Border Classes="card">
                    <StackPanel>
                        <TextBlock Text="Интерактивные туры" FontWeight="SemiBold"/>
                        <TextBlock Text="Пошаговое знакомство с функциями" Opacity="0.85"/>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel>
                        <TextBlock Text="Контекстные подсказки" FontWeight="SemiBold"/>
                        <TextBlock Text="Советы при работе с файлами" Opacity="0.85"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                <TextBlock Text="Включить обучающие подсказки" VerticalAlignment="Center"/>
                <CheckBox IsChecked="{Binding EnableTips, Mode=TwoWay}"/>
            </StackPanel>

            <StackPanel>
                <Button Content="Продолжить"
                        HorizontalAlignment="Center"
                        Width="160"
                        Command="{Binding ContinueCommand}"/>
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>
