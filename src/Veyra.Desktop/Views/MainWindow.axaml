<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:windows="clr-namespace:Veyra.Desktop.ViewModels.Windows"
        xmlns:dashboard="clr-namespace:Veyra.Desktop.Views.Pages.Dashboard"
        mc:Ignorable="d"
        x:Class="Veyra.Desktop.Views.MainWindow"
        x:DataType="windows:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="VeyraFlow — Версионный Проводник"
        Width="1200" Height="750"
        MinWidth="900" MinHeight="600"
        Background="#0D0D0D" Foreground="#EEEEEE"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <!-- Top title bar -->
        <Border DockPanel.Dock="Top" Padding="20,12"
                Background="#0A0A0A" BorderBrush="#1A1A1A" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="⟐" FontSize="20" Foreground="#8B5CF6" VerticalAlignment="Center"/>
                    <TextBlock Text="Версионный Проводник" FontSize="15" FontWeight="SemiBold"
                               Foreground="#EEEEEE" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Right">
                    <TextBlock Text="⚙" FontSize="16" Foreground="#555" VerticalAlignment="Center"
                               Cursor="Hand"/>
                </StackPanel>
                <Panel/> <!-- spacer -->
            </DockPanel>
        </Border>

        <!-- Dashboard content -->
        <dashboard:RepositoryDashboardView DataContext="{Binding Dashboard}"/>
    </DockPanel>
</Window>
