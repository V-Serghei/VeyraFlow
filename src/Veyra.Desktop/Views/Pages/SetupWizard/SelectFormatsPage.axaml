<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Veyra.Desktop.ViewModels.Pages.SetupWizard"
             xmlns:setupWizard="clr-namespace:Veyra.Desktop.Models.Pages.SetupWizard"
             x:Class="Veyra.Desktop.Views.Pages.SetupWizard.SelectFormatsPage"
             d:DataContext="{d:DesignInstance vm:SelectFormatsViewModel, IsDesignTimeCreatable=True}"
             x:DataType="vm:SelectFormatsViewModel">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
        <StackPanel Spacing="8">
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Выбор форматов"/>
            <TextBlock Opacity="0.8" Text="Отметь расширения, которые будут участвовать в сканировании"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#171717" CornerRadius="10" Padding="10" BorderBrush="#262626" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding AllExtensions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="setupWizard:FileExtensionOption">
                            <ToggleButton Margin="5" Padding="12,6" IsChecked="{Binding IsSelected}">
                                <TextBlock Text="{Binding Name}"/>
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="240,Auto,*" ColumnSpacing="8">
            <TextBox Grid.Column="0" Text="{Binding CustomExt, Mode=TwoWay}" Watermark="добавить формат"/>
            <Button Grid.Column="1" Content="Добавить" Width="100" Command="{Binding AddCustomCommand}"/>
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Opacity="0.7" Text="{Binding FooterText}"/>
        </Grid>
    </Grid>
</UserControl>
