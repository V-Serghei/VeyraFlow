<UserControl
    x:Class="Veyra.Desktop.Views.Pages.AuthWindow.LoginView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:vm="clr-namespace:Veyra.Desktop.ViewModels.Pages.AuthWindow"
    xmlns:conv="clr-namespace:Veyra.Desktop.Converters"
    d:DataContext="{d:DesignInstance vm:LoginViewModel, IsDesignTimeCreatable=True}"
    x:DataType="vm:LoginViewModel"
    Background="#0D0D0D">

    <Grid>
        <Border Width="460" Padding="28" Background="#131313" CornerRadius="14"
                BorderBrush="#272727" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="14">
                <TextBlock Text="VeyraFlow" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding ActionTitle}" FontSize="20"/>
                <TextBlock Text="Secure cloud account and sync access" Opacity="0.75"/>

                <StackPanel Spacing="6" Margin="0,8,0,0">
                    <TextBlock Text="Username" Opacity="0.8"/>
                    <TextBox Text="{Binding Username}" Watermark="Enter username"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Password" Opacity="0.8"/>
                    <TextBox PasswordChar="*" Text="{Binding Password}" Watermark="Enter password"/>
                </StackPanel>

                <StackPanel Spacing="6" IsVisible="{Binding IsRegisterMode}">
                    <TextBlock Text="Confirm password" Opacity="0.8"/>
                    <TextBox PasswordChar="*" Text="{Binding ConfirmPassword}" Watermark="Repeat password"/>
                </StackPanel>

                <Button Content="Sign in"
                        Command="{Binding LoginCommand}"
                        IsVisible="{Binding IsRegisterMode, Converter={x:Static conv:BoolInvertConverter.Instance}}"
                        IsEnabled="{Binding IsBusy, Converter={x:Static conv:BoolInvertConverter.Instance}}"
                        Height="38"/>

                <Button Content="Register"
                        Command="{Binding RegisterCommand}"
                        IsVisible="{Binding IsRegisterMode}"
                        IsEnabled="{Binding IsBusy, Converter={x:Static conv:BoolInvertConverter.Instance}}"
                        Height="38"/>

                <Button Content="{Binding ToggleLabel}"
                        Command="{Binding ToggleModeCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#7DD3FC"
                        HorizontalAlignment="Left"/>

                <TextBlock Foreground="#F87171" Text="{Binding Error}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
