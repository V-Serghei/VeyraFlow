<UserControl
    x:Class="Veyra.Desktop.Views.Pages.AuthWindow.LoginView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:vm="clr-namespace:Veyra.Desktop.ViewModels.Pages.AuthWindow"
    d:DataContext="{d:DesignInstance vm:LoginViewModel, IsDesignTimeCreatable=True}"
    xmlns:conv="clr-namespace:Veyra.Desktop.Converters"
    x:DataType="vm:LoginViewModel"
    Background="#0D0D0D">

    <Grid>
        <Border Width="440" Padding="28" Background="#131313" CornerRadius="14"
                BorderBrush="#272727" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="14">
                <TextBlock Text="Вход в VeyraFlow" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="Локальный профиль и доступ к рабочим пространствам" Opacity="0.75"/>

                <StackPanel Spacing="6" Margin="0,8,0,0">
                    <TextBlock Text="Логин" Opacity="0.8"/>
                    <TextBox Text="{Binding Username}" Watermark="Введите логин"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Пароль" Opacity="0.8"/>
                    <TextBox PasswordChar="•" Text="{Binding Password}" Watermark="Введите пароль"/>
                </StackPanel>

                <Button Content="Войти"
                        Command="{Binding LoginCommand}"
                        IsEnabled="{Binding IsBusy, Converter={x:Static conv:BoolInvertConverter.Instance}}"
                        Height="38"/>

                <TextBlock Foreground="#F87171" Text="{Binding Error}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
