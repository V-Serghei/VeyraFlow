<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Veyra.Desktop.Localization"
        x:Class="Veyra.Desktop.Views.Windows.DetachedImagePreviewWindow"
        Width="1160"
        Height="860"
        MinWidth="680"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="Full"
        CanResize="True"
        Background="{DynamicResource VeyraCanvasBrush}"
        Foreground="{DynamicResource VeyraTextPrimaryBrush}">

    <Grid RowDefinitions="Auto,*" Margin="16" RowSpacing="12">
        <Border Grid.Row="0" Classes="dialog-shell" Padding="12">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock x:Name="PreviewTitleTextBlock"
                               FontSize="15"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{loc:Tr compare.zoom_hint}"
                               Classes="muted"
                               FontSize="11"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Classes="subtle compact responsive-icon"
                        Click="OnZoomOutClicked"
                        ToolTip.Tip="{loc:Tr compare.zoom_out}">
                    <Button.Content>
                        <StackPanel Classes="button-content">
                            <TextBlock Classes="button-icon" Text="-"/>
                            <TextBlock Classes="button-label" Text="{loc:Tr compare.zoom_out}"/>
                        </StackPanel>
                    </Button.Content>
                </Button>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Tr compare.zoom}" Classes="muted" FontSize="11" VerticalAlignment="Center"/>
                    <Slider x:Name="ZoomSlider"
                            Width="180"
                            Minimum="1"
                            Maximum="500"
                            Value="100"
                            TickFrequency="10"
                            ValueChanged="OnZoomSliderValueChanged"/>
                    <TextBlock x:Name="ZoomValueTextBlock"
                               Width="56"
                               Text="100%"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <Button Grid.Column="3"
                        Classes="subtle compact responsive-icon"
                        Click="OnZoomInClicked"
                        ToolTip.Tip="{loc:Tr compare.zoom_in}">
                    <Button.Content>
                        <StackPanel Classes="button-content">
                            <TextBlock Classes="button-icon" Text="+"/>
                            <TextBlock Classes="button-label" Text="{loc:Tr compare.zoom_in}"/>
                        </StackPanel>
                    </Button.Content>
                </Button>

                <Button Grid.Column="4"
                        Classes="subtle compact responsive-icon"
                        Click="OnFitToWindowClicked"
                        ToolTip.Tip="{loc:Tr compare.zoom_fit}">
                    <Button.Content>
                        <StackPanel Classes="button-content">
                            <TextBlock Classes="button-icon" Text="&#xE9A6;"/>
                            <TextBlock Classes="button-label" Text="{loc:Tr compare.zoom_fit}"/>
                        </StackPanel>
                    </Button.Content>
                </Button>

                <Button Grid.Column="5"
                        Classes="subtle compact responsive-icon"
                        Click="OnResetToHundredClicked"
                        ToolTip.Tip="{loc:Tr compare.zoom_reset}">
                    <Button.Content>
                        <StackPanel Classes="button-content">
                            <TextBlock Classes="button-icon" Text="100"/>
                            <TextBlock Classes="button-label" Text="{loc:Tr compare.zoom_reset}"/>
                        </StackPanel>
                    </Button.Content>
                </Button>

                <Button Grid.Column="6"
                        Classes="subtle compact responsive-icon"
                        Click="OnCloseClicked"
                        ToolTip.Tip="{loc:Tr common.close}">
                    <Button.Content>
                        <StackPanel Classes="button-content">
                            <TextBlock Classes="button-icon" Text="&#xE711;"/>
                            <TextBlock Classes="button-label" Text="{loc:Tr common.close}"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{DynamicResource VeyraSurfaceSoftBrush}"
                BorderBrush="{DynamicResource VeyraBorderSoftBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="8">
            <ScrollViewer x:Name="ImageScrollViewer"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          PointerWheelChanged="OnImagePointerWheelChanged"
                          SizeChanged="OnImageViewportSizeChanged">
                <Grid x:Name="ImageViewportHost"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      ClipToBounds="True">
                    <Grid x:Name="ImageHost"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          ClipToBounds="True">
                        <Image x:Name="PreviewImage"
                               Stretch="Uniform"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"/>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
