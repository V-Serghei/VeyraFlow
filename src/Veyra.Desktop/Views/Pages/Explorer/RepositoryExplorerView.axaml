
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:explorer="clr-namespace:Veyra.Desktop.ViewModels.Pages.Explorer"
             x:Class="Veyra.Desktop.Views.Pages.Explorer.RepositoryExplorerView"
             x:Name="Root"
             x:DataType="explorer:RepositoryExplorerViewModel"
             Background="{DynamicResource VeyraCanvasBrush}">

    <UserControl.Styles>
        <Style Selector="ListBox.clean-list">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBox.clean-list > ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ListBox.clean-list > ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#23384D"/>
        </Style>
        <Style Selector="ListBox.clean-list > ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1B2E42"/>
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource VeyraTextMutedBrush}"/>
            <Setter Property="Opacity" Value="0.9"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*" Margin="18,14,18,18" RowSpacing="10">
        <Border Grid.Row="0" Classes="hero">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                <Button Grid.Column="0" Content="Back" Command="{Binding BackCommand}" Classes="subtle"/>

                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="{Binding RepositoryName}" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Classes="muted" Text="{Binding RepositoryPath}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Classes="muted"
                               Text="Live sync enabled"
                               FontSize="11"
                               IsVisible="{Binding IsLiveSyncActive}"/>
                </StackPanel>

                <WrapPanel Grid.Column="2" Orientation="Horizontal" ItemHeight="34" ItemWidth="150" Margin="0,2,0,0">
                    <Button Content="Sync index"
                            Command="{Binding RescanCommand}"
                            Classes="subtle"
                            IsEnabled="{Binding CanRunScanActions}"/>
                    <Button Content="Create snapshot"
                            Command="{Binding CreateSnapshotCommand}"
                            Classes="primary"
                            IsEnabled="{Binding CanCreateSnapshot}"/>
                    <Button Content="Snapshot history"
                            Command="{Binding ShowSnapshotHistoryCommand}"
                            Classes="subtle"
                            IsEnabled="{Binding CanRunScanActions}"/>
                    <Button Content="Settings" Command="{Binding OpenSettingsCommand}" Classes="subtle"/>
                </WrapPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Spacing="6">
            <Border Classes="panel" IsVisible="{Binding IsScanRunning}" Padding="10">
                <Grid ColumnDefinitions="*,120" ColumnSpacing="10" VerticalAlignment="Center">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="{Binding ScanMessage}" FontWeight="SemiBold"/>
                        <ProgressBar Minimum="0"
                                     Maximum="100"
                                     Value="{Binding ScanPercent}"
                                     Height="8"
                                     IsIndeterminate="{Binding ScanIsIndeterminate}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding ScanPercent, StringFormat='{}{0}%'}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>
                </Grid>
            </Border>

            <Border Classes="panel" IsVisible="{Binding HasErrorMessage}" Padding="10" BorderBrush="#7B3139">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource VeyraDangerBrush}" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid ColumnDefinitions="270,*,390" ColumnSpacing="12">
                <Border Grid.Column="0" Classes="panel">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Folders" Classes="section-title" Margin="0,0,0,8"/>
                        <TreeView ItemsSource="{Binding TreeNodes}"
                                  SelectedItem="{Binding SelectedTreeNode, Mode=TwoWay}">
                            <TreeView.DataTemplates>
                                <TreeDataTemplate DataType="explorer:ExplorerTreeNodeViewModel" ItemsSource="{Binding Children}">
                                    <TextBlock Text="{Binding Name}"/>
                                </TreeDataTemplate>
                            </TreeView.DataTemplates>
                        </TreeView>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Classes="panel">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                        <TextBox Grid.Row="0"
                                 Text="{Binding SearchQuery, Mode=TwoWay}"
                                 Watermark="Search in current folder"/>

                        <Grid Grid.Row="1" ColumnDefinitions="40,*,120,110,120,110" Margin="0,4,0,2" ColumnSpacing="6">
                            <TextBlock Grid.Column="1" Text="Name" FontWeight="SemiBold" Opacity="0.82"/>
                            <TextBlock Grid.Column="2" Text="Type" FontWeight="SemiBold" Opacity="0.82"/>
                            <TextBlock Grid.Column="3" Text="Size" FontWeight="SemiBold" Opacity="0.82"/>
                            <TextBlock Grid.Column="4" Text="Modified" FontWeight="SemiBold" Opacity="0.82"/>
                            <TextBlock Grid.Column="5" Text="Action" FontWeight="SemiBold" Opacity="0.82"/>
                        </Grid>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="explorer:ExplorerItemViewModel">
                                        <Border Classes="card" Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="40,*,120,110,120,110" ColumnSpacing="6">
                                                <Button Grid.Column="0"
                                                        Content="{Binding Icon}"
                                                        FontSize="14"
                                                        Classes="subtle"
                                                        Command="{Binding #Root.((explorer:RepositoryExplorerViewModel)DataContext).SelectItemCommand}"
                                                        CommandParameter="{Binding .}"/>

                                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Type}" VerticalAlignment="Center" Opacity="0.85"/>
                                                <TextBlock Grid.Column="3" Text="{Binding SizeDisplay}" VerticalAlignment="Center" Opacity="0.85"/>
                                                <TextBlock Grid.Column="4" Text="{Binding ModifiedDisplay}" VerticalAlignment="Center" Opacity="0.85"/>

                                                <Button Grid.Column="5"
                                                        Content="Open"
                                                        Classes="subtle"
                                                        IsVisible="{Binding CanOpenDirectory}"
                                                        Command="{Binding #Root.((explorer:RepositoryExplorerViewModel)DataContext).OpenItemCommand}"
                                                        CommandParameter="{Binding .}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Classes="panel">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Pending changes" Classes="section-title"/>
                            <TextBlock Classes="muted" Text="{Binding LastSnapshotLabel}"/>
                            <TextBlock Text="{Binding PendingChangesSummary}" Opacity="0.88" TextWrapping="Wrap"/>
                            <ListBox Classes="clean-list"
                                     ItemsSource="{Binding PendingChanges}"
                                     MaxHeight="230"
                                     IsVisible="{Binding HasPendingChanges}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="explorer:RepositoryPendingChangeViewModel">
                                        <Border Classes="card">
                                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" RowSpacing="2">
                                                <TextBlock Grid.Row="0" Grid.Column="0"
                                                           Text="{Binding ChangeKindLabel}"
                                                           Foreground="{Binding ChangeKindColor}"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding SizeDeltaLabel}" Opacity="0.78"/>
                                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                                           Text="{Binding RelativePath}"
                                                           Opacity="0.72"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="No pending changes" Opacity="0.72" IsVisible="{Binding HasNoPendingChanges}"/>

                            <Button Content="Open snapshot history"
                                    Command="{Binding ShowSnapshotHistoryCommand}"
                                    Classes="subtle"
                                    HorizontalAlignment="Stretch"
                                    Padding="12,10"/>

                            <Border Height="1" Background="{DynamicResource VeyraBorderSoftBrush}" Margin="0,4"/>

                            <TextBlock Text="Selected file" Classes="section-title"/>

                            <StackPanel IsVisible="{Binding HasSelectedItem}" Spacing="8">
                                <TextBlock Text="{Binding SelectedItem.Name}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Classes="muted" Text="{Binding SelectedItem.RelativePath}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedItem.Type}" Opacity="0.84"/>
                                <TextBlock Text="{Binding SelectedItem.SizeDisplay}" Opacity="0.84"/>
                                <TextBlock Text="{Binding SelectedItem.ModifiedDisplay}" Opacity="0.84"/>

                                <Border Height="1" Background="{DynamicResource VeyraBorderSoftBrush}" Margin="0,4"/>

                                <TextBlock Text="File versions" FontWeight="SemiBold"/>
                                <TextBlock Text="Loading versions..." Opacity="0.72" IsVisible="{Binding IsVersionLoading}"/>

                                <ListBox Classes="clean-list"
                                         ItemsSource="{Binding FileVersions}"
                                         SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                                         MaxHeight="200">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="explorer:ExplorerFileVersionViewModel">
                                            <Border Classes="card" Padding="8">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding Title}"/>
                                                    <TextBlock Text="{Binding SizeDisplay}" Opacity="0.7" FontSize="11"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock Text="No content blocks for selected version. Restore and diff are unavailable."
                                           Foreground="{DynamicResource VeyraWarningBrush}"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding SelectedVersionHasNoContentBlocks}"/>

                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="Restore as copy"
                                            Command="{Binding RestoreVersionAsCopyCommand}"
                                            IsEnabled="{Binding CanRestoreSelectedVersion}"
                                            Classes="subtle"/>
                                    <Button Content="Restore overwrite"
                                            Command="{Binding RestoreVersionOverwriteCommand}"
                                            IsEnabled="{Binding CanRestoreSelectedVersion}"/>
                                </StackPanel>

                                <Button Content="Preview diff"
                                        Command="{Binding CompareSelectedWithPreviousCommand}"
                                        IsEnabled="{Binding CanRunDiffForSelectedVersion}"
                                        Classes="primary"/>

                                <TextBlock Text="{Binding VersionActionMessage}"
                                           TextWrapping="Wrap"
                                           Opacity="0.9"
                                           IsVisible="{Binding HasVersionActionMessage}"/>
                            </StackPanel>

                            <TextBlock Text="Select a file from index or snapshot history."
                                       Opacity="0.72"
                                       IsVisible="{Binding HasNoSelectedItem}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Border IsVisible="{Binding IsSnapshotHistoryMenuOpen}"
                    Background="#B2060A12"
                    Padding="20">
                <Border Classes="panel" Padding="14" CornerRadius="16">
                    <Grid RowDefinitions="Auto,*" RowSpacing="12">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Snapshot history" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Classes="muted"
                                           Text="Browse commits, inspect changed files and manage file versions."
                                           FontSize="12"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Close"
                                    Command="{Binding CloseSnapshotHistoryMenuCommand}"
                                    Classes="subtle"/>
                        </Grid>

                        <Grid Grid.Row="1" ColumnDefinitions="330,370,*" ColumnSpacing="12">
                            <Border Grid.Column="0" Classes="panel">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Commits" Classes="section-title"/>
                                    <TextBlock Text="Loading commits..." Opacity="0.72" IsVisible="{Binding IsSnapshotHistoryLoading}"/>

                                    <ListBox Classes="clean-list"
                                             ItemsSource="{Binding SnapshotHistory}"
                                             SelectedItem="{Binding SelectedSnapshot, Mode=TwoWay}"
                                             IsVisible="{Binding HasSnapshotHistory}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="explorer:RepositorySnapshotHistoryEntryViewModel">
                                                <Border Classes="card">
                                                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="3">
                                                        <TextBlock Grid.Row="0" Text="{Binding DisplayTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Row="1" Text="{Binding DisplayTime}" Opacity="0.78" FontSize="11"/>
                                                        <TextBlock Grid.Row="2" Text="{Binding ChangedFilesLabel}" Opacity="0.78" FontSize="11"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <TextBlock Text="No commits yet" Opacity="0.72" IsVisible="{Binding HasNoSnapshotHistory}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Classes="panel">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Files in selected commit" Classes="section-title"/>
                                    <TextBlock Text="Select a commit to see changed files" Opacity="0.72" IsVisible="{Binding HasNoSelectedSnapshot}"/>
                                    <TextBlock Text="Loading changed files..." Opacity="0.72" IsVisible="{Binding IsSnapshotFilesLoading}"/>

                                    <ListBox Classes="clean-list"
                                             ItemsSource="{Binding SnapshotFiles}"
                                             SelectedItem="{Binding SelectedSnapshotFile, Mode=TwoWay}"
                                             IsVisible="{Binding HasSnapshotFiles}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="explorer:RepositorySnapshotFileChangeViewModel">
                                                <Border Classes="card">
                                                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" RowSpacing="2">
                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding ChangeKindLabel}" FontWeight="SemiBold"/>
                                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding SizeDeltaLabel}" Opacity="0.78"/>
                                                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                                                   Text="{Binding RelativePath}"
                                                                   Opacity="0.72"
                                                                   FontSize="11"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <TextBlock Text="No changed files in this commit" Opacity="0.72" IsVisible="{Binding HasNoSnapshotFiles}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Classes="panel">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Version controls" Classes="section-title"/>

                                        <StackPanel IsVisible="{Binding HasSelectedItem}" Spacing="8">
                                            <TextBlock Text="{Binding SelectedItem.Name}" FontSize="16" FontWeight="SemiBold"/>
                                            <TextBlock Classes="muted" Text="{Binding SelectedItem.RelativePath}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding SelectedItem.Type}"/>
                                            <TextBlock Text="{Binding SelectedItem.SizeDisplay}"/>
                                            <TextBlock Text="{Binding SelectedItem.ModifiedDisplay}"/>
                                            <TextBlock Classes="muted" Text="{Binding SelectedItem.HashSha256}" TextWrapping="Wrap"/>

                                            <Border Height="1" Background="{DynamicResource VeyraBorderSoftBrush}" Margin="0,4"/>

                                            <TextBlock Text="File versions" FontWeight="SemiBold"/>
                                            <TextBlock Text="Loading versions..." Opacity="0.72" IsVisible="{Binding IsVersionLoading}"/>

                                            <ListBox Classes="clean-list"
                                                     ItemsSource="{Binding FileVersions}"
                                                     SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                                                     MaxHeight="220">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="explorer:ExplorerFileVersionViewModel">
                                                        <Border Classes="card" Padding="8">
                                                            <StackPanel Spacing="2">
                                                                <TextBlock Text="{Binding Title}"/>
                                                                <TextBlock Text="{Binding SizeDisplay}" Opacity="0.72" FontSize="11"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>

                                            <TextBlock Text="No content blocks for selected version. Restore and diff are unavailable."
                                                       Foreground="{DynamicResource VeyraWarningBrush}"
                                                       TextWrapping="Wrap"
                                                       IsVisible="{Binding SelectedVersionHasNoContentBlocks}"/>

                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Button Content="Restore as copy"
                                                        Command="{Binding RestoreVersionAsCopyCommand}"
                                                        IsEnabled="{Binding CanRestoreSelectedVersion}"
                                                        Classes="subtle"/>
                                                <Button Content="Restore overwrite"
                                                        Command="{Binding RestoreVersionOverwriteCommand}"
                                                        IsEnabled="{Binding CanRestoreSelectedVersion}"/>
                                            </StackPanel>

                                            <Button Content="Preview diff"
                                                    Command="{Binding CompareSelectedWithPreviousCommand}"
                                                    IsEnabled="{Binding CanRunDiffForSelectedVersion}"
                                                    Classes="primary"/>

                                            <TextBlock Text="{Binding VersionActionMessage}"
                                                       TextWrapping="Wrap"
                                                       Opacity="0.9"
                                                       IsVisible="{Binding HasVersionActionMessage}"/>
                                        </StackPanel>

                                        <TextBlock Text="Select a file in commit list to open version controls."
                                                   Opacity="0.75"
                                                   IsVisible="{Binding HasNoSelectedItem}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Border>

            <Border IsVisible="{Binding IsDiffPreviewMenuOpen}"
                    Background="#BD09101A"
                    Padding="22">
                <Border Classes="panel" Padding="14" CornerRadius="16" BorderBrush="#2E506B">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Diff preview" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Classes="muted" Text="{Binding DiffPreviewTitle}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Close"
                                    Command="{Binding CloseDiffPreviewMenuCommand}"
                                    Classes="subtle"/>
                        </Grid>

                        <TextBlock Grid.Row="1" Text="{Binding DiffPreviewSummary}" Opacity="0.84" TextWrapping="Wrap"/>

                        <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="8">
                            <TextBlock Grid.Row="0"
                                       Text="Building preview..."
                                       Opacity="0.75"
                                       IsVisible="{Binding IsDiffPreviewLoading}"/>

                            <Grid Grid.Row="1"
                                  ColumnDefinitions="*,*"
                                  ColumnSpacing="10"
                                  IsVisible="{Binding HasDiffPreviewColumns}">
                                <Border Grid.Column="0" Classes="panel" Padding="10" BorderBrush="#2D465A">
                                    <Grid RowDefinitions="Auto,*" RowSpacing="8">
                                        <TextBlock Text="Before" FontWeight="SemiBold"/>
                                        <TextBox Grid.Row="1"
                                                 Text="{Binding DiffPreviewLeftColumn}"
                                                 IsReadOnly="True"
                                                 AcceptsReturn="True"
                                                 TextWrapping="NoWrap"
                                                 FontFamily="Cascadia Code,Consolas,Monospace"
                                                 FontSize="12"/>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="1" Classes="panel" Padding="10" BorderBrush="#2A5862">
                                    <Grid RowDefinitions="Auto,*" RowSpacing="8">
                                        <TextBlock Text="After" FontWeight="SemiBold"/>
                                        <TextBox Grid.Row="1"
                                                 Text="{Binding DiffPreviewRightColumn}"
                                                 IsReadOnly="True"
                                                 AcceptsReturn="True"
                                                 TextWrapping="NoWrap"
                                                 FontFamily="Cascadia Code,Consolas,Monospace"
                                                 FontSize="12"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <TextBlock Grid.Row="1"
                                       Text="Diff data is unavailable for this file/version pair."
                                       Opacity="0.75"
                                       IsVisible="{Binding HasNoDiffPreviewColumns}"/>
                        </Grid>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </Grid>
</UserControl>
