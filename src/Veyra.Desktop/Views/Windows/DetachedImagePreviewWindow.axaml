<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Veyra.Desktop.Localization"
        x:Class="Veyra.Desktop.Views.Windows.DetachedImagePreviewWindow"
        Width="1160"
        Height="860"
        MinWidth="680"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="Full"
        CanResize="True"
        Topmost="True"
        Background="{DynamicResource VeyraCanvasBrush}"
        Foreground="{DynamicResource VeyraTextPrimaryBrush}">

    <Grid RowDefinitions="Auto,*" Margin="16" RowSpacing="12">
        <Border Grid.Row="0" Classes="dialog-shell" Padding="12">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                <StackPanel Grid.Row="0" Spacing="2">
                    <TextBlock x:Name="PreviewTitleTextBlock"
                               FontSize="15"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{loc:Tr compare.zoom_hint}"
                               Classes="muted"
                               FontSize="11"/>
                </StackPanel>

                <WrapPanel Grid.Row="1"
                           Orientation="Horizontal"
                           HorizontalAlignment="Right"
                           ItemHeight="40">
                    <Button Classes="subtle compact responsive-icon"
                            Click="OnZoomOutClicked"
                            Margin="0,0,8,8">
                        <Button.Content>
                            <StackPanel Classes="button-content">
                                <TextBlock Classes="button-icon" Text="-"/>
                                <TextBlock Classes="button-label" Text="{loc:Tr compare.zoom_out}"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>

                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center"
                                Margin="0,0,8,8">
                        <TextBlock Text="{loc:Tr compare.zoom}"
                                   Classes="muted"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>
                        <Slider x:Name="ZoomSlider"
                                Width="180"
                                Minimum="1"
                                Maximum="500"
                                Value="100"
                                TickFrequency="10"
                                ValueChanged="OnZoomSliderValueChanged"/>
                        <TextBlock x:Name="ZoomValueTextBlock"
                                   Width="56"
                                   Text="100%"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"/>
                    </StackPanel>

                    <Button Classes="subtle compact responsive-icon"
                            Click="OnZoomInClicked"
                            Margin="0,0,8,8">
                        <Button.Content>
                            <StackPanel Classes="button-content">
                                <TextBlock Classes="button-icon" Text="+"/>
                                <TextBlock Classes="button-label" Text="{loc:Tr compare.zoom_in}"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>

                    <Button Classes="subtle compact responsive-icon"
                            Click="OnFitToWindowClicked"
                            Margin="0,0,8,8">
                        <Button.Content>
                            <StackPanel Classes="button-content">
                                <TextBlock Classes="button-icon" Text="&#xE9A6;"/>
                                <TextBlock Classes="button-label" Text="{loc:Tr compare.zoom_fit}"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>

                    <Button Classes="subtle compact responsive-icon"
                            Click="OnResetToHundredClicked"
                            Margin="0,0,8,8">
                        <Button.Content>
                            <StackPanel Classes="button-content">
                                <TextBlock Classes="button-icon" Text="100"/>
                                <TextBlock Classes="button-label" Text="{loc:Tr compare.zoom_reset}"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>

                    <Button Classes="subtle compact responsive-icon"
                            Click="OnCloseClicked"
                            Margin="0,0,0,8">
                        <Button.Content>
                            <StackPanel Classes="button-content">
                                <TextBlock Classes="button-icon" Text="&#xE711;"/>
                                <TextBlock Classes="button-label" Text="{loc:Tr common.close}"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{DynamicResource VeyraSurfaceSoftBrush}"
                BorderBrush="{DynamicResource VeyraBorderSoftBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="8">
            <ScrollViewer x:Name="ImageScrollViewer"
                          Focusable="True"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          PointerPressed="OnImagePointerPressed"
                          PointerMoved="OnImagePointerMoved"
                          PointerReleased="OnImagePointerReleased"
                          PointerCaptureLost="OnImagePointerCaptureLost"
                          PointerWheelChanged="OnImagePointerWheelChanged"
                          KeyDown="OnImageKeyDown"
                          KeyUp="OnImageKeyUp"
                          LostFocus="OnImageLostFocus"
                          SizeChanged="OnImageViewportSizeChanged">
                <Grid x:Name="ImageViewportHost"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      ClipToBounds="True">
                    <Grid x:Name="ImageHost"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          ClipToBounds="True">
                        <Image x:Name="PreviewImage"
                               Stretch="Uniform"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"/>
                        <Image x:Name="SplitBaseImage"
                               Stretch="Uniform"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               IsVisible="False"/>
                        <Border x:Name="SplitRevealHost"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                ClipToBounds="True"
                                IsVisible="False">
                            <Image x:Name="SplitRevealImage"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"/>
                        </Border>
                        <Border x:Name="SplitDivider"
                                Width="2"
                                Background="{DynamicResource VeyraInfoBrush}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch"
                                IsVisible="False"
                                IsHitTestVisible="False"/>
                        <Image x:Name="PeekBeforeImage"
                               Stretch="Uniform"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               IsVisible="False"
                               IsHitTestVisible="False"/>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
