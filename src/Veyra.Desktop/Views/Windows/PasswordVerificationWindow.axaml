<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Veyra.Desktop.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:windows="clr-namespace:Veyra.Desktop.ViewModels.Windows"
        mc:Ignorable="d"
        x:Class="Veyra.Desktop.Views.Windows.PasswordVerificationWindow"
        x:DataType="windows:PasswordVerificationWindowViewModel"
        Width="520"
        Height="320"
        MinWidth="460"
        MinHeight="280"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource VeyraCanvasBrush}"
        Foreground="{DynamicResource VeyraTextPrimaryBrush}"
        Title="{Binding WindowTitleText}">
    <Border Padding="16" Background="{DynamicResource VeyraCanvasBrush}">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
            <Border Grid.Row="0" Classes="dialog-hero">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding TitleText}" Classes="h2"/>
                    <TextBlock Text="{Binding Message}" Classes="muted" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding UsernameText}" Classes="caption"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Classes="dialog-shell" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding PasswordLabelText}" Classes="label"/>
                    <TextBox Text="{Binding Password, Mode=TwoWay}"
                             PasswordChar="*"
                             Watermark="{Binding PasswordPlaceholderText}"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Classes="toolbar" Padding="10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="{Binding CancelButtonText}" Command="{Binding CancelCommand}" Classes="subtle" Width="110"/>
                    <Button Content="{Binding ContinueButtonText}" Command="{Binding ConfirmCommand}" Classes="primary" Width="130"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
