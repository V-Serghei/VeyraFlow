<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Veyra.Desktop.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:windows="clr-namespace:Veyra.Desktop.ViewModels.Windows"
        xmlns:conv="clr-namespace:Veyra.Desktop.Converters"
        mc:Ignorable="d"
        x:Class="Veyra.Desktop.Views.Windows.SnapshotNameDialogWindow"
        x:Name="Root"
        x:DataType="windows:SnapshotNameDialogWindowViewModel"
        Width="1180"
        Height="760"
        MinWidth="860"
        MinHeight="580"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="Full"
        CanResize="True"
        Background="{DynamicResource VeyraCanvasBrush}"
        Foreground="{DynamicResource VeyraTextPrimaryBrush}"
        Title="{loc:Tr snapshot_dialog.window_title}">

    <Grid RowDefinitions="Auto,*" Margin="16" RowSpacing="12">
        <Border Grid.Row="0" Classes="dialog-hero">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="{loc:Tr snapshot_dialog.title}" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SnapshotHeaderSummary}"
                                   Classes="muted"
                                   FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="8">
                        <Button Width="132" Classes="subtle responsive-icon" Command="{Binding CancelCommand}">
                            <Button.Content>
                                <StackPanel Classes="button-content">
                                    <TextBlock Classes="button-icon" Text="&#xE711;"/>
                                    <TextBlock Classes="button-label" Text="{loc:Tr common.cancel}"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        <Button Width="164"
                                Classes="primary responsive-icon"
                                Command="{Binding SaveCommand}"
                                IsEnabled="{Binding CanSave}">
                            <Button.Content>
                                <StackPanel Classes="button-content">
                                    <TextBlock Classes="button-icon" Text="&#xE74E;"/>
                                    <TextBlock Classes="button-label" Text="{loc:Tr snapshot_dialog.save_snapshot}"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12" VerticalAlignment="Center">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="{loc:Tr snapshot_dialog.snapshot_name}" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding SnapshotName, Mode=TwoWay}"
                                 Watermark="{loc:Tr snapshot_dialog.snapshot_name_placeholder}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="{loc:Tr snapshot_dialog.snapshot_tags}" FontWeight="SemiBold"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox x:Name="SnapshotTagInputTextBox"
                                     Grid.Column="0"
                                     Text="{Binding SnapshotTagsInput, Mode=TwoWay}"
                                     Watermark="{loc:Tr snapshot_dialog.snapshot_tags_placeholder}"
                                     KeyDown="OnSnapshotTagInputKeyDown"
                                     LostFocus="OnTagInputLostFocus"/>
                            <Button Grid.Column="1"
                                    Content="{loc:Tr common.add}"
                                    Command="{Binding AddSnapshotTagCommand}"
                                    IsEnabled="{Binding CanAddSnapshotTag}"
                                    Classes="subtle"/>
                            <Popup Grid.Column="0"
                                   PlacementTarget="{Binding ElementName=SnapshotTagInputTextBox}"
                                   Placement="Bottom"
                                   IsOpen="{Binding HasTagSuggestions}"
                                   IsLightDismissEnabled="False"
                                   MinWidth="{Binding ElementName=SnapshotTagInputTextBox, Path=Bounds.Width}">
                                <Border Classes="card" Padding="4" MaxHeight="220">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding TagSuggestions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left"
                                                            Padding="10,6"
                                                            Classes="ghost"
                                                            Command="{Binding #Root.((windows:SnapshotNameDialogWindowViewModel)DataContext).SelectTagSuggestionCommand}"
                                                            CommandParameter="{Binding .}">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <TextBlock Text="#"
                                                                       Foreground="{DynamicResource VeyraInfoBrush}"
                                                                       FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding .}"
                                                                       FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </StackPanel>
                </Grid>

                <ItemsControl Grid.Row="2" ItemsSource="{Binding SnapshotTagChips}" IsVisible="{Binding HasSnapshotTags}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="badge"
                                    Margin="0,0,6,6"
                                    Padding="8,3"
                                    CornerRadius="12">
                                <StackPanel Orientation="Horizontal" Spacing="0">
                                    <Button Classes="subtle compact"
                                            Padding="2,0"
                                            Command="{Binding #Root.((windows:SnapshotNameDialogWindowViewModel)DataContext).OpenSnapshotTagCommand}"
                                            CommandParameter="{Binding .}"
                                            ToolTip.Tip="{loc:Tr snapshot_dialog.open_tag_tooltip}">
                                        <StackPanel Orientation="Horizontal" Spacing="0">
                                            <TextBlock Text="#"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource VeyraInfoBrush}"/>
                                            <TextBlock Text="{Binding .}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource VeyraInfoBrush}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="subtle compact"
                                            Width="22"
                                            Height="22"
                                            Padding="0"
                                            Margin="4,0,0,0"
                                            Command="{Binding #Root.((windows:SnapshotNameDialogWindowViewModel)DataContext).RemoveSnapshotTagCommand}"
                                            CommandParameter="{Binding .}"
                                            ToolTip.Tip="{loc:Tr snapshot_dialog.remove_tag_tooltip}">
                                        <TextBlock Text="&#xE711;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="10"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Row="3"
                           Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource VeyraDangerBrush}"
                           FontWeight="SemiBold"
                           IsVisible="{Binding HasErrorMessage}"
                           TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="320,8,*" ColumnSpacing="0">
            <Border Grid.Column="0" Classes="dialog-shell" MinWidth="240">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
                        <TextBlock Grid.Row="0" Text="{loc:Tr snapshot_dialog.changed_files}" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="1" Classes="muted" Text="{Binding ChangedFilesCountLabel}"/>

                        <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="8">
                            <TextBlock Grid.Row="0"
                                       Text="{loc:Tr snapshot_dialog.no_changed_files}"
                                       Classes="muted"
                                       IsVisible="{Binding HasNoChangedFiles}"/>

                            <ListBox Grid.Row="1"
                                     Classes="clean-list"
                                     ItemsSource="{Binding ChangedFiles}"
                                     SelectedItem="{Binding SelectedChangedFile, Mode=TwoWay}"
                                     IsVisible="{Binding HasChangedFiles}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="windows:SnapshotPendingFileItemViewModel">
                                        <Border Classes="list-item">
                                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" RowSpacing="4">
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding ChangeKindLabel}" FontWeight="SemiBold" Foreground="{DynamicResource VeyraInfoBrush}"/>
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding SizeDeltaLabel}" Opacity="0.85"/>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                                           Text="{Binding RelativePath}"
                                                           Classes="muted"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"/>

            <Border Grid.Column="2" Classes="dialog-shell" Margin="12,0,0,0" MinWidth="360">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <StackPanel Spacing="4">
                                <Border Classes="badge"
                                        HorizontalAlignment="Left"
                                        Padding="10,6"
                                        CornerRadius="9">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding SelectedChangedFileTitle}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding SelectedChangedFilePath}"
                                                   Classes="muted"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="420"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Classes="badge"
                                    CornerRadius="9"
                                    Padding="10,6"
                                    VerticalAlignment="Top"
                                    IsVisible="{Binding IsImagePreview, Converter={x:Static conv:BoolInvertConverter.Instance}}">
                                <TextBlock Text="{Binding SelectedChangedFileHint}" FontSize="11" TextWrapping="Wrap" MaxWidth="260"/>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1"
                              ColumnDefinitions="Auto,Auto,*,Auto,Auto"
                              ColumnSpacing="8"
                              VerticalAlignment="Center"
                              IsVisible="{Binding IsImagePreview, Converter={x:Static conv:BoolInvertConverter.Instance}}">
                            <Border Grid.Column="0"
                                    Width="28"
                                    Height="28"
                                    CornerRadius="14"
                                    Background="{DynamicResource VeyraSurfaceSoftBrush}"
                                    BorderBrush="{DynamicResource VeyraBorderSoftBrush}"
                                    BorderThickness="1"
                                    ToolTip.Placement="Bottom">
                                <ToolTip.Tip>
                                    <Border Classes="popover-panel" Padding="12" MaxWidth="360">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="{loc:Tr snapshot_dialog.diff_legend_title}" FontWeight="SemiBold"/>
                                            <WrapPanel Orientation="Horizontal">
                                                <Border Background="{DynamicResource VeyraDiffAddBgBrush}" CornerRadius="11" Padding="8,4" Margin="0,0,8,6">
                                                    <TextBlock Text="{loc:Tr snapshot_dialog.diff_legend_added}" Foreground="{DynamicResource VeyraDiffAddFgBrush}" FontWeight="SemiBold"/>
                                                </Border>
                                                <Border Background="{DynamicResource VeyraDiffRemoveBgBrush}" CornerRadius="11" Padding="8,4" Margin="0,0,8,6">
                                                    <TextBlock Text="{loc:Tr snapshot_dialog.diff_legend_removed}" Foreground="{DynamicResource VeyraDiffRemoveFgBrush}" FontWeight="SemiBold"/>
                                                </Border>
                                                <Border Background="{DynamicResource VeyraDiffModifiedBgBrush}" CornerRadius="11" Padding="8,4" Margin="0,0,8,6">
                                                    <TextBlock Text="{loc:Tr snapshot_dialog.diff_legend_modified}" Foreground="{DynamicResource VeyraDiffModifiedFgBrush}" FontWeight="SemiBold"/>
                                                </Border>
                                                <Border Background="{DynamicResource VeyraDiffContextBgBrush}" CornerRadius="11" Padding="8,4" Margin="0,0,8,6">
                                                    <TextBlock Text="{loc:Tr snapshot_dialog.diff_legend_context}" Foreground="{DynamicResource VeyraDiffContextFgBrush}" FontWeight="SemiBold"/>
                                                </Border>
                                            </WrapPanel>
                                            <TextBlock Text="{loc:Tr snapshot_dialog.diff_legend_scroll}"
                                                       Classes="muted"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </ToolTip.Tip>
                                <TextBlock Text="!"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource VeyraWarningBrush}"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{loc:Tr snapshot_dialog.diff_summary}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="{Binding PreviewSummary}" Classes="muted" TextWrapping="Wrap"/>
                            <Button Grid.Column="3"
                                    Classes="subtle responsive-icon"
                                    Command="{Binding ToggleFullTextPreviewCommand}"
                                    IsVisible="{Binding IsTextPreview}"
                                    ToolTip.Tip="{loc:Tr compare.tooltip_toggle_full_preview}">
                                <Button.Content>
                                    <StackPanel Classes="button-content">
                                        <TextBlock Classes="button-icon" Text="&#xE8A5;"/>
                                        <TextBlock Classes="button-label" Text="{Binding FullPreviewToggleLabel}"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                            <Button Grid.Column="4"
                                    Classes="subtle responsive-icon"
                                    Command="{Binding ToggleWrapModeCommand}"
                                    IsVisible="{Binding IsTextPreview}"
                                    ToolTip.Tip="{loc:Tr compare.tooltip_toggle_wrap}">
                                <Button.Content>
                                    <StackPanel Classes="button-content">
                                        <TextBlock Classes="button-icon" Text="&#xE8A9;"/>
                                        <TextBlock Classes="button-label" Text="{Binding WrapToggleLabel}"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                        </Grid>

                        <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="8">
                            <TextBlock Grid.Row="0" Text="{loc:Tr common.preview}" FontWeight="SemiBold" FontSize="16"/>

                            <Border Grid.Row="1" Classes="diff-surface" IsVisible="{Binding IsTextPreview}">
                                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                                    <Grid Grid.Row="0" ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <Border Grid.Column="0" Background="{DynamicResource VeyraDiffHeaderBgBrush}" CornerRadius="8" Padding="8,4">
                                            <TextBlock Text="{loc:Tr common.before}" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border Grid.Column="1" Background="{DynamicResource VeyraDiffHeaderBgBrush}" CornerRadius="8" Padding="8,4">
                                            <TextBlock Text="{loc:Tr common.after}" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>

                                    <Border Grid.Row="1"
                                            Background="{DynamicResource VeyraDiffPinnedBgBrush}"
                                            BorderBrush="{DynamicResource VeyraDiffHunkBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="8,4"
                                            IsVisible="{Binding HasPinnedHunkHeader}">
                                        <TextBlock Text="{Binding PinnedHunkHeader}"
                                                   FontFamily="Cascadia Code,Consolas,Monospace"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource VeyraDiffPinnedFgBrush}"/>
                                    </Border>
                                    <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <ScrollViewer x:Name="LeftDiffScrollViewer"
                                                      Grid.Column="0"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="{Binding IsWrapEnabled, Converter={x:Static conv:BoolToHorizontalScrollBarVisibilityConverter.Instance}}"
                                                      ScrollChanged="OnLeftDiffScrollChanged">
                                            <ItemsControl ItemsSource="{Binding PreviewRows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="windows:SnapshotDiffRowItemViewModel">
                                                        <StackPanel Spacing="4" Margin="0,0,0,4">
                                                            <Border IsVisible="{Binding IsHunkHeader}"
                                                                    Background="{DynamicResource VeyraDiffHunkBgBrush}"
                                                                    BorderBrush="{DynamicResource VeyraDiffHunkBorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="8"
                                                                    Padding="8,4">
                                                                <TextBlock Text="{Binding HunkHeader}"
                                                                           FontFamily="Cascadia Code,Consolas,Monospace"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource VeyraDiffHunkFgBrush}"/>
                                                            </Border>

                                                            <Border IsVisible="{Binding IsContextFoldRow}"
                                                                    Background="{DynamicResource VeyraDiffFoldBgBrush}"
                                                                    BorderBrush="{DynamicResource VeyraDiffFoldBorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="8"
                                                                    Padding="8,4">
                                                                <Button Content="{Binding ContextFoldLabel}"
                                                                        HorizontalAlignment="Left"
                                                                        Classes="subtle"
                                                                        Command="{Binding #Root.((windows:SnapshotNameDialogWindowViewModel)DataContext).ExpandContextFoldCommand}"
                                                                        CommandParameter="{Binding}"/>
                                                            </Border>

                                                            <Border IsVisible="{Binding IsContentRow}"
                                                                    Classes="diff-side"
                                                                    Background="{Binding LeftBackground}" ClipToBounds="True">
                                                                <Grid ColumnDefinitions="58,16,30,*" ColumnSpacing="6">
                                                                    <TextBlock Grid.Column="0"
                                                                               Text="{Binding LeftGutter}"
                                                                               Foreground="{DynamicResource VeyraDiffLineNumberBrush}"
                                                                               FontFamily="Cascadia Code,Consolas,Monospace"
                                                                               FontSize="12"/>
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding LeftMarker}"
                                                                               Foreground="{Binding LeftMarkerForeground}"
                                                                               FontWeight="Bold"
                                                                               FontFamily="Cascadia Code,Consolas,Monospace"
                                                                               FontSize="12"/>
                                                                    <TextBlock Grid.Column="2"
                                                                               Text="{Binding KindLabel}"
                                                                               Foreground="{DynamicResource VeyraDiffMarkerBrush}"
                                                                               FontSize="10"
                                                                               FontWeight="SemiBold"
                                                                               VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="3"
                                                                               Text="{Binding LeftText}"
                                                                               FontFamily="Cascadia Code,Consolas,Monospace"
                                                                               FontSize="12"
                                                                               TextWrapping="{Binding #Root.((windows:SnapshotNameDialogWindowViewModel)DataContext).IsWrapEnabled, Converter={x:Static conv:BoolToTextWrappingConverter.Instance}}"/>
                                                                </Grid>
                                                            </Border>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>

                                        <ScrollViewer x:Name="RightDiffScrollViewer"
                                                      Grid.Column="1"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="{Binding IsWrapEnabled, Converter={x:Static conv:BoolToHorizontalScrollBarVisibilityConverter.Instance}}"
                                                      ScrollChanged="OnRightDiffScrollChanged">
                                            <ItemsControl ItemsSource="{Binding PreviewRows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="windows:SnapshotDiffRowItemViewModel">
                                                        <StackPanel Spacing="4" Margin="0,0,0,4">
                                                            <Border IsVisible="{Binding IsHunkHeader}"
                                                                    Background="{DynamicResource VeyraDiffHunkBgBrush}"
                                                                    BorderBrush="{DynamicResource VeyraDiffHunkBorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="8"
                                                                    Padding="8,4">
                                                                <TextBlock Text="{Binding HunkHeader}"
                                                                           FontFamily="Cascadia Code,Consolas,Monospace"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource VeyraDiffHunkFgBrush}"/>
                                                            </Border>

                                                            <Border IsVisible="{Binding IsContextFoldRow}"
                                                                    Background="{DynamicResource VeyraDiffFoldBgBrush}"
                                                                    BorderBrush="{DynamicResource VeyraDiffFoldBorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="8"
                                                                    Padding="8,4">
                                                                <TextBlock Text="{Binding ContextFoldLabel}"
                                                                           Classes="muted"
                                                                           FontSize="11"/>
                                                            </Border>

                                                            <Border IsVisible="{Binding IsContentRow}"
                                                                    Classes="diff-side"
                                                                    Background="{Binding RightBackground}" ClipToBounds="True">
                                                                <Grid ColumnDefinitions="58,16,30,*" ColumnSpacing="6">
                                                                    <TextBlock Grid.Column="0"
                                                                               Text="{Binding RightGutter}"
                                                                               Foreground="{DynamicResource VeyraDiffLineNumberBrush}"
                                                                               FontFamily="Cascadia Code,Consolas,Monospace"
                                                                               FontSize="12"/>
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding RightMarker}"
                                                                               Foreground="{Binding RightMarkerForeground}"
                                                                               FontWeight="Bold"
                                                                               FontFamily="Cascadia Code,Consolas,Monospace"
                                                                               FontSize="12"/>
                                                                    <TextBlock Grid.Column="2"
                                                                               Text="{Binding KindLabel}"
                                                                               Foreground="{DynamicResource VeyraDiffMarkerBrush}"
                                                                               FontSize="10"
                                                                               FontWeight="SemiBold"
                                                                               VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="3"
                                                                               Text="{Binding RightText}"
                                                                               FontFamily="Cascadia Code,Consolas,Monospace"
                                                                               FontSize="12"
                                                                               TextWrapping="{Binding #Root.((windows:SnapshotNameDialogWindowViewModel)DataContext).IsWrapEnabled, Converter={x:Static conv:BoolToTextWrappingConverter.Instance}}"/>
                                                                </Grid>
                                                            </Border>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Classes="diff-surface" IsVisible="{Binding IsBinaryPreview}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding PreviewMetrics}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="windows:SnapshotPreviewMetricItemViewModel">
                                                <Grid ColumnDefinitions="170,*" ColumnSpacing="10" Margin="0,0,0,8">
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Label}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource VeyraDiffHunkFgBrush}"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Value}"
                                                               TextWrapping="Wrap"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                            <Border Grid.Row="1" Classes="diff-surface" IsVisible="{Binding IsArchivePreview}">
                                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                                    <TextBlock Grid.Row="0"
                                               Text="{loc:Tr compare.archive_contents}"
                                               FontWeight="SemiBold"
                                               FontSize="14"/>

                                    <Grid Grid.Row="1" ColumnDefinitions="2*,8,*" ColumnSpacing="0">
                                        <Border Grid.Column="0"
                                                Background="{DynamicResource VeyraSurfaceSoftBrush}"
                                                BorderBrush="{DynamicResource VeyraBorderSoftBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="10">
                                            <Grid>
                                                <ListBox Classes="clean-list"
                                                         ItemsSource="{Binding ArchiveEntries}"
                                                         SelectedItem="{Binding SelectedArchiveEntry, Mode=TwoWay}"
                                                         IsVisible="{Binding HasArchiveEntries}">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate x:DataType="windows:ArchiveDiffEntryItemViewModel">
                                                            <Border Classes="metric-card" Padding="10" Margin="0,0,0,6">
                                                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                                                                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                                        <Border Grid.Column="0"
                                                                                CornerRadius="8"
                                                                                Background="{Binding StatusBadgeBackground}"
                                                                                Padding="8,4">
                                                                            <TextBlock Text="{Binding StatusLabel}"
                                                                                       Foreground="{Binding StatusBadgeForeground}"
                                                                                       FontWeight="SemiBold"
                                                                                       FontSize="11"/>
                                                                        </Border>
                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{Binding EntryPath}"
                                                                                   FontWeight="SemiBold"
                                                                                   TextWrapping="Wrap"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Grid.Column="2"
                                                                                   Text="{Binding TypeLabel}"
                                                                                   Classes="muted"
                                                                                   FontSize="11"/>
                                                                    </Grid>

                                                                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                                        <TextBlock Grid.Column="0" Text="{loc:Tr common.size}" Classes="muted" FontSize="11"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding SizeLabel}" FontSize="11" TextWrapping="Wrap"/>
                                                                    </Grid>

                                                                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                                        <TextBlock Grid.Column="0" Text="CRC32" Classes="muted" FontSize="11"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding CrcLabel}" FontSize="11" TextWrapping="Wrap"/>
                                                                    </Grid>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>

                                                <TextBlock Text="{loc:Tr compare.archive_no_entries}"
                                                           Classes="muted"
                                                           TextWrapping="Wrap"
                                                           IsVisible="{Binding HasArchiveEntries, Converter={x:Static conv:BoolInvertConverter.Instance}}"/>
                                            </Grid>
                                        </Border>

                                        <GridSplitter Grid.Column="1"
                                                      Width="8"
                                                      Background="{DynamicResource VeyraSplitBrush}"
                                                      ResizeDirection="Columns"
                                                      ResizeBehavior="PreviousAndNext"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch"/>

                                        <ScrollViewer Grid.Column="2"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel Spacing="10">
                                                <Border Background="{DynamicResource VeyraSurfaceSoftBrush}"
                                                        BorderBrush="{DynamicResource VeyraBorderSoftBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Padding="10">
                                                    <ItemsControl ItemsSource="{Binding PreviewMetrics}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="windows:SnapshotPreviewMetricItemViewModel">
                                                                <Grid ColumnDefinitions="150,*" ColumnSpacing="10" Margin="0,0,0,6">
                                                                    <TextBlock Grid.Column="0"
                                                                               Text="{Binding Label}"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource VeyraDiffHunkFgBrush}"/>
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding Value}"
                                                                               TextWrapping="Wrap"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>

                                                <Border Background="{DynamicResource VeyraSurfaceSoftBrush}"
                                                        BorderBrush="{DynamicResource VeyraBorderSoftBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Padding="10"
                                                        IsVisible="{Binding HasSelectedArchiveEntry}">
                                                    <Grid RowDefinitions="Auto,*" RowSpacing="8">
                                                        <TextBlock Grid.Row="0"
                                                                   Text="{loc:Tr common.details}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="13"/>

                                                        <StackPanel Grid.Row="1" Spacing="8">
                                                            <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                                                                <TextBlock Grid.Column="0" Text="{loc:Tr common.path}" FontWeight="SemiBold"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding SelectedArchiveEntry.EntryPath}" TextWrapping="Wrap"/>
                                                            </Grid>
                                                            <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                                                                <TextBlock Grid.Column="0" Text="{loc:Tr common.type}" FontWeight="SemiBold"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding SelectedArchiveEntry.TypeLabel}" TextWrapping="Wrap"/>
                                                            </Grid>
                                                            <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                                                                <TextBlock Grid.Column="0" Text="{loc:Tr common.size}" FontWeight="SemiBold"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding SelectedArchiveEntry.SizeLabel}" TextWrapping="Wrap"/>
                                                            </Grid>
                                                            <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                                                                <TextBlock Grid.Column="0" Text="{loc:Tr metric.compressed_size}" FontWeight="SemiBold"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding SelectedArchiveEntry.CompressedSizeLabel}" TextWrapping="Wrap"/>
                                                            </Grid>
                                                            <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                                                                <TextBlock Grid.Column="0" Text="{loc:Tr metric.crc32}" FontWeight="SemiBold"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding SelectedArchiveEntry.CrcLabel}" TextWrapping="Wrap"/>
                                                            </Grid>
                                                            <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                                                                <TextBlock Grid.Column="0" Text="{loc:Tr common.modified}" FontWeight="SemiBold"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding SelectedArchiveEntry.ModifiedLabel}" TextWrapping="Wrap"/>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Classes="diff-surface" IsVisible="{Binding IsAudioPreview}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                      <StackPanel Spacing="12">
                                          <TextBlock Text="{loc:Tr compare.audio_waveform}"
                                                     FontWeight="SemiBold"
                                                     FontSize="14"/>

                                          <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto"
                                                ColumnSpacing="8">
                                              <Button Grid.Column="0"
                                                      Classes="subtle"
                                                      Command="{Binding PlayBeforeAudioCommand}">
                                                  <TextBlock Text="{loc:Tr compare.audio_play_before}"/>
                                              </Button>
                                              <Button Grid.Column="1"
                                                      Classes="subtle"
                                                      Command="{Binding PlayAfterAudioCommand}">
                                                  <TextBlock Text="{loc:Tr compare.audio_play_after}"/>
                                              </Button>
                                              <Button Grid.Column="2"
                                                      Classes="subtle"
                                                      Command="{Binding PlayDifferenceAudioCommand}">
                                                  <TextBlock Text="{loc:Tr compare.audio_play_difference}"/>
                                              </Button>
                                              <Button Grid.Column="3"
                                                      Classes="subtle"
                                                      Command="{Binding StopAudioPlaybackCommand}">
                                                  <TextBlock Text="{loc:Tr compare.audio_play_stop}"/>
                                              </Button>
                                              <TextBlock Grid.Column="5"
                                                         Text="{Binding AudioPlaybackStatus}"
                                                         Classes="muted"
                                                         VerticalAlignment="Center"
                                                         IsVisible="{Binding HasAudioPlaybackStatus}"/>
                                          </Grid>

                                          <Grid ColumnDefinitions="Auto,*"
                                                ColumnSpacing="12"
                                                IsVisible="{Binding HasAudioPlaybackStatus}">
                                              <TextBlock Grid.Column="0"
                                                         Text="{Binding AudioPlaybackTimerText}"
                                                         Classes="muted"
                                                         VerticalAlignment="Center"/>
                                              <Slider Grid.Column="1"
                                                      Minimum="0"
                                                      Maximum="{Binding AudioPlaybackDurationSeconds}"
                                                      Value="{Binding AudioPlaybackPositionSeconds, Mode=TwoWay}"
                                                      IsEnabled="{Binding IsAudioPlaybackSeekEnabled}"/>
                                          </Grid>

                                          <Border Background="{DynamicResource VeyraSurfaceSoftBrush}"
                                                  BorderBrush="{DynamicResource VeyraBorderSoftBrush}"
                                                  BorderThickness="1"
                                                  CornerRadius="12"
                                                  Padding="10"
                                                  IsVisible="{Binding ShowAudioSpectralHero}">
                                              <Grid RowDefinitions="Auto,*" RowSpacing="8">
                                                  <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                      <TextBlock Grid.Column="0"
                                                                 Text="{loc:Tr compare.audio_spectral_delta}"
                                                                 FontWeight="SemiBold"/>
                                                      <TextBlock Grid.Column="1"
                                                                 Text="{Binding PreviewSummary}"
                                                                 Classes="muted"
                                                                 TextTrimming="CharacterEllipsis"/>
                                                  </Grid>
                                                  <Grid Grid.Row="1" MinHeight="180">
                                                      <Image Source="{Binding AudioSpectralDeltaPreview}"
                                                             Stretch="Uniform"
                                                             HorizontalAlignment="Stretch"
                                                             VerticalAlignment="Stretch"
                                                             IsVisible="{Binding HasAudioSpectralDeltaPreview}"/>
                                                      <Image Source="{Binding AudioSpectrogramPreview}"
                                                             Stretch="Uniform"
                                                             HorizontalAlignment="Stretch"
                                                             VerticalAlignment="Stretch"
                                                             IsVisible="{Binding HasAudioSpectralDeltaPreview, Converter={x:Static conv:BoolInvertConverter.Instance}}"/>
                                                  </Grid>
                                              </Grid>
                                          </Border>

                                          <Border Background="{DynamicResource VeyraSurfaceSoftBrush}"
                                                  BorderBrush="{DynamicResource VeyraBorderSoftBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="10"
                                                IsVisible="{Binding HasAudioWaveformPreview}">
                                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                          VerticalScrollBarVisibility="Auto"
                                                          MaxHeight="320">
                                                <Image Source="{Binding AudioWaveformPreview}"
                                                       Stretch="None"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Top"/>
                                            </ScrollViewer>
                                        </Border>

                                        <TextBlock Text="{loc:Tr compare.audio_preview_unavailable}"
                                                   Classes="muted"
                                                   TextWrapping="Wrap"
                                                   IsVisible="{Binding HasAudioWaveformPreview, Converter={x:Static conv:BoolInvertConverter.Instance}}"/>

                                        <TextBlock Text="{loc:Tr compare.audio_spectrogram}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   IsVisible="{Binding HasAudioSpectrogramPreview}"/>

                                        <Border Background="{DynamicResource VeyraSurfaceSoftBrush}"
                                                BorderBrush="{DynamicResource VeyraBorderSoftBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="10"
                                                IsVisible="{Binding HasAudioSpectrogramPreview}">
                                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                          VerticalScrollBarVisibility="Auto"
                                                          MaxHeight="300">
                                                <Image Source="{Binding AudioSpectrogramPreview}"
                                                       Stretch="None"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Top"/>
                                            </ScrollViewer>
                                        </Border>

                                        <TextBlock Text="{loc:Tr compare.audio_spectral_delta}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   IsVisible="{Binding HasAudioSpectralDeltaPreview}"/>

                                        <Border Background="{DynamicResource VeyraSurfaceSoftBrush}"
                                                BorderBrush="{DynamicResource VeyraBorderSoftBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="10"
                                                IsVisible="{Binding HasAudioSpectralDeltaPreview}">
                                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                          VerticalScrollBarVisibility="Auto"
                                                          MaxHeight="220">
                                                <Image Source="{Binding AudioSpectralDeltaPreview}"
                                                       Stretch="None"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Top"/>
                                            </ScrollViewer>
                                        </Border>

                                        <Border Background="{DynamicResource VeyraSurfaceSoftBrush}"
                                                BorderBrush="{DynamicResource VeyraBorderSoftBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="10">
                                            <ItemsControl ItemsSource="{Binding PreviewMetrics}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="windows:SnapshotPreviewMetricItemViewModel">
                                                        <Grid ColumnDefinitions="170,*" ColumnSpacing="10" Margin="0,0,0,6">
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding Label}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource VeyraDiffHunkFgBrush}"/>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Value}"
                                                                       TextWrapping="Wrap"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>

                                        <Border Background="{DynamicResource VeyraSurfaceSoftBrush}"
                                                BorderBrush="{DynamicResource VeyraBorderSoftBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="10">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="{loc:Tr compare.audio_changed_segments}"
                                                           FontWeight="SemiBold"
                                                           FontSize="13"/>

                                                 <ItemsControl ItemsSource="{Binding AudioChangedSegments}"
                                                               IsVisible="{Binding HasAudioChangedSegments}">
                                                     <ItemsControl.ItemTemplate>
                                                         <DataTemplate x:DataType="windows:AudioChangedSegmentItemViewModel">
                                                             <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto"
                                                                   ColumnSpacing="10"
                                                                   Margin="0,0,0,6">
                                                                 <TextBlock Grid.Column="0"
                                                                            Text="{Binding SegmentLabel}"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource VeyraDiffHunkFgBrush}"/>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding RangeLabel}"
                                                                           TextWrapping="Wrap"/>
                                                                <TextBlock Grid.Column="2"
                                                                           Text="{Binding DurationLabel}"
                                                                           Classes="muted"/>
                                                                 <TextBlock Grid.Column="3"
                                                                            Text="{Binding IntensityLabel}"
                                                                            Classes="muted"/>
                                                                 <Button Grid.Column="4"
                                                                         Classes="subtle"
                                                                         Command="{Binding #Root.((windows:SnapshotNameDialogWindowViewModel)DataContext).PlayBeforeAudioSegmentCommand}"
                                                                         CommandParameter="{Binding}">
                                                                     <TextBlock Text="{loc:Tr common.before}"/>
                                                                 </Button>
                                                                 <Button Grid.Column="5"
                                                                         Classes="subtle"
                                                                         Command="{Binding #Root.((windows:SnapshotNameDialogWindowViewModel)DataContext).PlayAfterAudioSegmentCommand}"
                                                                         CommandParameter="{Binding}">
                                                                     <TextBlock Text="{loc:Tr common.after}"/>
                                                                 </Button>
                                                                 <Button Grid.Column="6"
                                                                         Classes="subtle"
                                                                         Command="{Binding #Root.((windows:SnapshotNameDialogWindowViewModel)DataContext).LoopAudioSegmentCommand}"
                                                                         CommandParameter="{Binding}">
                                                                     <TextBlock Text="{loc:Tr compare.audio_loop_segment}"/>
                                                                 </Button>
                                                             </Grid>
                                                         </DataTemplate>
                                                     </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <TextBlock Text="{loc:Tr compare.audio_changed_segments_none}"
                                                           Classes="muted"
                                                           IsVisible="{Binding HasAudioChangedSegments, Converter={x:Static conv:BoolInvertConverter.Instance}}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                                                        <Border Grid.Row="1" Classes="diff-surface" IsVisible="{Binding IsImagePreview}">
                                <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="10">
                                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="{Binding ImageDiffCompactSummary}"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"/>
                                                <TextBlock Text="{Binding ImageDiffCompactStateText}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>

                                        <Button Grid.Column="1"
                                                Classes="subtle compact responsive-icon"
                                                Command="{Binding ToggleShowImageDiffDetailsCommand}"
                                                ToolTip.Tip="{Binding ImageDiffDetailsToggleLabel}">
                                            <Button.Content>
                                                <StackPanel Classes="button-content">
                                                    <TextBlock Classes="button-icon" Text="i"/>
                                                    <TextBlock Classes="button-label" Text="{Binding ImageDiffDetailsToggleLabel}"/>
                                                </StackPanel>
                                            </Button.Content>
                                        </Button>

                                        <Button Grid.Column="2"
                                                Classes="subtle compact responsive-icon"
                                                Command="{Binding ToggleShowImageDiffSettingsCommand}"
                                                ToolTip.Tip="{Binding ImageDiffSettingsToggleLabel}">
                                            <Button.Content>
                                                <StackPanel Classes="button-content">
                                                    <TextBlock Classes="button-icon" Text="&#xE713;"/>
                                                    <TextBlock Classes="button-label" Text="{Binding ImageDiffSettingsToggleLabel}"/>
                                                </StackPanel>
                                            </Button.Content>
                                        </Button>
                                    </Grid>

                                    <Border Grid.Row="1"
                                            Background="#01000000"
                                            ZIndex="900"
                                            IsVisible="{Binding ShowImageDiffSettings}"
                                            PointerPressed="OnImageDiffSettingsBackdropPressed"/>

                                    <Border Grid.Row="1"
                                            Classes="popover-panel"
                                            ZIndex="901"
                                            HorizontalAlignment="Right"
                                            MaxWidth="560"
                                            IsVisible="{Binding ShowImageDiffSettings}">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="{loc:Tr compare.image_diff_settings_title}" FontWeight="SemiBold"/>

                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{loc:Tr compare.image_mode}" Classes="muted" FontSize="11"/>
                                                <Border Classes="segmented-control">
                                                    <ItemsControl ItemsSource="{Binding ImageDiffModes}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal" ItemWidth="140"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="windows:ImageDiffModeOptionViewModel">
                                                                <ToggleButton Classes="segmented"
                                                                              Content="{Binding Label}"
                                                                              IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                                              Command="{Binding #Root.((windows:SnapshotNameDialogWindowViewModel)DataContext).SelectImageDiffModeCommand}"
                                                                              CommandParameter="{Binding}"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                            </StackPanel>

                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                                <StackPanel Grid.Column="0" Spacing="4">
                                                    <TextBlock Text="{loc:Tr compare.image_sensitivity}" Classes="muted" FontSize="11"/>
                                                    <Slider Minimum="1"
                                                            Maximum="100"
                                                            Value="{Binding ImageDiffSensitivity}"
                                                            TickFrequency="5"
                                                            IsSnapToTickEnabled="False"/>
                                                    <TextBlock Text="{Binding ImageSensitivityLabel}" Classes="muted" FontSize="11"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Spacing="4" IsVisible="{Binding IsSplitImageDiffMode}">
                                                    <TextBlock Text="{loc:Tr compare.image_split}" Classes="muted" FontSize="11"/>
                                                    <Slider Minimum="{Binding MinComparisonSplitPercent}"
                                                            Maximum="{Binding MaxComparisonSplitPercent}"
                                                            Value="{Binding ComparisonSplitPercent}"/>
                                                    <TextBlock Text="{Binding SplitPositionLabel}" Classes="muted" FontSize="11"/>
                                                </StackPanel>
                                            </Grid>

                                            <WrapPanel Orientation="Horizontal">
                                                <Button Classes="subtle compact responsive-icon"
                                                        Margin="0,0,8,8"
                                                        Command="{Binding ToggleShowImageDiffRegionBoxesCommand}">
                                                    <Button.Content>
                                                        <StackPanel Classes="button-content">
                                                            <TextBlock Classes="button-icon" Text="&#xE81E;"/>
                                                            <TextBlock Classes="button-label" Text="{Binding ImageRegionBoxesLabel}"/>
                                                        </StackPanel>
                                                    </Button.Content>
                                                </Button>
                                                <Button Classes="subtle compact responsive-icon"
                                                        Margin="0,0,0,8"
                                                        Command="{Binding ResetImageDiffSettingsCommand}">
                                                    <Button.Content>
                                                        <StackPanel Classes="button-content">
                                                            <TextBlock Classes="button-icon" Text="&#xE72C;"/>
                                                            <TextBlock Classes="button-label" Text="{loc:Tr compare.reset_diff_settings}"/>
                                                        </StackPanel>
                                                    </Button.Content>
                                                </Button>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="2"
                                            Background="{DynamicResource VeyraCanvasBrush}"
                                            BorderThickness="0"
                                            CornerRadius="10"
                                            Padding="0"
                                            IsVisible="{Binding HasAnyImagePreview}">
                                        <Grid RowDefinitions="Auto,*" RowSpacing="6">
                                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                                                    <StackPanel Grid.Column="0" Spacing="2">
                                                        <TextBlock Text="{Binding OverlayImageCaption}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="12"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{loc:Tr compare.zoom_hint}"
                                                               Classes="muted"
                                                               FontSize="11"/>
                                                </StackPanel>

                                                <Button Grid.Column="1"
                                                        Classes="subtle compact responsive-icon"
                                                        Click="OnZoomOutOverlayImageClicked"
                                                        ToolTip.Tip="{loc:Tr compare.zoom_out}">
                                                    <Button.Content>
                                                        <StackPanel Classes="button-content">
                                                            <TextBlock Classes="button-icon" Text="-"/>
                                                        </StackPanel>
                                                    </Button.Content>
                                                </Button>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <TextBlock Text="{loc:Tr compare.zoom}" Classes="muted" FontSize="11" VerticalAlignment="Center"/>
                                                    <Slider x:Name="OverlayZoomSlider"
                                                            Width="180"
                                                            Minimum="1"
                                                            Maximum="500"
                                                            Value="100"
                                                            TickFrequency="10"
                                                            ValueChanged="OnOverlayZoomSliderValueChanged"/>
                                                    <TextBlock x:Name="OverlayZoomValueText"
                                                               Width="52"
                                                               Text="100%"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               FontWeight="SemiBold"/>
                                                </StackPanel>

                                                <Button Grid.Column="3"
                                                        Classes="subtle compact responsive-icon"
                                                        Click="OnZoomInOverlayImageClicked"
                                                        ToolTip.Tip="{loc:Tr compare.zoom_in}">
                                                    <Button.Content>
                                                        <StackPanel Classes="button-content">
                                                            <TextBlock Classes="button-icon" Text="+"/>
                                                        </StackPanel>
                                                    </Button.Content>
                                                </Button>

                                                <Button Grid.Column="4"
                                                        Classes="subtle compact responsive-icon"
                                                        Click="OnFitOverlayImageToViewClicked"
                                                        ToolTip.Tip="{loc:Tr compare.zoom_fit}">
                                                    <Button.Content>
                                                        <StackPanel Classes="button-content">
                                                            <TextBlock Classes="button-icon" Text="&#xE9A6;"/>
                                                            <TextBlock Classes="button-label" Text="{loc:Tr compare.zoom_fit}"/>
                                                        </StackPanel>
                                                    </Button.Content>
                                                </Button>

                                                <Button Grid.Column="5"
                                                        Classes="subtle compact responsive-icon"
                                                        Click="OnOpenDetachedImagePreviewClicked"
                                                        ToolTip.Tip="{loc:Tr compare.open_detached_preview}">
                                                    <Button.Content>
                                                        <StackPanel Classes="button-content">
                                                            <TextBlock Classes="button-icon" Text="&#xE740;"/>
                                                        </StackPanel>
                                                    </Button.Content>
                                                </Button>
                                            </Grid>

                                            <ScrollViewer x:Name="OverlayImageScrollViewer"
                                                          Grid.Row="1"
                                                          Focusable="True"
                                                          HorizontalScrollBarVisibility="Auto"
                                                          VerticalScrollBarVisibility="Auto"
                                                          PointerPressed="OnOverlayImagePointerPressed"
                                                          PointerMoved="OnOverlayImagePointerMoved"
                                                          PointerReleased="OnOverlayImagePointerReleased"
                                                          PointerCaptureLost="OnOverlayImagePointerCaptureLost"
                                                          KeyDown="OnOverlayImageKeyDown"
                                                          KeyUp="OnOverlayImageKeyUp"
                                                          LostFocus="OnOverlayImageLostFocus"
                                                          SizeChanged="OnOverlayImageViewportSizeChanged">
                                                <Grid x:Name="OverlayImageViewportHost"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Top"
                                                      ClipToBounds="True">
                                                    <Grid x:Name="OverlayImageHost"
                                                          HorizontalAlignment="Left"
                                                          VerticalAlignment="Top"
                                                          ClipToBounds="True">
                                                        <Image x:Name="OverlayImageControl"
                                                               Source="{Binding OverlayImagePreview}"
                                                               Stretch="Uniform"
                                                               HorizontalAlignment="Left"
                                                               VerticalAlignment="Top"/>
                                                        <Image x:Name="OverlaySplitBaseImageControl"
                                                               Source="{Binding RightImagePreview}"
                                                               Stretch="Uniform"
                                                               HorizontalAlignment="Left"
                                                               VerticalAlignment="Top"
                                                               IsVisible="False"/>
                                                        <Border x:Name="OverlaySplitRevealHost"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Top"
                                                                ClipToBounds="True"
                                                                IsVisible="False">
                                                            <Image x:Name="OverlaySplitRevealImageControl"
                                                                   Source="{Binding LeftImagePreview}"
                                                                   Stretch="Uniform"
                                                                   HorizontalAlignment="Left"
                                                                   VerticalAlignment="Top"/>
                                                        </Border>
                                                        <Border x:Name="OverlaySplitDivider"
                                                                Width="2"
                                                                Background="{DynamicResource VeyraInfoBrush}"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Stretch"
                                                                IsVisible="False"
                                                                IsHitTestVisible="False"/>
                                                        <Image x:Name="OverlayPeekBeforeImageControl"
                                                               Source="{Binding LeftImagePreview}"
                                                               Stretch="Uniform"
                                                               HorizontalAlignment="Left"
                                                               VerticalAlignment="Top"
                                                               IsVisible="False"
                                                               IsHitTestVisible="False"/>
                                                    </Grid>
                                                </Grid>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>

                                    <TextBlock Grid.Row="2"
                                               Text="{loc:Tr compare.image_preview_unavailable}"
                                               Classes="muted"
                                               IsVisible="{Binding HasNoImagePreviews}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Top"/>

                                    <Border Grid.Row="3"
                                            Background="{DynamicResource VeyraCanvasBrush}"
                                            BorderBrush="{DynamicResource VeyraBorderSoftBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="10"
                                            IsVisible="{Binding ShowSourceImagePanelsSection}">
                                        <Grid RowDefinitions="Auto,*" RowSpacing="8">
                                            <TextBlock Grid.Row="0" Text="{loc:Tr compare.image_sources}" FontWeight="SemiBold"/>
                                            <Grid Grid.Row="1" ColumnDefinitions="*,8,*" ColumnSpacing="0">
                                                <Border Grid.Column="0" Background="{DynamicResource VeyraCanvasBrush}" BorderBrush="{DynamicResource VeyraBorderSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="8">
                                                    <Grid RowDefinitions="Auto,*" RowSpacing="8">
                                                        <TextBlock Grid.Row="0" Text="{Binding LeftImageCaption}" FontWeight="SemiBold"/>
                                                        <ScrollViewer Grid.Row="1"
                                                                      HorizontalScrollBarVisibility="Auto"
                                                                      VerticalScrollBarVisibility="Auto"
                                                                      MaxHeight="240">
                                                            <Image Source="{Binding LeftImagePreview}"
                                                                   Stretch="Uniform"
                                                                   HorizontalAlignment="Left"
                                                                   VerticalAlignment="Top"/>
                                                        </ScrollViewer>
                                                    </Grid>
                                                </Border>

                                                <GridSplitter Grid.Column="1"
                                                              Width="8"
                                                              Background="{DynamicResource VeyraSplitBrush}"
                                                              ResizeDirection="Columns"
                                                              ResizeBehavior="PreviousAndNext"
                                                              HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Stretch"/>

                                                <Border Grid.Column="2" Background="{DynamicResource VeyraCanvasBrush}" BorderBrush="{DynamicResource VeyraBorderSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="8">
                                                    <Grid RowDefinitions="Auto,*" RowSpacing="8">
                                                        <TextBlock Grid.Row="0" Text="{Binding RightImageCaption}" FontWeight="SemiBold"/>
                                                        <ScrollViewer Grid.Row="1"
                                                                      HorizontalScrollBarVisibility="Auto"
                                                                      VerticalScrollBarVisibility="Auto"
                                                                      MaxHeight="240">
                                                            <Image Source="{Binding RightImagePreview}"
                                                                   Stretch="Uniform"
                                                                   HorizontalAlignment="Left"
                                                                   VerticalAlignment="Top"/>
                                                        </ScrollViewer>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="4"
                                            Background="{DynamicResource VeyraSurfaceSoftBrush}"
                                            BorderBrush="{DynamicResource VeyraBorderSoftBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="10"
                                            IsVisible="{Binding ShowImageDiffDetails}">
                                        <StackPanel Spacing="12">
                                            <ItemsControl ItemsSource="{Binding PreviewMetrics}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="windows:SnapshotPreviewMetricItemViewModel">
                                                        <Grid ColumnDefinitions="170,*" ColumnSpacing="10" Margin="0,0,0,6">
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding Label}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource VeyraDiffHunkFgBrush}"/>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Value}"
                                                                       TextWrapping="Wrap"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <Border Grid.Row="1" Classes="diff-surface" IsVisible="{Binding HasNoPreviewContent}">
                                <TextBlock Text="{loc:Tr snapshot_dialog.select_file_for_preview}"
                                           Classes="muted"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <Border Grid.RowSpan="2"
                                    Classes="loading-overlay"
                                    IsVisible="{Binding IsPreviewLoading}">
                                <Border Classes="loading-card"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Width="340"
                                        MaxWidth="400">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="{Binding LoadingTitle}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"/>
                                        <TextBlock Text="{Binding LoadingDetail}"
                                                   Classes="muted"
                                                   TextWrapping="Wrap"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"/>
                                        <ProgressBar Minimum="0"
                                                     Maximum="100"
                                                     Height="10"
                                                     Value="{Binding LoadingProgressValue}"
                                                     IsIndeterminate="{Binding IsLoadingProgressIndeterminate}"/>
                                        <TextBlock Text="{Binding LoadingProgressLabel}"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"
                                                   IsVisible="{Binding HasDeterminateLoadingProgress}"/>
                                    </StackPanel>
                                </Border>
                            </Border>
                        </Grid>
                    </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>
