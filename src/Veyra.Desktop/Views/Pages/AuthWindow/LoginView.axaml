<UserControl
    x:Class="Veyra.Desktop.Views.Pages.AuthWindow.LoginView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Veyra.Desktop.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:vm="clr-namespace:Veyra.Desktop.ViewModels.Pages.AuthWindow"
    xmlns:conv="clr-namespace:Veyra.Desktop.Converters"
    d:DataContext="{d:DesignInstance vm:LoginViewModel, IsDesignTimeCreatable=True}"
    x:DataType="vm:LoginViewModel"
    Background="#0D0D0D">

    <Grid>
        <Border Width="460" Padding="28" Background="#131313" CornerRadius="14"
                BorderBrush="#272727" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="14">
                <TextBlock Text="{loc:Tr app.brand}" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding ActionTitle}" FontSize="20"/>
                <TextBlock Text="{loc:Tr auth.subtitle}" Opacity="0.75"/>

                <StackPanel Spacing="6" Margin="0,8,0,0">
                    <TextBlock Text="{loc:Tr auth.username}" Opacity="0.8"/>
                    <TextBox Text="{Binding Username}" Watermark="{loc:Tr auth.username_placeholder}"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="{loc:Tr auth.password}" Opacity="0.8"/>
                    <TextBox Text="{Binding Password, Mode=TwoWay}" PasswordChar="*" Watermark="{loc:Tr auth.password_placeholder}"/>
                </StackPanel>

                <StackPanel Spacing="6" IsVisible="{Binding IsRegisterMode}">
                    <TextBlock Text="{loc:Tr auth.confirm_password}" Opacity="0.8"/>
                    <TextBox Text="{Binding ConfirmPassword, Mode=TwoWay}" PasswordChar="*" Watermark="{loc:Tr auth.confirm_password_placeholder}"/>
                </StackPanel>

                <Button Content="{loc:Tr auth.sign_in}"
                        Command="{Binding LoginCommand}"
                        IsVisible="{Binding IsRegisterMode, Converter={x:Static conv:BoolInvertConverter.Instance}}"
                        IsEnabled="{Binding IsBusy, Converter={x:Static conv:BoolInvertConverter.Instance}}"
                        Height="38"/>

                <Button Content="{loc:Tr auth.register}"
                        Command="{Binding RegisterCommand}"
                        IsVisible="{Binding IsRegisterMode}"
                        IsEnabled="{Binding IsBusy, Converter={x:Static conv:BoolInvertConverter.Instance}}"
                        Height="38"/>

                <Button Content="{Binding ToggleLabel}"
                        Command="{Binding ToggleModeCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#7DD3FC"
                        HorizontalAlignment="Left"/>

                <TextBlock Foreground="#F87171" Text="{Binding Error}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>


