<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Veyra.Desktop.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:windows="clr-namespace:Veyra.Desktop.ViewModels.Windows"
        mc:Ignorable="d"
        x:Class="Veyra.Desktop.Views.Windows.ConfirmActionWindow"
        x:DataType="windows:ConfirmActionWindowViewModel"
        Width="520"
        Height="300"
        MinWidth="460"
        MinHeight="260"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource VeyraCanvasBrush}"
        Foreground="{DynamicResource VeyraTextPrimaryBrush}"
        Title="{loc:Tr common.confirm}">
    <Border Padding="16" Background="{DynamicResource VeyraCanvasBrush}">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
            <Border Grid.Row="0" Classes="dialog-hero">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding TitleText}" Classes="h2"/>
                    <TextBlock Text="{Binding Message}" Classes="muted" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1"
                    Classes="card"
                    Padding="14"
                    BorderBrush="{DynamicResource VeyraDangerBrush}"
                    Background="{DynamicResource VeyraDiffRemoveBgBrush}">
                <TextBlock Text="{Binding WarningText}" Foreground="{DynamicResource VeyraDangerBrush}" TextWrapping="Wrap"/>
            </Border>

            <Border Grid.Row="2" Classes="toolbar" Padding="10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="{loc:Tr common.cancel}" Command="{Binding CancelCommand}" Classes="subtle" Width="110"/>
                    <Button Content="{Binding ConfirmButtonText}" Command="{Binding ConfirmCommand}" Classes="danger" Width="150"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
