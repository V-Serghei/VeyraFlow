<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Veyra.Desktop.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:settings="clr-namespace:Veyra.Desktop.ViewModels.Pages.Settings"
             xmlns:conv="clr-namespace:Veyra.Desktop.Converters"
             x:Class="Veyra.Desktop.Views.Pages.Settings.AppSettingsView"
             x:Name="Root"
             x:DataType="settings:AppSettingsViewModel"
             Background="{DynamicResource VeyraCanvasBrush}">

    <DockPanel Margin="16">
        <Border DockPanel.Dock="Top" Classes="hero" Padding="18" Margin="0,0,0,12">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Button Content="{loc:Tr common.back}" Command="{Binding BackCommand}" Classes="subtle"/>
                    <Button Content="{loc:Tr common.refresh}" Command="{Binding RefreshCommand}" Classes="subtle"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{loc:Tr app_settings.title}" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="{loc:Tr app_settings.subtitle}"
                               Opacity="0.75"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Border Grid.Column="2" Classes="badge" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Tr app_settings.live_badge}" FontWeight="SemiBold" Foreground="{DynamicResource VeyraInfoBrush}"/>
                </Border>
            </Grid>
        </Border>

        <Grid ColumnDefinitions="280,8,*" ColumnSpacing="0">
            <Border Grid.Column="0" Classes="card" Padding="10" MinWidth="220">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Tabs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="settings:AppSettingsTabViewModel">
                                <Button Margin="0,0,0,8"
                                        Padding="12,10"
                                        Classes="subtle"
                                        Classes.primary="{Binding IsSelected}"
                                        Command="{Binding #Root.((settings:AppSettingsViewModel)DataContext).SelectTabCommand}"
                                        CommandParameter="{Binding .}">
                                    <StackPanel Spacing="2" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.65" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"/>

            <Border Grid.Column="2" Classes="card" Padding="16" Margin="12,0,0,0" MinWidth="420">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{Binding SelectedTab.Title}" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SelectedTab.Subtitle}" Opacity="0.75"/>

                        <Border Classes="card" Padding="12" IsVisible="{Binding IsUserTabSelected}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{loc:Tr app_settings.current_session}" FontSize="16" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="170,*" ColumnSpacing="10">
                                    <TextBlock Grid.Column="0" Text="{loc:Tr app_settings.active_username}" Opacity="0.8"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ActiveUsername}" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid ColumnDefinitions="170,*" ColumnSpacing="10">
                                    <TextBlock Grid.Column="0" Text="{loc:Tr app_settings.active_email}" Opacity="0.8"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ActiveEmail}" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid ColumnDefinitions="170,*" ColumnSpacing="10">
                                    <TextBlock Grid.Column="0" Text="{loc:Tr app_settings.cloud_user_id}" Opacity="0.8"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ActiveCloudUserText}"/>
                                </Grid>
                                <Grid ColumnDefinitions="170,*" ColumnSpacing="10">
                                    <TextBlock Grid.Column="0" Text="{loc:Tr app_settings.token_state}" Opacity="0.8"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ActiveSessionTokenState}" TextWrapping="Wrap"/>
                                </Grid>

                                <TextBlock Text="{Binding TokenPolicyHint}" Opacity="0.75" TextWrapping="Wrap"/>

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="{loc:Tr app_settings.sign_out}"
                                            Command="{Binding SignOutCommand}"
                                            IsEnabled="{Binding HasActiveProfile}"
                                            Classes="subtle"/>
                                </StackPanel>

                                <TextBlock Text="{Binding AuthMessage}"
                                           IsVisible="{Binding AuthMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                           Foreground="{DynamicResource VeyraInfoBrush}"
                                           TextWrapping="Wrap"/>

                                <Border Height="1" Background="{DynamicResource VeyraBorderSoftBrush}"/>

                                <TextBlock Text="{loc:Tr app_settings.known_profiles}" FontWeight="SemiBold"/>
                                <ItemsControl ItemsSource="{Binding Profiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="settings:AppUserProfileItemViewModel">
                                            <Border Classes="card" Padding="10" Margin="0,0,0,8">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <StackPanel Grid.Column="0" Spacing="2">
                                                        <TextBlock Text="{Binding Username}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding EmailText}" Opacity="0.75"/>
                                                        <TextBlock Text="{Binding LastLoginText}" Opacity="0.75"/>
                                                        <TextBlock Text="{Binding CloudUserLabel}" Opacity="0.75"/>
                                                        <TextBlock Text="{Binding TokenStateText}" Opacity="0.75" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{loc:Tr app_settings.token_available}"
                                                                   Foreground="{DynamicResource VeyraSuccessBrush}"
                                                                   IsVisible="{Binding HasAccessToken}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="6" HorizontalAlignment="Right">
                                                        <TextBlock Text="{loc:Tr app_settings.active}"
                                                                   IsVisible="{Binding IsActive}"
                                                                   Foreground="{DynamicResource VeyraInfoBrush}"
                                                                   HorizontalAlignment="Right"/>
                                                        <Button Content="{loc:Tr app_settings.activate}"
                                                                Classes="subtle"
                                                                IsEnabled="{Binding IsActive, Converter={x:Static conv:BoolInvertConverter.Instance}}"
                                                                Command="{Binding #Root.((settings:AppSettingsViewModel)DataContext).ActivateProfileCommand}"
                                                                CommandParameter="{Binding .}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Height="1" Background="{DynamicResource VeyraBorderSoftBrush}"/>

                                <TextBlock Text="{loc:Tr app_settings.authentication}" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox Grid.Column="0" Text="{Binding UsernameInput, Mode=TwoWay}" Watermark="{loc:Tr auth.username}"/>
                                    <Button Grid.Column="1" Content="{Binding ToggleAuthLabel}" Command="{Binding ToggleAuthModeCommand}" Classes="subtle"/>
                                </Grid>

                                <TextBox Text="{Binding EmailInput, Mode=TwoWay}"
                                         Watermark="{loc:Tr auth.email}"
                                         IsVisible="{Binding IsConfirmPasswordVisible}"/>

                                <TextBox Text="{Binding PasswordInput, Mode=TwoWay}" PasswordChar="*" Watermark="{loc:Tr auth.password}"/>
                                <TextBox Text="{Binding ConfirmPasswordInput, Mode=TwoWay}"
                                         PasswordChar="*"
                                         Watermark="{loc:Tr auth.confirm_password}"
                                         IsVisible="{Binding IsConfirmPasswordVisible}"/>

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="{Binding SubmitAuthLabel}"
                                            Command="{Binding SubmitAuthCommand}"
                                            Classes="primary"/>
                                </StackPanel>

                                <TextBlock Text="{Binding AuthMessage}"
                                           IsVisible="{Binding AuthMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                           Foreground="{DynamicResource VeyraInfoBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Padding="12" IsVisible="{Binding IsSyncTabSelected}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{loc:Tr app_settings.pseudo_cloud_sync}" FontSize="16" FontWeight="SemiBold"/>

                                <Grid ColumnDefinitions="170,*" ColumnSpacing="10">
                                    <TextBlock Grid.Column="0" Text="{loc:Tr app_settings.cloud_api}" Opacity="0.8"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CloudApiBaseUrl}" TextWrapping="Wrap"/>
                                </Grid>

                                <Grid ColumnDefinitions="170,*" ColumnSpacing="10">
                                    <TextBlock Grid.Column="0" Text="{loc:Tr app_settings.local_repositories}" Opacity="0.8"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LocalRepositoryCount}"/>
                                </Grid>

                                <TextBlock Text="{Binding TokenPolicyHint}" Opacity="0.75" TextWrapping="Wrap"/>

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="{loc:Tr app_settings.restore_from_cloud}"
                                            Command="{Binding RestoreFromCloudCommand}"
                                            IsEnabled="{Binding IsSyncBusy, Converter={x:Static conv:BoolInvertConverter.Instance}}"
                                            Classes="subtle"/>
                                    <Button Content="{loc:Tr app_settings.push_all_latest}"
                                            Command="{Binding PushAllRepositoriesCommand}"
                                            IsEnabled="{Binding IsSyncBusy, Converter={x:Static conv:BoolInvertConverter.Instance}}"
                                            Classes="subtle"/>
                                    <Button Content="{loc:Tr app_settings.process_queue}"
                                            Command="{Binding ProcessQueueCommand}"
                                            IsEnabled="{Binding IsSyncBusy, Converter={x:Static conv:BoolInvertConverter.Instance}}"
                                            Classes="subtle"/>
                                </StackPanel>

                                <TextBlock Text="{loc:Tr common.running}"
                                           IsVisible="{Binding IsSyncBusy}"/>

                                <TextBlock Text="{Binding SyncMessage}"
                                           IsVisible="{Binding SyncMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                           Foreground="{DynamicResource VeyraInfoBrush}"
                                           TextWrapping="Wrap"/>

                                <Border Classes="filter-sheet" Padding="12">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{loc:Tr app_settings.cloud_storage_title}" FontSize="16" FontWeight="SemiBold"/>
                                                <TextBlock Text="{loc:Tr app_settings.cloud_storage_subtitle}" Classes="muted" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                                <Button Content="{loc:Tr app_settings.cloud_storage_refresh}"
                                                        Command="{Binding RefreshCloudStorageMetricsCommand}"
                                                        IsEnabled="{Binding IsCloudMaintenanceBusy, Converter={x:Static conv:BoolInvertConverter.Instance}}"
                                                        Classes="subtle"/>
                                                <Button Content="{loc:Tr app_settings.cloud_storage_repair}"
                                                        Command="{Binding RepairCloudStorageCommand}"
                                                        IsEnabled="{Binding IsCloudMaintenanceBusy, Converter={x:Static conv:BoolInvertConverter.Instance}}"
                                                        Classes="primary"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="{loc:Tr app_settings.cloud_storage_empty_hint}"
                                                   Classes="muted"
                                                   TextWrapping="Wrap"
                                                   IsVisible="{Binding HasCloudStorageMetrics, Converter={x:Static conv:BoolInvertConverter.Instance}}"/>

                                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10" IsVisible="{Binding HasCloudStorageMetrics}">
                                            <Border Grid.Column="0" Classes="metric-card">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{loc:Tr app_settings.cloud_storage_metric_logical_blocks}" Classes="muted" FontSize="11"/>
                                                    <TextBlock Text="{Binding CloudStorageLogicalBlockCount}" FontSize="22" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding CloudStorageLogicalBytesText}" Classes="muted" FontSize="11"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1" Classes="metric-card">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{loc:Tr app_settings.cloud_storage_metric_physical_objects}" Classes="muted" FontSize="11"/>
                                                    <TextBlock Text="{Binding CloudStoragePhysicalObjectCount}" FontSize="22" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding CloudStoragePhysicalPayloadBytesText}" Classes="muted" FontSize="11"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" Classes="metric-card">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{loc:Tr app_settings.cloud_storage_metric_missing_blocks}" Classes="muted" FontSize="11"/>
                                                    <TextBlock Text="{Binding CloudStorageMissingBlockCount}" FontSize="22" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding CloudStorageBlocksBreakdownText}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="3" Classes="metric-card">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{loc:Tr app_settings.cloud_storage_metric_reduction}" Classes="muted" FontSize="11"/>
                                                    <TextBlock Text="{Binding CloudStorageReductionText}" FontSize="22" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{loc:Tr app_settings.cloud_storage_metric_reduction_hint}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <Grid ColumnDefinitions="180,*" ColumnSpacing="10" IsVisible="{Binding HasCloudStorageMetrics}">
                                            <TextBlock Grid.Column="0" Text="{loc:Tr app_settings.cloud_storage_packs_label}" Opacity="0.8"/>
                                            <TextBlock Grid.Column="1" Text="{Binding CloudStoragePacksBreakdownText}" TextWrapping="Wrap"/>
                                        </Grid>

                                        <Grid ColumnDefinitions="180,*" ColumnSpacing="10" IsVisible="{Binding HasCloudStorageMetrics}">
                                            <TextBlock Grid.Column="0" Text="{loc:Tr app_settings.cloud_storage_filesystem_label}" Opacity="0.8"/>
                                            <TextBlock Grid.Column="1" Text="{Binding CloudStorageFilesystemBreakdownText}" TextWrapping="Wrap"/>
                                        </Grid>

                                        <Grid ColumnDefinitions="180,*" ColumnSpacing="10" IsVisible="{Binding HasCloudStorageMetrics}">
                                            <TextBlock Grid.Column="0" Text="{loc:Tr app_settings.cloud_storage_last_updated}" Opacity="0.8"/>
                                            <TextBlock Grid.Column="1" Text="{Binding CloudStorageLastUpdatedText}" TextWrapping="Wrap"/>
                                        </Grid>

                                        <TextBlock Text="{loc:Tr common.running}"
                                                   IsVisible="{Binding IsCloudMaintenanceBusy}"/>

                                        <TextBlock Text="{Binding CloudStorageMessage}"
                                                   IsVisible="{Binding CloudStorageMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                                   Foreground="{DynamicResource VeyraInfoBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Classes="filter-sheet" Padding="12">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{loc:Tr app_settings.repository_sync_health_title}" FontSize="16" FontWeight="SemiBold"/>
                                                <TextBlock Text="{loc:Tr app_settings.repository_sync_health_subtitle}" Classes="muted" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <Border Classes="badge" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding RepositorySyncIssueCount}" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>

                                        <TextBlock Text="{loc:Tr app_settings.repository_sync_health_empty}"
                                                   Classes="muted"
                                                   TextWrapping="Wrap"
                                                   IsVisible="{Binding HasRepositorySyncIssues, Converter={x:Static conv:BoolInvertConverter.Instance}}"/>

                                        <ItemsControl ItemsSource="{Binding RepositorySyncIssues}"
                                                      IsVisible="{Binding HasRepositorySyncIssues}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="settings:AppRepositorySyncIssueItemViewModel">
                                                    <Border Classes="card" Padding="12" Margin="0,0,0,8">
                                                        <StackPanel Spacing="8">
                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                <StackPanel Grid.Column="0" Spacing="2">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                                </StackPanel>
                                                                <Border Grid.Column="1" Classes="badge" VerticalAlignment="Top">
                                                                    <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"/>
                                                                </Border>
                                                            </Grid>

                                                            <Grid ColumnDefinitions="150,*" ColumnSpacing="10">
                                                                <TextBlock Grid.Column="0" Text="{loc:Tr repo_settings.queue}" Opacity="0.8"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding QueueText}" TextWrapping="Wrap"/>
                                                            </Grid>

                                                            <Grid ColumnDefinitions="150,*" ColumnSpacing="10">
                                                                <TextBlock Grid.Column="0" Text="{loc:Tr app_settings.repository_sync_health_last_sync}" Opacity="0.8"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding LastSyncText}" TextWrapping="Wrap"/>
                                                            </Grid>

                                                            <TextBlock Text="{Binding ErrorText}"
                                                                       Foreground="{DynamicResource VeyraWarningBrush}"
                                                                       TextWrapping="Wrap"
                                                                       IsVisible="{Binding HasError}"/>

                                                            <Button Content="{loc:Tr app_settings.repository_sync_health_open_settings}"
                                                                    Classes="subtle"
                                                                    HorizontalAlignment="Left"
                                                                    Command="{Binding #Root.((settings:AppSettingsViewModel)DataContext).OpenRepositorySyncIssueSettingsCommand}"
                                                                    CommandParameter="{Binding .}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Padding="12" IsVisible="{Binding IsGeneralTabSelected}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{loc:Tr app_settings.general_title}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{loc:Tr app_settings.general_subtitle}" Opacity="0.75" TextWrapping="Wrap"/>

                                <Grid ColumnDefinitions="170,*" ColumnSpacing="10">
                                    <TextBlock Grid.Column="0" Text="{loc:Tr app_settings.theme_label}" Opacity="0.8"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding Themes}"
                                              SelectedItem="{Binding SelectedTheme, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="settings:AppThemeOptionItemViewModel">
                                                <TextBlock Text="{Binding DisplayName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <TextBlock Text="{loc:Tr app_settings.theme_hint}" Opacity="0.72" TextWrapping="Wrap"/>

                                <Grid ColumnDefinitions="170,*" ColumnSpacing="10">
                                    <TextBlock Grid.Column="0" Text="{loc:Tr app_settings.language_label}" Opacity="0.8"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding Languages}"
                                              SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="settings:AppLanguageOptionItemViewModel">
                                                <TextBlock Text="{Binding DisplayName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <TextBlock Text="{loc:Tr app_settings.language_hint}" Opacity="0.72" TextWrapping="Wrap"/>

                                <Border Classes="card" Padding="10" BorderBrush="{DynamicResource VeyraBorderSoftBrush}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{loc:Tr app_settings.sensitive_actions_title}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{loc:Tr app_settings.sensitive_actions_hint}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                                        <CheckBox Content="{loc:Tr app_settings.sensitive_actions_checkbox}"
                                                  IsChecked="{Binding RequirePasswordForSensitiveActions, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanEditSensitiveActionVerification}"/>
                                        <TextBlock Text="{loc:Tr app_settings.sensitive_actions_requires_sign_in}"
                                                   Classes="muted"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   IsVisible="{Binding CanEditSensitiveActionVerification, Converter={x:Static conv:BoolInvertConverter.Instance}}"/>
                                        <TextBlock Text="{Binding GeneralMessage}"
                                                   Foreground="{DynamicResource VeyraInfoBrush}"
                                                   TextWrapping="Wrap"
                                                   IsVisible="{Binding GeneralMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
                                    </StackPanel>
                                </Border>

                                <Border Classes="card" Padding="10" BorderBrush="{DynamicResource VeyraBorderSoftBrush}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{loc:Tr app_settings.localization_diagnostics_title}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{loc:Tr app_settings.localization_diagnostics_subtitle}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>

                                        <Grid ColumnDefinitions="190,*" ColumnSpacing="10">
                                            <TextBlock Grid.Column="0" Text="{loc:Tr app_settings.localization_files_count_label}" Opacity="0.8"/>
                                            <TextBlock Grid.Column="1" Text="{Binding LocalizationResourceFilesCount}"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="190,*" ColumnSpacing="10">
                                            <TextBlock Grid.Column="0" Text="{loc:Tr app_settings.localization_total_keys_label}" Opacity="0.8"/>
                                            <TextBlock Grid.Column="1" Text="{Binding LocalizationTotalKeysCount}"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="190,*" ColumnSpacing="10">
                                            <TextBlock Grid.Column="0" Text="{loc:Tr app_settings.localization_missing_keys_label}" Opacity="0.8"/>
                                            <TextBlock Grid.Column="1" Text="{Binding LocalizationMissingKeysCount}"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="190,*" ColumnSpacing="10">
                                            <TextBlock Grid.Column="0" Text="{loc:Tr app_settings.localization_duplicate_keys_label}" Opacity="0.8"/>
                                            <TextBlock Grid.Column="1" Text="{Binding LocalizationDuplicateKeysCount}"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="190,*" ColumnSpacing="10">
                                            <TextBlock Grid.Column="0" Text="{loc:Tr app_settings.localization_extra_keys_label}" Opacity="0.8"/>
                                            <TextBlock Grid.Column="1" Text="{Binding LocalizationExtraKeysCount}"/>
                                        </Grid>

                                        <TextBlock Text="{Binding LocalizationHealthText}"
                                                   Foreground="{DynamicResource VeyraSuccessBrush}"
                                                   IsVisible="{Binding HasLocalizationIssues, Converter={x:Static conv:BoolInvertConverter.Instance}}"/>
                                        <TextBlock Text="{Binding LocalizationHealthText}"
                                                   Foreground="{DynamicResource VeyraWarningBrush}"
                                                   IsVisible="{Binding HasLocalizationIssues}"/>

                                        <TextBlock Text="{loc:Tr app_settings.localization_sample_missing_label}"
                                                   FontWeight="SemiBold"
                                                   IsVisible="{Binding HasLocalizationMissingSample}"/>
                                        <TextBlock Text="{Binding LocalizationMissingSample}"
                                                   Classes="muted"
                                                   TextWrapping="Wrap"
                                                   IsVisible="{Binding HasLocalizationMissingSample}"/>

                                        <TextBlock Text="{loc:Tr app_settings.localization_sample_duplicate_label}"
                                                   FontWeight="SemiBold"
                                                   IsVisible="{Binding HasLocalizationDuplicateSample}"/>
                                        <TextBlock Text="{Binding LocalizationDuplicateSample}"
                                                   Classes="muted"
                                                   TextWrapping="Wrap"
                                                   IsVisible="{Binding HasLocalizationDuplicateSample}"/>

                                        <TextBlock Text="{loc:Tr app_settings.localization_sample_extra_label}"
                                                   FontWeight="SemiBold"
                                                   IsVisible="{Binding HasLocalizationExtraSample}"/>
                                        <TextBlock Text="{Binding LocalizationExtraSample}"
                                                   Classes="muted"
                                                   TextWrapping="Wrap"
                                                   IsVisible="{Binding HasLocalizationExtraSample}"/>
                                    </StackPanel>
                                </Border>

                                <Border Classes="card" Padding="10" BorderBrush="{DynamicResource VeyraBorderSoftBrush}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{loc:Tr app_settings.operation_journal_title}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{loc:Tr app_settings.operation_journal_subtitle}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>

                                        <ItemsControl ItemsSource="{Binding OperationJournalItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="settings:AppOperationJournalItemViewModel">
                                                    <Border Classes="card" Padding="8" Margin="0,0,0,6">
                                                        <Grid ColumnDefinitions="150,68,92,220,90,*" ColumnSpacing="8">
                                                            <TextBlock Grid.Column="0" Text="{Binding TimestampText}" Classes="muted"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Level}" FontWeight="SemiBold"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Category}" Classes="muted"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding Action}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="4" Text="{Binding ScopeText}" Classes="muted"/>
                                                            <TextBlock Grid.Column="5" Text="{Binding Message}" TextWrapping="Wrap"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>

