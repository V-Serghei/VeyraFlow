<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Veyra.Desktop.Localization"
        xmlns:conv="clr-namespace:Veyra.Desktop.Converters"
        xmlns:vm="clr-namespace:Veyra.Desktop.ViewModels.Windows"
        x:Class="Veyra.Desktop.Views.Windows.AuthDialogWindow"
        x:DataType="vm:AuthDialogWindowViewModel"
        Width="520"
        MinWidth="460"
        Height="560"
        MinHeight="520"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Title="{Binding TitleText}">

    <Border Classes="dialog-shell" Margin="14" Padding="18">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*" RowSpacing="12">
            <Border Grid.Row="0" Classes="hero">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding TitleText}" Classes="h2"/>
                    <TextBlock Text="{Binding SubtitleText}" Classes="muted" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <TextBox Grid.Row="1"
                     Text="{Binding UsernameInput, Mode=TwoWay}"
                     Watermark="{loc:Tr auth.username_placeholder}"/>

            <TextBox Grid.Row="2"
                     Text="{Binding EmailInput, Mode=TwoWay}"
                     Watermark="{loc:Tr auth.email_placeholder}"
                     IsVisible="{Binding IsConfirmPasswordVisible}"/>

            <TextBox Grid.Row="3"
                     Text="{Binding PasswordInput, Mode=TwoWay}"
                     PasswordChar="*"
                     Watermark="{loc:Tr auth.password_placeholder}"/>

            <TextBox Grid.Row="4"
                     Text="{Binding ConfirmPasswordInput, Mode=TwoWay}"
                     PasswordChar="*"
                     Watermark="{loc:Tr auth.confirm_password}"
                     IsVisible="{Binding IsConfirmPasswordVisible}"/>

            <StackPanel Grid.Row="5" Spacing="8">
                <Button Content="{Binding ToggleModeLabel}"
                        Command="{Binding ToggleModeCommand}"
                        Classes="subtle compact"
                        HorizontalAlignment="Left"/>

                <TextBlock Text="{Binding MessageText}"
                           IsVisible="{Binding MessageText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                           Foreground="{DynamicResource VeyraInfoBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Grid Grid.Row="6" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" VerticalAlignment="Bottom">
                <Border Grid.Column="0" Background="Transparent"/>
                <Button Grid.Column="1"
                        Content="{loc:Tr common.cancel}"
                        Command="{Binding CancelCommand}"
                        Classes="subtle"/>
                <Button Grid.Column="2"
                        Content="{Binding SubmitLabel}"
                        Command="{Binding SubmitCommand}"
                        Classes="primary"/>
            </Grid>
        </Grid>
    </Border>
</Window>
