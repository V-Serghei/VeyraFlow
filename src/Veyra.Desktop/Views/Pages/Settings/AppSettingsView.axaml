<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:settings="clr-namespace:Veyra.Desktop.ViewModels.Pages.Settings"
             x:Class="Veyra.Desktop.Views.Pages.Settings.AppSettingsView"
             x:Name="Root"
             x:DataType="settings:AppSettingsViewModel"
             Background="#0D0D0D">

    <DockPanel Margin="24,18">
        <Border DockPanel.Dock="Top" Background="#121212" CornerRadius="10" Padding="16" Margin="0,0,0,12">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Button Grid.Column="0" Content="← Назад" Command="{Binding BackCommand}" Padding="12,8"/>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="Настройки приложения" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="Дизайн и структура модулей конфигурации" Opacity="0.7"/>
                </StackPanel>
                <Border Grid.Column="2" Background="#173B2D" CornerRadius="8" Padding="10,6" VerticalAlignment="Center">
                    <TextBlock Text="Draft UI" Foreground="#6EE7B7" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <Grid ColumnDefinitions="300,*" ColumnSpacing="12">
            <Border Grid.Column="0" Background="#121212" CornerRadius="10" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Tabs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="settings:AppSettingsTabViewModel">
                                <Button Background="#171717" BorderBrush="#242424" BorderThickness="1" CornerRadius="8"
                                        Margin="0,0,0,8" Padding="12,10"
                                        Command="{Binding #Root.((settings:AppSettingsViewModel)DataContext).SelectTabCommand}"
                                        CommandParameter="{Binding .}">
                                    <StackPanel Spacing="2" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.65" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Background="#121212" CornerRadius="10" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <TextBlock Text="{Binding SelectedTab.Title}" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SelectedTab.Subtitle}" Opacity="0.75"/>

                        <Border Background="#171717" CornerRadius="10" Padding="14" BorderBrush="#242424" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Параметры" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Основной параметр" Opacity="0.8"/>
                                        <TextBox Watermark="Значение"/>
                                    </StackPanel>
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Режим" Opacity="0.8"/>
                                        <ComboBox SelectedIndex="0">
                                            <ComboBoxItem Content="Стандартный"/>
                                            <ComboBoxItem Content="Расширенный"/>
                                            <ComboBoxItem Content="Тестовый"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                                <CheckBox Content="Включить параметр" IsChecked="True"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#171717" CornerRadius="10" Padding="14" BorderBrush="#242424" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Правила" FontWeight="SemiBold"/>
                                <ItemsControl>
                                    <ItemsControl.Items>
                                        <TextBlock Text="• Политика хранится локально в SQLite"/>
                                        <TextBlock Text="• Будет синхронизироваться после включения облака"/>
                                        <TextBlock Text="• Изменения применяются к новым операциям"/>
                                    </ItemsControl.Items>
                                </ItemsControl>
                                <TextBox AcceptsReturn="True" Height="90" Watermark="Дополнительные правила"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button Content="Сбросить" Padding="12,8"/>
                            <Button Content="Сохранить" Padding="12,8"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
