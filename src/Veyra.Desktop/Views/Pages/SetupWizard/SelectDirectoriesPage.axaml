<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Veyra.Desktop.ViewModels.Pages.SetupWizard"
             x:Class="Veyra.Desktop.Views.Pages.SetupWizard.SelectDirectoriesPage"
             x:Name="Root"
             d:DataContext="{d:DesignInstance vm:SelectDirectoriesViewModel, IsDesignTimeCreatable=True}"
             x:DataType="vm:SelectDirectoriesViewModel">
  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
    <StackPanel Spacing="8">
      <TextBlock FontSize="22" FontWeight="SemiBold" Text="Выбор директорий"/>
      <TextBlock Opacity="0.8" Text="Укажи папки для отслеживания версий"/>
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,8,0,0">
        <TextBox Grid.Column="0" Text="{Binding InputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="Путь к папке"/>
        <Button Grid.Column="1" Content="Обзор" Width="100" Command="{Binding BrowseCommand}"/>
        <Button Grid.Column="2" Content="Добавить" Width="100" Command="{Binding AddCommand}"/>
      </Grid>
    </StackPanel>

    <Border Grid.Row="1" Padding="12" Background="#171717" CornerRadius="10" BorderBrush="#262626" BorderThickness="1">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Directories}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <Border Background="#101010" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                <DockPanel>
                  <Button Content="Удалить" DockPanel.Dock="Right" Margin="8,0,0,0"
                          Command="{Binding DataContext.RemoveCommand, ElementName=Root}"
                          CommandParameter="{Binding .}" />
                  <TextBlock Text="{Binding .}" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <TextBlock Grid.Row="2" Opacity="0.72" Text="{Binding FooterText}"/>
  </Grid>
</UserControl>
