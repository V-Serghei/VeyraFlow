<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:Veyra.Desktop.ViewModels.Windows"
        x:Class="Veyra.Desktop.Views.Windows.InfoWindow"
        Width="640" Height="420"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Title="О проекте"
        d:DataContext="{d:DesignInstance vm:InfoWindowViewModel, IsDesignTimeCreatable=True}"
        x:DataType="vm:InfoWindowViewModel">
    <ScrollViewer Padding="24">
        <StackPanel Spacing="12">
            <TextBlock Text="О VeyraFlow" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap">
                VeyraFlow is a desktop file explorer with content-based versioning,
                snapshots, block-level deduplication, encryption, and a local SQLite index.
                Cloud sync is optional (S3/WebDAV/SFTP).
            </TextBlock>
            <TextBlock Text="• Snapshots and change history"/>
            <TextBlock Text="• Block deduplication and space saving"/>
            <TextBlock Text="• End-to-end encryption"/>
            <TextBlock Text="• Cross-language architecture: C# / Rust / Go"/>
            <Button Content="Close" HorizontalAlignment="Right" Width="120" IsDefault="True"
                    Command="{Binding CloseCommand}"/>
        </StackPanel>
    </ScrollViewer>
</Window>
