
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Veyra.Desktop.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:explorer="clr-namespace:Veyra.Desktop.ViewModels.Pages.Explorer"
             x:Class="Veyra.Desktop.Views.Pages.Explorer.RepositoryExplorerView"
             x:Name="Root"
             x:DataType="explorer:RepositoryExplorerViewModel"
             Background="{DynamicResource VeyraCanvasBrush}">

    <Grid RowDefinitions="Auto,Auto,*" Margin="18,14,18,18" RowSpacing="10">
        <Border Grid.Row="0" Classes="hero">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                <Button Grid.Column="0" Content="{loc:Tr common.back}" Command="{Binding BackCommand}" Classes="subtle"/>

                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="{Binding RepositoryName}" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Classes="muted" Text="{Binding RepositoryPath}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Classes="muted"
                               Text="{loc:Tr explorer.live_sync}"
                               FontSize="11"
                               IsVisible="{Binding IsLiveSyncActive}"/>
                </StackPanel>

                <WrapPanel Grid.Column="2" Orientation="Horizontal" ItemHeight="34" ItemWidth="150" Margin="0,2,0,0">
                    <Button Content="{loc:Tr explorer.rescan_files}"
                            ToolTip.Tip="{loc:Tr explorer.tooltip_rescan}"
                            Command="{Binding RescanCommand}"
                            Classes="subtle"
                            IsEnabled="{Binding CanRunScanActions}"/>
                    <Button Content="{loc:Tr explorer.create_snapshot}"
                            Command="{Binding CreateSnapshotCommand}"
                            Classes="primary"
                            IsEnabled="{Binding CanCreateSnapshot}"/>
                    <Button Content="{loc:Tr explorer.snapshot_history}"
                            Command="{Binding ShowSnapshotHistoryCommand}"
                            Classes="subtle"
                            IsEnabled="{Binding CanRunScanActions}"/>
                    <Button Content="{loc:Tr common.settings}" Command="{Binding OpenSettingsCommand}" Classes="subtle"/>
                </WrapPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Spacing="6">
            <Border Classes="panel" IsVisible="{Binding IsScanRunning}" Padding="10">
                <Grid ColumnDefinitions="*,120" ColumnSpacing="10" VerticalAlignment="Center">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="{Binding ScanMessage}" FontWeight="SemiBold"/>
                        <ProgressBar Minimum="0"
                                     Maximum="100"
                                     Value="{Binding ScanPercent}"
                                     Height="8"
                                     IsIndeterminate="{Binding ScanIsIndeterminate}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding ScanPercent, StringFormat='{}{0}%'}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>
                </Grid>
            </Border>

            <Border Classes="panel" IsVisible="{Binding HasErrorMessage}" Padding="10" BorderBrush="{DynamicResource VeyraDangerBrush}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource VeyraDangerBrush}" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid ColumnDefinitions="270,*,390" ColumnSpacing="12">
                <Border Grid.Column="0" Classes="panel">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{loc:Tr explorer.folders}" Classes="section-title" Margin="0,0,0,8"/>
                        <TreeView ItemsSource="{Binding TreeNodes}"
                                  SelectedItem="{Binding SelectedTreeNode, Mode=TwoWay}">
                            <TreeView.DataTemplates>
                                <TreeDataTemplate DataType="explorer:ExplorerTreeNodeViewModel" ItemsSource="{Binding Children}">
                                    <TextBlock Text="{Binding Name}"/>
                                </TreeDataTemplate>
                            </TreeView.DataTemplates>
                        </TreeView>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Classes="panel">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                        <TextBox Grid.Row="0"
                                 Text="{Binding SearchQuery, Mode=TwoWay}"
                                 Watermark="{loc:Tr explorer.search_current_folder}"/>

                        <Grid Grid.Row="1" ColumnDefinitions="40,*,120,110,120,110" Margin="0,4,0,2" ColumnSpacing="6">
                            <TextBlock Grid.Column="1" Text="{loc:Tr common.name}" FontWeight="SemiBold" Opacity="0.82"/>
                            <TextBlock Grid.Column="2" Text="{loc:Tr common.type}" FontWeight="SemiBold" Opacity="0.82"/>
                            <TextBlock Grid.Column="3" Text="{loc:Tr common.size}" FontWeight="SemiBold" Opacity="0.82"/>
                            <TextBlock Grid.Column="4" Text="{loc:Tr common.modified}" FontWeight="SemiBold" Opacity="0.82"/>
                            <TextBlock Grid.Column="5" Text="{loc:Tr common.action}" FontWeight="SemiBold" Opacity="0.82"/>
                        </Grid>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="explorer:ExplorerItemViewModel">
                                        <Border Classes="card" Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="40,*,120,110,120,110" ColumnSpacing="6">
                                                <Button Grid.Column="0"
                                                        Content="{Binding Icon}"
                                                        FontSize="14"
                                                        Classes="subtle"
                                                        Command="{Binding #Root.((explorer:RepositoryExplorerViewModel)DataContext).SelectItemCommand}"
                                                        CommandParameter="{Binding .}"/>

                                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Type}" VerticalAlignment="Center" Opacity="0.85"/>
                                                <TextBlock Grid.Column="3" Text="{Binding SizeDisplay}" VerticalAlignment="Center" Opacity="0.85"/>
                                                <TextBlock Grid.Column="4" Text="{Binding ModifiedDisplay}" VerticalAlignment="Center" Opacity="0.85"/>

                                                <Button Grid.Column="5"
                                                        Content="{loc:Tr common.open}"
                                                        Classes="subtle"
                                                        IsVisible="{Binding CanOpenDirectory}"
                                                        Command="{Binding #Root.((explorer:RepositoryExplorerViewModel)DataContext).OpenItemCommand}"
                                                        CommandParameter="{Binding .}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Classes="panel">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{loc:Tr explorer.pending_changes}" Classes="section-title"/>
                            <TextBlock Classes="muted" Text="{Binding LastSnapshotLabel}"/>
                            <TextBlock Text="{Binding PendingChangesSummary}" Opacity="0.88" TextWrapping="Wrap"/>
                            <ListBox Classes="clean-list"
                                     ItemsSource="{Binding PendingChanges}"
                                     MaxHeight="230"
                                     IsVisible="{Binding HasPendingChanges}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="explorer:RepositoryPendingChangeViewModel">
                                        <Border Classes="card">
                                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" RowSpacing="2">
                                                <TextBlock Grid.Row="0" Grid.Column="0"
                                                           Text="{Binding ChangeKindLabel}"
                                                           Foreground="{Binding ChangeKindColor}"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding SizeDeltaLabel}" Opacity="0.78"/>
                                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                                           Text="{Binding RelativePath}"
                                                           Opacity="0.72"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="{loc:Tr explorer.no_pending_changes}" Opacity="0.72" IsVisible="{Binding HasNoPendingChanges}"/>

                            <Button Content="{loc:Tr explorer.open_snapshot_history}"
                                    Command="{Binding ShowSnapshotHistoryCommand}"
                                    Classes="subtle"
                                    HorizontalAlignment="Stretch"
                                    Padding="12,10"/>

                            <Border Classes="panel" Padding="10" BorderBrush="{DynamicResource VeyraBorderSoftBrush}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{loc:Tr explorer.repository_tools}" FontWeight="SemiBold"/>
                                    <TextBlock Classes="muted" Text="{loc:Tr explorer.repository_tools_hint}" FontSize="11" TextWrapping="Wrap"/>
                                    <WrapPanel Orientation="Horizontal" ItemWidth="170" ItemHeight="34">
                                        <Button Content="{loc:Tr explorer.fix_missing_data}" ToolTip.Tip="{loc:Tr explorer.tooltip_repair_data}" AutomationProperties.Name="{loc:Tr explorer.automation_repair_data}"
                                                Command="{Binding RepairRepositoryDataCommand}"
                                                IsEnabled="{Binding CanRunMaintenanceActions}"
                                                Classes="subtle"/>
                                        <Button Content="{loc:Tr explorer.rebuild_index}" ToolTip.Tip="{loc:Tr explorer.tooltip_reindex_data}" AutomationProperties.Name="{loc:Tr explorer.automation_reindex_data}"
                                                Command="{Binding ReindexRepositoryDataCommand}"
                                                IsEnabled="{Binding CanRunMaintenanceActions}"
                                                Classes="subtle"/>
                                        <Button Content="{loc:Tr explorer.repair_links}" ToolTip.Tip="{loc:Tr explorer.tooltip_relink_graph}" AutomationProperties.Name="{loc:Tr explorer.automation_relink_graph}"
                                                Command="{Binding RelinkRepositoryDataCommand}"
                                                IsEnabled="{Binding CanRunMaintenanceActions}"
                                                Classes="subtle"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Height="1" Background="{DynamicResource VeyraBorderSoftBrush}" Margin="0,4"/>

                            <TextBlock Text="{loc:Tr explorer.selected_file}" Classes="section-title"/>

                            <StackPanel IsVisible="{Binding HasSelectedItem}" Spacing="8">
                                <TextBlock Text="{Binding SelectedItem.Name}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Classes="muted" Text="{Binding SelectedItem.RelativePath}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedItem.Type}" Opacity="0.84"/>
                                <TextBlock Text="{Binding SelectedItem.SizeDisplay}" Opacity="0.84"/>
                                <TextBlock Text="{Binding SelectedItem.ModifiedDisplay}" Opacity="0.84"/>

                                <Border Height="1" Background="{DynamicResource VeyraBorderSoftBrush}" Margin="0,4"/>

                                <TextBlock Text="{loc:Tr explorer.file_versions}" FontWeight="SemiBold"/>
                                <TextBlock Text="{loc:Tr explorer.loading_versions}" Opacity="0.72" IsVisible="{Binding IsVersionLoading}"/>
                                <TextBlock Text="{Binding VersionPanelError}"
                                           Foreground="{DynamicResource VeyraDangerBrush}"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding HasVersionPanelError}"/>
                                <TextBlock Text="{loc:Tr explorer.no_versions_for_selected_file}" Opacity="0.72" IsVisible="{Binding HasNoFileVersions}"/>

                                <ListBox Classes="clean-list"
                                         ItemsSource="{Binding VisibleFileVersions}"
                                         SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                                         MaxHeight="200">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="explorer:ExplorerFileVersionViewModel">
                                            <Border Classes="card" Padding="8">
                                                <Grid RowDefinitions="Auto" ColumnDefinitions="Auto,*,Auto" RowSpacing="2" ColumnSpacing="8">
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding VersionName}" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CreatedAtDisplay}" Opacity="0.82"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding SizeDisplay}" Opacity="0.78"/>
                                                    
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Button Content="{Binding FileVersionsToggleLabel}" Command="{Binding ToggleFileVersionsViewCommand}" Classes="subtle" IsVisible="{Binding CanToggleFileVersionsView}"/>

                                <Border Classes="card" Padding="8" IsVisible="{Binding HasSelectedVersion}">
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="100,*" RowSpacing="3" ColumnSpacing="8">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr common.path}" Opacity="0.7"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedItem.RelativePath}" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Tr common.version}" Opacity="0.7"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedVersion.VersionName}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Tr common.size}" Opacity="0.7"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedVersion.SizeDisplay}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Tr common.date}" Opacity="0.7"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedVersion.CreatedAtDisplay}"/>
                                    </Grid>
                                </Border>

                                <TextBlock Text="{loc:Tr explorer.no_content_blocks_for_version}"
                                           Foreground="{DynamicResource VeyraWarningBrush}"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding SelectedVersionHasNoContentBlocks}"/>

                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="{loc:Tr explorer.restore_as_copy}"
                                            Command="{Binding RestoreVersionAsCopyCommand}"
                                            IsEnabled="{Binding CanRestoreSelectedVersion}"
                                            Classes="subtle"/>
                                    <Button Content="{loc:Tr explorer.restore_overwrite}"
                                            Command="{Binding RestoreVersionOverwriteCommand}"
                                            IsEnabled="{Binding CanRestoreSelectedVersion}"/>
                                </StackPanel>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="{loc:Tr explorer.left_version}" Opacity="0.8" FontSize="11"/>
                                        <ComboBox ItemsSource="{Binding FileVersions}"
                                                  SelectedItem="{Binding CompareLeftVersion, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="explorer:ExplorerFileVersionViewModel">
                                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="{loc:Tr explorer.right_version}" Opacity="0.8" FontSize="11"/>
                                        <ComboBox ItemsSource="{Binding FileVersions}"
                                                  SelectedItem="{Binding CompareRightVersion, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="explorer:ExplorerFileVersionViewModel">
                                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{Binding ComparePairSummary}" Classes="muted" TextWrapping="Wrap"/>

                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="{loc:Tr explorer.compare_in_window}"
                                            Command="{Binding CompareSelectedVersionsCommand}"
                                            IsEnabled="{Binding CanCompareSelectedVersionPair}"
                                            Classes="primary"/>
                                </StackPanel>

                                <TextBlock Text="{Binding VersionActionMessage}"
                                           TextWrapping="Wrap"
                                           Opacity="0.9"
                                           IsVisible="{Binding HasVersionActionMessage}"/>
                            </StackPanel>

                            <TextBlock Text="{loc:Tr explorer.select_file_from_index}"
                                       Opacity="0.72"
                                       IsVisible="{Binding HasNoSelectedItem}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Border IsVisible="{Binding IsSnapshotHistoryMenuOpen}"
                    Classes="overlay-backdrop"
                    Padding="20">
                <Border Classes="dialog-shell" Padding="14" CornerRadius="16">
                    <Grid RowDefinitions="Auto,*" RowSpacing="12">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{loc:Tr explorer.snapshot_history}" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Classes="muted"
                                           Text="{loc:Tr explorer.snapshot_history_hint}"
                                           FontSize="12"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="{loc:Tr common.close}"
                                    Command="{Binding CloseSnapshotHistoryMenuCommand}"
                                    Classes="subtle"/>
                        </Grid>

                        <Grid Grid.Row="1" ColumnDefinitions="330,370,*" ColumnSpacing="12">
                            <Border Grid.Column="0" Classes="panel">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{loc:Tr explorer.commits}" Classes="section-title"/>
                                    <TextBlock Text="{loc:Tr explorer.loading_commits}" Opacity="0.72" IsVisible="{Binding IsSnapshotHistoryLoading}"/>

                                    <ListBox Classes="clean-list"
                                             ItemsSource="{Binding SnapshotHistory}"
                                             SelectedItem="{Binding SelectedSnapshot, Mode=TwoWay}"
                                             IsVisible="{Binding HasSnapshotHistory}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="explorer:RepositorySnapshotHistoryEntryViewModel">
                                                <Border Classes="card">
                                                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="3">
                                                        <TextBlock Grid.Row="0" Text="{Binding DisplayTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Row="1" Text="{Binding DisplayTime}" Opacity="0.78" FontSize="11"/>
                                                        <TextBlock Grid.Row="2" Text="{Binding ChangedFilesLabel}" Opacity="0.78" FontSize="11"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <TextBlock Text="{loc:Tr explorer.no_commits}" Opacity="0.72" IsVisible="{Binding HasNoSnapshotHistory}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Classes="panel">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{loc:Tr explorer.files_in_selected_commit}" Classes="section-title"/>
                                    <TextBlock Text="{loc:Tr explorer.select_commit_for_changes}" Opacity="0.72" IsVisible="{Binding HasNoSelectedSnapshot}"/>
                                    <TextBlock Text="{loc:Tr explorer.loading_changed_files}" Opacity="0.72" IsVisible="{Binding IsSnapshotFilesLoading}"/>

                                    <ListBox Classes="clean-list"
                                             ItemsSource="{Binding SnapshotFiles}"
                                             SelectedItem="{Binding SelectedSnapshotFile, Mode=TwoWay}"
                                             IsVisible="{Binding HasSnapshotFiles}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="explorer:RepositorySnapshotFileChangeViewModel">
                                                <Border Classes="card">
                                                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" RowSpacing="2">
                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding ChangeKindLabel}" FontWeight="SemiBold"/>
                                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding SizeDeltaLabel}" Opacity="0.78"/>
                                                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                                                   Text="{Binding RelativePath}"
                                                                   Opacity="0.72"
                                                                   FontSize="11"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <TextBlock Text="{loc:Tr explorer.no_changed_files_in_commit}" Opacity="0.72" IsVisible="{Binding HasNoSnapshotFiles}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Classes="panel">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{loc:Tr explorer.version_controls}" Classes="section-title"/>

                                        <StackPanel IsVisible="{Binding HasSelectedItem}" Spacing="8">
                                            <TextBlock Text="{Binding SelectedItem.Name}" FontSize="16" FontWeight="SemiBold"/>
                                            <TextBlock Classes="muted" Text="{Binding SelectedItem.RelativePath}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding SelectedItem.Type}"/>
                                            <TextBlock Text="{Binding SelectedItem.SizeDisplay}"/>
                                            <TextBlock Text="{Binding SelectedItem.ModifiedDisplay}"/>
                                            

                                            <Border Height="1" Background="{DynamicResource VeyraBorderSoftBrush}" Margin="0,4"/>

                                            <TextBlock Text="{loc:Tr explorer.file_versions}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{loc:Tr explorer.loading_versions}" Opacity="0.72" IsVisible="{Binding IsVersionLoading}"/>
                                            <TextBlock Text="{Binding VersionPanelError}"
                                                       Foreground="{DynamicResource VeyraDangerBrush}"
                                                       TextWrapping="Wrap"
                                                       IsVisible="{Binding HasVersionPanelError}"/>
                                            <TextBlock Text="{loc:Tr explorer.no_versions_for_selected_file}" Opacity="0.72" IsVisible="{Binding HasNoFileVersions}"/>

                                            <ListBox Classes="clean-list"
                                                     ItemsSource="{Binding VisibleFileVersions}"
                                                     SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                                                     MaxHeight="220">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="explorer:ExplorerFileVersionViewModel">
                                                        <Border Classes="card" Padding="8">
                                                            <Grid RowDefinitions="Auto" ColumnDefinitions="Auto,*,Auto" RowSpacing="2" ColumnSpacing="8">
                                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding VersionName}" FontWeight="SemiBold"/>
                                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CreatedAtDisplay}" Opacity="0.82"/>
                                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding SizeDisplay}" Opacity="0.78"/>
                                                                
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>

                                            <Button Content="{Binding FileVersionsToggleLabel}" Command="{Binding ToggleFileVersionsViewCommand}" Classes="subtle" IsVisible="{Binding CanToggleFileVersionsView}"/>

                                            <Border Classes="card" Padding="8" IsVisible="{Binding HasSelectedVersion}">
                                                <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="100,*" RowSpacing="3" ColumnSpacing="8">
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr common.path}" Opacity="0.7"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedItem.RelativePath}" TextWrapping="Wrap"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Tr common.version}" Opacity="0.7"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedVersion.VersionName}"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Tr common.size}" Opacity="0.7"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedVersion.SizeDisplay}"/>
                                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Tr common.date}" Opacity="0.7"/>
                                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedVersion.CreatedAtDisplay}"/>
                                                </Grid>
                                            </Border>

                                            <TextBlock Text="{loc:Tr explorer.no_content_blocks_for_version}"
                                                       Foreground="{DynamicResource VeyraWarningBrush}"
                                                       TextWrapping="Wrap"
                                                       IsVisible="{Binding SelectedVersionHasNoContentBlocks}"/>

                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Button Content="{loc:Tr explorer.restore_as_copy}"
                                                        Command="{Binding RestoreVersionAsCopyCommand}"
                                                        IsEnabled="{Binding CanRestoreSelectedVersion}"
                                                        Classes="subtle"/>
                                                <Button Content="{loc:Tr explorer.restore_overwrite}"
                                                        Command="{Binding RestoreVersionOverwriteCommand}"
                                                        IsEnabled="{Binding CanRestoreSelectedVersion}"/>
                                            </StackPanel>

                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="{loc:Tr explorer.left_version}" Opacity="0.8" FontSize="11"/>
                                        <ComboBox ItemsSource="{Binding FileVersions}"
                                                  SelectedItem="{Binding CompareLeftVersion, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="explorer:ExplorerFileVersionViewModel">
                                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="{loc:Tr explorer.right_version}" Opacity="0.8" FontSize="11"/>
                                        <ComboBox ItemsSource="{Binding FileVersions}"
                                                  SelectedItem="{Binding CompareRightVersion, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="explorer:ExplorerFileVersionViewModel">
                                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{Binding ComparePairSummary}" Classes="muted" TextWrapping="Wrap"/>

                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="{loc:Tr explorer.compare_in_window}"
                                            Command="{Binding CompareSelectedVersionsCommand}"
                                            IsEnabled="{Binding CanCompareSelectedVersionPair}"
                                            Classes="primary"/>
                                </StackPanel>

                                            <TextBlock Text="{Binding VersionActionMessage}"
                                                       TextWrapping="Wrap"
                                                       Opacity="0.9"
                                                       IsVisible="{Binding HasVersionActionMessage}"/>
                                        </StackPanel>

                                        <TextBlock Text="{loc:Tr explorer.select_file_for_version_controls}"
                                                   Opacity="0.75"
                                                   IsVisible="{Binding HasNoSelectedItem}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Border>

            <Border IsVisible="{Binding IsDiffPreviewMenuOpen}"
                    Classes="overlay-backdrop"
                    Padding="22">
                <Border Classes="dialog-shell" Padding="14" CornerRadius="16" BorderBrush="#2E506B">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{loc:Tr explorer.diff_preview}" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Classes="muted" Text="{Binding DiffPreviewTitle}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="{loc:Tr common.close}"
                                    Command="{Binding CloseDiffPreviewMenuCommand}"
                                    Classes="subtle"/>
                        </Grid>

                        <TextBlock Grid.Row="1" Text="{Binding DiffPreviewSummary}" Opacity="0.84" TextWrapping="Wrap"/>

                        <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="8">
                            <TextBlock Grid.Row="0"
                                       Text="{loc:Tr compare.building_preview}"
                                       Opacity="0.75"
                                       IsVisible="{Binding IsDiffPreviewLoading}"/>

                            <Grid Grid.Row="1"
                                  RowDefinitions="Auto,*"
                                  RowSpacing="8"
                                  IsVisible="{Binding HasDiffPreviewRows}">
                                <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
                                    <Border Grid.Column="0" Background="#1F4A3A" CornerRadius="8" Padding="8,4">
                                        <TextBlock Text="{loc:Tr diff.added}" Foreground="#98FFD2" FontWeight="SemiBold" FontSize="11"/>
                                    </Border>
                                    <Border Grid.Column="1" Background="#4A2530" CornerRadius="8" Padding="8,4">
                                        <TextBlock Text="{loc:Tr diff.removed}" Foreground="#FFB1BC" FontWeight="SemiBold" FontSize="11"/>
                                    </Border>
                                    <Border Grid.Column="2" Background="#213B5A" CornerRadius="8" Padding="8,4">
                                        <TextBlock Text="{loc:Tr diff.context}" Foreground="#C2D9F3" FontWeight="SemiBold" FontSize="11"/>
                                    </Border>
                                </Grid>

                                <Border Grid.Row="1" Classes="panel" Padding="10" BorderBrush="#2D465A">
                                    <Grid RowDefinitions="Auto,*" RowSpacing="8">
                                        <Grid Grid.Row="0" ColumnDefinitions="*,*" ColumnSpacing="8">
                                            <Border Grid.Column="0" Background="#1E3858" CornerRadius="8" Padding="8,4">
                                                <TextBlock Text="{loc:Tr common.before}" FontWeight="SemiBold"/>
                                            </Border>
                                            <Border Grid.Column="1" Background="#1E3858" CornerRadius="8" Padding="8,4">
                                                <TextBlock Text="{loc:Tr common.after}" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>

                                        <ScrollViewer Grid.Row="1"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding DiffPreviewRows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="explorer:DiffPreviewRowViewModel">
                                                        <StackPanel Spacing="4" Margin="0,0,0,4">
                                                            <Border IsVisible="{Binding IsHunkHeader}"
                                                                    Background="#1A3654"
                                                                    BorderBrush="#4A78A8"
                                                                    BorderThickness="1"
                                                                    CornerRadius="8"
                                                                    Padding="8,4">
                                                                <TextBlock Text="{Binding HunkHeader}"
                                                                           FontFamily="Cascadia Code,Consolas,Monospace"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#A8D1FF"/>
                                                            </Border>

                                                            <Grid IsVisible="{Binding IsContentRow}" ColumnDefinitions="*,*" ColumnSpacing="8">
                                                                <Border Grid.Column="0" Background="{Binding LeftBackground}" CornerRadius="6" Padding="8,4">
                                                                    <Grid ColumnDefinitions="58,18,*" ColumnSpacing="6">
                                                                        <TextBlock Grid.Column="0"
                                                                                   Text="{Binding LeftLineNumber}"
                                                                                   Foreground="#A4BEDA"
                                                                                   FontFamily="Cascadia Code,Consolas,Monospace"
                                                                                   FontSize="12"/>
                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{Binding LeftMarker}"
                                                                                   Foreground="{Binding LeftMarkerForeground}"
                                                                                   FontWeight="Bold"
                                                                                   FontFamily="Cascadia Code,Consolas,Monospace"
                                                                                   FontSize="12"/>
                                                                        <TextBlock Grid.Column="2"
                                                                                   Text="{Binding LeftText}"
                                                                                   FontFamily="Cascadia Code,Consolas,Monospace"
                                                                                   FontSize="12"
                                                                                   TextWrapping="NoWrap"/>
                                                                    </Grid>
                                                                </Border>

                                                                <Border Grid.Column="1" Background="{Binding RightBackground}" CornerRadius="6" Padding="8,4">
                                                                    <Grid ColumnDefinitions="58,18,*" ColumnSpacing="6">
                                                                        <TextBlock Grid.Column="0"
                                                                                   Text="{Binding RightLineNumber}"
                                                                                   Foreground="#A4BEDA"
                                                                                   FontFamily="Cascadia Code,Consolas,Monospace"
                                                                                   FontSize="12"/>
                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{Binding RightMarker}"
                                                                                   Foreground="{Binding RightMarkerForeground}"
                                                                                   FontWeight="Bold"
                                                                                   FontFamily="Cascadia Code,Consolas,Monospace"
                                                                                   FontSize="12"/>
                                                                        <TextBlock Grid.Column="2"
                                                                                   Text="{Binding RightText}"
                                                                                   FontFamily="Cascadia Code,Consolas,Monospace"
                                                                                   FontSize="12"
                                                                                   TextWrapping="NoWrap"/>
                                                                    </Grid>
                                                                </Border>
                                                            </Grid>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>

                            <TextBlock Grid.Row="1"
                                       Text="{loc:Tr explorer.diff_data_unavailable}"
                                       Opacity="0.75"
                                       IsVisible="{Binding HasNoDiffPreviewRows}"/>
                        </Grid>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </Grid>
</UserControl>




