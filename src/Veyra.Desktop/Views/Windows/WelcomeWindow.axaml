<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:Veyra.Desktop.ViewModels.Windows"
        x:Class="Veyra.Desktop.Views.Windows.WelcomeWindow"
        Width="1040" Height="620"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F14"
        Title="VeyraFlow — Welcome"
        d:DataContext="{d:DesignInstance vm:WelcomeWindowViewModel, IsDesignTimeCreatable=True}"
        x:DataType="vm:WelcomeWindowViewModel">

    <Border Background="#0B0F14" Padding="18">
        <Border Background="#0F141A" CornerRadius="16" BorderBrush="#22303D" BorderThickness="1" Padding="8">
            <ContentControl Content="{Binding CurrentPage}"/>
        </Border>
    </Border>
</Window>
