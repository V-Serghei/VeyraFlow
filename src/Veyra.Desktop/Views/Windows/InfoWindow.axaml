<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Veyra.Desktop.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:Veyra.Desktop.ViewModels.Windows"
        x:Class="Veyra.Desktop.Views.Windows.InfoWindow"
        Width="700" Height="470"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#0F1116"
        Title="{loc:Tr info.window_title}"
        d:DataContext="{d:DesignInstance vm:InfoWindowViewModel, IsDesignTimeCreatable=True}"
        x:DataType="vm:InfoWindowViewModel">
    <Border Padding="20" Background="#0F1116">
        <Border Background="#141922" CornerRadius="14" Padding="20" BorderBrush="#253246" BorderThickness="1">
            <ScrollViewer>
                <StackPanel Spacing="12">
                    <TextBlock Text="{loc:Tr app.brand}" FontSize="28" FontWeight="SemiBold" Foreground="#7DD3FC"/>
                    <TextBlock Text="{loc:Tr info.subtitle}" FontSize="16" Opacity="0.82"/>
                    <TextBlock Text="{loc:Tr info.description_body}" TextWrapping="Wrap"/>
                    <TextBlock Text="{loc:Tr info.feature_scan_modes}"/>
                    <TextBlock Text="{loc:Tr info.feature_snapshot_history}"/>
                    <TextBlock Text="{loc:Tr info.feature_sqlite}"/>
                    <TextBlock Text="{loc:Tr info.feature_arch}"/>
                    <Button Content="{loc:Tr common.close}" HorizontalAlignment="Right" Width="120" IsDefault="True"
                            Command="{Binding CloseCommand}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Border>
</Window>
