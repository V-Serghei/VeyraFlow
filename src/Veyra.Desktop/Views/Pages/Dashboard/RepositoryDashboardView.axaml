<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Veyra.Desktop.ViewModels.Pages.Dashboard"
             xmlns:conv="clr-namespace:Veyra.Desktop.Converters"
             x:Class="Veyra.Desktop.Views.Pages.Dashboard.RepositoryDashboardView"
             x:Name="Root"
             x:DataType="vm:RepositoryDashboardViewModel"
             Background="#0D0D0D">

    <Grid ColumnDefinitions="240,*">
        <Border Grid.Column="0" Background="#0D0D0D" Padding="12,16" BorderBrush="#1A1A1A" BorderThickness="0,0,1,0">
            <DockPanel>
                <Button DockPanel.Dock="Top"
                        Content="+ Create Repository"
                        HorizontalAlignment="Stretch"
                        Padding="12,10"
                        Command="{Binding AddRepositoryCommand}"
                        Margin="0,0,0,16"/>

                <TextBlock DockPanel.Dock="Top"
                           Text="REPOSITORIES"
                           FontSize="10" Foreground="#666666"
                           FontWeight="SemiBold"
                           Margin="8,0,0,8"
                           LetterSpacing="1"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Repositories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RepositoryCardViewModel">
                                <Border Background="#151515" CornerRadius="8" Padding="8" Margin="0,0,0,6">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Command="{Binding #Root.((vm:RepositoryDashboardViewModel)DataContext).OpenRepositoryCommand}"
                                                CommandParameter="{Binding .}">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding ShortPath}" FontSize="10" Opacity="0.65"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Content="Settings" Padding="8,4"
                                                Command="{Binding #Root.((vm:RepositoryDashboardViewModel)DataContext).OpenRepositorySettingsCommand}"
                                                CommandParameter="{Binding .}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="1" Background="#0D0D0D">
            <Border DockPanel.Dock="Top" Padding="20,14" BorderBrush="#1A1A1A" BorderThickness="0,0,0,1">
                <TextBox Text="{Binding SearchQuery, Mode=TwoWay}" Watermark="Search by name or path..."/>
            </Border>

            <TextBlock DockPanel.Dock="Top" Margin="20,8,20,0"
                       Text="{Binding ErrorMessage}" Foreground="#F87171"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>

            <ScrollViewer Padding="20,16" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Repositories}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RepositoryCardViewModel">
                            <Border Width="340" MinHeight="220" Margin="0,0,14,14"
                                    Background="#141414" CornerRadius="12" Padding="14">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <Button Background="Transparent" BorderThickness="0" Padding="0"
                                                    HorizontalAlignment="Left"
                                                    Command="{Binding #Root.((vm:RepositoryDashboardViewModel)DataContext).OpenRepositoryCommand}"
                                                    CommandParameter="{Binding .}">
                                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
                                            </Button>
                                            <TextBlock Text="{Binding DirectoryPath}" FontSize="11" Opacity="0.65"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding LastActivity}" FontSize="11" Opacity="0.75"/>
                                                <TextBlock Text="|" Opacity="0.4"/>
                                                <TextBlock Text="{Binding StatusText}" FontSize="11" Opacity="0.85"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Settings" Padding="8,4"
                                                Command="{Binding #Root.((vm:RepositoryDashboardViewModel)DataContext).OpenRepositorySettingsCommand}"
                                                CommandParameter="{Binding .}"/>
                                    </Grid>

                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="18" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding FileCount}" FontSize="24" Foreground="#8B5CF6" FontWeight="Bold"/>
                                            <TextBlock Text="Files" FontSize="11" Opacity="0.65"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding VersionCount}" FontSize="24" Foreground="#3B82F6" FontWeight="Bold"/>
                                            <TextBlock Text="Versions" FontSize="11" Opacity="0.65"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding SizeDisplay}" FontSize="24" Foreground="#10B981" FontWeight="Bold"/>
                                            <TextBlock Text="Size" FontSize="11" Opacity="0.65"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding LinkedFormats}" Margin="0,0,0,10">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border Background="#1E1E1E" CornerRadius="6" Padding="8,3" Margin="0,0,4,4">
                                                    <TextBlock Text="{Binding .}" FontSize="11" Opacity="0.85"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8">
                                        <Button Content="Open" Padding="10,6"
                                                Command="{Binding #Root.((vm:RepositoryDashboardViewModel)DataContext).OpenRepositoryCommand}"
                                                CommandParameter="{Binding .}"/>
                                        <Button Content="Delete" Padding="10,6" Foreground="#F87171"
                                                Command="{Binding #Root.((vm:RepositoryDashboardViewModel)DataContext).DeleteRepositoryCommand}"
                                                CommandParameter="{Binding .}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <TextBlock Text="No repositories yet" FontSize="18" Opacity="0.7" HorizontalAlignment="Center"/>
                <TextBlock Text="Create your first repository to start tracking versions." Opacity="0.55"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>

