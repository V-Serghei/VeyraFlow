<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Veyra.Desktop.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Veyra.Desktop.ViewModels.Pages.WelcomeWindow"
             x:Class="Veyra.Desktop.Views.Pages.WelcomeWindow.WelcomeIntroView"
             d:DataContext="{d:DesignInstance vm:WelcomeIntroViewModel, IsDesignTimeCreatable=True}"
             x:DataType="vm:WelcomeIntroViewModel">

    <Grid ColumnDefinitions="*,420" Margin="24">
        <Border Grid.Column="0" Background="#111821" CornerRadius="14" Padding="26" Margin="0,0,16,0">
            <StackPanel Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="{loc:Tr app.brand}" FontSize="38" FontWeight="Bold" Foreground="#7DD3FC"/>
                <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Subtitle}" Opacity="0.82" TextWrapping="Wrap" MaxWidth="520"/>

                <Border Background="#142332" CornerRadius="10" Padding="14" Margin="0,8,0,0">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{loc:Tr welcome.what_works}" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:Tr welcome.feature_repo}"/>
                        <TextBlock Text="{loc:Tr welcome.feature_scan}"/>
                        <TextBlock Text="{loc:Tr welcome.feature_history}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Background="#131313" CornerRadius="14" Padding="24">
            <StackPanel Spacing="14" VerticalAlignment="Center">
                <TextBlock Text="{loc:Tr welcome.get_started}" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="{loc:Tr welcome.get_started_hint}" Opacity="0.75" TextWrapping="Wrap"/>

                <Button Content="{loc:Tr welcome.start}" Height="40" Command="{Binding StartCommand}"/>
                <Button Content="{loc:Tr welcome.about}" Height="40" Command="{Binding LearnMoreCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
