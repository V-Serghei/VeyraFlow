<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Veyra.Desktop.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Veyra.Desktop.ViewModels.Pages.Dashboard"
             xmlns:conv="clr-namespace:Veyra.Desktop.Converters"
             x:Class="Veyra.Desktop.Views.Pages.Dashboard.RepositoryDashboardView"
             x:Name="Root"
             x:DataType="vm:RepositoryDashboardViewModel"
             Background="{DynamicResource VeyraCanvasBrush}">

    <Grid>
        <Grid ColumnDefinitions="272,6,*" ColumnSpacing="0" Margin="16">
            <Border Grid.Column="0" Classes="sidebar" Padding="16,18">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="14">
                <StackPanel Grid.Row="0" Spacing="4">
                    <TextBlock Text="{loc:Tr dashboard.repositories_label}" Classes="section-title"/>
                    <TextBlock Text="{Binding RepositoryResultsSummary}" Classes="muted" FontSize="12"/>
                </StackPanel>

                <Button x:Name="DashboardCreateRepositoryButton"
                        Grid.Row="1"
                        Content="{loc:Tr dashboard.create_repository}"
                        HorizontalAlignment="Stretch"
                        Padding="12,11"
                        Command="{Binding AddRepositoryCommand}"
                        Classes="primary"/>

                <ListBox Grid.Row="2"
                         Classes="clean-list passive-list"
                         ItemsSource="{Binding Repositories}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:RepositoryCardViewModel">
                                <Border Classes="card" Padding="10,10,10,12" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                                        <Button Grid.Row="0" Grid.Column="0"
                                                Classes="ghost"
                                                Padding="0"
                                                HorizontalAlignment="Left"
                                                HorizontalContentAlignment="Left"
                                                Command="{Binding #Root.((vm:RepositoryDashboardViewModel)DataContext).OpenRepositoryCommand}"
                                                CommandParameter="{Binding .}">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"/>
                                        </Button>

                                        <Button Grid.Row="0" Grid.Column="1"
                                                Content="{loc:Tr common.settings}"
                                                Padding="10,6"
                                                Classes="subtle"
                                                Command="{Binding #Root.((vm:RepositoryDashboardViewModel)DataContext).OpenRepositorySettingsCommand}"
                                                CommandParameter="{Binding .}"/>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="4">
                                            <TextBlock Text="{Binding ShortPath}"
                                                       FontSize="11"
                                                       Classes="muted"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Classes="badge" Padding="8,3">
                                                    <TextBlock Text="{Binding StatusText}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding StatusColor}"/>
                                                </Border>
                                                <TextBlock Text="{Binding LastActivity}" FontSize="11" Classes="muted" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"/>

            <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*" RowSpacing="8" Margin="12,0,0,0">
                <Border Grid.Row="0" Classes="toolbar" Padding="14,12">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBox x:Name="DashboardSearchBox"
                                 Grid.Column="0"
                                 Classes="compact"
                                 Text="{Binding SearchQuery, Mode=TwoWay}"
                                 Watermark="{loc:Tr dashboard.search_placeholder}"
                                 ToolTip.Tip="{loc:Tr dashboard.search_tokens_hint}"/>

                        <Border Grid.Column="1"
                                Classes="badge warning"
                                Padding="9,7"
                                VerticalAlignment="Center"
                                IsVisible="{Binding ShowConnectivityPanel}"
                                ToolTip.Tip="{Binding ConnectivityPanelDetail}">
                            <TextBlock Text="&#xE783;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       Foreground="{Binding ConnectivityPanelAccentColor}"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <Button Grid.Column="2"
                                Classes="subtle"
                                Padding="12,7"
                                Command="{Binding ToggleAdvancedFiltersCommand}"
                                ToolTip.Tip="{loc:Tr dashboard.toggle_filters}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="&#xE71C;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding FilterButtonLabel}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Text="{Binding RepositoryResultsSummary}"
                               Classes="muted"
                               FontSize="11"/>
                </Grid>
                </Border>

                <TextBlock Grid.Row="1"
                           Margin="8,0,8,0"
                           Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource VeyraDangerBrush}"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="{Binding IsAdvancedFiltersVisible, Converter={x:Static conv:BooleanToGridLengthConverter.Instance}, ConverterParameter=6}"/>
                        <ColumnDefinition Width="{Binding IsAdvancedFiltersVisible, Converter={x:Static conv:BooleanToGridLengthConverter.Instance}, ConverterParameter=336}"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" Padding="6,6,6,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="14">
                    <ItemsControl ItemsSource="{Binding Repositories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RepositoryCardViewModel">
                                <Border Width="348" MinHeight="310" Margin="0,0,14,14" Classes="card" Padding="16">
                                    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
                                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <StackPanel Spacing="6">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Border Classes="badge" Padding="8,3">
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding StatusColor}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding LastActivity}" Classes="muted" VerticalAlignment="Center" FontSize="11"/>
                                                </StackPanel>

                                                <Button Classes="ghost"
                                                        Padding="0"
                                                        HorizontalAlignment="Left"
                                                        HorizontalContentAlignment="Left"
                                                        Command="{Binding #Root.((vm:RepositoryDashboardViewModel)DataContext).OpenRepositoryCommand}"
                                                        CommandParameter="{Binding .}">
                                                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"/>
                                                </Button>

                                                <TextBlock Text="{Binding DirectoryPath}"
                                                           FontSize="11"
                                                           Classes="muted"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Content="{loc:Tr common.settings}"
                                                    Padding="10,6"
                                                    Classes="subtle"
                                                    VerticalAlignment="Top"
                                                    Command="{Binding #Root.((vm:RepositoryDashboardViewModel)DataContext).OpenRepositorySettingsCommand}"
                                                    CommandParameter="{Binding .}"/>
                                        </Grid>

                                        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="10">
                                            <Border Grid.Column="0" Classes="metric-card">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{Binding FileCount}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource VeyraAccentStrongBrush}"/>
                                                    <TextBlock Text="{loc:Tr dashboard.files}" Classes="caption"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="1" Classes="metric-card">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{Binding VersionCount}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource VeyraAccentBrush}"/>
                                                    <TextBlock Text="{loc:Tr dashboard.versions}" Classes="caption"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="2" Classes="metric-card">
                                                <StackPanel Spacing="4">
                                                <TextBlock Text="{Binding SizeDisplay}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource VeyraSuccessBrush}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{loc:Tr common.size}" Classes="caption"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <Border Grid.Row="2"
                                                Classes="metric-card"
                                                IsVisible="{Binding ShowCloudSection}"
                                                Background="{Binding CloudModeBackgroundColor}"
                                                BorderBrush="{Binding CloudModeBorderColor}">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="{loc:Tr dashboard.cloud_sync}" FontWeight="SemiBold" FontSize="12"/>
                                                <Border Classes="badge"
                                                        Padding="8,3"
                                                        HorizontalAlignment="Left"
                                                        BorderBrush="{Binding CloudModeBorderColor}">
                                                    <TextBlock Text="{Binding CloudModeText}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding CloudModeColor}"/>
                                                </Border>
                                                <TextBlock Text="{Binding CloudSyncStatus}" FontSize="12"/>
                                                <TextBlock Text="{Binding CloudQueueSummary}"
                                                           FontSize="11"
                                                           Classes="muted"
                                                           TextWrapping="Wrap"
                                                           IsVisible="{Binding CloudQueueSummary, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Grid.Row="3" Spacing="8">
                                            <TextBlock Text="{loc:Tr dashboard.formats_label}" Classes="label"/>
                                            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                                          VerticalScrollBarVisibility="Auto"
                                                          MaxHeight="84">
                                                <ItemsControl ItemsSource="{Binding LinkedFormats}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <Border Classes="chip" Padding="8,4" Margin="0,0,6,6">
                                                                <TextBlock Text="{Binding .}" FontSize="11" Opacity="0.9"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>

                                        <Grid Grid.Row="4" ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Bottom">
                                            <Button Grid.Column="0"
                                                    Content="{loc:Tr common.open}"
                                                    Padding="12,7"
                                                    Command="{Binding #Root.((vm:RepositoryDashboardViewModel)DataContext).OpenRepositoryCommand}"
                                                    CommandParameter="{Binding .}"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel IsVisible="{Binding IsEmpty}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8"
                                Margin="0,40,0,0">
                        <TextBlock Text="{loc:Tr dashboard.no_repositories}"
                                   FontSize="18"
                                   Opacity="0.8"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{loc:Tr dashboard.no_repositories_hint}"
                                   Classes="muted"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <GridSplitter Grid.Column="1"
                                  Width="6"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  ResizeDirection="Columns"
                                  ResizeBehavior="PreviousAndNext"
                                  IsVisible="{Binding IsAdvancedFiltersVisible}"/>

                    <Border Grid.Column="2"
                            Classes="filter-sheet"
                            Padding="14,14,14,10"
                            IsVisible="{Binding IsAdvancedFiltersVisible}">
                        <Grid RowDefinitions="Auto,*" RowSpacing="12">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{loc:Tr dashboard.advanced_filters}" Classes="section-title"/>
                                    <TextBlock Text="{loc:Tr dashboard.filters_hint}" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="{loc:Tr dashboard.clear_filters}"
                                        Command="{Binding ClearAdvancedFiltersCommand}"
                                        Classes="subtle compact"
                                        VerticalAlignment="Top"/>

                                <Button Grid.Column="2"
                                        Command="{Binding ToggleAdvancedFiltersCommand}"
                                        Classes="subtle icon compact"
                                        Content="&#xE711;"
                                        ToolTip.Tip="{loc:Tr common.close}"
                                        VerticalAlignment="Top"/>
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="14">
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="{loc:Tr dashboard.filter_availability}" Classes="label"/>
                                            <ComboBox Classes="compact"
                                                      ItemsSource="{Binding AvailabilityFilters}"
                                                      SelectedItem="{Binding SelectedAvailabilityFilter, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <TextBlock Text="{Binding ., Converter={x:Static conv:LocalizedOptionTextConverter.Instance}, ConverterParameter=dashboard.availability}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="{loc:Tr dashboard.filter_sync_state}" Classes="label"/>
                                            <ComboBox Classes="compact"
                                                      ItemsSource="{Binding SyncStateFilters}"
                                                      SelectedItem="{Binding SelectedSyncStateFilter, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <TextBlock Text="{Binding ., Converter={x:Static conv:LocalizedOptionTextConverter.Instance}, ConverterParameter=dashboard.sync_state}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{loc:Tr dashboard.filter_format_tag}" Classes="label"/>
                                        <ComboBox Classes="compact"
                                                  ItemsSource="{Binding FormatTagFilters}"
                                                  SelectedItem="{Binding SelectedFormatTagFilter, Mode=TwoWay}"/>
                                    </StackPanel>

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="{loc:Tr dashboard.filter_min_size_mb}" Classes="label"/>
                                            <TextBox Classes="compact" Text="{Binding MinSizeMb, Mode=TwoWay}" Watermark="0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="{loc:Tr dashboard.filter_max_size_mb}" Classes="label"/>
                                            <TextBox Classes="compact" Text="{Binding MaxSizeMb, Mode=TwoWay}" Watermark="0"/>
                                        </StackPanel>
                                    </Grid>

                                    <CheckBox Content="{loc:Tr dashboard.queue_issues_only}"
                                              IsChecked="{Binding OnlyQueueIssues, Mode=TwoWay}"/>

                                    <Border Classes="metric-card">
                                        <StackPanel Spacing="10">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{loc:Tr dashboard.saved_filters}" Classes="section-title"/>
                                                <TextBlock Text="{loc:Tr dashboard.saved_filters_hint}" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <TextBox Classes="compact"
                                                     Text="{Binding SavedFilterName, Mode=TwoWay}"
                                                     Watermark="{loc:Tr dashboard.saved_filter_name}"/>

                                            <Button Content="{loc:Tr dashboard.save_filter}"
                                                    Command="{Binding SaveCurrentFilterCommand}"
                                                    Classes="compact"/>

                                            <ComboBox Classes="compact"
                                                      ItemsSource="{Binding SavedFilters}"
                                                      SelectedItem="{Binding SelectedSavedFilter, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:RepositoryDashboardSavedFilterViewModel">
                                                        <TextBlock Text="{Binding Name}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                                <Button Grid.Column="0"
                                                        Content="{loc:Tr common.apply}"
                                                        Command="{Binding ApplySavedFilterCommand}"
                                                        CommandParameter="{Binding SelectedSavedFilter}"
                                                        Classes="compact"/>
                                                <Button Grid.Column="1"
                                                        Content="{loc:Tr common.delete}"
                                                        Classes="danger compact"
                                                        Command="{Binding DeleteSavedFilterCommand}"
                                                        CommandParameter="{Binding SelectedSavedFilter}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Border Classes="loading-overlay"
                IsVisible="{Binding ShowLoadingOverlay}">
            <Border Classes="loading-card"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="320"
                    MaxWidth="420">
                <StackPanel Classes="loading-state">
                    <TextBlock Text="{Binding LoadingOverlayTitle}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding LoadingOverlayDetail}" Classes="muted" TextWrapping="Wrap"/>
                    <ProgressBar Classes="loading-progress" IsIndeterminate="True"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
