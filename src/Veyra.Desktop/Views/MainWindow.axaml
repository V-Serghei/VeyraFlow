<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:windows="clr-namespace:Veyra.Desktop.ViewModels.Windows"
        mc:Ignorable="d"
        x:Class="Veyra.Desktop.Views.MainWindow"
        x:DataType="windows:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="VeyraFlow — Версионный Проводник"
        Width="1280" Height="820"
        MinWidth="980" MinHeight="640"
        Background="#0D0D0D" Foreground="#EEEEEE"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="18,12" Background="#0A0A0A" BorderBrush="#1A1A1A" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="◈" FontSize="18" Foreground="#3B82F6" VerticalAlignment="Center"/>
                    <TextBlock Text="Версионный Проводник" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Column="1" VerticalAlignment="Center" Opacity="0.6"
                           Text="VeyraFlow Desktop" HorizontalAlignment="Center"/>

                <Button Grid.Column="2" Content="⚙" Width="38" Height="34"
                        Command="{Binding OpenGlobalSettingsCommand}"/>
            </Grid>
        </Border>

        <ContentControl Content="{Binding CurrentPage}"/>
    </DockPanel>
</Window>
