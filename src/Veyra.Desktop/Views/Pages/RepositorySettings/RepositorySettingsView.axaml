<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:settings="clr-namespace:Veyra.Desktop.ViewModels.Pages.RepositorySettings"
             xmlns:conv="clr-namespace:Veyra.Desktop.Converters"
             x:Class="Veyra.Desktop.Views.Pages.RepositorySettings.RepositorySettingsView"
             x:Name="Root"
             x:DataType="settings:RepositorySettingsViewModel"
             Background="{DynamicResource VeyraCanvasBrush}">

    <DockPanel Margin="24,20">
        <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Back" Command="{Binding BackCommand}" Padding="12,8" Classes="subtle"/>
                <TextBlock Text="Repository settings" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource VeyraDangerBrush}"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="Delete" Command="{Binding DeleteCommand}" Foreground="{DynamicResource VeyraDangerBrush}" Classes="subtle"/>
            <Button Content="Save" Command="{Binding SaveCommand}" Classes="primary"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="900" Spacing="14">
                <TextBlock Text="Repository name" Opacity="0.8"/>
                <TextBox Text="{Binding RepositoryName, Mode=TwoWay}"/>

                <TextBlock Text="Description" Opacity="0.8"/>
                <TextBox Text="{Binding Description, Mode=TwoWay}" Height="90" AcceptsReturn="True"/>

                <TextBlock Text="Directory path" Opacity="0.8"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Grid.Column="0" Text="{Binding DirectoryPath, Mode=TwoWay}"/>
                    <Button Grid.Column="1" Content="Browse" Command="{Binding BrowseDirectoryCommand}"/>
                </Grid>

                <Border Height="1" Background="{DynamicResource VeyraBorderSoftBrush}" Margin="0,8"/>

                <TextBlock Text="Tracked formats" FontSize="14" FontWeight="SemiBold"/>
                <ItemsControl ItemsSource="{Binding SelectedFormats}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Border Classes="card" Padding="10,5" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding .}"/>
                                    <Button Content="x" Padding="2" FontSize="10"
                                            Command="{Binding #Root.((settings:RepositorySettingsViewModel)DataContext).RemoveFormatCommand}"
                                            CommandParameter="{Binding .}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Available formats" Opacity="0.8"/>
                <ItemsControl ItemsSource="{Binding AvailableFormats}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Button Content="{Binding .}" Margin="0,0,6,6"
                                    Command="{Binding #Root.((settings:RepositorySettingsViewModel)DataContext).AddAvailableFormatCommand}"
                                    CommandParameter="{Binding .}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Add custom format" Opacity="0.8"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Grid.Column="0" Text="{Binding CustomFormat, Mode=TwoWay}" Watermark="example: .sql"/>
                    <Button Grid.Column="1" Content="Add" Command="{Binding AddCustomFormatCommand}"/>
                </Grid>

                <Border Height="1" Background="{DynamicResource VeyraBorderSoftBrush}" Margin="0,8"/>

                <TextBlock Text="Cloud sync" FontSize="16" FontWeight="SemiBold"/>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock Text="Conflict strategy" Opacity="0.8"/>
                        <ComboBox ItemsSource="{Binding SyncConflictStrategies}"
                                  SelectedItem="{Binding SyncConflictStrategy, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding .}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="Sync status" Opacity="0.8"/>
                        <TextBlock Text="{Binding CloudSyncStatusText}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock Text="Retry max attempts" Opacity="0.8"/>
                        <TextBox Text="{Binding SyncRetryMaxAttempts, Mode=TwoWay}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="Retry base delay (sec)" Opacity="0.8"/>
                        <TextBox Text="{Binding SyncRetryBaseDelaySeconds, Mode=TwoWay}"/>
                    </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="Last successful sync" Opacity="0.7"/>
                        <TextBlock Text="{Binding CloudSyncLastSyncText}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="Queue" Opacity="0.7"/>
                        <TextBlock Text="{Binding CloudSyncQueueText}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding CloudSyncErrorText}" Foreground="{DynamicResource VeyraWarningBrush}" TextWrapping="Wrap"
                           IsVisible="{Binding CloudSyncErrorText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Sync now"
                            Command="{Binding SyncNowCommand}"
                            IsEnabled="{Binding IsSyncNowRunning, Converter={x:Static conv:BoolInvertConverter.Instance}}"
                            Classes="primary"/>
                    <TextBlock Text="Running..." VerticalAlignment="Center"
                               IsVisible="{Binding IsSyncNowRunning}"/>
                </StackPanel>

                <Border Height="1" Background="{DynamicResource VeyraBorderSoftBrush}" Margin="0,8"/>

                <TextBlock Text="Repository bundle" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Export current repository data or import a bundle into another folder."
                           Opacity="0.8"
                           TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Export bundle"
                            Command="{Binding ExportBundleCommand}"
                            IsEnabled="{Binding CanRunBundleOperations}"
                            Classes="subtle"/>
                    <Button Content="Import bundle"
                            Command="{Binding ImportBundleCommand}"
                            IsEnabled="{Binding CanRunBundleOperations}"
                            Classes="subtle"/>
                    <TextBlock Text="Working..." VerticalAlignment="Center"
                               IsVisible="{Binding IsBundleOperationRunning}"/>
                </StackPanel>

                <TextBlock Text="{Binding BundleOperationMessage}"
                           Foreground="#93C5FD"
                           TextWrapping="Wrap"
                           IsVisible="{Binding HasBundleOperationMessage}"/>

                <Border Height="1" Background="{DynamicResource VeyraBorderSoftBrush}" Margin="0,8"/>
                <TextBlock Text="Retention policy" FontSize="16" FontWeight="SemiBold"/>
                <CheckBox Content="Enable retention for this repository"
                          IsChecked="{Binding RetentionEnabled, Mode=TwoWay}"/>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock Text="Max age (days)" Opacity="0.8"/>
                        <TextBox Text="{Binding RetentionMaxAgeDays, Mode=TwoWay}" Watermark="example: 30"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="Max snapshots" Opacity="0.8"/>
                        <TextBox Text="{Binding RetentionMaxSnapshots, Mode=TwoWay}" Watermark="example: 200"/>
                    </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock Text="Max total size (MB)" Opacity="0.8"/>
                        <TextBox Text="{Binding RetentionMaxTotalSizeMb, Mode=TwoWay}" Watermark="example: 2048"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="Run interval (minutes)" Opacity="0.8"/>
                        <TextBox Text="{Binding RetentionRunIntervalMinutes, Mode=TwoWay}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Trigger filter (comma-separated)" Opacity="0.8"/>
                <TextBox Text="{Binding RetentionTriggerFilter, Mode=TwoWay}" Watermark="manual_snapshot, sync_live_watcher"/>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="Last run" Opacity="0.7"/>
                        <TextBlock Text="{Binding RetentionLastRunText}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="Last status" Opacity="0.7"/>
                        <TextBlock Text="{Binding RetentionLastStatusText}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Dry run" Command="{Binding RunRetentionDryRunCommand}"/>
                    <Button Content="Apply retention" Command="{Binding RunRetentionApplyCommand}"/>
                    <Button Content="Cancel" Command="{Binding CancelRetentionCommand}"/>
                </StackPanel>

                <TextBlock Text="{Binding RetentionProgressText}" Opacity="0.8"
                           IsVisible="{Binding RetentionProgressText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
                <TextBlock Text="{Binding RetentionResultText}" Foreground="#93C5FD" TextWrapping="Wrap"
                           IsVisible="{Binding RetentionResultText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>

