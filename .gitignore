## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# Others
~$*
*~
CodeCoverage/
.codex-temp/
docs/defense/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Rust
native/veyra_core/target/
#native/veyra_core/Cargo.lock
**/*.rs.bk
*.pdb

# Go
tools/sync-agent/sync-agent
tools/sync-agent/sync-agent.exe

# IDE
.idea/
.vscode/
*.swp
*.swo

# Native libraries (build artifacts, not source)
src/Veyra.Desktop/runtimes/*/native/*.so
src/Veyra.Desktop/runtimes/*/native/*.dll
src/Veyra.Desktop/runtimes/*/native/*.dylib

# SQLite databases
*.db
*.db-shm
*.db-wal

# Generated files
*.g.cs


.env
**/.env
*.env
*.env.*
!.env.example


# Local dotnet and nuget caches
.dotnet_home2/
**/.dotnet_home2/
.nuget/
**/.nuget/
.dotnet/
**/.dotnet/

# SDK advertising / temp
**/sdk-advertising/
**/workloadAdvertising*/
**/useSharedDesignerContext.txt
**/workloadVersion.txt

# User and IDE files
*.user
*.suo
*.userprefs

*.log
