<UserControl
    x:Class="Veyra.Desktop.Views.Pages.AuthWindow.LoginView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Veyra.Desktop.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:vm="clr-namespace:Veyra.Desktop.ViewModels.Pages.AuthWindow"
    xmlns:conv="clr-namespace:Veyra.Desktop.Converters"
    d:DataContext="{d:DesignInstance vm:LoginViewModel, IsDesignTimeCreatable=True}"
    x:DataType="vm:LoginViewModel"
    Background="{DynamicResource VeyraCanvasBrush}">

    <Grid>
        <Border MaxWidth="980"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Classes="dialog-shell"
                Padding="18">
            <Grid ColumnDefinitions="1.1*,14,0.9*" ColumnSpacing="0">
                <Border Grid.Column="0" Classes="dialog-hero" Padding="28" Margin="0,0,14,0">
                    <StackPanel Spacing="14" VerticalAlignment="Center">
                        <Border Classes="badge" HorizontalAlignment="Left">
                            <TextBlock Text="{loc:Tr app.brand}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource VeyraAccentBrush}"/>
                        </Border>

                        <TextBlock Text="{Binding ActionTitle}" Classes="h1" TextWrapping="Wrap"/>
                        <TextBlock Text="{loc:Tr auth.subtitle}" Classes="muted" TextWrapping="Wrap"/>

                        <Border Classes="card" Padding="14" Margin="0,8,0,0">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{loc:Tr welcome.what_works}" Classes="label"/>
                                <TextBlock Text="{loc:Tr welcome.feature_repo}" TextWrapping="Wrap"/>
                                <TextBlock Text="{loc:Tr welcome.feature_scan}" TextWrapping="Wrap"/>
                                <TextBlock Text="{loc:Tr welcome.feature_history}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <GridSplitter Grid.Column="1"
                              Width="14"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext"/>

                <Border Grid.Column="2" Classes="card" Padding="24" MinWidth="320">
                    <StackPanel Spacing="14" VerticalAlignment="Center">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding ActionTitle}" Classes="h2"/>
                            <TextBlock Text="{loc:Tr auth.subtitle}" Classes="muted" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Spacing="6" Margin="0,8,0,0">
                            <TextBlock Text="{loc:Tr auth.username}" Classes="label"/>
                            <TextBox Text="{Binding Username}" Watermark="{loc:Tr auth.username_placeholder}"/>
                        </StackPanel>

                        <StackPanel Spacing="6" IsVisible="{Binding IsRegisterMode}">
                            <TextBlock Text="{loc:Tr auth.email}" Classes="label"/>
                            <TextBox Text="{Binding Email}" Watermark="{loc:Tr auth.email_placeholder}"/>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="{loc:Tr auth.password}" Classes="label"/>
                            <TextBox Text="{Binding Password, Mode=TwoWay}" PasswordChar="*" Watermark="{loc:Tr auth.password_placeholder}"/>
                        </StackPanel>

                        <StackPanel Spacing="6" IsVisible="{Binding IsRegisterMode}">
                            <TextBlock Text="{loc:Tr auth.confirm_password}" Classes="label"/>
                            <TextBox Text="{Binding ConfirmPassword, Mode=TwoWay}" PasswordChar="*" Watermark="{loc:Tr auth.confirm_password_placeholder}"/>
                        </StackPanel>

                        <Button Content="{loc:Tr auth.sign_in}"
                                Command="{Binding LoginCommand}"
                                IsVisible="{Binding IsRegisterMode, Converter={x:Static conv:BoolInvertConverter.Instance}}"
                                IsEnabled="{Binding IsBusy, Converter={x:Static conv:BoolInvertConverter.Instance}}"
                                Height="40"
                                Classes="primary"/>

                        <Button Content="{loc:Tr auth.register}"
                                Command="{Binding RegisterCommand}"
                                IsVisible="{Binding IsRegisterMode}"
                                IsEnabled="{Binding IsBusy, Converter={x:Static conv:BoolInvertConverter.Instance}}"
                                Height="40"
                                Classes="primary"/>

                        <Button Content="{Binding ToggleLabel}"
                                Command="{Binding ToggleModeCommand}"
                                Classes="subtle"
                                HorizontalAlignment="Left"/>

                        <Border Classes="card"
                                Padding="12"
                                BorderBrush="{DynamicResource VeyraDangerBrush}"
                                Background="{DynamicResource VeyraDiffRemoveBgBrush}"
                                IsVisible="{Binding Error, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Foreground="{DynamicResource VeyraDangerBrush}" Text="{Binding Error}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Classes="loading-overlay"
                IsVisible="{Binding IsBusy}">
            <Border Classes="loading-card"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="360">
                <StackPanel Classes="loading-state">
                    <TextBlock Text="{Binding BusyTitle}" FontSize="18" FontWeight="SemiBold" TextAlignment="Center"/>
                    <TextBlock Text="{Binding BusyDetail}"
                               Classes="muted"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>
                    <ProgressBar Classes="loading-progress" IsIndeterminate="True"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>



