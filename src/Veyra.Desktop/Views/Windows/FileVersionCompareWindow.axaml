<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Veyra.Desktop.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:windows="clr-namespace:Veyra.Desktop.ViewModels.Windows"
        xmlns:explorer="clr-namespace:Veyra.Desktop.ViewModels.Pages.Explorer"
        xmlns:conv="clr-namespace:Veyra.Desktop.Converters"
        mc:Ignorable="d"
        x:Class="Veyra.Desktop.Views.Windows.FileVersionCompareWindow"
        x:Name="Root"
        x:DataType="windows:FileVersionCompareWindowViewModel"
        Width="1280"
        Height="820"
        MinWidth="960"
        MinHeight="620"
        WindowStartupLocation="Manual"
        SystemDecorations="Full"
        CanResize="True"
        Background="{DynamicResource VeyraCanvasBrush}"
        Foreground="{DynamicResource VeyraTextPrimaryBrush}"
        Title="{loc:Tr compare.window_title}">

    <Grid RowDefinitions="Auto,*,Auto" Margin="16" RowSpacing="12">
        <Border Grid.Row="0" Classes="dialog-hero">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                <TextBlock Grid.Row="0"
                           Text="{Binding WindowTitle}"
                           FontSize="28"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Row="1" Text="{Binding InstructionText}" Classes="muted" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid ColumnDefinitions="320,*" ColumnSpacing="12">
                <Border Grid.Column="0" Classes="dialog-shell">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                        <TextBlock Grid.Row="0" Text="{loc:Tr compare.version_history}" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="1" Classes="muted" Text="{loc:Tr compare.selection_instruction}"/>

                        <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="8">
                            <TextBlock Grid.Row="0"
                                       Text="{loc:Tr explorer.loading_versions}"
                                       Classes="muted"
                                       IsVisible="{Binding IsVersionListLoading}"/>

                            <ListBox Grid.Row="1"
                                     Classes="clean-list"
                                     ItemsSource="{Binding Versions}"
                                     IsVisible="{Binding HasVersions}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="windows:FileVersionCompareListItemViewModel">
                                        <Border Classes="list-item"
                                                Background="{Binding CardBackground}"
                                                BorderBrush="{Binding CardBorderBrush}"
                                                PointerPressed="OnVersionItemPointerPressed">
                                            <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                                                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                    <TextBlock Grid.Column="0" Text="{Binding VersionName}" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding CreatedAtDisplay}" Opacity="0.82"/>
                                                    <Border Grid.Column="2"
                                                            Classes="badge"
                                                            Background="{Binding SelectionBadgeBackground}"
                                                            Padding="8,4"
                                                            IsVisible="{Binding HasSelectionBadge}">
                                                        <TextBlock Text="{Binding SelectionBadge}"
                                                                   Foreground="{Binding SelectionBadgeForeground}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="11"/>
                                                    </Border>
                                                </Grid>

                                                <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                    <TextBlock Grid.Column="0" Text="{Binding SizeDisplay}" Classes="muted" FontSize="11"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding StateLabel}" Classes="muted" FontSize="11"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Grid.Row="1"
                                       Text="{loc:Tr explorer.no_versions_for_selected_file}"
                                       Classes="muted"
                                       IsVisible="{Binding HasNoVersions}"/>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Classes="dialog-shell">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
                        <StackPanel Grid.Row="0" Spacing="4">
                            <TextBlock Text="{loc:Tr compare.selected_pair}" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedPairSummary}" Classes="muted" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Spacing="4">
                            <TextBlock Text="{Binding PreviewSummary}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="{DynamicResource VeyraDangerBrush}"
                                       IsVisible="{Binding HasErrorMessage}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="8">
                            <TextBlock Grid.Row="0"
                                       Text="{loc:Tr compare.building_preview}"
                                       Classes="muted"
                                       IsVisible="{Binding IsPreviewLoading}"/>

                            <Grid Grid.Row="1" RowDefinitions="*,Auto,Auto,Auto" RowSpacing="8">
                                <Border Grid.Row="0" Classes="diff-surface" IsVisible="{Binding ShowDiffRowsPanel}">
                                    <Grid RowDefinitions="Auto,*" RowSpacing="8">
                                        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
                                            <Border Grid.Column="0" Background="#1F4A3A" CornerRadius="8" Padding="8,4">
                                                <TextBlock Text="{loc:Tr diff.added}" Foreground="#98FFD2" FontWeight="SemiBold" FontSize="11"/>
                                            </Border>
                                            <Border Grid.Column="1" Background="#4A2530" CornerRadius="8" Padding="8,4">
                                                <TextBlock Text="{loc:Tr diff.removed}" Foreground="#FFB1BC" FontWeight="SemiBold" FontSize="11"/>
                                            </Border>
                                            <Border Grid.Column="2" Background="#30455F" CornerRadius="8" Padding="8,4">
                                                <TextBlock Text="{loc:Tr diff.modified}" Foreground="#D6E6FF" FontWeight="SemiBold" FontSize="11"/>
                                            </Border>
                                            <Border Grid.Column="3" Background="#213B5A" CornerRadius="8" Padding="8,4">
                                                <TextBlock Text="{loc:Tr diff.context}" Foreground="#C2D9F3" FontWeight="SemiBold" FontSize="11"/>
                                            </Border>
                                        </Grid>

                                        <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="8">
                                            <Grid Grid.Row="0" ColumnDefinitions="*,8,*">
                                                <Border Grid.Column="0" Background="#1E3858" CornerRadius="8" Padding="8,4">
                                                    <TextBlock Text="{loc:Tr common.before}" FontWeight="SemiBold"/>
                                                </Border>
                                                <GridSplitter Grid.Column="1"
                                                              Width="8"
                                                              Background="#4E6F8E"
                                                              ResizeDirection="Columns"
                                                              ResizeBehavior="PreviousAndNext"
                                                              HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Stretch"/>
                                                <Border Grid.Column="2" Background="#1E3858" CornerRadius="8" Padding="8,4">
                                                    <TextBlock Text="{loc:Tr common.after}" FontWeight="SemiBold"/>
                                                </Border>
                                            </Grid>

                                            <Grid Grid.Row="1" ColumnDefinitions="*,8,*" ColumnSpacing="0">
                                                <ScrollViewer x:Name="LeftDiffScrollViewer"
                                                              Grid.Column="0"
                                                              VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Auto"
                                                              ScrollChanged="OnLeftDiffScrollChanged">
                                                    <ItemsControl ItemsSource="{Binding PreviewRows}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="explorer:DiffPreviewRowViewModel">
                                                                <StackPanel Spacing="4" Margin="0,0,0,4">
                                                                    <Border IsVisible="{Binding IsHunkHeader}"
                                                                            Background="#1A3654"
                                                                            BorderBrush="#4A78A8"
                                                                            BorderThickness="1"
                                                                            CornerRadius="8"
                                                                            Padding="8,4">
                                                                        <TextBlock Text="{Binding HunkHeader}"
                                                                                   FontFamily="Cascadia Code,Consolas,Monospace"
                                                                                   FontSize="12"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="#A8D1FF"/>
                                                                    </Border>

                                                                    <Border IsVisible="{Binding IsContentRow}"
                                                                            Classes="diff-side"
                                                                            Background="{Binding LeftBackground}"
                                                                            ClipToBounds="True">
                                                                        <Grid ColumnDefinitions="58,16,24,*" ColumnSpacing="6">
                                                                            <TextBlock Grid.Column="0" Text="{Binding LeftLineNumber}" Foreground="#A4BEDA" FontFamily="Cascadia Code,Consolas,Monospace" FontSize="12"/>
                                                                            <TextBlock Grid.Column="1" Text="{Binding LeftMarker}" Foreground="{Binding LeftMarkerForeground}" FontWeight="Bold" FontFamily="Cascadia Code,Consolas,Monospace" FontSize="12"/>
                                                                            <TextBlock Grid.Column="2" Text="{Binding KindBadge}" Foreground="#9BC1E8" FontWeight="SemiBold" FontFamily="Cascadia Code,Consolas,Monospace" FontSize="11"/>
                                                                            <TextBlock Grid.Column="3"
                                                                                       Text="{Binding LeftText}"
                                                                                       FontFamily="Cascadia Code,Consolas,Monospace"
                                                                                       FontSize="12"
                                                                                       TextWrapping="{Binding #Root.((windows:FileVersionCompareWindowViewModel)DataContext).IsWrapEnabled, Converter={x:Static conv:BoolToTextWrappingConverter.Instance}}"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                                <GridSplitter Grid.Column="1"
                                                              Width="8"
                                                              Background="#4E6F8E"
                                                              ResizeDirection="Columns"
                                                              ResizeBehavior="PreviousAndNext"
                                                              HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Stretch"/>

                                                <ScrollViewer x:Name="RightDiffScrollViewer"
                                                              Grid.Column="2"
                                                              VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Auto"
                                                              ScrollChanged="OnRightDiffScrollChanged">
                                                    <ItemsControl ItemsSource="{Binding PreviewRows}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="explorer:DiffPreviewRowViewModel">
                                                                <StackPanel Spacing="4" Margin="0,0,0,4">
                                                                    <Border IsVisible="{Binding IsHunkHeader}"
                                                                            Background="#1A3654"
                                                                            BorderBrush="#4A78A8"
                                                                            BorderThickness="1"
                                                                            CornerRadius="8"
                                                                            Padding="8,4">
                                                                        <TextBlock Text="{Binding HunkHeader}"
                                                                                   FontFamily="Cascadia Code,Consolas,Monospace"
                                                                                   FontSize="12"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="#A8D1FF"/>
                                                                    </Border>

                                                                    <Border IsVisible="{Binding IsContentRow}"
                                                                            Classes="diff-side"
                                                                            Background="{Binding RightBackground}"
                                                                            ClipToBounds="True">
                                                                        <Grid ColumnDefinitions="58,16,24,*" ColumnSpacing="6">
                                                                            <TextBlock Grid.Column="0" Text="{Binding RightLineNumber}" Foreground="#A4BEDA" FontFamily="Cascadia Code,Consolas,Monospace" FontSize="12"/>
                                                                            <TextBlock Grid.Column="1" Text="{Binding RightMarker}" Foreground="{Binding RightMarkerForeground}" FontWeight="Bold" FontFamily="Cascadia Code,Consolas,Monospace" FontSize="12"/>
                                                                            <TextBlock Grid.Column="2" Text="{Binding KindBadge}" Foreground="#9BC1E8" FontWeight="SemiBold" FontFamily="Cascadia Code,Consolas,Monospace" FontSize="11"/>
                                                                            <TextBlock Grid.Column="3"
                                                                                       Text="{Binding RightText}"
                                                                                       FontFamily="Cascadia Code,Consolas,Monospace"
                                                                                       FontSize="12"
                                                                                       TextWrapping="{Binding #Root.((windows:FileVersionCompareWindowViewModel)DataContext).IsWrapEnabled, Converter={x:Static conv:BoolToTextWrappingConverter.Instance}}"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="0" Classes="diff-surface" IsVisible="{Binding ShowWordDiffRowsPanel}" Background="#E7EDF5" BorderBrush="#C8D4E2">
                                    <Grid RowDefinitions="Auto,*" RowSpacing="10">
                                        <Grid Grid.Row="0" ColumnDefinitions="*,8,*" ColumnSpacing="0">
                                            <Border Grid.Column="0" Background="#F3F6FA" BorderBrush="#D5DEE8" BorderThickness="1" CornerRadius="8" Padding="10,6">
                                                <TextBlock Text="{loc:Tr compare.before_version}" FontWeight="SemiBold" Foreground="#1F2937"/>
                                            </Border>
                                            <GridSplitter Grid.Column="1"
                                                          Width="8"
                                                          Background="#D5DEE8"
                                                          ResizeDirection="Columns"
                                                          ResizeBehavior="PreviousAndNext"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Stretch"/>
                                            <Border Grid.Column="2" Background="#F3F6FA" BorderBrush="#D5DEE8" BorderThickness="1" CornerRadius="8" Padding="10,6">
                                                <TextBlock Text="{loc:Tr compare.after_version}" FontWeight="SemiBold" Foreground="#1F2937"/>
                                            </Border>
                                        </Grid>

                                        <Grid Grid.Row="1" ColumnDefinitions="*,8,*" ColumnSpacing="0">
                                            <Border Grid.Column="0" Background="#DFE7F1" BorderBrush="#C8D4E2" BorderThickness="1" CornerRadius="8" Padding="10">
                                                <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="48,40,48,48">
                                                    <ScrollViewer x:Name="LeftWordDiffScrollViewer"
                                                                  VerticalScrollBarVisibility="Auto"
                                                                  HorizontalScrollBarVisibility="Auto"
                                                                  ScrollChanged="OnLeftWordDiffScrollChanged">
                                                        <ItemsControl ItemsSource="{Binding WordPreviewRows}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="windows:WordSemanticDiffRowViewModel">
                                                                    <Border IsVisible="{Binding IsContentRow}"
                                                                            Margin="{Binding LeftParagraphMargin}"
                                                                            Background="{Binding LeftBackground}"
                                                                            BorderBrush="{Binding LeftBorderBrush}"
                                                                            BorderThickness="{Binding LeftBorderThickness}"
                                                                            CornerRadius="0"
                                                                            Padding="0"
                                                                            ToolTip.Tip="{Binding LeftStyleTooltip}"
                                                                            ToolTip.IsEnabled="{Binding HasLeftStyleTooltip}">
                                                                        <StackPanel Spacing="0" HorizontalAlignment="{Binding LeftParagraphAlignment}">
                                                                            <ItemsControl IsVisible="{Binding UseLeftTokenLayout}"
                                                                                          ItemsSource="{Binding LeftTokens}">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate>
                                                                                        <WrapPanel Orientation="Horizontal"/>
                                                                                    </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate x:DataType="windows:WordSemanticTokenViewModel">
                                                                                        <Border Background="{Binding Background}"
                                                                                                BorderBrush="{Binding OutlineBrush}"
                                                                                                BorderThickness="{Binding OutlineThickness}"
                                                                                                CornerRadius="1"
                                                                                                Padding="0"
                                                                                                ToolTip.Tip="{Binding Tooltip}"
                                                                                                ToolTip.IsEnabled="{Binding HasTooltip}">
                                                                                            <TextBlock Text="{Binding Text}"
                                                                                                       xml:space="preserve"
                                                                                                       FontFamily="{Binding FontFamily}"
                                                                                                       FontSize="{Binding FontSize}"
                                                                                                       FontWeight="{Binding FontWeight}"
                                                                                                       FontStyle="{Binding FontStyle}"
                                                                                                        Foreground="{Binding Foreground}"
                                                                                                        TextDecorations="{Binding TextDecorations}"
                                                                                                        Margin="{Binding TextMargin}"/>
                                                                                        </Border>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>

                                                                            <TextBlock IsVisible="{Binding UseLeftPlainLayout}"
                                                                                       Text="{Binding LeftText}"
                                                                                       xml:space="preserve"
                                                                                       FontFamily="{Binding LeftFontFamily}"
                                                                                       FontSize="{Binding LeftFontSize}"
                                                                                       FontWeight="{Binding LeftFontWeight}"
                                                                                       FontStyle="{Binding LeftFontStyle}"
                                                                                       Foreground="{Binding LeftForeground}"
                                                                                       Background="{Binding LeftTextBackground}"
                                                                                       TextDecorations="{Binding LeftTextDecorations}"
                                                                                       Margin="{Binding LeftTextMargin}"
                                                                                       TextAlignment="{Binding LeftTextAlignment}"
                                                                                       TextWrapping="{Binding #Root.((windows:FileVersionCompareWindowViewModel)DataContext).IsWrapEnabled, Converter={x:Static conv:BoolToTextWrappingConverter.Instance}}"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </Border>
                                            </Border>

                                            <GridSplitter Grid.Column="1"
                                                          Width="8"
                                                          Background="#C8D4E2"
                                                          ResizeDirection="Columns"
                                                          ResizeBehavior="PreviousAndNext"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Stretch"/>

                                            <Border Grid.Column="2" Background="#DFE7F1" BorderBrush="#C8D4E2" BorderThickness="1" CornerRadius="8" Padding="10">
                                                <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="48,40,48,48">
                                                    <ScrollViewer x:Name="RightWordDiffScrollViewer"
                                                                  VerticalScrollBarVisibility="Auto"
                                                                  HorizontalScrollBarVisibility="Auto"
                                                                  ScrollChanged="OnRightWordDiffScrollChanged">
                                                        <ItemsControl ItemsSource="{Binding WordPreviewRows}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="windows:WordSemanticDiffRowViewModel">
                                                                    <Border IsVisible="{Binding IsContentRow}"
                                                                            Margin="{Binding RightParagraphMargin}"
                                                                            Background="{Binding RightBackground}"
                                                                            BorderBrush="{Binding RightBorderBrush}"
                                                                            BorderThickness="{Binding RightBorderThickness}"
                                                                            CornerRadius="0"
                                                                            Padding="0"
                                                                            ToolTip.Tip="{Binding RightStyleTooltip}"
                                                                            ToolTip.IsEnabled="{Binding HasRightStyleTooltip}">
                                                                        <StackPanel Spacing="0" HorizontalAlignment="{Binding RightParagraphAlignment}">
                                                                            <ItemsControl IsVisible="{Binding UseRightTokenLayout}"
                                                                                          ItemsSource="{Binding RightTokens}">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate>
                                                                                        <WrapPanel Orientation="Horizontal"/>
                                                                                    </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate x:DataType="windows:WordSemanticTokenViewModel">
                                                                                        <Border Background="{Binding Background}"
                                                                                                BorderBrush="{Binding OutlineBrush}"
                                                                                                BorderThickness="{Binding OutlineThickness}"
                                                                                                CornerRadius="1"
                                                                                                Padding="0"
                                                                                                ToolTip.Tip="{Binding Tooltip}"
                                                                                                ToolTip.IsEnabled="{Binding HasTooltip}">
                                                                                            <TextBlock Text="{Binding Text}"
                                                                                                       xml:space="preserve"
                                                                                                       FontFamily="{Binding FontFamily}"
                                                                                                       FontSize="{Binding FontSize}"
                                                                                                       FontWeight="{Binding FontWeight}"
                                                                                                       FontStyle="{Binding FontStyle}"
                                                                                                        Foreground="{Binding Foreground}"
                                                                                                        TextDecorations="{Binding TextDecorations}"
                                                                                                        Margin="{Binding TextMargin}"/>
                                                                                        </Border>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>

                                                                            <TextBlock IsVisible="{Binding UseRightPlainLayout}"
                                                                                       Text="{Binding RightText}"
                                                                                       xml:space="preserve"
                                                                                       FontFamily="{Binding RightFontFamily}"
                                                                                       FontSize="{Binding RightFontSize}"
                                                                                       FontWeight="{Binding RightFontWeight}"
                                                                                       FontStyle="{Binding RightFontStyle}"
                                                                                       Foreground="{Binding RightForeground}"
                                                                                       Background="{Binding RightTextBackground}"
                                                                                       TextDecorations="{Binding RightTextDecorations}"
                                                                                       Margin="{Binding RightTextMargin}"
                                                                                       TextAlignment="{Binding RightTextAlignment}"
                                                                                       TextWrapping="{Binding #Root.((windows:FileVersionCompareWindowViewModel)DataContext).IsWrapEnabled, Converter={x:Static conv:BoolToTextWrappingConverter.Instance}}"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </Border>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="0" Classes="diff-surface" IsVisible="{Binding ShowFullFilePreviewPanel}">
                                    <Grid RowDefinitions="Auto,*" RowSpacing="8">
                                        <TextBlock Grid.Row="0" Text="{Binding FullPreviewSummary}" Classes="muted" TextWrapping="Wrap"/>
                                        <Grid Grid.Row="1" ColumnDefinitions="*,8,*" ColumnSpacing="0">
                                            <Border Grid.Column="0" Background="#12273D" CornerRadius="8" Padding="6" ClipToBounds="True">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                                    <TextBlock Text="{Binding FullPreviewBeforeText}" FontFamily="Cascadia Code,Consolas,Monospace" FontSize="12" TextWrapping="{Binding IsWrapEnabled, Converter={x:Static conv:BoolToTextWrappingConverter.Instance}}"/>
                                                </ScrollViewer>
                                            </Border>
                                                <GridSplitter Grid.Column="1"
                                                              Width="8"
                                                              Background="#4E6F8E"
                                                              ResizeDirection="Columns"
                                                              ResizeBehavior="PreviousAndNext"
                                                              HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Stretch"/>
                                            <Border Grid.Column="2" Background="#12273D" CornerRadius="8" Padding="6" ClipToBounds="True">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                                    <TextBlock Text="{Binding FullPreviewAfterText}" FontFamily="Cascadia Code,Consolas,Monospace" FontSize="12" TextWrapping="{Binding IsWrapEnabled, Converter={x:Static conv:BoolToTextWrappingConverter.Instance}}"/>
                                                </ScrollViewer>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="0" Classes="diff-surface" IsVisible="{Binding IsBinaryPreview}">
                                    <ItemsControl ItemsSource="{Binding PreviewMetrics}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="windows:SnapshotPreviewMetricItemViewModel">
                                                <Grid ColumnDefinitions="180,*" ColumnSpacing="10" Margin="0,0,0,6">
                                                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontWeight="SemiBold" Foreground="#A8D1FF"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <Border Grid.Row="0" Classes="diff-surface" IsVisible="{Binding IsImagePreview}">
                                    <Grid RowDefinitions="Auto,*" RowSpacing="10">
                                        <ItemsControl Grid.Row="0" ItemsSource="{Binding PreviewMetrics}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="windows:SnapshotPreviewMetricItemViewModel">
                                                    <Grid ColumnDefinitions="180,*" ColumnSpacing="10" Margin="0,0,0,6">
                                                        <TextBlock Grid.Column="0" Text="{Binding Label}" FontWeight="SemiBold" Foreground="#A8D1FF"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Grid Grid.Row="1" ColumnDefinitions="*,8,*" ColumnSpacing="0" IsVisible="{Binding HasImagePreviews}">
                                            <Border Grid.Column="0" Background="#0B172A" BorderBrush="#2D4864" BorderThickness="1" CornerRadius="10" Padding="8">
                                                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                                                    <TextBlock Grid.Row="0" Text="{Binding LeftImageCaption}" FontWeight="SemiBold"/>
                                                    <Image Grid.Row="1" Source="{Binding LeftImagePreview}" Stretch="Uniform"/>
                                                </Grid>
                                            </Border>
                                                <GridSplitter Grid.Column="1"
                                                              Width="8"
                                                              Background="#4E6F8E"
                                                              ResizeDirection="Columns"
                                                              ResizeBehavior="PreviousAndNext"
                                                              HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Stretch"/>
                                            <Border Grid.Column="2" Background="#0B172A" BorderBrush="#2D4864" BorderThickness="1" CornerRadius="10" Padding="8">
                                                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                                                    <TextBlock Grid.Row="0" Text="{Binding RightImageCaption}" FontWeight="SemiBold"/>
                                                    <Image Grid.Row="1" Source="{Binding RightImagePreview}" Stretch="Uniform"/>
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <TextBlock Grid.Row="1"
                                                   Text="{loc:Tr compare.image_preview_unavailable}"
                                                   Classes="muted"
                                                   IsVisible="{Binding HasNoImagePreviews}"/>
                                    </Grid>
                                </Border>

                                <TextBlock Grid.Row="1"
                                           Text="{Binding PreviewSummary}"
                                           Classes="muted"
                                           IsVisible="{Binding ShowNoDiffPreviewMessage}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="2"
                                           Text="{loc:Tr compare.no_full_preview}"
                                           Classes="muted"
                                           IsVisible="{Binding ShowNoFullFilePreviewMessage}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="3"
                                           Text="{loc:Tr compare.word_hint}"
                                           Classes="muted"
                                           FontSize="11"
                                           Opacity="0.82"
                                           IsVisible="{Binding IsWordDocument}"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2"
                Classes="dialog-shell"
                Background="#0F2138"
                BorderBrush="#3A5E84"
                Padding="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding SelectedPairSummary}" Classes="muted" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding PreviewSummary}" Classes="muted" TextWrapping="Wrap" Opacity="0.86"/>
                </StackPanel>

                <ScrollViewer Grid.Column="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="{Binding WrapToggleLabel}" ToolTip.Tip="{loc:Tr compare.tooltip_toggle_wrap}" Classes="subtle" Command="{Binding ToggleWrapModeCommand}" IsVisible="{Binding IsTextPreview}"/>
                        <Button Content="{Binding FullPreviewToggleLabel}"
                                Classes="subtle"
                                ToolTip.Tip="{loc:Tr compare.tooltip_toggle_full_preview}"
                                Command="{Binding ToggleFullFilePreviewCommand}"
                                IsEnabled="{Binding CanToggleFullFilePreview}"
                                IsVisible="{Binding CanToggleFullFilePreview}"/>
                        <Button Content="{loc:Tr compare.open_word_compare}"
                                ToolTip.Tip="{Binding NativeWordCompareHint}"
                                Classes="subtle"
                                Command="{Binding OpenNativeWordCompareCommand}"
                                IsVisible="{Binding IsWordDocument}"
                                IsEnabled="{Binding CanOpenNativeWordCompare}"/>
                        <Button Content="{loc:Tr compare.word_compare_styles}"
                                ToolTip.Tip="{Binding NativeWordCompareFormattingHint}"
                                Classes="subtle"
                                Command="{Binding OpenNativeWordCompareWithFormattingCommand}"
                                IsVisible="{Binding IsWordDocument}"
                                IsEnabled="{Binding CanOpenNativeWordCompare}"/>
                        <Button Content="{loc:Tr compare.open_file}"
                                ToolTip.Tip="{loc:Tr compare.tooltip_open_file}"
                                Classes="subtle"
                                Command="{Binding OpenSourceFileCommand}"
                                IsEnabled="{Binding CanOpenSourceFileOnDisk}"/>
                        <Button Content="{loc:Tr compare.show_in_explorer}"
                                ToolTip.Tip="{loc:Tr compare.tooltip_show_in_explorer}"
                                Classes="subtle"
                                Command="{Binding OpenSourceFileInExplorerCommand}"
                                IsEnabled="{Binding CanOpenSourceFileOnDisk}"/>
                        <Button Content="{loc:Tr common.close}" ToolTip.Tip="{loc:Tr compare.tooltip_close_window}" Classes="primary" Command="{Binding CloseCommand}"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>

