<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:Veyra.Desktop.ViewModels.Pages.SetupWizard"
        xmlns:pages="clr-namespace:Veyra.Desktop.Views.Pages.SetupWizard"
        x:Class="Veyra.Desktop.Views.Pages.SetupWizard.SetupWizardWindow"
        x:DataType="vm:SetupWizardViewModel"
        Width="920" Height="640" Title="Первичная настройка"
        Background="#121212" Foreground="#EEEEEE" CanResize="False">

    <DockPanel Margin="24">

        <!-- Bottom: navigation buttons + step info -->
        <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0" ColumnDefinitions="Auto,*,Auto">
            <TextBlock Grid.Column="0" Text="{Binding StepInfo}"
                       VerticalAlignment="Center" Opacity="0.6"/>

            <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}"
                       Foreground="#FF5555" TextWrapping="Wrap"
                       VerticalAlignment="Center" Margin="16,0"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="Назад" Width="120" Margin="0,0,8,0"
                        Command="{Binding BackCommand}"/>
                <Button Content="{Binding NextButtonText}" Width="160"
                        Command="{Binding NextCommand}"
                        IsEnabled="{Binding CanGoNext}"/>
            </StackPanel>
        </Grid>

        <!-- Content: step views -->
        <ContentControl Content="{Binding CurrentStep}">
            <ContentControl.DataTemplates>
                <DataTemplate DataType="vm:SelectDirectoriesViewModel">
                    <pages:SelectDirectoriesPage/>
                </DataTemplate>
                <DataTemplate DataType="vm:SelectFormatsViewModel">
                    <pages:SelectFormatsPage/>
                </DataTemplate>
                <DataTemplate DataType="vm:RepositoryNameViewModel">
                    <pages:RepositoryNamePage/>
                </DataTemplate>
            </ContentControl.DataTemplates>
        </ContentControl>
    </DockPanel>
</Window>
