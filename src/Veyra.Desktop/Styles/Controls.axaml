<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <LinearGradientBrush x:Key="VeyraCanvasBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0A111A" Offset="0"/>
            <GradientStop Color="#0D1623" Offset="0.5"/>
            <GradientStop Color="#0A1D2A" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="VeyraSurfaceBrush" Color="#121D2B"/>
        <SolidColorBrush x:Key="VeyraSurfaceRaisedBrush" Color="#182638"/>
        <SolidColorBrush x:Key="VeyraSurfaceSoftBrush" Color="#0F1926"/>
        <SolidColorBrush x:Key="VeyraBorderBrush" Color="#28405A"/>
        <SolidColorBrush x:Key="VeyraBorderSoftBrush" Color="#203449"/>
        <SolidColorBrush x:Key="VeyraAccentBrush" Color="#2FB8A8"/>
        <SolidColorBrush x:Key="VeyraAccentStrongBrush" Color="#1F8D80"/>
        <SolidColorBrush x:Key="VeyraTextPrimaryBrush" Color="#F2F6FB"/>
        <SolidColorBrush x:Key="VeyraTextMutedBrush" Color="#AABBCF"/>
        <SolidColorBrush x:Key="VeyraDangerBrush" Color="#FF7B85"/>
        <SolidColorBrush x:Key="VeyraWarningBrush" Color="#FFC867"/>
    </Styles.Resources>

    <Style Selector="UserControl">
        <Setter Property="FontFamily" Value="Bahnschrift, Segoe UI"/>
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource VeyraTextPrimaryBrush}"/>
    </Style>

    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{DynamicResource VeyraSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource VeyraBorderSoftBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="12"/>
    </Style>

    <Style Selector="Border.hero">
        <Setter Property="BorderBrush" Value="{DynamicResource VeyraBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1A2A3E" Offset="0"/>
                    <GradientStop Color="#102033" Offset="0.55"/>
                    <GradientStop Color="#132E3A" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Button">
        <Setter Property="Background" Value="#1B2B3D"/>
        <Setter Property="Foreground" Value="{DynamicResource VeyraTextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="#315171"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#25425E"/>
    </Style>

    <Style Selector="Button:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#183249"/>
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource VeyraAccentBrush}"/>
        <Setter Property="Foreground" Value="#052A28"/>
        <Setter Property="BorderBrush" Value="{DynamicResource VeyraAccentStrongBrush}"/>
    </Style>

    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#38CDBB"/>
    </Style>

    <Style Selector="Button.subtle">
        <Setter Property="Background" Value="#122031"/>
        <Setter Property="BorderBrush" Value="#274058"/>
    </Style>

    <Style Selector="TextBox">
        <Setter Property="Background" Value="#0E1824"/>
        <Setter Property="Foreground" Value="{DynamicResource VeyraTextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="#2C455F"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="SelectionBrush" Value="#6692D4FF"/>
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="Background" Value="#0E1824"/>
        <Setter Property="Foreground" Value="{DynamicResource VeyraTextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="#2C455F"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <Style Selector="ProgressBar">
        <Setter Property="Background" Value="#102133"/>
        <Setter Property="Foreground" Value="{DynamicResource VeyraAccentBrush}"/>
    </Style>

    <Style Selector="TreeView">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style Selector="TextBlock.caption">
        <Setter Property="Opacity" Value="0.76"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource VeyraTextMutedBrush}"/>
    </Style>

    <Style Selector="TextBlock.section-title">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource VeyraSurfaceRaisedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource VeyraBorderSoftBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="10"/>
    </Style>
</Styles>
