<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:settings="clr-namespace:Veyra.Desktop.ViewModels.Pages.RepositorySettings"
             x:Class="Veyra.Desktop.Views.Pages.RepositorySettings.RepositorySettingsView"
             x:Name="Root"
             x:DataType="settings:RepositorySettingsViewModel"
             Background="#0D0D0D">

    <DockPanel Margin="24,20">
        <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="← Назад" Command="{Binding BackCommand}" Padding="12,8"/>
                <TextBlock Text="Настройки репозитория" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#F87171"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="Удалить" Command="{Binding DeleteCommand}" Foreground="#F87171"/>
            <Button Content="Сохранить" Command="{Binding SaveCommand}"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="760" Spacing="14">
                <TextBlock Text="Имя репозитория" Opacity="0.8"/>
                <TextBox Text="{Binding RepositoryName, Mode=TwoWay}"/>

                <TextBlock Text="Описание" Opacity="0.8"/>
                <TextBox Text="{Binding Description, Mode=TwoWay}" Height="90" AcceptsReturn="True"/>

                <TextBlock Text="Директория" Opacity="0.8"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Grid.Column="0" Text="{Binding DirectoryPath, Mode=TwoWay}"/>
                    <Button Grid.Column="1" Content="Обзор" Command="{Binding BrowseDirectoryCommand}"/>
                </Grid>

                <Border Height="1" Background="#1E1E1E" Margin="0,8"/>

                <TextBlock Text="Привязанные форматы" FontSize="14" FontWeight="SemiBold"/>
                <ItemsControl ItemsSource="{Binding SelectedFormats}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Border Background="#1A1A1A" CornerRadius="6" Padding="10,5" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding .}"/>
                                    <Button Content="✕" Padding="2" FontSize="10"
                                            Command="{Binding #Root.((settings:RepositorySettingsViewModel)DataContext).RemoveFormatCommand}"
                                            CommandParameter="{Binding .}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Добавить существующий формат" Opacity="0.8"/>
                <ItemsControl ItemsSource="{Binding AvailableFormats}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Button Content="{Binding .}" Margin="0,0,6,6"
                                    Command="{Binding #Root.((settings:RepositorySettingsViewModel)DataContext).AddAvailableFormatCommand}"
                                    CommandParameter="{Binding .}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Добавить новый формат" Opacity="0.8"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Grid.Column="0" Text="{Binding CustomFormat, Mode=TwoWay}" Watermark="например .sql"/>
                    <Button Grid.Column="1" Content="Добавить" Command="{Binding AddCustomFormatCommand}"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
