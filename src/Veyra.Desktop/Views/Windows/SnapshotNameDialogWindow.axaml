<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:windows="clr-namespace:Veyra.Desktop.ViewModels.Windows"
        mc:Ignorable="d"
        x:Class="Veyra.Desktop.Views.Windows.SnapshotNameDialogWindow"
        x:DataType="windows:SnapshotNameDialogWindowViewModel"
        Width="1080"
        Height="700"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#0F1724"
        Foreground="#EEEEEE"
        Title="Create Snapshot">

    <DockPanel Margin="16" LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
            <TextBlock Text="Create snapshot" FontSize="19" FontWeight="SemiBold"/>
            <TextBlock Text="Review changed files, choose commit name and inspect side-by-side preview before saving."
                       Opacity="0.75"
                       TextWrapping="Wrap"/>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
                <TextBlock Grid.Column="0" Text="Snapshot name" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1"
                         Text="{Binding SnapshotName, Mode=TwoWay}"
                         Watermark="snimok_yyyyMMdd_HHmmss"/>
            </Grid>

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#F87171"
                       IsVisible="{Binding HasErrorMessage}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Grid ColumnDefinitions="360,*" ColumnSpacing="12">
            <Border Grid.Column="0"
                    Background="#132033"
                    BorderBrush="#22354A"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Changed files" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock DockPanel.Dock="Top"
                               Text="No changed files detected."
                               Opacity="0.7"
                               IsVisible="{Binding HasNoChangedFiles}"/>

                    <ListBox ItemsSource="{Binding ChangedFiles}"
                             SelectedItem="{Binding SelectedChangedFile, Mode=TwoWay}"
                             IsVisible="{Binding HasChangedFiles}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="windows:SnapshotPendingFileItemViewModel">
                                <Border Background="#0F1722" CornerRadius="8" Padding="8" Margin="0,0,0,6">
                                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" RowSpacing="2">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding ChangeKindLabel}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding SizeDeltaLabel}" Opacity="0.75"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                                   Text="{Binding RelativePath}"
                                                   Opacity="0.65"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="#132033"
                    BorderBrush="#22354A"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="8">
                    <TextBlock Grid.Row="0" Text="Selected file" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Grid.Row="1" Text="{Binding SelectedChangedFileTitle}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="2" Text="{Binding SelectedChangedFilePath}" Opacity="0.72" TextWrapping="Wrap"/>

                    <StackPanel Grid.Row="3" Spacing="4" Margin="0,4,0,0">
                        <TextBlock Text="Comparison summary" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SelectedChangedFileHint}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding PreviewSummary}" TextWrapping="Wrap" Opacity="0.9"/>
                    </StackPanel>

                    <Grid Grid.Row="4" RowDefinitions="Auto,*,Auto" RowSpacing="6">
                        <TextBlock Grid.Row="0" Text="Diff preview" FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="0"
                                   HorizontalAlignment="Right"
                                   Text="Building preview..."
                                   Opacity="0.7"
                                   IsVisible="{Binding IsPreviewLoading}"/>

                        <Grid Grid.Row="1"
                              ColumnDefinitions="*,*"
                              ColumnSpacing="8"
                              IsVisible="{Binding HasPreviewColumns}">
                            <Border Grid.Column="0" Background="#0D121C" BorderBrush="#203145" BorderThickness="1" CornerRadius="8" Padding="6">
                                <TextBox Text="{Binding PreviewLeftColumn}"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"/>
                            </Border>

                            <Border Grid.Column="1" Background="#0D121C" BorderBrush="#203145" BorderThickness="1" CornerRadius="8" Padding="6">
                                <TextBox Text="{Binding PreviewRightColumn}"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"/>
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="2"
                                   Text="Select a modified text file to see side-by-side preview."
                                   Opacity="0.7"
                                   IsVisible="{Binding HasNoPreviewColumns}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,12,0,0">
            <Button Content="Cancel" Width="120" Command="{Binding CancelCommand}"/>
            <Button Content="Save Snapshot"
                    Width="140"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding CanSave}"/>
        </StackPanel>
    </DockPanel>
</Window>
