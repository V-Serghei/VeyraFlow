<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Veyra.Desktop.ViewModels.Pages.SetupWizard"
             x:Class="Veyra.Desktop.Views.Pages.SetupWizard.RepositoryNamePage"
             d:DataContext="{d:DesignInstance vm:RepositoryNameViewModel, IsDesignTimeCreatable=True}"
             x:DataType="vm:RepositoryNameViewModel">

    <StackPanel Spacing="12">
        <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Title}"/>
        <TextBlock Opacity="0.8" Text="{Binding Subtitle}" TextWrapping="Wrap"/>

        <Border Padding="16" Background="#171717" CornerRadius="10" BorderBrush="#262626" BorderThickness="1" Margin="0,6,0,0">
            <StackPanel Spacing="8">
                <TextBlock Text="Имя репозитория" Opacity="0.85"/>
                <TextBox Text="{Binding RepositoryName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Watermark="Например диплом-проект"
                         Width="460" HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
