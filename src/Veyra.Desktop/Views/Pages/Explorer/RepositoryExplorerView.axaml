
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Veyra.Desktop.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:Veyra.Desktop.Converters"
             xmlns:explorer="clr-namespace:Veyra.Desktop.ViewModels.Pages.Explorer"
             x:Class="Veyra.Desktop.Views.Pages.Explorer.RepositoryExplorerView"
             x:Name="Root"
             x:DataType="explorer:RepositoryExplorerViewModel"
             Background="{DynamicResource VeyraCanvasBrush}">

    <Grid x:Name="ExplorerRootGrid" RowDefinitions="Auto,Auto,*" Margin="12" RowSpacing="8">
        <Border Grid.Row="0" Classes="hero">
            <Grid x:Name="ExplorerHeroGrid" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                <Button x:Name="ExplorerBackButton" Grid.Column="0" Command="{Binding BackCommand}" Classes="subtle responsive-icon" ToolTip.Tip="{loc:Tr common.back}">
                    <Button.Content>
                        <StackPanel Classes="button-content">
                            <TextBlock Classes="button-icon" Text="&#xE72B;"/>
                            <TextBlock Classes="button-label" Text="{loc:Tr common.back}"/>
                        </StackPanel>
                    </Button.Content>
                </Button>

                <StackPanel x:Name="ExplorerHeroContent" Grid.Column="1" Spacing="4">
                    <TextBlock x:Name="ExplorerHeroTitle" Text="{Binding RepositoryName}" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Classes="muted" Text="{Binding RepositoryPath}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Classes="muted"
                               Text="{loc:Tr explorer.live_sync}"
                               FontSize="11"
                               IsVisible="{Binding IsLiveSyncActive}"/>
                </StackPanel>

                <WrapPanel x:Name="ExplorerHeroActionsPanel"
                           Grid.Column="2"
                           Orientation="Horizontal"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="0,2,0,0">
                        <Button ToolTip.Tip="{loc:Tr explorer.tooltip_rescan}"
                                Command="{Binding RescanCommand}"
                                Classes="subtle compact responsive-icon"
                                Margin="0,0,8,8"
                                IsEnabled="{Binding CanRunScanActions}">
                            <Button.Content>
                                <StackPanel Classes="button-content">
                                    <TextBlock Classes="button-icon" Text="&#xE72C;"/>
                                    <TextBlock Classes="button-label" Text="{loc:Tr explorer.rescan_files}"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        <Button
                                Command="{Binding CreateSnapshotCommand}"
                                Classes="primary compact responsive-icon"
                                Margin="0,0,8,8"
                                IsEnabled="{Binding CanCreateSnapshot}"
                                ToolTip.Tip="{loc:Tr explorer.create_snapshot}">
                            <Button.Content>
                                <StackPanel Classes="button-content">
                                    <TextBlock Classes="button-icon" Text="&#xE710;"/>
                                    <TextBlock Classes="button-label" Text="{loc:Tr explorer.create_snapshot}"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        <Button x:Name="ExplorerSnapshotHistoryButton"
                                Command="{Binding ShowSnapshotHistoryCommand}"
                                Classes="subtle compact responsive-icon"
                                Margin="0,0,8,8"
                                IsEnabled="{Binding CanRunScanActions}"
                                ToolTip.Tip="{loc:Tr explorer.snapshot_history}">
                            <Button.Content>
                                <StackPanel Classes="button-content">
                                    <TextBlock Classes="button-icon" Text="&#xE81C;"/>
                                    <TextBlock Classes="button-label" Text="{loc:Tr explorer.snapshot_history}"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        <Button x:Name="ExplorerOpenSettingsButton"
                                Command="{Binding OpenSettingsCommand}"
                                Classes="subtle compact responsive-icon"
                                Margin="0,0,0,8"
                                ToolTip.Tip="{loc:Tr common.settings}">
                            <Button.Content>
                                <StackPanel Classes="button-content">
                                    <TextBlock Classes="button-icon" Text="&#xE713;"/>
                                    <TextBlock Classes="button-label" Text="{loc:Tr common.settings}"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Spacing="6">
            <Border Classes="panel" IsVisible="{Binding IsScanRunning}" Padding="10">
                <Grid ColumnDefinitions="*,120" ColumnSpacing="10" VerticalAlignment="Center">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="{Binding ScanMessage}" FontWeight="SemiBold"/>
                        <ProgressBar Minimum="0"
                                     Maximum="100"
                                     Value="{Binding ScanPercent}"
                                     Height="8"
                                     IsIndeterminate="{Binding ScanIsIndeterminate}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding ScanPercent, StringFormat='{}{0}%'}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>
                </Grid>
            </Border>

            <Border Classes="panel" IsVisible="{Binding HasErrorMessage}" Padding="10" BorderBrush="{DynamicResource VeyraDangerBrush}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource VeyraDangerBrush}" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid x:Name="ExplorerLayoutGrid" ColumnDefinitions="0.82*,4,1.72*,4,1.02*" ColumnSpacing="0">
                <Border x:Name="ExplorerTreePanel" Grid.Column="0" Classes="sidebar" MinWidth="150">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{loc:Tr explorer.folders}" Classes="section-title" Margin="0,0,0,8"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <TreeView x:Name="ExplorerTreeView"
                                      ItemsSource="{Binding TreeNodes}"
                                      SelectedItem="{Binding SelectedTreeNode, Mode=TwoWay}">
                                <TreeView.DataTemplates>
                                    <TreeDataTemplate DataType="explorer:ExplorerTreeNodeViewModel" ItemsSource="{Binding Children}">
                                        <TextBlock Text="{Binding Name}"/>
                                    </TreeDataTemplate>
                                </TreeView.DataTemplates>
                            </TreeView>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <GridSplitter x:Name="ExplorerLeftSplitter" Grid.Column="1"
                              Width="4"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext"/>

                <Border x:Name="ExplorerCenterPanel" Grid.Column="2" Classes="panel" Margin="10,0" MinWidth="280">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
                        <Border Grid.Row="0" Classes="filter-sheet">
                            <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <TextBox Grid.Column="0"
                                             Text="{Binding SearchQuery, Mode=TwoWay}"
                                             Classes="compact"
                                             Watermark="{loc:Tr explorer.search_current_folder}"
                                             ToolTip.Tip="{loc:Tr explorer.search_tokens_hint}"/>

                                    <Button Grid.Column="1"
                                            Classes="subtle compact responsive-icon"
                                            Command="{Binding ToggleExplorerFiltersCommand}"
                                            ToolTip.Tip="{loc:Tr explorer.toggle_filters}">
                                        <StackPanel Classes="button-content">
                                            <TextBlock Classes="button-icon" Text="&#xE71C;"/>
                                            <TextBlock Classes="button-label" Text="{Binding ExplorerFilterButtonLabel}"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <TextBlock Grid.Row="1"
                                           Text="{Binding ExplorerResultsSummary}"
                                           Classes="muted"
                                           FontSize="12"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Classes="filter-sheet" IsVisible="{Binding IsExplorerFiltersVisible}">
                            <StackPanel Spacing="14">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{loc:Tr explorer.advanced_filters}" Classes="section-title"/>
                                        <TextBlock Text="{loc:Tr explorer.filters_hint}" Classes="muted" FontSize="12"/>
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Content="{loc:Tr explorer.clear_filters}"
                                            Command="{Binding ClearAdvancedFiltersCommand}"
                                            Classes="subtle"
                                            VerticalAlignment="Top"/>
                                </Grid>

                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <StackPanel Width="148" Spacing="4" Margin="0,0,12,12">
                                        <TextBlock Text="{loc:Tr explorer.filter_type}" Classes="label"/>
                                        <ComboBox ItemsSource="{Binding EntryTypeFilters}"
                                                  Classes="compact"
                                                  SelectedItem="{Binding SelectedEntryTypeFilter, Mode=TwoWay}">
                                            <ComboBox.SelectionBoxItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <TextBlock Text="{Binding ., Converter={x:Static conv:LocalizedOptionTextConverter.Instance}, ConverterParameter=explorer.entry_type}"/>
                                                </DataTemplate>
                                            </ComboBox.SelectionBoxItemTemplate>
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <TextBlock Text="{Binding ., Converter={x:Static conv:LocalizedOptionTextConverter.Instance}, ConverterParameter=explorer.entry_type}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Width="148" Spacing="4" Margin="0,0,12,12">
                                        <TextBlock Text="{loc:Tr explorer.filter_extension}" Classes="label"/>
                                                <ComboBox ItemsSource="{Binding ExtensionFilters}"
                                                          Classes="compact"
                                                          SelectedItem="{Binding SelectedExtensionFilter, Mode=TwoWay}">
                                                    <ComboBox.SelectionBoxItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <TextBlock Text="{Binding .}"/>
                                                        </DataTemplate>
                                                    </ComboBox.SelectionBoxItemTemplate>
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <TextBlock Text="{Binding .}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                    </StackPanel>

                                    <StackPanel Width="148" Spacing="4" Margin="0,0,12,12">
                                        <TextBlock Text="{loc:Tr explorer.filter_modified}" Classes="label"/>
                                        <ComboBox ItemsSource="{Binding ModifiedWindowFilters}"
                                                  Classes="compact"
                                                  SelectedItem="{Binding SelectedModifiedWindowFilter, Mode=TwoWay}">
                                            <ComboBox.SelectionBoxItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <TextBlock Text="{Binding ., Converter={x:Static conv:LocalizedOptionTextConverter.Instance}, ConverterParameter=explorer.modified_window}"/>
                                                </DataTemplate>
                                            </ComboBox.SelectionBoxItemTemplate>
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <TextBlock Text="{Binding ., Converter={x:Static conv:LocalizedOptionTextConverter.Instance}, ConverterParameter=explorer.modified_window}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Width="132" Spacing="4" Margin="0,0,12,12">
                                        <TextBlock Text="{loc:Tr explorer.filter_min_size_mb}" Classes="label"/>
                                        <TextBox Text="{Binding MinSizeMb, Mode=TwoWay}" Watermark="0" Classes="compact"/>
                                    </StackPanel>

                                    <StackPanel Width="132" Spacing="4" Margin="0,0,12,12">
                                        <TextBlock Text="{loc:Tr explorer.filter_max_size_mb}" Classes="label"/>
                                        <TextBox Text="{Binding MaxSizeMb, Mode=TwoWay}" Watermark="0" Classes="compact"/>
                                    </StackPanel>
                                </WrapPanel>

                                <Border Classes="metric-card">
                                    <StackPanel Spacing="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{loc:Tr explorer.saved_filters}" Classes="section-title"/>
                                            <TextBlock Text="{loc:Tr explorer.saved_filters_hint}" Classes="muted" FontSize="12"/>
                                        </StackPanel>

                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <TextBox Grid.Column="0"
                                                         Text="{Binding SavedExplorerFilterName, Mode=TwoWay}"
                                                         Classes="compact"
                                                         Watermark="{loc:Tr explorer.saved_filter_name}"/>
                                                <Button Grid.Column="1"
                                                        Content="{loc:Tr explorer.save_filter}"
                                                        Command="{Binding SaveCurrentExplorerFilterCommand}"
                                                        Classes="compact"/>
                                            </Grid>

                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                                <ComboBox Grid.Column="0"
                                                          Classes="compact"
                                                          ItemsSource="{Binding SavedExplorerFilters}"
                                                          SelectedItem="{Binding SelectedExplorerSavedFilter, Mode=TwoWay}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="explorer:RepositoryExplorerSavedFilterViewModel">
                                                            <TextBlock Text="{Binding Name}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <Button Grid.Column="1"
                                                        Content="{loc:Tr common.apply}"
                                                        Classes="compact"
                                                        Command="{Binding ApplyExplorerSavedFilterCommand}"
                                                        CommandParameter="{Binding SelectedExplorerSavedFilter}"/>
                                                <Button Grid.Column="2"
                                                        Content="{loc:Tr common.delete}"
                                                        Classes="danger compact"
                                                        Command="{Binding DeleteExplorerSavedFilterCommand}"
                                                        CommandParameter="{Binding SelectedExplorerSavedFilter}"/>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="6">
                            <Grid x:Name="ExplorerItemsHeaderGrid" Grid.Row="0" ColumnDefinitions="36,3.2*,1*,0.9*,1*" Margin="0,2,0,2" ColumnSpacing="8" Classes="explorer-file-grid">
                                    <TextBlock Grid.Column="1" Text="{loc:Tr common.name}" Classes="label"/>
                                    <TextBlock Grid.Column="2" Text="{loc:Tr common.type}" Classes="label"/>
                                    <TextBlock Grid.Column="3" Text="{loc:Tr common.size}" Classes="label"/>
                                    <TextBlock Grid.Column="4" Text="{loc:Tr common.modified}" Classes="label"/>
                                </Grid>

                                <ListBox x:Name="ExplorerItemsListBox" Grid.Row="1"
                                         Classes="clean-list"
                                         ItemsSource="{Binding Items}"
                                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="explorer:ExplorerItemViewModel">
                                            <Border Padding="10"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    PointerPressed="OnExplorerItemPointerPressed">
                                                <Grid ColumnDefinitions="36,3.2*,1*,0.9*,1*" ColumnSpacing="8" Classes="explorer-file-grid">
                                                    <Border Grid.Column="0"
                                                            Classes="chip"
                                                            Width="32"
                                                            Height="32"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Icon}"
                                                                   FontSize="14"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Center"/>
                                                    </Border>

                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Type}" VerticalAlignment="Center" Opacity="0.85" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding SizeDisplay}" VerticalAlignment="Center" Opacity="0.85" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding ModifiedDisplay}" VerticalAlignment="Center" Opacity="0.85" TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                        </Grid>
                    </Grid>
                </Border>

                <GridSplitter x:Name="ExplorerRightSplitter" Grid.Column="3"
                              Width="4"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext"/>

                <Border x:Name="ExplorerDetailsPanel" Grid.Column="4" Classes="panel" Margin="10,0,0,0" MinWidth="240">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{loc:Tr explorer.pending_changes}" Classes="section-title"/>
                            <TextBlock Classes="muted" Text="{Binding LastSnapshotLabel}"/>
                            <TextBlock Text="{Binding PendingChangesSummary}" Opacity="0.88" TextWrapping="Wrap"/>
                            <ListBox Classes="clean-list"
                                     ItemsSource="{Binding PendingChanges}"
                                     MaxHeight="230"
                                     IsVisible="{Binding HasPendingChanges}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="explorer:RepositoryPendingChangeViewModel">
                                        <Border Classes="card">
                                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" RowSpacing="2">
                                                <TextBlock Grid.Row="0" Grid.Column="0"
                                                           Text="{Binding ChangeKindLabel}"
                                                           Foreground="{Binding ChangeKindColor}"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding SizeDeltaLabel}" Opacity="0.78"/>
                                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                                           Text="{Binding RelativePath}"
                                                           Opacity="0.72"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="{loc:Tr explorer.no_pending_changes}" Opacity="0.72" IsVisible="{Binding HasNoPendingChanges}"/>

                            <Button
                                    Command="{Binding ShowSnapshotHistoryCommand}"
                                    Classes="subtle compact responsive-icon"
                                    HorizontalAlignment="Stretch"
                                    Padding="12,10"
                                    ToolTip.Tip="{loc:Tr explorer.open_snapshot_history}">
                                <Button.Content>
                                    <StackPanel Classes="button-content">
                                        <TextBlock Classes="button-icon" Text="&#xE81C;"/>
                                        <TextBlock Classes="button-label" Text="{loc:Tr explorer.open_snapshot_history}"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>

                            <TextBlock Text="{loc:Tr explorer.selected_file}" Classes="section-title"/>

                            <StackPanel IsVisible="{Binding HasSelectedItem}" Spacing="8">
                                <TextBlock Text="{Binding SelectedItem.Name}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Classes="muted" Text="{Binding SelectedItem.RelativePath}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedItem.Type}" Opacity="0.84"/>
                                <TextBlock Text="{Binding SelectedItem.SizeDisplay}" Opacity="0.84"/>
                                <TextBlock Text="{Binding SelectedItem.ModifiedDisplay}" Opacity="0.84"/>

                                <Border Height="1" Background="{DynamicResource VeyraBorderSoftBrush}" Margin="0,4"/>

                                <Border Classes="metric-card">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{loc:Tr explorer.compare_in_window}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding ComparePairSummary}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Command="{Binding CompareSelectedVersionsCommand}"
                                                    IsEnabled="{Binding CanCompareSelectedVersionPair}"
                                                    Classes="primary responsive-icon"
                                                    VerticalAlignment="Top"
                                                    ToolTip.Tip="{loc:Tr explorer.compare_in_window}">
                                                <Button.Content>
                                                    <StackPanel Classes="button-content">
                                                        <TextBlock Classes="button-icon" Text="&#xE8AB;"/>
                                                        <TextBlock Classes="button-label" Text="{loc:Tr explorer.compare_in_window}"/>
                                                    </StackPanel>
                                                </Button.Content>
                                            </Button>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8">
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock Text="{loc:Tr explorer.left_version}" Opacity="0.8" FontSize="11"/>
                                                <ComboBox ItemsSource="{Binding FileVersions}"
                                                          SelectedItem="{Binding CompareLeftVersion, Mode=TwoWay}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="explorer:ExplorerFileVersionViewModel">
                                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Content="&#xE8AB;"
                                                    Classes="subtle icon"
                                                    VerticalAlignment="Bottom"
                                                    ToolTip.Tip="{loc:Tr common.swap}"
                                                    Command="{Binding SwapCompareVersionsCommand}"
                                                    IsEnabled="{Binding CanSwapCompareVersions}"/>

                                            <StackPanel Grid.Column="2" Spacing="4">
                                                <TextBlock Text="{loc:Tr explorer.right_version}" Opacity="0.8" FontSize="11"/>
                                                <ComboBox ItemsSource="{Binding FileVersions}"
                                                          SelectedItem="{Binding CompareRightVersion, Mode=TwoWay}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="explorer:ExplorerFileVersionViewModel">
                                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{loc:Tr explorer.file_versions}" FontWeight="SemiBold"/>
                                <TextBlock Text="{loc:Tr explorer.loading_versions}" Opacity="0.72" IsVisible="{Binding IsVersionLoading}"/>
                                <TextBlock Text="{Binding VersionPanelError}"
                                           Foreground="{DynamicResource VeyraDangerBrush}"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding HasVersionPanelError}"/>
                                <TextBlock Text="{loc:Tr explorer.no_versions_for_selected_file}" Opacity="0.72" IsVisible="{Binding HasNoFileVersions}"/>

                                <ListBox Classes="clean-list"
                                         ItemsSource="{Binding VisibleFileVersions}"
                                         SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                                         MaxHeight="200">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="explorer:ExplorerFileVersionViewModel">
                                            <Border Classes="card" Padding="8">
                                                <Grid RowDefinitions="Auto" ColumnDefinitions="Auto,*,Auto" RowSpacing="2" ColumnSpacing="8">
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding VersionName}" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CreatedAtDisplay}" Opacity="0.82"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding SizeDisplay}" Opacity="0.78"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Button Content="{Binding FileVersionsToggleLabel}" Command="{Binding ToggleFileVersionsViewCommand}" Classes="subtle" IsVisible="{Binding CanToggleFileVersionsView}"/>

                                <Border Classes="card" Padding="8" IsVisible="{Binding HasSelectedVersion}">
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="100,*" RowSpacing="3" ColumnSpacing="8">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr common.path}" Opacity="0.7"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedItem.RelativePath}" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Tr common.version}" Opacity="0.7"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedVersion.VersionName}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Tr common.size}" Opacity="0.7"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedVersion.SizeDisplay}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Tr common.date}" Opacity="0.7"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedVersion.CreatedAtDisplay}"/>
                                    </Grid>
                                </Border>

                                <TextBlock Text="{loc:Tr explorer.no_content_blocks_for_version}"
                                           Foreground="{DynamicResource VeyraWarningBrush}"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding SelectedVersionHasNoContentBlocks}"/>

                                <StackPanel x:Name="ExplorerRestoreActionsPanel" Orientation="Horizontal" Spacing="6">
                                    <Button
                                            Command="{Binding RestoreVersionAsCopyCommand}"
                                            IsEnabled="{Binding CanRestoreSelectedVersion}"
                                            Classes="subtle responsive-icon"
                                            ToolTip.Tip="{loc:Tr explorer.restore_as_copy}">
                                        <Button.Content>
                                            <StackPanel Classes="button-content">
                                                <TextBlock Classes="button-icon" Text="&#xE8C8;"/>
                                                <TextBlock Classes="button-label" Text="{loc:Tr explorer.restore_as_copy}"/>
                                            </StackPanel>
                                        </Button.Content>
                                    </Button>
                                    <Button
                                            Command="{Binding RestoreVersionOverwriteCommand}"
                                            IsEnabled="{Binding CanRestoreSelectedVersion}"
                                            Classes="responsive-icon"
                                            ToolTip.Tip="{loc:Tr explorer.restore_overwrite}">
                                        <Button.Content>
                                            <StackPanel Classes="button-content">
                                                <TextBlock Classes="button-icon" Text="&#xE7C3;"/>
                                                <TextBlock Classes="button-label" Text="{loc:Tr explorer.restore_overwrite}"/>
                                            </StackPanel>
                                        </Button.Content>
                                    </Button>
                                </StackPanel>

                                <TextBlock Text="{Binding VersionActionMessage}"
                                           TextWrapping="Wrap"
                                           Opacity="0.9"
                                           IsVisible="{Binding HasVersionActionMessage}"/>
                            </StackPanel>

                            <TextBlock Text="{loc:Tr explorer.select_file_from_index}"
                                       Opacity="0.72"
                                       IsVisible="{Binding HasNoSelectedItem}"
                                       TextWrapping="Wrap"/>

                            <Border Height="1" Background="{DynamicResource VeyraBorderSoftBrush}" Margin="0,6"/>

                            <Border Classes="card" Padding="12" BorderBrush="{DynamicResource VeyraBorderSoftBrush}">
                                <StackPanel Spacing="10">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{loc:Tr explorer.repository_tools}" FontWeight="SemiBold"/>
                                        <TextBlock Classes="muted"
                                                   Text="{loc:Tr explorer.repository_tools_hint}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <Button Content="{loc:Tr explorer.fix_missing_data}"
                                            ToolTip.Tip="{loc:Tr explorer.tooltip_repair_data}"
                                            AutomationProperties.Name="{loc:Tr explorer.automation_repair_data}"
                                            Command="{Binding RepairRepositoryDataCommand}"
                                            IsEnabled="{Binding CanRunMaintenanceActions}"
                                            Classes="subtle compact"
                                            HorizontalAlignment="Stretch"/>
                                    <Button Content="{loc:Tr explorer.rebuild_index}"
                                            ToolTip.Tip="{loc:Tr explorer.tooltip_reindex_data}"
                                            AutomationProperties.Name="{loc:Tr explorer.automation_reindex_data}"
                                            Command="{Binding ReindexRepositoryDataCommand}"
                                            IsEnabled="{Binding CanRunMaintenanceActions}"
                                            Classes="subtle compact"
                                            HorizontalAlignment="Stretch"/>
                                    <Button Content="{loc:Tr explorer.repair_links}"
                                            ToolTip.Tip="{loc:Tr explorer.tooltip_relink_graph}"
                                            AutomationProperties.Name="{loc:Tr explorer.automation_relink_graph}"
                                            Command="{Binding RelinkRepositoryDataCommand}"
                                            IsEnabled="{Binding CanRunMaintenanceActions}"
                                            Classes="subtle compact"
                                            HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Border IsVisible="{Binding IsSnapshotHistoryMenuOpen}"
                    Classes="overlay-backdrop"
                    Padding="24">
                <Border Classes="dialog-shell"
                        MaxWidth="1700"
                        MinHeight="760"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="18"
                        CornerRadius="16">
                    <Grid RowDefinitions="Auto,*" RowSpacing="14">
                        <Border Grid.Row="0" Classes="hero">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{loc:Tr explorer.snapshot_history}" Classes="h2"/>
                                    <TextBlock Classes="muted"
                                               Text="{loc:Tr explorer.snapshot_history_hint}"
                                               FontSize="12"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="{loc:Tr common.close}"
                                        Command="{Binding CloseSnapshotHistoryMenuCommand}"
                                        Classes="subtle"
                                        VerticalAlignment="Top"/>
                            </Grid>
                        </Border>

                        <Grid x:Name="SnapshotHistoryLayoutGrid" Grid.Row="1" ColumnDefinitions="1.02*,6,1.12*,6,1.16*" ColumnSpacing="0">
                            <Border x:Name="SnapshotHistoryCommitsPanel" Grid.Column="0" Classes="card" Padding="14">
                                <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
                                    <TextBlock Grid.Row="0" Text="{loc:Tr explorer.commits}" Classes="section-title"/>

                                    <Border Grid.Row="1" Classes="filter-sheet" Padding="12">
                                        <StackPanel Spacing="10">
                                            <TextBox Text="{Binding SnapshotHistorySearchQuery, Mode=TwoWay}"
                                                     Classes="compact"
                                                     Watermark="{loc:Tr explorer.search_commits}"/>
                                            <WrapPanel Orientation="Horizontal">
                                                <ComboBox Width="160"
                                                          Margin="0,0,8,8"
                                                          Classes="compact"
                                                          ItemsSource="{Binding SnapshotTriggerFilters}"
                                                          SelectedItem="{Binding SelectedSnapshotTriggerFilter, Mode=TwoWay}">
                                                    <ComboBox.SelectionBoxItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <TextBlock Text="{Binding ., Converter={x:Static conv:LocalizedOptionTextConverter.Instance}, ConverterParameter=explorer.snapshot_trigger}"/>
                                                        </DataTemplate>
                                                    </ComboBox.SelectionBoxItemTemplate>
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <TextBlock Text="{Binding ., Converter={x:Static conv:LocalizedOptionTextConverter.Instance}, ConverterParameter=explorer.snapshot_trigger}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <TextBox Width="112"
                                                         Margin="0,0,8,8"
                                                         Classes="compact"
                                                         Text="{Binding SnapshotHistoryMinChangedFiles, Mode=TwoWay}"
                                                         Watermark="{loc:Tr explorer.min_changed_files}"/>
                                                <Button Margin="0,0,8,8"
                                                         Content="{loc:Tr explorer.clear_filters}"
                                                         Command="{Binding ClearSnapshotHistoryFiltersCommand}"
                                                         Classes="subtle compact"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Grid.Row="2"
                                               Text="{loc:Tr explorer.loading_commits}"
                                               Classes="muted"
                                               IsVisible="{Binding IsSnapshotHistoryLoading}"/>

                                    <Grid Grid.Row="3">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      IsVisible="{Binding HasSnapshotHistory}">
                                             <ListBox Classes="clean-list"
                                                      ItemsSource="{Binding SnapshotHistory}"
                                                      SelectedItem="{Binding SelectedSnapshot, Mode=TwoWay}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="explorer:RepositorySnapshotHistoryEntryViewModel">
                                                        <Border Padding="10" Background="Transparent" BorderThickness="0">
                                                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                                                <TextBlock Grid.Row="0" Text="{Binding DisplayTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Grid.Row="1" Text="{Binding DisplayTime}" Classes="muted" FontSize="11"/>
                                                                <TextBlock Grid.Row="2" Text="{Binding ChangedFilesLabel}" Classes="muted" FontSize="11"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </ScrollViewer>

                                        <TextBlock Text="{loc:Tr explorer.no_commits}"
                                                   Classes="muted"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   IsVisible="{Binding HasNoSnapshotHistory}"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <GridSplitter x:Name="SnapshotHistoryLeftSplitter" Grid.Column="1"
                                          Width="6"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          ResizeDirection="Columns"
                                          ResizeBehavior="PreviousAndNext"/>

                            <Border x:Name="SnapshotHistoryFilesPanel" Grid.Column="2" Classes="card" Padding="14" Margin="14,0">
                                <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
                                    <TextBlock Grid.Row="0" Text="{loc:Tr explorer.files_in_selected_commit}" Classes="section-title"/>

                                    <Border Grid.Row="1" Classes="filter-sheet" Padding="12">
                                        <StackPanel Spacing="10">
                                            <TextBox Text="{Binding SnapshotFilesSearchQuery, Mode=TwoWay}"
                                                     Classes="compact"
                                                     Watermark="{loc:Tr explorer.search_commit_files}"/>
                                            <WrapPanel Orientation="Horizontal">
                                                <ComboBox Width="160"
                                                          Margin="0,0,8,8"
                                                          Classes="compact"
                                                          ItemsSource="{Binding SnapshotFileChangeKindFilters}"
                                                          SelectedItem="{Binding SelectedSnapshotFileChangeKindFilter, Mode=TwoWay}">
                                                    <ComboBox.SelectionBoxItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <TextBlock Text="{Binding ., Converter={x:Static conv:LocalizedOptionTextConverter.Instance}, ConverterParameter=explorer.snapshot_change_kind}"/>
                                                        </DataTemplate>
                                                    </ComboBox.SelectionBoxItemTemplate>
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <TextBlock Text="{Binding ., Converter={x:Static conv:LocalizedOptionTextConverter.Instance}, ConverterParameter=explorer.snapshot_change_kind}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <ComboBox Width="140"
                                                          Margin="0,0,8,8"
                                                          Classes="compact"
                                                          ItemsSource="{Binding SnapshotFileExtensionFilters}"
                                                          SelectedItem="{Binding SelectedSnapshotFileExtensionFilter, Mode=TwoWay}">
                                                    <ComboBox.SelectionBoxItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <TextBlock Text="{Binding .}"/>
                                                        </DataTemplate>
                                                    </ComboBox.SelectionBoxItemTemplate>
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <TextBlock Text="{Binding .}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <TextBox Width="112"
                                                         Margin="0,0,8,8"
                                                         Classes="compact"
                                                         Text="{Binding SnapshotFilesMinSizeDeltaKb, Mode=TwoWay}"
                                                         Watermark="{loc:Tr explorer.min_delta_kb}"/>
                                                <Button Margin="0,0,8,8"
                                                         Content="{loc:Tr explorer.clear_filters}"
                                                         Command="{Binding ClearSnapshotFilesFiltersCommand}"
                                                         Classes="subtle compact"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Grid.Row="2" Spacing="4">
                                        <TextBlock Text="{loc:Tr explorer.select_commit_for_changes}"
                                                   Classes="muted"
                                                   IsVisible="{Binding HasNoSelectedSnapshot}"/>
                                        <TextBlock Text="{loc:Tr explorer.loading_changed_files}"
                                                   Classes="muted"
                                                   IsVisible="{Binding IsSnapshotFilesLoading}"/>
                                    </StackPanel>

                                    <Grid Grid.Row="3">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      IsVisible="{Binding HasSnapshotFiles}">
                                             <ListBox Classes="clean-list"
                                                      ItemsSource="{Binding SnapshotFiles}"
                                                      SelectedItem="{Binding SelectedSnapshotFile, Mode=TwoWay}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="explorer:RepositorySnapshotFileChangeViewModel">
                                                        <Border Padding="10" Background="Transparent" BorderThickness="0">
                                                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" RowSpacing="4">
                                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding ChangeKindLabel}" FontWeight="SemiBold"/>
                                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding SizeDeltaLabel}" Classes="muted"/>
                                                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                                                           Text="{Binding RelativePath}"
                                                                           Classes="muted"
                                                                           FontSize="11"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </ScrollViewer>

                                        <TextBlock Text="{loc:Tr explorer.no_changed_files_in_commit}"
                                                   Classes="muted"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   IsVisible="{Binding HasNoSnapshotFiles}"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <GridSplitter x:Name="SnapshotHistoryRightSplitter" Grid.Column="3"
                                          Width="6"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          ResizeDirection="Columns"
                                          ResizeBehavior="PreviousAndNext"/>

                            <Border x:Name="SnapshotHistoryVersionsPanel" Grid.Column="4" Classes="card" Padding="14">
                                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                                    <StackPanel Grid.Row="0" Spacing="4">
                                        <TextBlock Text="{loc:Tr explorer.version_controls}" Classes="section-title"/>
                                        <TextBlock Text="{loc:Tr explorer.select_file_for_version_controls}"
                                                   Classes="muted"
                                                   FontSize="12"
                                                   IsVisible="{Binding HasNoSelectedItem}"/>
                                    </StackPanel>

                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <StackPanel Spacing="10" IsVisible="{Binding HasSelectedItem}">
                                            <Border Classes="metric-card">
                                                <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="92,*" RowSpacing="6" ColumnSpacing="10">
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr common.name}" Classes="label"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedItem.Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>

                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Tr common.path}" Classes="label"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedItem.RelativePath}" Classes="muted" TextWrapping="Wrap"/>

                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Tr common.type}" Classes="label"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedItem.Type}"/>

                                                    <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="92,*,92,*" ColumnSpacing="10">
                                                        <TextBlock Grid.Column="0" Text="{loc:Tr common.size}" Classes="label"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding SelectedItem.SizeDisplay}"/>
                                                        <TextBlock Grid.Column="2" Text="{loc:Tr common.modified}" Classes="label"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding SelectedItem.ModifiedDisplay}"/>
                                                    </Grid>
                                                </Grid>
                                            </Border>

                                            <Border Classes="filter-sheet" Padding="12">
                                                <StackPanel Spacing="8">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                        <TextBlock Text="{loc:Tr explorer.file_versions}" FontWeight="SemiBold"/>
                                                        <Button Grid.Column="1"
                                                                Content="{Binding FileVersionsToggleLabel}"
                                                                Command="{Binding ToggleFileVersionsViewCommand}"
                                                                Classes="subtle compact"
                                                                IsVisible="{Binding CanToggleFileVersionsView}"/>
                                                    </Grid>

                                                    <TextBlock Text="{loc:Tr explorer.loading_versions}" Classes="muted" IsVisible="{Binding IsVersionLoading}"/>
                                                    <TextBlock Text="{Binding VersionPanelError}"
                                                               Foreground="{DynamicResource VeyraDangerBrush}"
                                                               TextWrapping="Wrap"
                                                               IsVisible="{Binding HasVersionPanelError}"/>
                                                    <TextBlock Text="{loc:Tr explorer.no_versions_for_selected_file}" Classes="muted" IsVisible="{Binding HasNoFileVersions}"/>

                                                     <ListBox Classes="clean-list"
                                                              ItemsSource="{Binding VisibleFileVersions}"
                                                              SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                                                              MaxHeight="220">
                                                         <ListBox.ItemTemplate>
                                                             <DataTemplate x:DataType="explorer:ExplorerFileVersionViewModel">
                                                                 <Border Padding="8" Background="Transparent" BorderThickness="0">
                                                                     <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                                         <TextBlock Grid.Column="0" Text="{Binding VersionName}" FontWeight="SemiBold"/>
                                                                         <TextBlock Grid.Column="1" Text="{Binding CreatedAtDisplay}" Classes="muted"/>
                                                                         <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" Classes="muted"/>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </StackPanel>
                                            </Border>

                                            <Border Classes="metric-card">
                                                <StackPanel Spacing="10">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="{loc:Tr explorer.version_compare}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding ComparePairSummary}" Classes="muted" TextWrapping="Wrap"/>
                                                        </StackPanel>

                                                        <Button Grid.Column="1"
                                                                Command="{Binding CompareSelectedVersionsCommand}"
                                                                IsEnabled="{Binding CanCompareSelectedVersionPair}"
                                                                Classes="primary responsive-icon"
                                                                VerticalAlignment="Top"
                                                                ToolTip.Tip="{loc:Tr explorer.compare_in_window}">
                                                            <Button.Content>
                                                                <StackPanel Classes="button-content">
                                                                    <TextBlock Classes="button-icon" Text="&#xE8AB;"/>
                                                                    <TextBlock Classes="button-label" Text="{loc:Tr explorer.compare_in_window}"/>
                                                                </StackPanel>
                                                            </Button.Content>
                                                        </Button>
                                                    </Grid>

                                                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8">
                                                        <StackPanel Grid.Column="0" Spacing="4">
                                                            <TextBlock Text="{loc:Tr explorer.left_version}" Classes="label"/>
                                                            <ComboBox Classes="compact"
                                                                      ItemsSource="{Binding FileVersions}"
                                                                      SelectedItem="{Binding CompareLeftVersion, Mode=TwoWay}">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="explorer:ExplorerFileVersionViewModel">
                                                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                        </StackPanel>

                                                        <Button Grid.Column="1"
                                                                Content="&#xE8AB;"
                                                                Classes="subtle icon"
                                                                VerticalAlignment="Bottom"
                                                                ToolTip.Tip="{loc:Tr common.swap}"
                                                                Command="{Binding SwapCompareVersionsCommand}"
                                                                IsEnabled="{Binding CanSwapCompareVersions}"/>

                                                        <StackPanel Grid.Column="2" Spacing="4">
                                                            <TextBlock Text="{loc:Tr explorer.right_version}" Classes="label"/>
                                                            <ComboBox Classes="compact"
                                                                      ItemsSource="{Binding FileVersions}"
                                                                      SelectedItem="{Binding CompareRightVersion, Mode=TwoWay}">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="explorer:ExplorerFileVersionViewModel">
                                                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <Border Classes="card" Padding="10" IsVisible="{Binding HasSelectedVersion}">
                                                <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="100,*" RowSpacing="4" ColumnSpacing="8">
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr common.path}" Classes="label"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedItem.RelativePath}" TextWrapping="Wrap"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Tr common.version}" Classes="label"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedVersion.VersionName}"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Tr common.size}" Classes="label"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedVersion.SizeDisplay}"/>
                                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Tr common.date}" Classes="label"/>
                                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedVersion.CreatedAtDisplay}"/>
                                                </Grid>
                                            </Border>

                                            <TextBlock Text="{loc:Tr explorer.no_content_blocks_for_version}"
                                                       Foreground="{DynamicResource VeyraWarningBrush}"
                                                       TextWrapping="Wrap"
                                                       IsVisible="{Binding SelectedVersionHasNoContentBlocks}"/>

                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button
                                                        Command="{Binding RestoreVersionAsCopyCommand}"
                                                        IsEnabled="{Binding CanRestoreSelectedVersion}"
                                                        Classes="subtle responsive-icon"
                                                        ToolTip.Tip="{loc:Tr explorer.restore_as_copy}">
                                                    <Button.Content>
                                                        <StackPanel Classes="button-content">
                                                            <TextBlock Classes="button-icon" Text="&#xE8C8;"/>
                                                            <TextBlock Classes="button-label" Text="{loc:Tr explorer.restore_as_copy}"/>
                                                        </StackPanel>
                                                    </Button.Content>
                                                </Button>
                                                <Button
                                                        Command="{Binding RestoreVersionOverwriteCommand}"
                                                        IsEnabled="{Binding CanRestoreSelectedVersion}"
                                                        Classes="responsive-icon"
                                                        ToolTip.Tip="{loc:Tr explorer.restore_overwrite}">
                                                    <Button.Content>
                                                        <StackPanel Classes="button-content">
                                                            <TextBlock Classes="button-icon" Text="&#xE7C3;"/>
                                                            <TextBlock Classes="button-label" Text="{loc:Tr explorer.restore_overwrite}"/>
                                                        </StackPanel>
                                                    </Button.Content>
                                                </Button>
                                            </StackPanel>

                                            <TextBlock Text="{Binding VersionActionMessage}"
                                                       TextWrapping="Wrap"
                                                       Opacity="0.9"
                                                       IsVisible="{Binding HasVersionActionMessage}"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Border>
            <Border IsVisible="{Binding IsDiffPreviewMenuOpen}"
                    Classes="overlay-backdrop"
                    Padding="24">
                <Border Classes="dialog-shell"
                        MaxWidth="1440"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="18"
                        CornerRadius="16"
                        BorderBrush="{DynamicResource VeyraBorderBrush}">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="14">
                        <Border Grid.Row="0" Classes="hero">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{loc:Tr explorer.diff_preview}" Classes="h2"/>
                                    <TextBlock Classes="muted"
                                               Text="{Binding DiffPreviewTitle}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="{loc:Tr common.close}"
                                        Command="{Binding CloseDiffPreviewMenuCommand}"
                                        Classes="subtle"
                                        VerticalAlignment="Top"/>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding DiffPreviewSummary}"
                                       Classes="muted"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                                <Border Classes="badge success">
                                    <TextBlock Text="{loc:Tr diff.added}" Foreground="{DynamicResource VeyraDiffAddFgBrush}" FontWeight="SemiBold" FontSize="11"/>
                                </Border>
                                <Border Classes="badge danger">
                                    <TextBlock Text="{loc:Tr diff.removed}" Foreground="{DynamicResource VeyraDiffRemoveFgBrush}" FontWeight="SemiBold" FontSize="11"/>
                                </Border>
                                <Border Classes="badge warning">
                                    <TextBlock Text="{loc:Tr diff.context}" Foreground="{DynamicResource VeyraDiffContextFgBrush}" FontWeight="SemiBold" FontSize="11"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="10">
                            <TextBlock Grid.Row="0"
                                       Text="{loc:Tr compare.building_preview}"
                                       Classes="muted"
                                       IsVisible="{Binding IsDiffPreviewLoading}"/>

                            <Border Grid.Row="1"
                                    Classes="diff-surface"
                                    Padding="12"
                                    MinHeight="420"
                                    IsVisible="{Binding HasDiffPreviewRows}">
                                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                                    <Grid Grid.Row="0" ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <Border Grid.Column="0" Background="{DynamicResource VeyraDiffHeaderBgBrush}" CornerRadius="8" Padding="10,6">
                                            <TextBlock Text="{loc:Tr common.before}" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border Grid.Column="1" Background="{DynamicResource VeyraDiffHeaderBgBrush}" CornerRadius="8" Padding="10,6">
                                            <TextBlock Text="{loc:Tr common.after}" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>

                                    <ScrollViewer Grid.Row="1"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding DiffPreviewRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="explorer:DiffPreviewRowViewModel">
                                                    <StackPanel Spacing="4" Margin="0,0,0,4">
                                                        <Border IsVisible="{Binding IsHunkHeader}"
                                                                Background="{DynamicResource VeyraDiffHunkBgBrush}"
                                                                BorderBrush="{DynamicResource VeyraDiffHunkBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="8"
                                                                Padding="8,4">
                                                            <TextBlock Text="{Binding HunkHeader}"
                                                                       FontFamily="Cascadia Code,Consolas,Monospace"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource VeyraDiffHunkFgBrush}"/>
                                                        </Border>

                                                        <Grid IsVisible="{Binding IsContentRow}" ColumnDefinitions="*,*" ColumnSpacing="8">
                                                            <Border Grid.Column="0" Background="{Binding LeftBackground}" CornerRadius="6" Padding="8,4">
                                                                <Grid ColumnDefinitions="58,18,*" ColumnSpacing="6">
                                                                    <TextBlock Grid.Column="0"
                                                                               Text="{Binding LeftLineNumber}"
                                                                               Foreground="{DynamicResource VeyraDiffLineNumberBrush}"
                                                                               FontFamily="Cascadia Code,Consolas,Monospace"
                                                                               FontSize="12"/>
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding LeftMarker}"
                                                                               Foreground="{Binding LeftMarkerForeground}"
                                                                               FontWeight="Bold"
                                                                               FontFamily="Cascadia Code,Consolas,Monospace"
                                                                               FontSize="12"/>
                                                                    <TextBlock Grid.Column="2"
                                                                               Text="{Binding LeftText}"
                                                                               FontFamily="Cascadia Code,Consolas,Monospace"
                                                                               FontSize="12"
                                                                               TextWrapping="NoWrap"/>
                                                                </Grid>
                                                            </Border>

                                                            <Border Grid.Column="1" Background="{Binding RightBackground}" CornerRadius="6" Padding="8,4">
                                                                <Grid ColumnDefinitions="58,18,*" ColumnSpacing="6">
                                                                    <TextBlock Grid.Column="0"
                                                                               Text="{Binding RightLineNumber}"
                                                                               Foreground="{DynamicResource VeyraDiffLineNumberBrush}"
                                                                               FontFamily="Cascadia Code,Consolas,Monospace"
                                                                               FontSize="12"/>
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding RightMarker}"
                                                                               Foreground="{Binding RightMarkerForeground}"
                                                                               FontWeight="Bold"
                                                                               FontFamily="Cascadia Code,Consolas,Monospace"
                                                                               FontSize="12"/>
                                                                    <TextBlock Grid.Column="2"
                                                                               Text="{Binding RightText}"
                                                                               FontFamily="Cascadia Code,Consolas,Monospace"
                                                                               FontSize="12"
                                                                               TextWrapping="NoWrap"/>
                                                                </Grid>
                                                            </Border>
                                                        </Grid>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1"
                                    Classes="card"
                                    Padding="20"
                                    IsVisible="{Binding HasNoDiffPreviewRows}">
                                <TextBlock Text="{loc:Tr explorer.diff_data_unavailable}"
                                           Classes="muted"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </Grid>
</UserControl>
