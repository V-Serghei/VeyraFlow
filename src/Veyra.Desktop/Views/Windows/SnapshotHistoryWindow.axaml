<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Veyra.Desktop.Localization"
        xmlns:conv="clr-namespace:Veyra.Desktop.Converters"
        xmlns:explorer="clr-namespace:Veyra.Desktop.ViewModels.Pages.Explorer"
        x:Class="Veyra.Desktop.Views.Windows.SnapshotHistoryWindow"
        x:DataType="explorer:RepositoryExplorerViewModel"
        Width="1480"
        Height="860"
        MinWidth="1080"
        MinHeight="720"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="Full"
        CanResize="True"
        Background="{DynamicResource VeyraCanvasBrush}"
        Foreground="{DynamicResource VeyraTextPrimaryBrush}"
        Title="{loc:Tr explorer.snapshot_history}">

    <Grid Margin="16">
                <Border Classes="dialog-shell"
                        MinHeight="760"
                        Padding="18"
                        CornerRadius="16">
                    <Grid RowDefinitions="Auto,*" RowSpacing="14">
                        <Border Grid.Row="0" Classes="hero">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{loc:Tr explorer.snapshot_history}" Classes="h2"/>
                                    <TextBlock Classes="muted"
                                               Text="{loc:Tr explorer.snapshot_history_hint}"
                                               FontSize="12"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="{loc:Tr common.close}"
                                        Command="{Binding CloseSnapshotHistoryMenuCommand}"
                                        Classes="subtle"
                                        VerticalAlignment="Top"/>
                            </Grid>
                        </Border>

                        <Grid x:Name="SnapshotHistoryLayoutGrid" Grid.Row="1" ColumnDefinitions="1.02*,6,1.12*,6,1.16*" ColumnSpacing="0">
                            <Border x:Name="SnapshotHistoryCommitsPanel" Grid.Column="0" Classes="card" Padding="14">
                                <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
                                    <TextBlock Grid.Row="0" Text="{loc:Tr explorer.commits}" Classes="section-title"/>

                                    <Border Grid.Row="1" Classes="filter-sheet" Padding="12">
                                        <StackPanel Spacing="10">
                                            <TextBox Text="{Binding SnapshotHistorySearchQuery, Mode=TwoWay}"
                                                     Classes="compact"
                                                     Watermark="{loc:Tr explorer.search_commits}"/>
                                            <WrapPanel Orientation="Horizontal">
                                                <ComboBox Width="152"
                                                          Margin="0,0,8,8"
                                                          Classes="compact"
                                                          ItemsSource="{Binding SnapshotKindFilters}"
                                                          SelectedItem="{Binding SelectedSnapshotKindFilter, Mode=TwoWay}">
                                                    <ComboBox.SelectionBoxItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <TextBlock Text="{Binding ., Converter={x:Static conv:LocalizedOptionTextConverter.Instance}, ConverterParameter=explorer.snapshot_kind}"/>
                                                        </DataTemplate>
                                                    </ComboBox.SelectionBoxItemTemplate>
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <TextBlock Text="{Binding ., Converter={x:Static conv:LocalizedOptionTextConverter.Instance}, ConverterParameter=explorer.snapshot_kind}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <ComboBox Width="160"
                                                          Margin="0,0,8,8"
                                                          Classes="compact"
                                                          ItemsSource="{Binding SnapshotTriggerFilters}"
                                                          SelectedItem="{Binding SelectedSnapshotTriggerFilter, Mode=TwoWay}">
                                                    <ComboBox.SelectionBoxItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <TextBlock Text="{Binding ., Converter={x:Static conv:LocalizedOptionTextConverter.Instance}, ConverterParameter=explorer.snapshot_trigger}"/>
                                                        </DataTemplate>
                                                    </ComboBox.SelectionBoxItemTemplate>
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <TextBlock Text="{Binding ., Converter={x:Static conv:LocalizedOptionTextConverter.Instance}, ConverterParameter=explorer.snapshot_trigger}"/>
                                                           </DataTemplate>
                                                       </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <ComboBox Width="150"
                                                          Margin="0,0,8,8"
                                                          Classes="compact"
                                                          ItemsSource="{Binding SnapshotTagFilters}"
                                                          SelectedItem="{Binding SelectedSnapshotTagFilter, Mode=TwoWay}">
                                                    <ComboBox.SelectionBoxItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <TextBlock Text="{Binding ., Converter={x:Static conv:LocalizedOptionTextConverter.Instance}, ConverterParameter=search.snapshot_tag}"/>
                                                        </DataTemplate>
                                                    </ComboBox.SelectionBoxItemTemplate>
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <TextBlock Text="{Binding ., Converter={x:Static conv:LocalizedOptionTextConverter.Instance}, ConverterParameter=search.snapshot_tag}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <TextBox Width="112"
                                                         Margin="0,0,8,8"
                                                         Classes="compact"
                                                         Text="{Binding SnapshotHistoryMinChangedFiles, Mode=TwoWay}"
                                                         Watermark="{loc:Tr explorer.min_changed_files}"/>
                                                <Button Margin="0,0,8,8"
                                                         Content="{loc:Tr explorer.clear_filters}"
                                                         Command="{Binding ClearSnapshotHistoryFiltersCommand}"
                                                         Classes="subtle compact"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Grid.Row="2"
                                                Spacing="6"
                                                IsVisible="{Binding IsSnapshotHistoryLoading}">
                                        <TextBlock Text="{loc:Tr explorer.loading_commits}"
                                                   Classes="muted"/>
                                        <ProgressBar Classes="loading-progress" IsIndeterminate="True"/>
                                    </StackPanel>

                                    <Grid Grid.Row="3">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      IsVisible="{Binding HasSnapshotHistory}">
                                             <ListBox Classes="clean-list"
                                                      ItemsSource="{Binding SnapshotHistory}"
                                                      SelectedItem="{Binding SelectedSnapshot, Mode=TwoWay}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="explorer:RepositorySnapshotHistoryEntryViewModel">
                                                        <Border Padding="10" Background="Transparent" BorderThickness="0">
                                                       <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                                                           <TextBlock Grid.Row="0" Text="{Binding DisplayTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                           <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                                                               <TextBlock Text="{Binding KindLabel}" Classes="muted" FontSize="11"/>
                                                               <Border Background="#223B5B" CornerRadius="8" Padding="6,1" IsVisible="{Binding IsArchived}">
                                                                   <TextBlock Text="{Binding ArchivedLabel}" Foreground="#A9D3FF" FontSize="10" FontWeight="SemiBold"/>
                                                               </Border>
                                                           </StackPanel>
                                                           <TextBlock Grid.Row="2" Text="{Binding DisplayTime}" Classes="muted" FontSize="11"/>
                                                           <TextBlock Grid.Row="3" Text="{Binding ChangedFilesLabel}" Classes="muted" FontSize="11"/>
                                                           <TextBlock Grid.Row="4" Text="{Binding TagsLabel}" Classes="muted" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding HasTags}"/>
                                                       </Grid>
                                                   </Border>
                                               </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </ScrollViewer>

                                        <TextBlock Text="{loc:Tr explorer.no_commits}"
                                                   Classes="muted"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   IsVisible="{Binding HasNoSnapshotHistory}"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <GridSplitter x:Name="SnapshotHistoryLeftSplitter" Grid.Column="1"
                                          Width="6"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          ResizeDirection="Columns"
                                          ResizeBehavior="PreviousAndNext"/>

                            <Border x:Name="SnapshotHistoryFilesPanel" Grid.Column="2" Classes="card" Padding="14" Margin="14,0">
                                <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
                                    <TextBlock Grid.Row="0" Text="{loc:Tr explorer.files_in_selected_commit}" Classes="section-title"/>

                                    <Border Grid.Row="1" Classes="filter-sheet" Padding="12">
                                        <StackPanel Spacing="10">
                                            <TextBox Text="{Binding SnapshotFilesSearchQuery, Mode=TwoWay}"
                                                     Classes="compact"
                                                     Watermark="{loc:Tr explorer.search_commit_files}"/>
                                            <WrapPanel Orientation="Horizontal">
                                                <ComboBox Width="160"
                                                          Margin="0,0,8,8"
                                                          Classes="compact"
                                                          ItemsSource="{Binding SnapshotFileChangeKindFilters}"
                                                          SelectedItem="{Binding SelectedSnapshotFileChangeKindFilter, Mode=TwoWay}">
                                                    <ComboBox.SelectionBoxItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <TextBlock Text="{Binding ., Converter={x:Static conv:LocalizedOptionTextConverter.Instance}, ConverterParameter=explorer.snapshot_change_kind}"/>
                                                        </DataTemplate>
                                                    </ComboBox.SelectionBoxItemTemplate>
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <TextBlock Text="{Binding ., Converter={x:Static conv:LocalizedOptionTextConverter.Instance}, ConverterParameter=explorer.snapshot_change_kind}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <ComboBox Width="140"
                                                          Margin="0,0,8,8"
                                                          Classes="compact"
                                                          ItemsSource="{Binding SnapshotFileExtensionFilters}"
                                                          SelectedItem="{Binding SelectedSnapshotFileExtensionFilter, Mode=TwoWay}">
                                                    <ComboBox.SelectionBoxItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <TextBlock Text="{Binding .}"/>
                                                        </DataTemplate>
                                                    </ComboBox.SelectionBoxItemTemplate>
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <TextBlock Text="{Binding .}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <TextBox Width="112"
                                                         Margin="0,0,8,8"
                                                         Classes="compact"
                                                         Text="{Binding SnapshotFilesMinSizeDeltaKb, Mode=TwoWay}"
                                                         Watermark="{loc:Tr explorer.min_delta_kb}"/>
                                                <Button Margin="0,0,8,8"
                                                         Content="{loc:Tr explorer.clear_filters}"
                                                         Command="{Binding ClearSnapshotFilesFiltersCommand}"
                                                         Classes="subtle compact"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Grid.Row="2" Spacing="4">
                                        <TextBlock Text="{loc:Tr explorer.select_commit_for_changes}"
                                                   Classes="muted"
                                                   IsVisible="{Binding HasNoSelectedSnapshot}"/>
                                        <TextBlock Text="{loc:Tr explorer.loading_changed_files}"
                                                   Classes="muted"
                                                   IsVisible="{Binding IsSnapshotFilesLoading}"/>
                                        <ProgressBar Classes="loading-progress"
                                                     IsIndeterminate="True"
                                                     IsVisible="{Binding IsSnapshotFilesLoading}"/>
                                    </StackPanel>

                                    <Grid Grid.Row="3">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      IsVisible="{Binding HasSnapshotFiles}">
                                             <ListBox Classes="clean-list"
                                                      ItemsSource="{Binding SnapshotFiles}"
                                                      SelectedItem="{Binding SelectedSnapshotFile, Mode=TwoWay}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="explorer:RepositorySnapshotFileChangeViewModel">
                                                        <Border Padding="10" Background="Transparent" BorderThickness="0">
                                                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" RowSpacing="4">
                                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding ChangeKindLabel}" FontWeight="SemiBold"/>
                                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding SizeDeltaLabel}" Classes="muted"/>
                                                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                                                           Text="{Binding RelativePath}"
                                                                           Classes="muted"
                                                                           FontSize="11"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </ScrollViewer>

                                        <TextBlock Text="{loc:Tr explorer.no_changed_files_in_commit}"
                                                   Classes="muted"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   IsVisible="{Binding HasNoSnapshotFiles}"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <GridSplitter x:Name="SnapshotHistoryRightSplitter" Grid.Column="3"
                                          Width="6"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          ResizeDirection="Columns"
                                          ResizeBehavior="PreviousAndNext"/>

                            <Border x:Name="SnapshotHistoryVersionsPanel" Grid.Column="4" Classes="card" Padding="14">
                                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                                    <StackPanel Grid.Row="0" Spacing="4">
                                        <TextBlock Text="{loc:Tr explorer.version_controls}" Classes="section-title"/>
                                        <TextBlock Text="{loc:Tr explorer.select_file_for_version_controls}"
                                                   Classes="muted"
                                                   FontSize="12"
                                                   IsVisible="{Binding HasNoSelectedItem}"/>
                                    </StackPanel>

                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <StackPanel Spacing="10" IsVisible="{Binding HasSelectedItem}">
                                            <Border Classes="metric-card">
                                                <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="92,*" RowSpacing="6" ColumnSpacing="10">
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr common.name}" Classes="label"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedItem.Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>

                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Tr common.path}" Classes="label"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedItem.RelativePath}" Classes="muted" TextWrapping="Wrap"/>

                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Tr common.type}" Classes="label"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedItem.Type}"/>

                                                    <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="92,*,92,*" ColumnSpacing="10">
                                                        <TextBlock Grid.Column="0" Text="{loc:Tr common.size}" Classes="label"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding SelectedItem.SizeDisplay}"/>
                                                        <TextBlock Grid.Column="2" Text="{loc:Tr common.modified}" Classes="label"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding SelectedItem.ModifiedDisplay}"/>
                                                    </Grid>
                                                </Grid>
                                            </Border>

                                            <Border Classes="filter-sheet" Padding="12">
                                                <StackPanel Spacing="8">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                        <TextBlock Text="{loc:Tr explorer.file_versions}" FontWeight="SemiBold"/>
                                                        <Button Grid.Column="1"
                                                                Content="{Binding FileVersionsToggleLabel}"
                                                                Command="{Binding ToggleFileVersionsViewCommand}"
                                                                Classes="subtle compact"
                                                                IsVisible="{Binding CanToggleFileVersionsView}"/>
                                                    </Grid>

                                                    <StackPanel Spacing="6" IsVisible="{Binding IsVersionLoading}">
                                                        <TextBlock Text="{loc:Tr explorer.loading_versions}" Classes="muted"/>
                                                        <ProgressBar Classes="loading-progress" IsIndeterminate="True"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding VersionPanelError}"
                                                               Foreground="{DynamicResource VeyraDangerBrush}"
                                                               TextWrapping="Wrap"
                                                               IsVisible="{Binding HasVersionPanelError}"/>
                                                    <TextBlock Text="{loc:Tr explorer.no_versions_for_selected_file}" Classes="muted" IsVisible="{Binding HasNoFileVersions}"/>

                                                     <ListBox Classes="clean-list"
                                                              ItemsSource="{Binding VisibleFileVersions}"
                                                              SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                                                              MaxHeight="220">
                                                         <ListBox.ItemTemplate>
                                                             <DataTemplate x:DataType="explorer:ExplorerFileVersionViewModel">
                                                                 <Border Padding="8" Background="Transparent" BorderThickness="0">
                                                                     <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                                         <TextBlock Grid.Column="0" Text="{Binding VersionName}" FontWeight="SemiBold"/>
                                                                         <TextBlock Grid.Column="1" Text="{Binding CreatedAtDisplay}" Classes="muted"/>
                                                                         <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" Classes="muted"/>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </StackPanel>
                                            </Border>

                                            <Border Classes="metric-card">
                                                <StackPanel Spacing="10">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="{loc:Tr explorer.version_compare}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding ComparePairSummary}" Classes="muted" TextWrapping="Wrap"/>
                                                        </StackPanel>

                                                        <Button Grid.Column="1"
                                                                Command="{Binding CompareSelectedVersionsCommand}"
                                                                IsEnabled="{Binding CanCompareSelectedVersionPair}"
                                                                Classes="primary responsive-icon"
                                                                VerticalAlignment="Top"
                                                                ToolTip.Tip="{loc:Tr explorer.compare_in_window}">
                                                            <Button.Content>
                                                                <StackPanel Classes="button-content">
                                                                    <TextBlock Classes="button-icon" Text="&#xE8AB;"/>
                                                                    <TextBlock Classes="button-label" Text="{loc:Tr explorer.compare_in_window}"/>
                                                                </StackPanel>
                                                            </Button.Content>
                                                        </Button>
                                                    </Grid>

                                                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8">
                                                        <StackPanel Grid.Column="0" Spacing="4">
                                                            <TextBlock Text="{loc:Tr explorer.left_version}" Classes="label"/>
                                                            <ComboBox Classes="compact"
                                                                      ItemsSource="{Binding FileVersions}"
                                                                      SelectedItem="{Binding CompareLeftVersion, Mode=TwoWay}">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="explorer:ExplorerFileVersionViewModel">
                                                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                        </StackPanel>

                                                        <Button Grid.Column="1"
                                                                Content="&#xE8AB;"
                                                                Classes="subtle icon"
                                                                VerticalAlignment="Bottom"
                                                                ToolTip.Tip="{loc:Tr common.swap}"
                                                                Command="{Binding SwapCompareVersionsCommand}"
                                                                IsEnabled="{Binding CanSwapCompareVersions}"/>

                                                        <StackPanel Grid.Column="2" Spacing="4">
                                                            <TextBlock Text="{loc:Tr explorer.right_version}" Classes="label"/>
                                                            <ComboBox Classes="compact"
                                                                      ItemsSource="{Binding FileVersions}"
                                                                      SelectedItem="{Binding CompareRightVersion, Mode=TwoWay}">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="explorer:ExplorerFileVersionViewModel">
                                                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <Border Classes="card" Padding="10" IsVisible="{Binding HasSelectedVersion}">
                                                <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="100,*" RowSpacing="4" ColumnSpacing="8">
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr common.path}" Classes="label"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedItem.RelativePath}" TextWrapping="Wrap"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Tr common.version}" Classes="label"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedVersion.VersionName}"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Tr common.size}" Classes="label"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedVersion.SizeDisplay}"/>
                                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Tr common.date}" Classes="label"/>
                                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedVersion.CreatedAtDisplay}"/>
                                                </Grid>
                                            </Border>

                                            <TextBlock Text="{loc:Tr explorer.no_content_blocks_for_version}"
                                                       Foreground="{DynamicResource VeyraWarningBrush}"
                                                       TextWrapping="Wrap"
                                                       IsVisible="{Binding SelectedVersionHasNoContentBlocks}"/>

                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button
                                                        Command="{Binding RestoreVersionAsCopyCommand}"
                                                        IsEnabled="{Binding CanRestoreSelectedVersion}"
                                                        Classes="subtle responsive-icon"
                                                        ToolTip.Tip="{loc:Tr explorer.restore_as_copy}">
                                                    <Button.Content>
                                                        <StackPanel Classes="button-content">
                                                            <TextBlock Classes="button-icon" Text="&#xE8C8;"/>
                                                            <TextBlock Classes="button-label" Text="{loc:Tr explorer.restore_as_copy}"/>
                                                        </StackPanel>
                                                    </Button.Content>
                                                </Button>
                                                <Button
                                                        Command="{Binding RestoreVersionOverwriteCommand}"
                                                        IsEnabled="{Binding CanRestoreSelectedVersion}"
                                                        Classes="responsive-icon"
                                                        ToolTip.Tip="{loc:Tr explorer.restore_overwrite}">
                                                    <Button.Content>
                                                        <StackPanel Classes="button-content">
                                                            <TextBlock Classes="button-icon" Text="&#xE7C3;"/>
                                                            <TextBlock Classes="button-label" Text="{loc:Tr explorer.restore_overwrite}"/>
                                                        </StackPanel>
                                                    </Button.Content>
                                                </Button>
                                            </StackPanel>

                                            <Border Classes="metric-card" IsVisible="{Binding IsVersionActionRunning}">
                                                <StackPanel Classes="loading-state">
                                                    <TextBlock Text="{Binding VersionActionProgressTitle}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding VersionActionProgressDetail}"
                                                               Classes="muted"
                                                               TextWrapping="Wrap"/>
                                                    <ProgressBar Classes="loading-progress" IsIndeterminate="True"/>
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Text="{Binding VersionActionMessage}"
                                                       TextWrapping="Wrap"
                                                       Opacity="0.9"
                                                       IsVisible="{Binding HasVersionActionMessage}"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
    </Grid>
</Window>
