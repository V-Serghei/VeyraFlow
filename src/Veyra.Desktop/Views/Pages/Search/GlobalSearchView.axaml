<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Veyra.Desktop.Localization"
             xmlns:conv="clr-namespace:Veyra.Desktop.Converters"
             xmlns:vm="clr-namespace:Veyra.Desktop.ViewModels.Pages.Search"
             x:Class="Veyra.Desktop.Views.Pages.Search.GlobalSearchView"
             x:Name="Root"
             x:DataType="vm:GlobalSearchViewModel"
             Background="{DynamicResource VeyraCanvasBrush}">

    <Grid Margin="18">
        <Grid ColumnDefinitions="0.92*,1.18*" RowDefinitions="0.52*,0.48*" ColumnSpacing="14" RowSpacing="14" Margin="0,44,0,0">
                <Border Classes="card"
                        Padding="12"
                        Grid.Row="{Binding RepositorySectionRow}"
                        Grid.Column="{Binding RepositorySectionColumn}"
                        Grid.RowSpan="{Binding RepositorySectionRowSpan}"
                        Grid.ColumnSpan="{Binding RepositorySectionColumnSpan}"
                        IsVisible="{Binding IsRepositoriesSectionVisible}">
                    <Grid RowDefinitions="Auto,*" RowSpacing="10">
                        <StackPanel Grid.Row="0" Spacing="2">
                            <TextBlock Text="{loc:Tr search.repositories_section_title}" Classes="section-title"/>
                            <TextBlock Text="{Binding RepositoryResultsSummary}" Classes="muted" FontSize="12"/>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <TextBlock Text="{loc:Tr search.empty_repositories}"
                                       Classes="muted"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding HasRepositoryResults, Converter={x:Static conv:BoolInvertConverter.Instance}}"/>

                            <ListBox IsVisible="{Binding HasRepositoryResults}"
                                     Classes="clean-list passive-list"
                                     SelectedItem="{Binding SelectedRepositoryResult, Mode=TwoWay}"
                                     ItemsSource="{Binding RepositoryResults}">
                                <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:GlobalSearchRepositoryResultItemViewModel">
                                            <Border Classes="card" Padding="12" Margin="0,0,0,10">
                                                <StackPanel Spacing="8">
                                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                        <Button Grid.Column="1"
                                                                Content="{loc:Tr common.open}"
                                                                Classes="subtle"
                                                                Command="{Binding #Root.((vm:GlobalSearchViewModel)DataContext).OpenRepositoryCommand}"
                                                                CommandParameter="{Binding .}"/>
                                                        <Button Grid.Column="2"
                                                                Content="{loc:Tr common.settings}"
                                                                Classes="subtle"
                                                                Command="{Binding #Root.((vm:GlobalSearchViewModel)DataContext).OpenRepositorySettingsCommand}"
                                                                CommandParameter="{Binding .}"/>
                                                    </Grid>

                                                    <TextBlock Text="{Binding DirectoryPath}" Classes="muted" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" IsVisible="{Binding HasDescription}"/>
                                                    <TextBlock Text="{Binding FormatsText}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasFormats}"/>

                                                    <WrapPanel Orientation="Horizontal">
                                                        <Border Classes="badge" Margin="0,0,8,6">
                                                            <TextBlock Text="{Binding MetricsText}"/>
                                                        </Border>
                                                        <Border Classes="badge" Margin="0,0,8,6">
                                                            <TextBlock Text="{Binding StatusText}"/>
                                                        </Border>
                                                        <Border Classes="badge" Margin="0,0,8,6">
                                                            <TextBlock Text="{Binding LastScannedText}"/>
                                                        </Border>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Border>

                <Border Classes="card"
                        Padding="12"
                        Grid.Row="{Binding SnapshotSectionRow}"
                        Grid.Column="{Binding SnapshotSectionColumn}"
                        Grid.RowSpan="{Binding SnapshotSectionRowSpan}"
                        Grid.ColumnSpan="{Binding SnapshotSectionColumnSpan}"
                        IsVisible="{Binding IsSnapshotsSectionVisible}">
                    <Grid RowDefinitions="Auto,*" RowSpacing="10">
                        <StackPanel Grid.Row="0" Spacing="2">
                            <TextBlock Text="{loc:Tr search.snapshots_section_title}" Classes="section-title"/>
                            <TextBlock Text="{Binding SnapshotResultsSummary}" Classes="muted" FontSize="12"/>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <TextBlock Text="{loc:Tr search.empty_snapshots}"
                                       Classes="muted"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding HasSnapshotResults, Converter={x:Static conv:BoolInvertConverter.Instance}}"/>

                            <ListBox IsVisible="{Binding HasSnapshotResults}"
                                     Classes="clean-list passive-list"
                                     SelectedItem="{Binding SelectedSnapshotResult, Mode=TwoWay}"
                                     ItemsSource="{Binding SnapshotResults}">
                                <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:GlobalSearchSnapshotResultItemViewModel">
                                            <Border Classes="card" Padding="12" Margin="0,0,0,10">
                                                <StackPanel Spacing="8">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                        <StackPanel Grid.Column="0" Spacing="4">
                                                            <TextBlock Text="{Binding RepositoryName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" IsVisible="{Binding HasTitle}"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1"
                                                                Content="{loc:Tr common.open}"
                                                                Classes="primary"
                                                                Command="{Binding #Root.((vm:GlobalSearchViewModel)DataContext).OpenSnapshotCommand}"
                                                                CommandParameter="{Binding .}"/>
                                                    </Grid>

                                                    <WrapPanel Orientation="Horizontal">
                                                        <Border Classes="badge" Margin="0,0,8,6">
                                                            <TextBlock Text="{Binding TriggerText}"/>
                                                        </Border>
                                                        <Border Classes="badge" Margin="0,0,8,6">
                                                            <TextBlock Text="{Binding ChangedFilesText}"/>
                                                        </Border>
                                                        <Border Classes="badge" Margin="0,0,8,6">
                                                            <TextBlock Text="{Binding CreatedText}"/>
                                                        </Border>
                                                    </WrapPanel>

                                                    <TextBlock Text="{Binding TagsText}"
                                                               Classes="muted"
                                                               TextWrapping="Wrap"
                                                               IsVisible="{Binding HasTags}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Border>
            <Border Classes="card"
                    Padding="12"
                    Grid.Row="{Binding FileSectionRow}"
                    Grid.Column="{Binding FileSectionColumn}"
                    Grid.RowSpan="{Binding FileSectionRowSpan}"
                    Grid.ColumnSpan="{Binding FileSectionColumnSpan}"
                    IsVisible="{Binding IsFilesSectionVisible}">
                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                    <StackPanel Grid.Row="0" Spacing="2">
                        <TextBlock Text="{loc:Tr search.files_section_title}" Classes="section-title"/>
                        <TextBlock Text="{Binding FileResultsSummary}" Classes="muted" FontSize="12"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <TextBlock Text="{loc:Tr search.empty_files}"
                                   Classes="muted"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding HasFileResults, Converter={x:Static conv:BoolInvertConverter.Instance}}"/>

                        <ListBox IsVisible="{Binding HasFileResults}"
                                 Classes="clean-list passive-list"
                                 ItemsSource="{Binding FileResults}">
                            <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GlobalSearchFileResultItemViewModel">
                                        <Border Classes="card" Padding="12" Margin="0,0,0,10">
                                            <StackPanel Spacing="8">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <StackPanel Grid.Column="0" Spacing="4">
                                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding RelativePath}" Classes="muted" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Content="{loc:Tr common.open}"
                                                            Classes="primary"
                                                            Command="{Binding #Root.((vm:GlobalSearchViewModel)DataContext).OpenEntryCommand}"
                                                            CommandParameter="{Binding .}"/>
                                                </Grid>

                                                <TextBlock Text="{Binding ParentPath}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasParentPath}"/>
                                                <TextBlock Text="{Binding TagsText}"
                                                           Classes="muted"
                                                           TextWrapping="Wrap"
                                                           IsVisible="{Binding HasTags}"/>

                                                <WrapPanel Orientation="Horizontal">
                                                    <Border Classes="badge" Margin="0,0,8,6">
                                                        <TextBlock Text="{Binding RepositoryBadgeText}"/>
                                                    </Border>
                                                    <Border Classes="badge" Margin="0,0,8,6">
                                                        <TextBlock Text="{Binding KindText}"/>
                                                    </Border>
                                                    <Border Classes="badge" Margin="0,0,8,6" IsVisible="{Binding HasExtension}">
                                                        <TextBlock Text="{Binding ExtensionText}"/>
                                                    </Border>
                                                    <Border Classes="badge" Margin="0,0,8,6">
                                                        <TextBlock Text="{Binding SizeText}"/>
                                                    </Border>
                                                    <Border Classes="badge" Margin="0,0,8,6">
                                                        <TextBlock Text="{Binding ModifiedText}"/>
                                                    </Border>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>

            <TextBlock Text="{loc:Tr search.no_visible_sections}"
                       Classes="muted"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasAnyVisibleSection, Converter={x:Static conv:BoolInvertConverter.Instance}}"
                       Grid.RowSpan="2"
                       Grid.ColumnSpan="2"/>
        </Grid>

        <StackPanel Orientation="Horizontal"
                    Spacing="10"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top">
            <TextBlock Text="{Binding LastUpdatedText}"
                       Classes="muted"
                       FontSize="11"
                       IsVisible="{Binding HasLastUpdatedText}"
                       VerticalAlignment="Center"/>
            <Button Classes="ghost icon compact"
                    Command="{Binding RefreshCommand}"
                    IsEnabled="{Binding CanRefresh}"
                    ToolTip.Tip="{loc:Tr search.refresh_index}">
                <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            </Button>
            <Button Classes="subtle compact responsive-icon"
                    Padding="10,7"
                    Command="{Binding ToggleSectionPanelCommand}"
                    ToolTip.Tip="{loc:Tr search.toggle_sections}">
                <StackPanel Classes="button-content">
                    <TextBlock Classes="button-icon" Text="&#xE8A9;"/>
                    <TextBlock Classes="button-label" Text="{Binding SectionButtonLabel}"/>
                </StackPanel>
            </Button>
            <Button Classes="subtle compact responsive-icon"
                    Padding="10,7"
                    Command="{Binding ToggleFilterPanelCommand}"
                    ToolTip.Tip="{loc:Tr search.toggle_filters}">
                <StackPanel Classes="button-content">
                    <TextBlock Classes="button-icon" Text="&#xE71C;"/>
                    <TextBlock Classes="button-label" Text="{Binding FilterButtonLabel}"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <Border Background="#01000000"
                IsVisible="{Binding IsSectionPanelVisible}"
                PointerPressed="OnFloatingPanelBackdropPressed"/>

        <Border Background="#01000000"
                IsVisible="{Binding IsFilterPanelVisible}"
                PointerPressed="OnFloatingPanelBackdropPressed"/>

        <Border Classes="filter-sheet floating-panel"
                Padding="14"
                Width="320"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,44,150,0"
                IsVisible="{Binding IsSectionPanelVisible}">
            <StackPanel Spacing="10">
                <TextBlock Text="{loc:Tr search.sections_title}" Classes="section-title"/>
                <TextBlock Text="{loc:Tr search.sections_hint}" Classes="muted" FontSize="12" TextWrapping="Wrap"/>

                <CheckBox Content="{loc:Tr search.linked_search}"
                          IsChecked="{Binding IsLinkedSearchEnabled, Mode=TwoWay}"/>
                <TextBlock Text="{Binding LinkedSelectionText}" Classes="muted" FontSize="12" TextWrapping="Wrap"/>

                <Button Command="{Binding ToggleRepositoriesSectionCommand}" Classes="subtle">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBlock Text="{loc:Tr search.repositories_section_title}" FontWeight="SemiBold"/>
                        <Border Grid.Column="1" Classes="badge">
                            <TextBlock FontSize="11"
                                   Text="{Binding RepositorySectionStateText}"/>
                        </Border>
                    </Grid>
                </Button>
                <Button Command="{Binding ToggleSnapshotsSectionCommand}" Classes="subtle">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBlock Text="{loc:Tr search.snapshots_section_title}" FontWeight="SemiBold"/>
                        <Border Grid.Column="1" Classes="badge">
                            <TextBlock FontSize="11"
                                   Text="{Binding SnapshotSectionStateText}"/>
                        </Border>
                    </Grid>
                </Button>
                <Button Command="{Binding ToggleFilesSectionCommand}" Classes="subtle">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBlock Text="{loc:Tr search.files_section_title}" FontWeight="SemiBold"/>
                        <Border Grid.Column="1" Classes="badge">
                            <TextBlock FontSize="11"
                                   Text="{Binding FileSectionStateText}"/>
                        </Border>
                    </Grid>
                </Button>

                <Button Content="{loc:Tr search.clear_linked_selection}"
                        Command="{Binding ClearLinkedSelectionCommand}"
                        Classes="ghost compact"/>
            </StackPanel>
        </Border>

        <Border Classes="filter-sheet floating-panel"
                Padding="16"
                MaxWidth="1180"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Margin="0,44,0,0"
                IsVisible="{Binding IsFilterPanelVisible}">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <TextBox Grid.Column="0"
                             Text="{Binding SearchQuery, Mode=TwoWay}"
                             Watermark="{loc:Tr search.search_placeholder}"/>

                    <Button Grid.Column="1"
                            Content="{loc:Tr search.clear_filters}"
                            Command="{Binding ClearFiltersCommand}"
                            Classes="subtle"/>
                    <Button Grid.Column="2"
                            Content="{loc:Tr common.close}"
                            Command="{Binding ToggleFilterPanelCommand}"
                            Classes="subtle"/>
                </Grid>

                <WrapPanel Orientation="Horizontal">
                    <StackPanel Width="220" Spacing="4" Margin="0,0,12,12">
                        <TextBlock Text="{loc:Tr search.filter_repository}" Classes="label"/>
                        <ComboBox ItemsSource="{Binding RepositoryFilters}"
                                  SelectedItem="{Binding SelectedRepositoryFilter, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:GlobalSearchRepositoryFilterOptionViewModel">
                                    <TextBlock Text="{Binding Label}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Width="190" Spacing="4" Margin="0,0,12,12">
                        <TextBlock Text="{loc:Tr search.filter_tracked_format}" Classes="label"/>
                        <ComboBox ItemsSource="{Binding TrackedFormatFilters}"
                                  SelectedItem="{Binding SelectedTrackedFormatFilter, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Width="160" Spacing="4" Margin="0,0,12,12">
                        <TextBlock Text="{loc:Tr search.filter_entry_type}" Classes="label"/>
                        <ComboBox ItemsSource="{Binding EntryTypeFilters}"
                                  SelectedItem="{Binding SelectedEntryTypeFilter, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding ., Converter={x:Static conv:LocalizedOptionTextConverter.Instance}, ConverterParameter=explorer.entry_type}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Width="150" Spacing="4" Margin="0,0,12,12">
                        <TextBlock Text="{loc:Tr search.filter_extension}" Classes="label"/>
                        <ComboBox ItemsSource="{Binding ExtensionFilters}"
                                  SelectedItem="{Binding SelectedExtensionFilter, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Width="190" Spacing="4" Margin="0,0,12,12">
                        <TextBlock Text="{loc:Tr search.filter_modified_window}" Classes="label"/>
                        <ComboBox ItemsSource="{Binding ModifiedWindowFilters}"
                                  SelectedItem="{Binding SelectedModifiedWindowFilter, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding ., Converter={x:Static conv:LocalizedOptionTextConverter.Instance}, ConverterParameter=explorer.modified_window}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Width="170" Spacing="4" Margin="0,0,12,12">
                        <TextBlock Text="{loc:Tr search.filter_snapshot_tag}" Classes="label"/>
                        <ComboBox ItemsSource="{Binding SnapshotTagFilters}"
                                  SelectedItem="{Binding SelectedSnapshotTagFilter, Mode=TwoWay}">
                            <ComboBox.SelectionBoxItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding ., Converter={x:Static conv:LocalizedOptionTextConverter.Instance}, ConverterParameter=search.snapshot_tag}"/>
                                </DataTemplate>
                            </ComboBox.SelectionBoxItemTemplate>
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding ., Converter={x:Static conv:LocalizedOptionTextConverter.Instance}, ConverterParameter=search.snapshot_tag}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Width="140" Spacing="4" Margin="0,0,12,12">
                        <TextBlock Text="{loc:Tr search.filter_min_size_mb}" Classes="label"/>
                        <TextBox Text="{Binding MinSizeMb, Mode=TwoWay}" Watermark="0"/>
                    </StackPanel>

                    <StackPanel Width="140" Spacing="4" Margin="0,0,12,12">
                        <TextBlock Text="{loc:Tr search.filter_max_size_mb}" Classes="label"/>
                        <TextBox Text="{Binding MaxSizeMb, Mode=TwoWay}" Watermark="0"/>
                    </StackPanel>
                </WrapPanel>

                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource VeyraInfoBrush}"
                           TextWrapping="Wrap"
                           IsVisible="{Binding HasStatusMessage}"/>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource VeyraWarningBrush}"
                           TextWrapping="Wrap"
                           IsVisible="{Binding HasErrorMessage}"/>
                <Grid ColumnDefinitions="220,*,Auto,Auto" ColumnSpacing="10" IsVisible="{Binding HasSavedFilters}">
                    <TextBlock Grid.Column="0"
                               Text="{loc:Tr search.saved_filters}"
                               Classes="label"
                               VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding SavedFilters}"
                              SelectedItem="{Binding SelectedSavedFilter, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:GlobalSearchSavedFilterViewModel">
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="2"
                            Content="{loc:Tr search.apply_saved_filter}"
                            Command="{Binding ApplySavedFilterCommand}"
                            CommandParameter="{Binding SelectedSavedFilter}"
                            Classes="subtle"/>
                    <Button Grid.Column="3"
                            Content="{loc:Tr common.delete}"
                            Command="{Binding DeleteSavedFilterCommand}"
                            CommandParameter="{Binding SelectedSavedFilter}"
                            Classes="subtle"/>
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBox Grid.Column="0"
                             Text="{Binding SavedFilterName, Mode=TwoWay}"
                             Watermark="{loc:Tr search.saved_filter_name_placeholder}"/>
                    <Button Grid.Column="1"
                            Content="{loc:Tr search.save_current_filter}"
                            Command="{Binding SaveCurrentFilterCommand}"
                            Classes="primary"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Classes="loading-overlay"
                Margin="18"
                IsVisible="{Binding IsBusy}">
            <Border Classes="loading-card"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="460"
                    MinWidth="340"
                    MaxWidth="460">
                <StackPanel Classes="loading-state">
                    <TextBlock Text="{Binding LoadingOverlayTitle}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding LoadingOverlayDetail}" Classes="muted" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding LoadingStatusText}" Classes="muted" TextWrapping="Wrap"
                               IsVisible="{Binding LoadingStatusText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
                    <ProgressBar Classes="loading-progress"
                                 HorizontalAlignment="Stretch"
                                 IsIndeterminate="True"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
