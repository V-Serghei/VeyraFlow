<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Veyra.Desktop.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:settings="clr-namespace:Veyra.Desktop.ViewModels.Pages.RepositorySettings"
             xmlns:conv="clr-namespace:Veyra.Desktop.Converters"
             x:Class="Veyra.Desktop.Views.Pages.RepositorySettings.RepositorySettingsView"
             x:Name="Root"
             x:DataType="settings:RepositorySettingsViewModel"
             Background="{DynamicResource VeyraCanvasBrush}">

    <DockPanel Margin="18">
        <Border DockPanel.Dock="Top" Classes="hero" Padding="18" Margin="0,0,0,12">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Button Grid.Column="0"
                        Content="{loc:Tr common.back}"
                        Command="{Binding BackCommand}"
                        Classes="subtle"/>

                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="{loc:Tr repo_settings.title}" Classes="h2"/>
                    <TextBlock Text="{Binding RepositoryName}" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding DirectoryPath}" Classes="muted" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Border Grid.Column="2" Classes="badge" VerticalAlignment="Top">
                    <TextBlock Text="{Binding CloudSyncStatusText}" FontSize="11" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Classes="toolbar" Padding="14" Margin="0,12,0,0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBlock Grid.Column="0"
                           Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource VeyraDangerBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="{loc:Tr common.save}"
                            Command="{Binding SaveCommand}"
                            Classes="primary"
                            Padding="14,8"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                <StackPanel Grid.Column="0" Spacing="14">
                    <Border Classes="card" Padding="16">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{loc:Tr repo_settings.repository_section_title}" Classes="section-title"/>
                                <TextBlock Text="{loc:Tr repo_settings.repository_section_hint}" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="{loc:Tr repo_settings.repository_name}" Classes="label"/>
                                <TextBox Text="{Binding RepositoryName, Mode=TwoWay}"/>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="{loc:Tr repo_settings.description}" Classes="label"/>
                                <TextBox Text="{Binding Description, Mode=TwoWay}" Height="110" AcceptsReturn="True"/>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="{loc:Tr repo_settings.directory_path}" Classes="label"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox Grid.Column="0" Text="{Binding DirectoryPath, Mode=TwoWay}"/>
                                    <Button Grid.Column="1" Content="{loc:Tr common.browse}" Command="{Binding BrowseDirectoryCommand}" Classes="subtle"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="card" Padding="16">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{loc:Tr repo_settings.tracked_formats}" Classes="section-title"/>
                                <TextBlock Text="{loc:Tr repo_settings.formats_hint}" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Text="{loc:Tr repo_settings.selected_formats}" Classes="label"/>
                                <ItemsControl ItemsSource="{Binding SelectedFormats}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Border Classes="chip" Padding="8,4" Margin="0,0,8,8">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding .}"/>
                                                    <Button Content="&#xE711;"
                                                            Width="22"
                                                            Height="22"
                                                            Padding="0"
                                                            Classes="ghost icon"
                                                            ToolTip.Tip="{loc:Tr common.remove}"
                                                            Command="{Binding #Root.((settings:RepositorySettingsViewModel)DataContext).RemoveFormatCommand}"
                                                            CommandParameter="{Binding .}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Text="{loc:Tr repo_settings.available_formats}" Classes="label"/>
                                <ItemsControl ItemsSource="{Binding AvailableFormats}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Button Content="{Binding .}"
                                                    Margin="0,0,8,8"
                                                    Classes="subtle"
                                                    Command="{Binding #Root.((settings:RepositorySettingsViewModel)DataContext).AddAvailableFormatCommand}"
                                                    CommandParameter="{Binding .}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="{loc:Tr repo_settings.add_custom_format}" Classes="label"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox Grid.Column="0"
                                             Text="{Binding CustomFormat, Mode=TwoWay}"
                                             Watermark="{loc:Tr repo_settings.example_sql}"/>
                                    <Button Grid.Column="1"
                                            Content="{loc:Tr common.add}"
                                            Command="{Binding AddCustomFormatCommand}"
                                            Classes="subtle"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="card" BorderBrush="{DynamicResource VeyraDangerBrush}" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{loc:Tr repo_settings.danger_zone_title}"
                                       Classes="section-title"
                                       Foreground="{DynamicResource VeyraDangerBrush}"/>
                            <TextBlock Text="{loc:Tr repo_settings.danger_zone_description}"
                                       Classes="muted"
                                       TextWrapping="Wrap"/>
                            <Button Content="{loc:Tr repo_settings.delete_repository}"
                                    Command="{Binding DeleteCommand}"
                                    Classes="danger"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="14">
                    <Border Classes="card" Padding="16">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{loc:Tr dashboard.cloud_sync}" Classes="section-title"/>
                                <TextBlock Text="{loc:Tr repo_settings.sync_hint}" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Border Grid.Column="0" Classes="metric-card">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding CloudSyncStatusText}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource VeyraAccentBrush}"/>
                                        <TextBlock Text="{loc:Tr repo_settings.sync_status}" Classes="caption"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Classes="metric-card">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding CloudSyncLastSyncText}" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="{loc:Tr repo_settings.last_successful_sync}" Classes="caption"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="{loc:Tr repo_settings.conflict_strategy}" Classes="label"/>
                                    <ComboBox ItemsSource="{Binding SyncConflictStrategies}"
                                              SelectedItem="{Binding SyncConflictStrategy, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Text="{Binding ., Converter={x:Static conv:LocalizedOptionTextConverter.Instance}, ConverterParameter=repo.sync_conflict_strategy}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="{loc:Tr repo_settings.queue}" Classes="label"/>
                                    <TextBlock Text="{Binding CloudSyncQueueText}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="{loc:Tr repo_settings.retry_max_attempts}" Classes="label"/>
                                    <TextBox Text="{Binding SyncRetryMaxAttempts, Mode=TwoWay}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="{loc:Tr repo_settings.retry_base_delay_sec}" Classes="label"/>
                                    <TextBox Text="{Binding SyncRetryBaseDelaySeconds, Mode=TwoWay}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding CloudSyncErrorText}"
                                       Foreground="{DynamicResource VeyraWarningBrush}"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding CloudSyncErrorText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{loc:Tr repo_settings.sync_now}"
                                        Command="{Binding SyncNowCommand}"
                                        IsEnabled="{Binding IsSyncNowRunning, Converter={x:Static conv:BoolInvertConverter.Instance}}"
                                        Classes="primary"/>
                                <TextBlock Text="{loc:Tr common.running}"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding IsSyncNowRunning}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="card" Padding="16">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{loc:Tr repo_settings.bundle_title}" Classes="section-title"/>
                                <TextBlock Text="{loc:Tr repo_settings.bundle_hint}" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{loc:Tr repo_settings.export_bundle}"
                                        Command="{Binding ExportBundleCommand}"
                                        IsEnabled="{Binding CanRunBundleOperations}"
                                        Classes="subtle"/>
                                <Button Content="{loc:Tr repo_settings.import_bundle}"
                                        Command="{Binding ImportBundleCommand}"
                                        IsEnabled="{Binding CanRunBundleOperations}"
                                        Classes="subtle"/>
                                <TextBlock Text="{loc:Tr common.working}"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding IsBundleOperationRunning}"/>
                            </StackPanel>

                            <TextBlock Text="{Binding BundleOperationMessage}"
                                       Foreground="{DynamicResource VeyraInfoBrush}"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding HasBundleOperationMessage}"/>
                        </StackPanel>
                    </Border>

                    <Border Classes="card" Padding="16">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{loc:Tr repo_settings.retention_policy}" Classes="section-title"/>
                                <TextBlock Text="{loc:Tr repo_settings.retention_hint}" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>

                            <CheckBox Content="{loc:Tr repo_settings.enable_retention}"
                                      IsChecked="{Binding RetentionEnabled, Mode=TwoWay}"/>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="{loc:Tr repo_settings.max_age_days}" Classes="label"/>
                                    <TextBox Text="{Binding RetentionMaxAgeDays, Mode=TwoWay}" Watermark="{loc:Tr repo_settings.example_30}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="{loc:Tr repo_settings.max_snapshots}" Classes="label"/>
                                    <TextBox Text="{Binding RetentionMaxSnapshots, Mode=TwoWay}" Watermark="{loc:Tr repo_settings.example_200}"/>
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="{loc:Tr repo_settings.max_total_size_mb}" Classes="label"/>
                                    <TextBox Text="{Binding RetentionMaxTotalSizeMb, Mode=TwoWay}" Watermark="{loc:Tr repo_settings.example_2048}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="{loc:Tr repo_settings.run_interval_minutes}" Classes="label"/>
                                    <TextBox Text="{Binding RetentionRunIntervalMinutes, Mode=TwoWay}"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="6">
                                <TextBlock Text="{loc:Tr repo_settings.trigger_filter}" Classes="label"/>
                                <TextBox Text="{Binding RetentionTriggerFilter, Mode=TwoWay}" Watermark="{loc:Tr repo_settings.trigger_placeholder}"/>
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Border Grid.Column="0" Classes="metric-card">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding RetentionLastRunText}" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="{loc:Tr repo_settings.last_run}" Classes="caption"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Classes="metric-card">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding RetentionLastStatusText}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{loc:Tr repo_settings.last_status}" Classes="caption"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{loc:Tr repo_settings.dry_run}" Command="{Binding RunRetentionDryRunCommand}" Classes="subtle"/>
                                <Button Content="{loc:Tr repo_settings.apply_retention}" Command="{Binding RunRetentionApplyCommand}" Classes="primary"/>
                                <Button Content="{loc:Tr common.cancel}" Command="{Binding CancelRetentionCommand}" Classes="subtle"/>
                            </StackPanel>

                            <TextBlock Text="{Binding RetentionProgressText}"
                                       Classes="muted"
                                       IsVisible="{Binding RetentionProgressText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
                            <TextBlock Text="{Binding RetentionResultText}"
                                       Foreground="{DynamicResource VeyraInfoBrush}"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding RetentionResultText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
