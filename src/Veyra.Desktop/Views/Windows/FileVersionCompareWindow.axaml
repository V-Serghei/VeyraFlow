<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Veyra.Desktop.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:windows="clr-namespace:Veyra.Desktop.ViewModels.Windows"
        xmlns:explorer="clr-namespace:Veyra.Desktop.ViewModels.Pages.Explorer"
        xmlns:conv="clr-namespace:Veyra.Desktop.Converters"
        mc:Ignorable="d"
        x:Class="Veyra.Desktop.Views.Windows.FileVersionCompareWindow"
        x:Name="Root"
        x:DataType="windows:FileVersionCompareWindowViewModel"
        Width="1180"
        Height="800"
        MinWidth="980"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="Full"
        CanResize="True"
        Background="{DynamicResource VeyraCanvasBrush}"
        Foreground="{DynamicResource VeyraTextPrimaryBrush}"
        Title="{loc:Tr compare.window_title}">

    <Grid RowDefinitions="Auto,*,Auto" Margin="16" RowSpacing="12">
        <Border Grid.Row="0" Classes="dialog-shell" Padding="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="{loc:Tr compare.window_title}"
                               FontSize="16"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding SelectedPairSummary}"
                               Classes="muted"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="Wrap"
                               IsVisible="{Binding IsImagePreview, Converter={x:Static conv:BoolInvertConverter.Instance}}"/>
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource VeyraDangerBrush}"
                               IsVisible="{Binding HasErrorMessage}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <WrapPanel Grid.Column="1"
                           Orientation="Horizontal"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center">
                    <Button Classes="subtle compact"
                            Command="{Binding ToggleSvgCodePreviewCommand}"
                            IsVisible="{Binding IsSvgFile}"
                            IsEnabled="{Binding CanToggleSvgCodePreview}"
                            Margin="0,0,8,0">
                        <StackPanel Classes="button-content">
                            <TextBlock Classes="button-icon" Text="&#xE943;"/>
                            <TextBlock Classes="button-label" Text="{Binding SvgCodePreviewToggleLabel}"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="subtle compact"
                            Command="{Binding ToggleShowImageDiffDetailsCommand}"
                            Margin="0,0,8,0"
                            IsVisible="{Binding IsImagePreview}">
                        <StackPanel Classes="button-content">
                            <TextBlock Classes="button-icon" Text="i"/>
                            <TextBlock Classes="button-label" Text="{Binding ImageDiffDetailsToggleLabel}"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="subtle compact"
                            Command="{Binding ToggleShowImageDiffSettingsCommand}"
                            Margin="0,0,8,0"
                            IsVisible="{Binding IsImagePreview}">
                        <StackPanel Classes="button-content">
                            <TextBlock Classes="button-icon" Text="&#xE713;"/>
                            <TextBlock Classes="button-label" Text="{Binding ImageDiffSettingsToggleLabel}"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="subtle compact"
                            Command="{Binding ToggleImagePreviewToolbarCommand}">
                        <StackPanel Classes="button-content">
                            <TextBlock Classes="button-icon" Text="&#xE70F;"/>
                            <TextBlock Classes="button-label" Text="{loc:Tr compare.image_controls}"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="280" MaxWidth="520"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*" MinWidth="720"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Classes="dialog-shell" MinWidth="280" MaxWidth="520">
                <Grid RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="{Binding ShowImageDiffDetails, Converter={x:Static conv:BooleanToGridLengthConverter.Instance}, ConverterParameter=8}"/>
                        <RowDefinition Height="{Binding ShowImageDiffDetails, Converter={x:Static conv:BooleanToGridLengthConverter.Instance}, ConverterParameter=220}"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" RowDefinitions="Auto,Auto,*" RowSpacing="8">
                        <TextBlock Grid.Row="0" Text="{loc:Tr compare.version_history}" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="1"
                                   Classes="muted"
                                   Text="{loc:Tr compare.selection_instruction}"
                                   TextWrapping="Wrap"/>

                        <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="8">
                            <StackPanel Grid.Row="0"
                                        Spacing="6"
                                        IsVisible="{Binding IsVersionListLoading}">
                                <TextBlock Text="{loc:Tr explorer.loading_versions}"
                                           Classes="muted"/>
                                <ProgressBar IsIndeterminate="True"
                                             Height="8"/>
                            </StackPanel>

                            <ListBox Grid.Row="1"
                                     Classes="clean-list"
                                     ItemsSource="{Binding Versions}"
                                     IsVisible="{Binding HasVersions}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="windows:FileVersionCompareListItemViewModel">
                                        <Border Classes="list-item"
                                                Background="{Binding CardBackground}"
                                                BorderBrush="{Binding CardBorderBrush}"
                                                PointerPressed="OnVersionItemPointerPressed">
                                            <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                                                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                    <TextBlock Grid.Column="0" Text="{Binding VersionName}" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding CreatedAtDisplay}" Opacity="0.82"/>
                                                    <Border Grid.Column="2"
                                                            Classes="badge"
                                                            Background="{Binding SelectionBadgeBackground}"
                                                            Padding="8,4"
                                                            IsVisible="{Binding HasSelectionBadge}">
                                                        <TextBlock Text="{Binding SelectionBadge}"
                                                                   Foreground="{Binding SelectionBadgeForeground}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="11"/>
                                                    </Border>
                                                </Grid>

                                                <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                    <TextBlock Grid.Column="0" Text="{Binding SizeDisplay}" Classes="muted" FontSize="11"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding StateLabel}" Classes="muted" FontSize="11"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Grid.Row="1"
                                       Text="{loc:Tr explorer.no_versions_for_selected_file}"
                                       Classes="muted"
                                       IsVisible="{Binding HasNoVersions}"/>
                        </Grid>
                    </Grid>

                    <GridSplitter Grid.Row="1"
                                  Height="8"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  ResizeDirection="Rows"
                                  ResizeBehavior="PreviousAndNext"
                                  IsVisible="{Binding ShowImageDiffDetails}"/>

                    <Border Grid.Row="2"
                            Classes="metric-card"
                            Padding="10"
                            MinHeight="140"
                            IsVisible="{Binding ShowImageDiffDetails}">
                        <Grid RowDefinitions="Auto,*" RowSpacing="8">
                            <TextBlock Grid.Row="0"
                                       Text="{loc:Tr compare.details_title}"
                                       FontWeight="SemiBold"/>

                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding PreviewMetrics}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="windows:SnapshotPreviewMetricItemViewModel">
                                            <Grid ColumnDefinitions="118,*"
                                                  ColumnSpacing="10"
                                                  Margin="0,0,0,6">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Label}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource VeyraDiffHunkFgBrush}"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Value}"
                                                           TextWrapping="Wrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="10"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"/>

            <Border Grid.Column="2" Classes="dialog-shell" Margin="10,0,0,0" MinWidth="720" Padding="8">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
                        <StackPanel Grid.Row="0"
                                    Spacing="2"
                                    IsVisible="{Binding IsImagePreview, Converter={x:Static conv:BoolInvertConverter.Instance}}">
                            <TextBlock Text="{loc:Tr compare.selected_pair}" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedPairSummary}" Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding IsImagePreview, Converter={x:Static conv:BoolInvertConverter.Instance}}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Spacing="4"
                                    IsVisible="{Binding IsImagePreview, Converter={x:Static conv:BoolInvertConverter.Instance}}">
                            <TextBlock Text="{Binding PreviewSummary}"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding IsImagePreview, Converter={x:Static conv:BoolInvertConverter.Instance}}"/>
                        </StackPanel>

                        <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="8">
                            <TextBlock Grid.Row="0"
                                       Text="{loc:Tr compare.building_preview}"
                                       Classes="muted"
                                       IsVisible="{Binding IsPreviewLoading}"/>

                            <Grid Grid.Row="1" RowDefinitions="*,Auto,Auto,Auto" RowSpacing="8">
                                <Border Grid.Row="0" Classes="diff-surface" IsVisible="{Binding ShowDiffRowsPanel}">
                                    <Grid RowDefinitions="Auto,*" RowSpacing="8">
                                        <WrapPanel Grid.Row="0" Orientation="Horizontal">
                                            <Border Background="{DynamicResource VeyraDiffAddBgBrush}" CornerRadius="8" Padding="8,4" Margin="0,0,8,8">
                                                <TextBlock Text="{loc:Tr diff.added}" Foreground="{DynamicResource VeyraDiffAddFgBrush}" FontWeight="SemiBold" FontSize="11"/>
                                            </Border>
                                            <Border Background="{DynamicResource VeyraDiffRemoveBgBrush}" CornerRadius="8" Padding="8,4" Margin="0,0,8,8">
                                                <TextBlock Text="{loc:Tr diff.removed}" Foreground="{DynamicResource VeyraDiffRemoveFgBrush}" FontWeight="SemiBold" FontSize="11"/>
                                            </Border>
                                            <Border Background="{DynamicResource VeyraDiffModifiedBgBrush}" CornerRadius="8" Padding="8,4" Margin="0,0,8,8">
                                                <TextBlock Text="{loc:Tr diff.modified}" Foreground="{DynamicResource VeyraDiffModifiedFgBrush}" FontWeight="SemiBold" FontSize="11"/>
                                            </Border>
                                            <Border Background="{DynamicResource VeyraDiffContextBgBrush}" CornerRadius="8" Padding="8,4" Margin="0,0,0,8">
                                                <TextBlock Text="{loc:Tr diff.context}" Foreground="{DynamicResource VeyraDiffContextFgBrush}" FontWeight="SemiBold" FontSize="11"/>
                                            </Border>
                                        </WrapPanel>

                                        <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="8">
                                            <Grid Grid.Row="0" ColumnDefinitions="*,8,*">
                                                <Border Grid.Column="0" Background="{DynamicResource VeyraDiffHeaderBgBrush}" CornerRadius="8" Padding="8,4">
                                                    <TextBlock Text="{loc:Tr common.before}" FontWeight="SemiBold"/>
                                                </Border>
                                                <GridSplitter Grid.Column="1"
                                                              Width="8"
                                                              Background="{DynamicResource VeyraSplitBrush}"
                                                              ResizeDirection="Columns"
                                                              ResizeBehavior="PreviousAndNext"
                                                              HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Stretch"/>
                                                <Border Grid.Column="2" Background="{DynamicResource VeyraDiffHeaderBgBrush}" CornerRadius="8" Padding="8,4">
                                                    <TextBlock Text="{loc:Tr common.after}" FontWeight="SemiBold"/>
                                                </Border>
                                            </Grid>

                                            <Grid Grid.Row="1" ColumnDefinitions="*,8,*" ColumnSpacing="0">
                                                <ScrollViewer x:Name="LeftDiffScrollViewer"
                                                              Grid.Column="0"
                                                              VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Auto"
                                                              ScrollChanged="OnLeftDiffScrollChanged">
                                                    <ItemsControl ItemsSource="{Binding PreviewRows}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="explorer:DiffPreviewRowViewModel">
                                                                <StackPanel Spacing="4" Margin="0,0,0,4">
                                                                    <Border IsVisible="{Binding IsHunkHeader}"
                                                                            Background="{DynamicResource VeyraDiffHunkBgBrush}"
                                                                            BorderBrush="{DynamicResource VeyraDiffHunkBorderBrush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="8"
                                                                            Padding="8,4">
                                                                        <TextBlock Text="{Binding HunkHeader}"
                                                                                   FontFamily="Cascadia Code,Consolas,Monospace"
                                                                                   FontSize="12"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource VeyraDiffHunkFgBrush}"/>
                                                                    </Border>

                                                                    <Border IsVisible="{Binding IsContentRow}"
                                                                            Classes="diff-side"
                                                                            Background="{Binding LeftBackground}"
                                                                            ClipToBounds="True">
                                                                        <Grid ColumnDefinitions="58,16,24,*" ColumnSpacing="6">
                                                                            <TextBlock Grid.Column="0" Text="{Binding LeftLineNumber}" Foreground="{DynamicResource VeyraDiffLineNumberBrush}" FontFamily="Cascadia Code,Consolas,Monospace" FontSize="12"/>
                                                                            <TextBlock Grid.Column="1" Text="{Binding LeftMarker}" Foreground="{Binding LeftMarkerForeground}" FontWeight="Bold" FontFamily="Cascadia Code,Consolas,Monospace" FontSize="12"/>
                                                                            <TextBlock Grid.Column="2" Text="{Binding KindBadge}" Foreground="{DynamicResource VeyraDiffMarkerBrush}" FontWeight="SemiBold" FontFamily="Cascadia Code,Consolas,Monospace" FontSize="11"/>
                                                                            <Grid Grid.Column="3">
                                                                                <StackPanel IsVisible="{Binding UseLeftTokenLayout}">
                                                                                    <ItemsControl IsVisible="{Binding #Root.((windows:FileVersionCompareWindowViewModel)DataContext).IsWrapEnabled}"
                                                                                                  ItemsSource="{Binding LeftTokens}">
                                                                                        <ItemsControl.ItemsPanel>
                                                                                            <ItemsPanelTemplate>
                                                                                                <WrapPanel Orientation="Horizontal"/>
                                                                                            </ItemsPanelTemplate>
                                                                                        </ItemsControl.ItemsPanel>
                                                                                        <ItemsControl.ItemTemplate>
                                                                                            <DataTemplate x:DataType="explorer:DiffPreviewTokenViewModel">
                                                                                                <Border Background="{Binding Background}"
                                                                                                        CornerRadius="2"
                                                                                                        Padding="{Binding Padding}">
                                                                                                    <TextBlock Text="{Binding Text}"
                                                                                                               xml:space="preserve"
                                                                                                               FontFamily="Cascadia Code,Consolas,Monospace"
                                                                                                               FontSize="12"
                                                                                                               FontWeight="{Binding FontWeight}"
                                                                                                               Foreground="{Binding Foreground}"/>
                                                                                                </Border>
                                                                                            </DataTemplate>
                                                                                        </ItemsControl.ItemTemplate>
                                                                                    </ItemsControl>

                                                                                    <ItemsControl IsVisible="{Binding #Root.((windows:FileVersionCompareWindowViewModel)DataContext).IsWrapEnabled, Converter={x:Static conv:BoolInvertConverter.Instance}}"
                                                                                                  ItemsSource="{Binding LeftTokens}">
                                                                                        <ItemsControl.ItemsPanel>
                                                                                            <ItemsPanelTemplate>
                                                                                                <StackPanel Orientation="Horizontal"/>
                                                                                            </ItemsPanelTemplate>
                                                                                        </ItemsControl.ItemsPanel>
                                                                                        <ItemsControl.ItemTemplate>
                                                                                            <DataTemplate x:DataType="explorer:DiffPreviewTokenViewModel">
                                                                                                <Border Background="{Binding Background}"
                                                                                                        CornerRadius="2"
                                                                                                        Padding="{Binding Padding}">
                                                                                                    <TextBlock Text="{Binding Text}"
                                                                                                               xml:space="preserve"
                                                                                                               FontFamily="Cascadia Code,Consolas,Monospace"
                                                                                                               FontSize="12"
                                                                                                               FontWeight="{Binding FontWeight}"
                                                                                                               Foreground="{Binding Foreground}"/>
                                                                                                </Border>
                                                                                            </DataTemplate>
                                                                                        </ItemsControl.ItemTemplate>
                                                                                    </ItemsControl>
                                                                                </StackPanel>

                                                                                <TextBlock IsVisible="{Binding UseLeftPlainLayout}"
                                                                                           Text="{Binding LeftText}"
                                                                                           FontFamily="Cascadia Code,Consolas,Monospace"
                                                                                           FontSize="12"
                                                                                           TextWrapping="{Binding #Root.((windows:FileVersionCompareWindowViewModel)DataContext).IsWrapEnabled, Converter={x:Static conv:BoolToTextWrappingConverter.Instance}}"/>
                                                                            </Grid>
                                                                        </Grid>
                                                                    </Border>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                                <GridSplitter Grid.Column="1"
                                                              Width="8"
                                                              Background="{DynamicResource VeyraSplitBrush}"
                                                              ResizeDirection="Columns"
                                                              ResizeBehavior="PreviousAndNext"
                                                              HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Stretch"/>

                                                <ScrollViewer x:Name="RightDiffScrollViewer"
                                                              Grid.Column="2"
                                                              VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Auto"
                                                              ScrollChanged="OnRightDiffScrollChanged">
                                                    <ItemsControl ItemsSource="{Binding PreviewRows}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="explorer:DiffPreviewRowViewModel">
                                                                <StackPanel Spacing="4" Margin="0,0,0,4">
                                                                    <Border IsVisible="{Binding IsHunkHeader}"
                                                                            Background="{DynamicResource VeyraDiffHunkBgBrush}"
                                                                            BorderBrush="{DynamicResource VeyraDiffHunkBorderBrush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="8"
                                                                            Padding="8,4">
                                                                        <TextBlock Text="{Binding HunkHeader}"
                                                                                   FontFamily="Cascadia Code,Consolas,Monospace"
                                                                                   FontSize="12"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource VeyraDiffHunkFgBrush}"/>
                                                                    </Border>

                                                                    <Border IsVisible="{Binding IsContentRow}"
                                                                            Classes="diff-side"
                                                                            Background="{Binding RightBackground}"
                                                                            ClipToBounds="True">
                                                                        <Grid ColumnDefinitions="58,16,24,*" ColumnSpacing="6">
                                                                            <TextBlock Grid.Column="0" Text="{Binding RightLineNumber}" Foreground="{DynamicResource VeyraDiffLineNumberBrush}" FontFamily="Cascadia Code,Consolas,Monospace" FontSize="12"/>
                                                                            <TextBlock Grid.Column="1" Text="{Binding RightMarker}" Foreground="{Binding RightMarkerForeground}" FontWeight="Bold" FontFamily="Cascadia Code,Consolas,Monospace" FontSize="12"/>
                                                                            <TextBlock Grid.Column="2" Text="{Binding KindBadge}" Foreground="{DynamicResource VeyraDiffMarkerBrush}" FontWeight="SemiBold" FontFamily="Cascadia Code,Consolas,Monospace" FontSize="11"/>
                                                                            <Grid Grid.Column="3">
                                                                                <StackPanel IsVisible="{Binding UseRightTokenLayout}">
                                                                                    <ItemsControl IsVisible="{Binding #Root.((windows:FileVersionCompareWindowViewModel)DataContext).IsWrapEnabled}"
                                                                                                  ItemsSource="{Binding RightTokens}">
                                                                                        <ItemsControl.ItemsPanel>
                                                                                            <ItemsPanelTemplate>
                                                                                                <WrapPanel Orientation="Horizontal"/>
                                                                                            </ItemsPanelTemplate>
                                                                                        </ItemsControl.ItemsPanel>
                                                                                        <ItemsControl.ItemTemplate>
                                                                                            <DataTemplate x:DataType="explorer:DiffPreviewTokenViewModel">
                                                                                                <Border Background="{Binding Background}"
                                                                                                        CornerRadius="2"
                                                                                                        Padding="{Binding Padding}">
                                                                                                    <TextBlock Text="{Binding Text}"
                                                                                                               xml:space="preserve"
                                                                                                               FontFamily="Cascadia Code,Consolas,Monospace"
                                                                                                               FontSize="12"
                                                                                                               FontWeight="{Binding FontWeight}"
                                                                                                               Foreground="{Binding Foreground}"/>
                                                                                                </Border>
                                                                                            </DataTemplate>
                                                                                        </ItemsControl.ItemTemplate>
                                                                                    </ItemsControl>

                                                                                    <ItemsControl IsVisible="{Binding #Root.((windows:FileVersionCompareWindowViewModel)DataContext).IsWrapEnabled, Converter={x:Static conv:BoolInvertConverter.Instance}}"
                                                                                                  ItemsSource="{Binding RightTokens}">
                                                                                        <ItemsControl.ItemsPanel>
                                                                                            <ItemsPanelTemplate>
                                                                                                <StackPanel Orientation="Horizontal"/>
                                                                                            </ItemsPanelTemplate>
                                                                                        </ItemsControl.ItemsPanel>
                                                                                        <ItemsControl.ItemTemplate>
                                                                                            <DataTemplate x:DataType="explorer:DiffPreviewTokenViewModel">
                                                                                                <Border Background="{Binding Background}"
                                                                                                        CornerRadius="2"
                                                                                                        Padding="{Binding Padding}">
                                                                                                    <TextBlock Text="{Binding Text}"
                                                                                                               xml:space="preserve"
                                                                                                               FontFamily="Cascadia Code,Consolas,Monospace"
                                                                                                               FontSize="12"
                                                                                                               FontWeight="{Binding FontWeight}"
                                                                                                               Foreground="{Binding Foreground}"/>
                                                                                                </Border>
                                                                                            </DataTemplate>
                                                                                        </ItemsControl.ItemTemplate>
                                                                                    </ItemsControl>
                                                                                </StackPanel>

                                                                                <TextBlock IsVisible="{Binding UseRightPlainLayout}"
                                                                                           Text="{Binding RightText}"
                                                                                           FontFamily="Cascadia Code,Consolas,Monospace"
                                                                                           FontSize="12"
                                                                                           TextWrapping="{Binding #Root.((windows:FileVersionCompareWindowViewModel)DataContext).IsWrapEnabled, Converter={x:Static conv:BoolToTextWrappingConverter.Instance}}"/>
                                                                            </Grid>
                                                                        </Grid>
                                                                    </Border>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="0" Classes="diff-surface" IsVisible="{Binding ShowWordDiffRowsPanel}" Background="{DynamicResource VeyraDocShellBrush}" BorderBrush="{DynamicResource VeyraDocShellBorderBrush}">
                                    <Grid RowDefinitions="Auto,*" RowSpacing="10">
                                        <Grid Grid.Row="0" ColumnDefinitions="*,8,*" ColumnSpacing="0">
                                            <Border Grid.Column="0" Background="{DynamicResource VeyraDocHeaderBrush}" BorderBrush="{DynamicResource VeyraDocHeaderBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                                                <TextBlock Text="{loc:Tr compare.before_version}" FontWeight="SemiBold" Foreground="{DynamicResource VeyraDocTextBrush}"/>
                                            </Border>
                                            <GridSplitter Grid.Column="1"
                                                          Width="8"
                                                          Background="{DynamicResource VeyraDocHeaderBorderBrush}"
                                                          ResizeDirection="Columns"
                                                          ResizeBehavior="PreviousAndNext"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Stretch"/>
                                            <Border Grid.Column="2" Background="{DynamicResource VeyraDocHeaderBrush}" BorderBrush="{DynamicResource VeyraDocHeaderBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                                                <TextBlock Text="{loc:Tr compare.after_version}" FontWeight="SemiBold" Foreground="{DynamicResource VeyraDocTextBrush}"/>
                                            </Border>
                                        </Grid>

                                        <Grid Grid.Row="1" ColumnDefinitions="*,8,*" ColumnSpacing="0">
                                            <Border Grid.Column="0" Background="{DynamicResource VeyraDocShellBrush}" BorderBrush="{DynamicResource VeyraDocShellBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                                                <Border Background="{DynamicResource VeyraDocPaperBrush}" BorderBrush="{DynamicResource VeyraDocPaperBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="48,40,48,48">
                                                    <ScrollViewer x:Name="LeftWordDiffScrollViewer"
                                                                  VerticalScrollBarVisibility="Auto"
                                                                  HorizontalScrollBarVisibility="Auto"
                                                                  ScrollChanged="OnLeftWordDiffScrollChanged">
                                                        <ItemsControl ItemsSource="{Binding WordPreviewRows}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="windows:WordSemanticDiffRowViewModel">
                                                                    <Border IsVisible="{Binding IsContentRow}"
                                                                            Margin="{Binding LeftParagraphMargin}"
                                                                            Background="{Binding LeftBackground}"
                                                                            BorderBrush="{Binding LeftBorderBrush}"
                                                                            BorderThickness="{Binding LeftBorderThickness}"
                                                                            CornerRadius="0"
                                                                            Padding="0">
                                                                        <StackPanel Spacing="0" HorizontalAlignment="{Binding LeftParagraphAlignment}">
                                                                            <ItemsControl IsVisible="{Binding UseLeftTokenLayout}"
                                                                                          ItemsSource="{Binding LeftTokens}">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate>
                                                                                        <WrapPanel Orientation="Horizontal"/>
                                                                                    </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate x:DataType="windows:WordSemanticTokenViewModel">
                                                                                        <Border Background="{Binding Background}"
                                                                                                BorderBrush="{Binding OutlineBrush}"
                                                                                                BorderThickness="{Binding OutlineThickness}"
                                                                                                CornerRadius="1"
                                                                                                Padding="0">
                                                                                            <TextBlock Text="{Binding Text}"
                                                                                                       xml:space="preserve"
                                                                                                       FontFamily="{Binding FontFamily}"
                                                                                                       FontSize="{Binding FontSize}"
                                                                                                       FontWeight="{Binding FontWeight}"
                                                                                                       FontStyle="{Binding FontStyle}"
                                                                                                        Foreground="{Binding Foreground}"
                                                                                                        TextDecorations="{Binding TextDecorations}"
                                                                                                        Margin="{Binding TextMargin}"/>
                                                                                        </Border>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>

                                                                            <TextBlock IsVisible="{Binding UseLeftPlainLayout}"
                                                                                       Text="{Binding LeftText}"
                                                                                       xml:space="preserve"
                                                                                       FontFamily="{Binding LeftFontFamily}"
                                                                                       FontSize="{Binding LeftFontSize}"
                                                                                       FontWeight="{Binding LeftFontWeight}"
                                                                                       FontStyle="{Binding LeftFontStyle}"
                                                                                       Foreground="{Binding LeftForeground}"
                                                                                       Background="{Binding LeftTextBackground}"
                                                                                       TextDecorations="{Binding LeftTextDecorations}"
                                                                                       Margin="{Binding LeftTextMargin}"
                                                                                       TextAlignment="{Binding LeftTextAlignment}"
                                                                                       TextWrapping="{Binding #Root.((windows:FileVersionCompareWindowViewModel)DataContext).IsWrapEnabled, Converter={x:Static conv:BoolToTextWrappingConverter.Instance}}"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </Border>
                                            </Border>

                                            <GridSplitter Grid.Column="1"
                                                          Width="8"
                                                          Background="{DynamicResource VeyraDocShellBorderBrush}"
                                                          ResizeDirection="Columns"
                                                          ResizeBehavior="PreviousAndNext"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Stretch"/>

                                            <Border Grid.Column="2" Background="{DynamicResource VeyraDocShellBrush}" BorderBrush="{DynamicResource VeyraDocShellBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                                                <Border Background="{DynamicResource VeyraDocPaperBrush}" BorderBrush="{DynamicResource VeyraDocPaperBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="48,40,48,48">
                                                    <ScrollViewer x:Name="RightWordDiffScrollViewer"
                                                                  VerticalScrollBarVisibility="Auto"
                                                                  HorizontalScrollBarVisibility="Auto"
                                                                  ScrollChanged="OnRightWordDiffScrollChanged">
                                                        <ItemsControl ItemsSource="{Binding WordPreviewRows}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="windows:WordSemanticDiffRowViewModel">
                                                                    <Border IsVisible="{Binding IsContentRow}"
                                                                            Margin="{Binding RightParagraphMargin}"
                                                                            Background="{Binding RightBackground}"
                                                                            BorderBrush="{Binding RightBorderBrush}"
                                                                            BorderThickness="{Binding RightBorderThickness}"
                                                                            CornerRadius="0"
                                                                            Padding="0">
                                                                        <StackPanel Spacing="0" HorizontalAlignment="{Binding RightParagraphAlignment}">
                                                                            <ItemsControl IsVisible="{Binding UseRightTokenLayout}"
                                                                                          ItemsSource="{Binding RightTokens}">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate>
                                                                                        <WrapPanel Orientation="Horizontal"/>
                                                                                    </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate x:DataType="windows:WordSemanticTokenViewModel">
                                                                                        <Border Background="{Binding Background}"
                                                                                                BorderBrush="{Binding OutlineBrush}"
                                                                                                BorderThickness="{Binding OutlineThickness}"
                                                                                                CornerRadius="1"
                                                                                                Padding="0">
                                                                                            <TextBlock Text="{Binding Text}"
                                                                                                       xml:space="preserve"
                                                                                                       FontFamily="{Binding FontFamily}"
                                                                                                       FontSize="{Binding FontSize}"
                                                                                                       FontWeight="{Binding FontWeight}"
                                                                                                       FontStyle="{Binding FontStyle}"
                                                                                                        Foreground="{Binding Foreground}"
                                                                                                        TextDecorations="{Binding TextDecorations}"
                                                                                                        Margin="{Binding TextMargin}"/>
                                                                                        </Border>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>

                                                                            <TextBlock IsVisible="{Binding UseRightPlainLayout}"
                                                                                       Text="{Binding RightText}"
                                                                                       xml:space="preserve"
                                                                                       FontFamily="{Binding RightFontFamily}"
                                                                                       FontSize="{Binding RightFontSize}"
                                                                                       FontWeight="{Binding RightFontWeight}"
                                                                                       FontStyle="{Binding RightFontStyle}"
                                                                                       Foreground="{Binding RightForeground}"
                                                                                       Background="{Binding RightTextBackground}"
                                                                                       TextDecorations="{Binding RightTextDecorations}"
                                                                                       Margin="{Binding RightTextMargin}"
                                                                                       TextAlignment="{Binding RightTextAlignment}"
                                                                                       TextWrapping="{Binding #Root.((windows:FileVersionCompareWindowViewModel)DataContext).IsWrapEnabled, Converter={x:Static conv:BoolToTextWrappingConverter.Instance}}"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </Border>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="0" Classes="diff-surface" IsVisible="{Binding ShowFullFilePreviewPanel}">
                                    <Grid RowDefinitions="Auto,*" RowSpacing="8">
                                        <TextBlock Grid.Row="0" Text="{Binding FullPreviewSummary}" Classes="muted" TextWrapping="Wrap"/>
                                        <Grid Grid.Row="1" ColumnDefinitions="*,8,*" ColumnSpacing="0">
                                            <Border Grid.Column="0" Background="{DynamicResource VeyraSurfaceSoftBrush}" CornerRadius="8" Padding="6" ClipToBounds="True">
                                                <ScrollViewer x:Name="LeftFullDiffScrollViewer"
                                                              VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Auto"
                                                              ScrollChanged="OnLeftFullDiffScrollChanged">
                                                    <Grid>
                                                        <ItemsControl IsVisible="{Binding HasFullPreviewRows}"
                                                                      ItemsSource="{Binding FullPreviewRows}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="explorer:DiffPreviewRowViewModel">
                                                                    <Border Classes="diff-side"
                                                                            Background="{Binding LeftBackground}"
                                                                            ClipToBounds="True"
                                                                            Margin="0,0,0,4">
                                                                        <Grid ColumnDefinitions="58,16,24,*" ColumnSpacing="6">
                                                                            <TextBlock Grid.Column="0" Text="{Binding LeftLineNumber}" Foreground="{DynamicResource VeyraDiffLineNumberBrush}" FontFamily="Cascadia Code,Consolas,Monospace" FontSize="12"/>
                                                                            <TextBlock Grid.Column="1" Text="{Binding LeftMarker}" Foreground="{Binding LeftMarkerForeground}" FontWeight="Bold" FontFamily="Cascadia Code,Consolas,Monospace" FontSize="12"/>
                                                                            <TextBlock Grid.Column="2" Text="{Binding KindBadge}" Foreground="{DynamicResource VeyraDiffMarkerBrush}" FontWeight="SemiBold" FontFamily="Cascadia Code,Consolas,Monospace" FontSize="11"/>
                                                                            <Grid Grid.Column="3">
                                                                                <StackPanel IsVisible="{Binding UseLeftTokenLayout}">
                                                                                    <ItemsControl IsVisible="{Binding #Root.((windows:FileVersionCompareWindowViewModel)DataContext).IsWrapEnabled}"
                                                                                                  ItemsSource="{Binding LeftTokens}">
                                                                                        <ItemsControl.ItemsPanel>
                                                                                            <ItemsPanelTemplate>
                                                                                                <WrapPanel Orientation="Horizontal"/>
                                                                                            </ItemsPanelTemplate>
                                                                                        </ItemsControl.ItemsPanel>
                                                                                        <ItemsControl.ItemTemplate>
                                                                                            <DataTemplate x:DataType="explorer:DiffPreviewTokenViewModel">
                                                                                                <Border Background="{Binding Background}"
                                                                                                        CornerRadius="2"
                                                                                                        Padding="{Binding Padding}">
                                                                                                    <TextBlock Text="{Binding Text}"
                                                                                                               xml:space="preserve"
                                                                                                               FontFamily="Cascadia Code,Consolas,Monospace"
                                                                                                               FontSize="12"
                                                                                                               FontWeight="{Binding FontWeight}"
                                                                                                               Foreground="{Binding Foreground}"/>
                                                                                                </Border>
                                                                                            </DataTemplate>
                                                                                        </ItemsControl.ItemTemplate>
                                                                                    </ItemsControl>

                                                                                    <ItemsControl IsVisible="{Binding #Root.((windows:FileVersionCompareWindowViewModel)DataContext).IsWrapEnabled, Converter={x:Static conv:BoolInvertConverter.Instance}}"
                                                                                                  ItemsSource="{Binding LeftTokens}">
                                                                                        <ItemsControl.ItemsPanel>
                                                                                            <ItemsPanelTemplate>
                                                                                                <StackPanel Orientation="Horizontal"/>
                                                                                            </ItemsPanelTemplate>
                                                                                        </ItemsControl.ItemsPanel>
                                                                                        <ItemsControl.ItemTemplate>
                                                                                            <DataTemplate x:DataType="explorer:DiffPreviewTokenViewModel">
                                                                                                <Border Background="{Binding Background}"
                                                                                                        CornerRadius="2"
                                                                                                        Padding="{Binding Padding}">
                                                                                                    <TextBlock Text="{Binding Text}"
                                                                                                               xml:space="preserve"
                                                                                                               FontFamily="Cascadia Code,Consolas,Monospace"
                                                                                                               FontSize="12"
                                                                                                               FontWeight="{Binding FontWeight}"
                                                                                                               Foreground="{Binding Foreground}"/>
                                                                                                </Border>
                                                                                            </DataTemplate>
                                                                                        </ItemsControl.ItemTemplate>
                                                                                    </ItemsControl>
                                                                                </StackPanel>

                                                                                <TextBlock IsVisible="{Binding UseLeftPlainLayout}"
                                                                                           Text="{Binding LeftText}"
                                                                                           FontFamily="Cascadia Code,Consolas,Monospace"
                                                                                           FontSize="12"
                                                                                           TextWrapping="{Binding #Root.((windows:FileVersionCompareWindowViewModel)DataContext).IsWrapEnabled, Converter={x:Static conv:BoolToTextWrappingConverter.Instance}}"/>
                                                                            </Grid>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <TextBlock IsVisible="{Binding ShowFullPreviewTextFallback}"
                                                                   Text="{Binding FullPreviewBeforeText}"
                                                                   FontFamily="Cascadia Code,Consolas,Monospace"
                                                                   FontSize="12"
                                                                   TextWrapping="{Binding IsWrapEnabled, Converter={x:Static conv:BoolToTextWrappingConverter.Instance}}"/>
                                                    </Grid>
                                                </ScrollViewer>
                                            </Border>
                                                <GridSplitter Grid.Column="1"
                                                              Width="8"
                                                              Background="{DynamicResource VeyraSplitBrush}"
                                                              ResizeDirection="Columns"
                                                              ResizeBehavior="PreviousAndNext"
                                                              HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Stretch"/>
                                            <Border Grid.Column="2" Background="{DynamicResource VeyraSurfaceSoftBrush}" CornerRadius="8" Padding="6" ClipToBounds="True">
                                                <ScrollViewer x:Name="RightFullDiffScrollViewer"
                                                              VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Auto"
                                                              ScrollChanged="OnRightFullDiffScrollChanged">
                                                    <Grid>
                                                        <ItemsControl IsVisible="{Binding HasFullPreviewRows}"
                                                                      ItemsSource="{Binding FullPreviewRows}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="explorer:DiffPreviewRowViewModel">
                                                                    <Border Classes="diff-side"
                                                                            Background="{Binding RightBackground}"
                                                                            ClipToBounds="True"
                                                                            Margin="0,0,0,4">
                                                                        <Grid ColumnDefinitions="58,16,24,*" ColumnSpacing="6">
                                                                            <TextBlock Grid.Column="0" Text="{Binding RightLineNumber}" Foreground="{DynamicResource VeyraDiffLineNumberBrush}" FontFamily="Cascadia Code,Consolas,Monospace" FontSize="12"/>
                                                                            <TextBlock Grid.Column="1" Text="{Binding RightMarker}" Foreground="{Binding RightMarkerForeground}" FontWeight="Bold" FontFamily="Cascadia Code,Consolas,Monospace" FontSize="12"/>
                                                                            <TextBlock Grid.Column="2" Text="{Binding KindBadge}" Foreground="{DynamicResource VeyraDiffMarkerBrush}" FontWeight="SemiBold" FontFamily="Cascadia Code,Consolas,Monospace" FontSize="11"/>
                                                                            <Grid Grid.Column="3">
                                                                                <StackPanel IsVisible="{Binding UseRightTokenLayout}">
                                                                                    <ItemsControl IsVisible="{Binding #Root.((windows:FileVersionCompareWindowViewModel)DataContext).IsWrapEnabled}"
                                                                                                  ItemsSource="{Binding RightTokens}">
                                                                                        <ItemsControl.ItemsPanel>
                                                                                            <ItemsPanelTemplate>
                                                                                                <WrapPanel Orientation="Horizontal"/>
                                                                                            </ItemsPanelTemplate>
                                                                                        </ItemsControl.ItemsPanel>
                                                                                        <ItemsControl.ItemTemplate>
                                                                                            <DataTemplate x:DataType="explorer:DiffPreviewTokenViewModel">
                                                                                                <Border Background="{Binding Background}"
                                                                                                        CornerRadius="2"
                                                                                                        Padding="{Binding Padding}">
                                                                                                    <TextBlock Text="{Binding Text}"
                                                                                                               xml:space="preserve"
                                                                                                               FontFamily="Cascadia Code,Consolas,Monospace"
                                                                                                               FontSize="12"
                                                                                                               FontWeight="{Binding FontWeight}"
                                                                                                               Foreground="{Binding Foreground}"/>
                                                                                                </Border>
                                                                                            </DataTemplate>
                                                                                        </ItemsControl.ItemTemplate>
                                                                                    </ItemsControl>

                                                                                    <ItemsControl IsVisible="{Binding #Root.((windows:FileVersionCompareWindowViewModel)DataContext).IsWrapEnabled, Converter={x:Static conv:BoolInvertConverter.Instance}}"
                                                                                                  ItemsSource="{Binding RightTokens}">
                                                                                        <ItemsControl.ItemsPanel>
                                                                                            <ItemsPanelTemplate>
                                                                                                <StackPanel Orientation="Horizontal"/>
                                                                                            </ItemsPanelTemplate>
                                                                                        </ItemsControl.ItemsPanel>
                                                                                        <ItemsControl.ItemTemplate>
                                                                                            <DataTemplate x:DataType="explorer:DiffPreviewTokenViewModel">
                                                                                                <Border Background="{Binding Background}"
                                                                                                        CornerRadius="2"
                                                                                                        Padding="{Binding Padding}">
                                                                                                    <TextBlock Text="{Binding Text}"
                                                                                                               xml:space="preserve"
                                                                                                               FontFamily="Cascadia Code,Consolas,Monospace"
                                                                                                               FontSize="12"
                                                                                                               FontWeight="{Binding FontWeight}"
                                                                                                               Foreground="{Binding Foreground}"/>
                                                                                                </Border>
                                                                                            </DataTemplate>
                                                                                        </ItemsControl.ItemTemplate>
                                                                                    </ItemsControl>
                                                                                </StackPanel>

                                                                                <TextBlock IsVisible="{Binding UseRightPlainLayout}"
                                                                                           Text="{Binding RightText}"
                                                                                           FontFamily="Cascadia Code,Consolas,Monospace"
                                                                                           FontSize="12"
                                                                                           TextWrapping="{Binding #Root.((windows:FileVersionCompareWindowViewModel)DataContext).IsWrapEnabled, Converter={x:Static conv:BoolToTextWrappingConverter.Instance}}"/>
                                                                            </Grid>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <TextBlock IsVisible="{Binding ShowFullPreviewTextFallback}"
                                                                   Text="{Binding FullPreviewAfterText}"
                                                                   FontFamily="Cascadia Code,Consolas,Monospace"
                                                                   FontSize="12"
                                                                   TextWrapping="{Binding IsWrapEnabled, Converter={x:Static conv:BoolToTextWrappingConverter.Instance}}"/>
                                                    </Grid>
                                                </ScrollViewer>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="0" Classes="diff-surface" IsVisible="{Binding IsBinaryPreview}">
                                    <ItemsControl ItemsSource="{Binding PreviewMetrics}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="windows:SnapshotPreviewMetricItemViewModel">
                                                <Grid ColumnDefinitions="180,*" ColumnSpacing="10" Margin="0,0,0,6">
                                                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontWeight="SemiBold" Foreground="{DynamicResource VeyraDiffHunkFgBrush}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <Border Grid.Row="0" Classes="diff-surface" IsVisible="{Binding IsArchivePreview}">
                                    <Grid RowDefinitions="Auto,*" RowSpacing="10">
                                        <Grid Grid.Row="0"
                                              RowDefinitions="Auto,Auto"
                                              RowSpacing="8">
                                            <WrapPanel Grid.Row="0"
                                                       Orientation="Horizontal"
                                                       HorizontalAlignment="Left"
                                                       ItemHeight="40">
                                                <Button Classes="subtle compact"
                                                        Command="{Binding ShowAllArchiveEntriesCommand}"
                                                        Margin="0,0,8,8">
                                                    <TextBlock Text="{Binding ArchiveAllFilterLabel}"/>
                                                </Button>
                                                <Button Classes="subtle compact"
                                                        Command="{Binding ShowAddedArchiveEntriesCommand}"
                                                        Margin="0,0,8,8">
                                                    <TextBlock Text="{Binding ArchiveAddedFilterLabel}"/>
                                                </Button>
                                                <Button Classes="subtle compact"
                                                        Command="{Binding ShowRemovedArchiveEntriesCommand}"
                                                        Margin="0,0,8,8">
                                                    <TextBlock Text="{Binding ArchiveRemovedFilterLabel}"/>
                                                </Button>
                                                <Button Classes="subtle compact"
                                                        Command="{Binding ShowChangedArchiveEntriesCommand}"
                                                        Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding ArchiveChangedFilterLabel}"/>
                                                </Button>
                                            </WrapPanel>

                                            <Grid Grid.Row="1"
                                                  ColumnDefinitions="*,Auto"
                                                  ColumnSpacing="10">
                                                <TextBox Grid.Column="0"
                                                         Text="{Binding ArchiveSearchQuery, Mode=TwoWay}"
                                                         Classes="compact"
                                                         Watermark="{loc:Tr compare.archive_search_placeholder}"/>
                                                <Button Grid.Column="1"
                                                        Classes="subtle compact"
                                                        Command="{Binding ToggleArchiveTreeViewCommand}">
                                                    <StackPanel Classes="button-content">
                                                        <TextBlock Classes="button-icon" Text="&#xE8B7;"/>
                                                        <TextBlock Classes="button-label" Text="{Binding ArchiveViewModeLabel}"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Grid>

                                        <Grid Grid.Row="1" ColumnDefinitions="2*,12,*" ColumnSpacing="0">
                                            <Border Grid.Column="0"
                                                    Background="{DynamicResource VeyraSurfaceSoftBrush}"
                                                    BorderBrush="{DynamicResource VeyraBorderSoftBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="10">
                                                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                                                    <TextBlock Grid.Row="0"
                                                               Text="{loc:Tr compare.archive_contents}"
                                                               FontWeight="SemiBold"
                                                               FontSize="13"/>

                                                    <Grid Grid.Row="1">
                                                        <ListBox Classes="clean-list"
                                                                 ItemsSource="{Binding ArchiveEntries}"
                                                                 SelectedItem="{Binding SelectedArchiveEntry, Mode=TwoWay}"
                                                                 IsVisible="{Binding IsArchiveListViewEnabled}">
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate x:DataType="windows:ArchiveDiffEntryItemViewModel">
                                                                    <Border Classes="metric-card" Padding="10" Margin="0,0,0,6">
                                                                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                                                                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                                                <Border Grid.Column="0"
                                                                                        CornerRadius="8"
                                                                                        Background="{Binding StatusBadgeBackground}"
                                                                                        Padding="8,4">
                                                                                    <TextBlock Text="{Binding StatusLabel}"
                                                                                               Foreground="{Binding StatusBadgeForeground}"
                                                                                               FontWeight="SemiBold"
                                                                                               FontSize="11"/>
                                                                                </Border>
                                                                                <TextBlock Grid.Column="1"
                                                                                           Text="{Binding EntryPath}"
                                                                                           FontWeight="SemiBold"
                                                                                           TextWrapping="Wrap"
                                                                                           TextTrimming="CharacterEllipsis"/>
                                                                                <TextBlock Grid.Column="2"
                                                                                           Text="{Binding TypeLabel}"
                                                                                           Classes="muted"
                                                                                           FontSize="11"/>
                                                                            </Grid>

                                                                            <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                                                <TextBlock Grid.Column="0" Text="{loc:Tr common.size}" Classes="muted" FontSize="11"/>
                                                                                <TextBlock Grid.Column="1" Text="{Binding SizeLabel}" FontSize="11" TextWrapping="Wrap"/>
                                                                            </Grid>

                                                                            <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                                                <TextBlock Grid.Column="0" Text="CRC32" Classes="muted" FontSize="11"/>
                                                                                <TextBlock Grid.Column="1" Text="{Binding CrcLabel}" FontSize="11" TextWrapping="Wrap"/>
                                                                            </Grid>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                        </ListBox>

                                                        <TreeView ItemsSource="{Binding ArchiveTreeRoots}"
                                                                  SelectedItem="{Binding SelectedArchiveTreeNode, Mode=TwoWay}"
                                                                  IsVisible="{Binding IsArchiveTreeViewEnabled}">
                                                            <TreeView.DataTemplates>
                                                                <TreeDataTemplate DataType="windows:ArchiveDiffTreeNodeViewModel"
                                                                                  ItemsSource="{Binding Children}">
                                                                    <Border Classes="metric-card" Padding="8" Margin="0,0,0,4">
                                                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                                            <TextBlock Grid.Column="0"
                                                                                       Text="{Binding Icon}"
                                                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                                       Foreground="{DynamicResource VeyraAccentBrush}"
                                                                                       VerticalAlignment="Center"/>
                                                                            <StackPanel Grid.Column="1" Spacing="2">
                                                                                <TextBlock Text="{Binding Name}"
                                                                                           FontWeight="SemiBold"
                                                                                           TextTrimming="CharacterEllipsis"/>
                                                                                <TextBlock Text="{Binding DetailLabel}"
                                                                                           Classes="muted"
                                                                                           FontSize="11"
                                                                                           TextTrimming="CharacterEllipsis"/>
                                                                            </StackPanel>
                                                                            <Border Grid.Column="2"
                                                                                    CornerRadius="8"
                                                                                    Background="{Binding StatusBadgeBackground}"
                                                                                    Padding="8,4"
                                                                                    VerticalAlignment="Center"
                                                                                    IsVisible="{Binding HasEntry}">
                                                                                <TextBlock Text="{Binding StatusLabel}"
                                                                                           Foreground="{Binding StatusBadgeForeground}"
                                                                                           FontWeight="SemiBold"
                                                                                           FontSize="11"/>
                                                                            </Border>
                                                                        </Grid>
                                                                    </Border>
                                                                </TreeDataTemplate>
                                                            </TreeView.DataTemplates>
                                                        </TreeView>

                                                        <TextBlock Text="{loc:Tr compare.archive_no_entries}"
                                                                   Classes="muted"
                                                                   TextWrapping="Wrap"
                                                                   IsVisible="{Binding HasArchiveEntries, Converter={x:Static conv:BoolInvertConverter.Instance}}"/>
                                                    </Grid>
                                                </Grid>
                                            </Border>

                                            <GridSplitter Grid.Column="1"
                                                          Width="8"
                                                          Background="{DynamicResource VeyraSplitBrush}"
                                                          ResizeDirection="Columns"
                                                          ResizeBehavior="PreviousAndNext"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Stretch"/>

                                            <ScrollViewer Grid.Column="2"
                                                          VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <StackPanel Spacing="10">
                                                    <Border Background="{DynamicResource VeyraSurfaceSoftBrush}"
                                                            BorderBrush="{DynamicResource VeyraBorderSoftBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="10"
                                                            Padding="10">
                                                        <ItemsControl ItemsSource="{Binding PreviewMetrics}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="windows:SnapshotPreviewMetricItemViewModel">
                                                                    <Grid ColumnDefinitions="150,*" ColumnSpacing="10" Margin="0,0,0,6">
                                                                        <TextBlock Grid.Column="0"
                                                                                   Text="{Binding Label}"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource VeyraDiffHunkFgBrush}"/>
                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{Binding Value}"
                                                                                   TextWrapping="Wrap"/>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Border>

                                                    <Border Background="{DynamicResource VeyraSurfaceSoftBrush}"
                                                            BorderBrush="{DynamicResource VeyraBorderSoftBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="10"
                                                            Padding="10"
                                                            IsVisible="{Binding HasSelectedArchiveEntry}">
                                                        <Grid RowDefinitions="Auto,*" RowSpacing="8">
                                                            <TextBlock Grid.Row="0"
                                                                       Text="{loc:Tr common.details}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="13"/>

                                                            <StackPanel Grid.Row="1" Spacing="8">
                                                                <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                                                                    <TextBlock Grid.Column="0" Text="{loc:Tr common.path}" FontWeight="SemiBold"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding SelectedArchiveEntry.EntryPath}" TextWrapping="Wrap"/>
                                                                </Grid>
                                                                <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                                                                    <TextBlock Grid.Column="0" Text="{loc:Tr common.type}" FontWeight="SemiBold"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding SelectedArchiveEntry.TypeLabel}" TextWrapping="Wrap"/>
                                                                </Grid>
                                                                <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                                                                    <TextBlock Grid.Column="0" Text="{loc:Tr common.size}" FontWeight="SemiBold"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding SelectedArchiveEntry.SizeLabel}" TextWrapping="Wrap"/>
                                                                </Grid>
                                                                <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                                                                    <TextBlock Grid.Column="0" Text="{loc:Tr metric.compressed_size}" FontWeight="SemiBold"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding SelectedArchiveEntry.CompressedSizeLabel}" TextWrapping="Wrap"/>
                                                                </Grid>
                                                                <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                                                                    <TextBlock Grid.Column="0" Text="{loc:Tr metric.crc32}" FontWeight="SemiBold"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding SelectedArchiveEntry.CrcLabel}" TextWrapping="Wrap"/>
                                                                </Grid>
                                                                <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                                                                    <TextBlock Grid.Column="0" Text="{loc:Tr common.modified}" FontWeight="SemiBold"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding SelectedArchiveEntry.ModifiedLabel}" TextWrapping="Wrap"/>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="0" Classes="diff-surface" IsVisible="{Binding IsAudioPreview}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Spacing="12">
                                            <Grid ColumnDefinitions="*,Auto"
                                                  ColumnSpacing="12">
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <TextBlock Text="{loc:Tr compare.audio_waveform}"
                                                               FontWeight="SemiBold"
                                                               FontSize="14"/>
                                                    <TextBlock Text="{Binding AudioPlaybackStatus}"
                                                               Classes="muted"
                                                               TextWrapping="Wrap"
                                                               IsVisible="{Binding HasAudioPlaybackStatus}"/>
                                                </StackPanel>

                                                <WrapPanel Grid.Column="1"
                                                           Orientation="Horizontal"
                                                           HorizontalAlignment="Right">
                                                    <Button Classes="subtle"
                                                            Command="{Binding PlayBeforeAudioCommand}"
                                                            Margin="0,0,8,8">
                                                        <TextBlock Text="{loc:Tr compare.audio_play_before}"/>
                                                    </Button>
                                                    <Button Classes="subtle"
                                                            Command="{Binding PlayAfterAudioCommand}"
                                                            Margin="0,0,8,8">
                                                        <TextBlock Text="{loc:Tr compare.audio_play_after}"/>
                                                    </Button>
                                                    <Button Classes="subtle"
                                                            Command="{Binding PlayDifferenceAudioCommand}"
                                                            Margin="0,0,8,8">
                                                        <TextBlock Text="{loc:Tr compare.audio_play_difference}"/>
                                                    </Button>
                                                    <Button Classes="subtle"
                                                            Command="{Binding StopAudioPlaybackCommand}"
                                                            Margin="0,0,0,8">
                                                        <TextBlock Text="{loc:Tr compare.audio_play_stop}"/>
                                                    </Button>
                                                </WrapPanel>
                                            </Grid>

                                            <Border Background="{DynamicResource VeyraCanvasBrush}"
                                                    BorderBrush="{DynamicResource VeyraBorderSoftBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="14"
                                                    Padding="12">
                                                <Grid RowDefinitions="Auto,Auto,Auto"
                                                      RowSpacing="10">
                                                    <Grid Grid.Row="0"
                                                          ColumnDefinitions="*,Auto"
                                                          ColumnSpacing="12">
                                                        <TextBlock Text="{Binding AudioPlaybackStatus}"
                                                                   Classes="muted"
                                                                   TextWrapping="Wrap"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding AudioPlaybackTimerText}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource VeyraTextBrush}"
                                                                   HorizontalAlignment="Right"/>
                                                    </Grid>

                                                    <Slider Grid.Row="1"
                                                            Minimum="0"
                                                            Maximum="{Binding AudioPlaybackDurationSeconds}"
                                                            Value="{Binding AudioPlaybackPositionSeconds, Mode=TwoWay}"
                                                            IsEnabled="{Binding IsAudioPlaybackSeekEnabled}"/>

                                                    <Grid Grid.Row="2"
                                                          ColumnDefinitions="*,12,*"
                                                          IsVisible="{Binding ShowAudioSpectralHero}">
                                                        <Border Grid.Column="0"
                                                                Background="{DynamicResource VeyraSurfaceBrush}"
                                                                CornerRadius="10"
                                                                ClipToBounds="True"
                                                                MinHeight="140"
                                                                IsVisible="{Binding HasAudioSpectrogramPreview}">
                                                            <Image Source="{Binding AudioSpectrogramPreview}"
                                                                   Stretch="UniformToFill"
                                                                   HorizontalAlignment="Stretch"
                                                                   VerticalAlignment="Stretch"/>
                                                        </Border>

                                                        <Border Grid.Column="2"
                                                                Background="{DynamicResource VeyraSurfaceBrush}"
                                                                CornerRadius="10"
                                                                ClipToBounds="True"
                                                                MinHeight="140"
                                                                IsVisible="{Binding HasAudioSpectralDeltaPreview}">
                                                            <Image Source="{Binding AudioSpectralDeltaPreview}"
                                                                   Stretch="UniformToFill"
                                                                   HorizontalAlignment="Stretch"
                                                                   VerticalAlignment="Stretch"/>
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                            </Border>

                                            <Border Background="{DynamicResource VeyraSurfaceSoftBrush}"
                                                    BorderBrush="{DynamicResource VeyraBorderSoftBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="10"
                                                    IsVisible="{Binding HasAudioWaveformPreview}">
                                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                              VerticalScrollBarVisibility="Auto"
                                                              MaxHeight="360">
                                                    <Image Source="{Binding AudioWaveformPreview}"
                                                           Stretch="None"
                                                           HorizontalAlignment="Left"
                                                           VerticalAlignment="Top"/>
                                                </ScrollViewer>
                                            </Border>

                                            <TextBlock Text="{loc:Tr compare.audio_preview_unavailable}"
                                                       Classes="muted"
                                                       TextWrapping="Wrap"
                                                       IsVisible="{Binding HasAudioWaveformPreview, Converter={x:Static conv:BoolInvertConverter.Instance}}"/>

                                            <TextBlock Text="{loc:Tr compare.audio_spectrogram}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       IsVisible="{Binding HasAudioSpectrogramPreview}"/>

                                            <Border Background="{DynamicResource VeyraSurfaceSoftBrush}"
                                                    BorderBrush="{DynamicResource VeyraBorderSoftBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="10"
                                                    IsVisible="{Binding HasAudioSpectrogramPreview}">
                                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                              VerticalScrollBarVisibility="Auto"
                                                              MaxHeight="320">
                                                    <Image Source="{Binding AudioSpectrogramPreview}"
                                                           Stretch="None"
                                                           HorizontalAlignment="Left"
                                                           VerticalAlignment="Top"/>
                                                </ScrollViewer>
                                            </Border>

                                            <TextBlock Text="{loc:Tr compare.audio_spectral_delta}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       IsVisible="{Binding HasAudioSpectralDeltaPreview}"/>

                                            <Border Background="{DynamicResource VeyraSurfaceSoftBrush}"
                                                    BorderBrush="{DynamicResource VeyraBorderSoftBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="10"
                                                    IsVisible="{Binding HasAudioSpectralDeltaPreview}">
                                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                              VerticalScrollBarVisibility="Auto"
                                                              MaxHeight="240">
                                                    <Image Source="{Binding AudioSpectralDeltaPreview}"
                                                           Stretch="None"
                                                           HorizontalAlignment="Left"
                                                           VerticalAlignment="Top"/>
                                                </ScrollViewer>
                                            </Border>

                                            <Border Background="{DynamicResource VeyraSurfaceSoftBrush}"
                                                    BorderBrush="{DynamicResource VeyraBorderSoftBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="10">
                                                <ItemsControl ItemsSource="{Binding PreviewMetrics}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="windows:SnapshotPreviewMetricItemViewModel">
                                                            <Grid ColumnDefinitions="180,*" ColumnSpacing="10" Margin="0,0,0,6">
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{Binding Label}"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource VeyraDiffHunkFgBrush}"/>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding Value}"
                                                                           TextWrapping="Wrap"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>

                                            <Border Background="{DynamicResource VeyraSurfaceSoftBrush}"
                                                    BorderBrush="{DynamicResource VeyraBorderSoftBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="10">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="{loc:Tr compare.audio_changed_segments}"
                                                               FontWeight="SemiBold"
                                                               FontSize="13"/>

                                                    <ItemsControl ItemsSource="{Binding AudioChangedSegments}"
                                                                  IsVisible="{Binding HasAudioChangedSegments}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="windows:AudioChangedSegmentItemViewModel">
                                                                <Border Classes="metric-card" Padding="10" Margin="0,0,0,6">
                                                                    <StackPanel Spacing="8">
                                                                        <WrapPanel Orientation="Horizontal">
                                                                            <TextBlock Text="{Binding SegmentLabel}"
                                                                                       FontWeight="SemiBold"
                                                                                       Foreground="{DynamicResource VeyraDiffHunkFgBrush}"
                                                                                       Margin="0,0,10,4"/>
                                                                            <TextBlock Text="{Binding RangeLabel}"
                                                                                       TextWrapping="Wrap"
                                                                                       Margin="0,0,10,4"/>
                                                                            <TextBlock Text="{Binding DurationLabel}"
                                                                                       Classes="muted"
                                                                                       Margin="0,0,10,4"/>
                                                                            <TextBlock Text="{Binding IntensityLabel}"
                                                                                       Classes="muted"
                                                                                       Margin="0,0,0,4"/>
                                                                        </WrapPanel>

                                                                        <WrapPanel Orientation="Horizontal">
                                                                            <Button Classes="subtle compact"
                                                                                    Margin="0,0,8,0"
                                                                                    Command="{Binding #Root.((windows:FileVersionCompareWindowViewModel)DataContext).PlayBeforeAudioSegmentCommand}"
                                                                                    CommandParameter="{Binding}">
                                                                                <TextBlock Text="{loc:Tr common.before}"/>
                                                                            </Button>
                                                                            <Button Classes="subtle compact"
                                                                                    Margin="0,0,8,0"
                                                                                    Command="{Binding #Root.((windows:FileVersionCompareWindowViewModel)DataContext).PlayAfterAudioSegmentCommand}"
                                                                                    CommandParameter="{Binding}">
                                                                                <TextBlock Text="{loc:Tr common.after}"/>
                                                                            </Button>
                                                                            <Button Classes="subtle compact"
                                                                                    Command="{Binding #Root.((windows:FileVersionCompareWindowViewModel)DataContext).LoopAudioSegmentCommand}"
                                                                                    CommandParameter="{Binding}">
                                                                                <TextBlock Text="{loc:Tr compare.audio_loop_segment}"/>
                                                                            </Button>
                                                                        </WrapPanel>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <TextBlock Text="{loc:Tr compare.audio_changed_segments_none}"
                                                               Classes="muted"
                                                               IsVisible="{Binding HasAudioChangedSegments, Converter={x:Static conv:BoolInvertConverter.Instance}}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>

                                
                                <Grid Grid.Row="0" IsVisible="{Binding IsImagePreview}">
                                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="6">
                                        <StackPanel Grid.Row="0" Spacing="10" IsVisible="False">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding ImageDiffCompactSummary}"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"/>
                                                <TextBlock Text="{Binding ImageDiffCompactStateText}"
                                                           Classes="muted"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <WrapPanel Orientation="Horizontal"
                                                       HorizontalAlignment="Left"
                                                       ItemHeight="40">
                                                <Button Classes="subtle compact"
                                                        Command="{Binding ToggleShowImageDiffDetailsCommand}"
                                                        Margin="0,0,8,8">
                                                    <Button.Content>
                                                        <StackPanel Classes="button-content">
                                                            <TextBlock Classes="button-icon" Text="i"/>
                                                            <TextBlock Classes="button-label" Text="{Binding ImageDiffDetailsToggleLabel}"/>
                                                        </StackPanel>
                                                    </Button.Content>
                                                </Button>

                                                <Button Classes="subtle compact"
                                                        Command="{Binding ToggleShowImageDiffSettingsCommand}"
                                                        Margin="0,0,0,8">
                                                    <Button.Content>
                                                        <StackPanel Classes="button-content">
                                                            <TextBlock Classes="button-icon" Text="&#xE713;"/>
                                                            <TextBlock Classes="button-label" Text="{Binding ImageDiffSettingsToggleLabel}"/>
                                                        </StackPanel>
                                                    </Button.Content>
                                                </Button>
                                            </WrapPanel>
                                        </StackPanel>

                                        <Grid Grid.Row="1"
                                              ZIndex="20">
                                            <Border Background="{DynamicResource VeyraCanvasBrush}"
                                                    BorderThickness="0"
                                                    CornerRadius="8"
                                                    Padding="0"
                                                    ClipToBounds="False"
                                                    IsVisible="{Binding HasAnyImagePreview}">
                                                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="0">
                                                    <StackPanel Grid.Row="0" Spacing="2" IsVisible="False">
                                                        <TextBlock Text="{Binding OverlayImageCaption}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="12"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{loc:Tr compare.zoom_hint}"
                                                                   Classes="muted"
                                                                   FontSize="11"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="1" Spacing="8" IsVisible="False">
                                                        <WrapPanel Orientation="Horizontal"
                                                                   HorizontalAlignment="Left"
                                                                   VerticalAlignment="Center"
                                                                   ItemHeight="40">
                                                            <Button Classes="subtle compact"
                                                                Click="OnZoomOutOverlayImageClicked"
                                                                Margin="0,0,8,8">
                                                                <Button.Content>
                                                                    <StackPanel Classes="button-content">
                                                                        <TextBlock Classes="button-icon" Text="-"/>
                                                                    </StackPanel>
                                                                </Button.Content>
                                                            </Button>

                                                            <StackPanel Orientation="Horizontal"
                                                                        Spacing="8"
                                                                        VerticalAlignment="Center"
                                                                        Margin="0,0,8,8">
                                                                <TextBlock Text="{loc:Tr compare.zoom}"
                                                                           Classes="muted"
                                                                           FontSize="11"
                                                                           VerticalAlignment="Center"/>
                                                                <Slider
                                                                        Width="140"
                                                                        Minimum="1"
                                                                        Maximum="500"
                                                                        Value="100"
                                                                        TickFrequency="10"
                                                                        ValueChanged="OnOverlayZoomSliderValueChanged"/>
                                                                <TextBlock
                                                                           Width="52"
                                                                           Text="100%"
                                                                           HorizontalAlignment="Right"
                                                                           VerticalAlignment="Center"
                                                                           FontWeight="SemiBold"/>
                                                            </StackPanel>
                                                            <Button Classes="subtle compact"
                                                                Click="OnZoomInOverlayImageClicked"
                                                                Margin="0,0,8,8">
                                                                <Button.Content>
                                                                    <StackPanel Classes="button-content">
                                                                        <TextBlock Classes="button-icon" Text="+"/>
                                                                    </StackPanel>
                                                                </Button.Content>
                                                            </Button>
                                                        </WrapPanel>

                                                        <WrapPanel Orientation="Horizontal"
                                                                   HorizontalAlignment="Left"
                                                                   VerticalAlignment="Center"
                                                                   ItemHeight="40">
                                                            <Button Classes="subtle compact"
                                                                Click="OnFitOverlayImageToViewClicked"
                                                                Margin="0,0,8,8">
                                                                <Button.Content>
                                                                    <StackPanel Classes="button-content">
                                                                        <TextBlock Classes="button-icon" Text="&#xE9A6;"/>
                                                                        <TextBlock Classes="button-label" Text="{loc:Tr compare.zoom_fit}"/>
                                                                    </StackPanel>
                                                                </Button.Content>
                                                            </Button>

                                                            <Button Classes="subtle compact"
                                                                Click="OnOpenDetachedImagePreviewClicked"
                                                                Margin="0,0,0,8">
                                                                <Button.Content>
                                                                    <StackPanel Classes="button-content">
                                                                        <TextBlock Classes="button-icon" Text="&#xE740;"/>
                                                                    </StackPanel>
                                                                </Button.Content>
                                                            </Button>
                                                        </WrapPanel>
                                                    </StackPanel>

                                                    <Grid Grid.Row="2" ClipToBounds="False">
                                                        <ScrollViewer x:Name="OverlayImageScrollViewer"
                                                                      Focusable="True"
                                                                      HorizontalScrollBarVisibility="Auto"
                                                                      VerticalScrollBarVisibility="Auto"
                                                                      HorizontalContentAlignment="Center"
                                                                      VerticalContentAlignment="Center"
                                                                      PointerPressed="OnOverlayImagePointerPressed"
                                                                      PointerMoved="OnOverlayImagePointerMoved"
                                                                      PointerReleased="OnOverlayImagePointerReleased"
                                                                      PointerCaptureLost="OnOverlayImagePointerCaptureLost"
                                                                      KeyDown="OnOverlayImageKeyDown"
                                                                      KeyUp="OnOverlayImageKeyUp"
                                                                      LostFocus="OnOverlayImageLostFocus"
                                                                      SizeChanged="OnOverlayImageViewportSizeChanged">
                                                            <Grid x:Name="OverlayImageViewportHost"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Top"
                                                                  ClipToBounds="True">
                                                                <Grid x:Name="OverlayImageHost"
                                                                      HorizontalAlignment="Left"
                                                                      VerticalAlignment="Top"
                                                                      ClipToBounds="True">
                                                                    <Image x:Name="OverlayImageControl"
                                                                           Source="{Binding OverlayImagePreview}"
                                                                           Stretch="Uniform"
                                                                           HorizontalAlignment="Left"
                                                                           VerticalAlignment="Top"/>
                                                                    <Image x:Name="OverlaySplitBaseImageControl"
                                                                           Source="{Binding RightImagePreview}"
                                                                           Stretch="Uniform"
                                                                           HorizontalAlignment="Left"
                                                                           VerticalAlignment="Top"
                                                                           IsVisible="False"/>
                                                                    <Border x:Name="OverlaySplitRevealHost"
                                                                            HorizontalAlignment="Left"
                                                                            VerticalAlignment="Top"
                                                                            ClipToBounds="True"
                                                                            IsVisible="False">
                                                                        <Image x:Name="OverlaySplitRevealImageControl"
                                                                               Source="{Binding LeftImagePreview}"
                                                                               Stretch="Uniform"
                                                                               HorizontalAlignment="Left"
                                                                               VerticalAlignment="Top"/>
                                                                    </Border>
                                                                    <Border x:Name="OverlaySplitDivider"
                                                                            Width="2"
                                                                            Background="{DynamicResource VeyraInfoBrush}"
                                                                            HorizontalAlignment="Left"
                                                                            VerticalAlignment="Stretch"
                                                                            IsVisible="False"
                                                                            IsHitTestVisible="False"/>
                                                                    <Image x:Name="OverlayPeekBeforeImageControl"
                                                                           Source="{Binding LeftImagePreview}"
                                                                           Stretch="Uniform"
                                                                           HorizontalAlignment="Left"
                                                                           VerticalAlignment="Top"
                                                                           IsVisible="False"
                                                                           IsHitTestVisible="False"/>
                                                                </Grid>
                                                            </Grid>
                                                        </ScrollViewer>

                                                        <Border Background="#D914171B"
                                                                BorderBrush="{DynamicResource VeyraBorderSoftBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="10"
                                                                Padding="10,8"
                                                                Margin="10"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Top"
                                                                IsHitTestVisible="False">
                                                            <StackPanel Spacing="2">
                                                                <TextBlock Text="{Binding OverlayImageCaption}"
                                                                           FontWeight="SemiBold"
                                                                           FontSize="12"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding ImageDiffCompactSummary}"
                                                                           Classes="muted"
                                                                           FontSize="11"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{loc:Tr compare.zoom_hint}"
                                                                           Classes="muted"
                                                                           FontSize="11"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <Border Background="#01000000"
                                                                IsVisible="{Binding ShowPreviewToolbar}"
                                                                PointerPressed="OnImageDiffSettingsBackdropPressed"/>

                                                        <Border Classes="popover-panel"
                                                                Width="520"
                                                                MaxWidth="560"
                                                                Margin="0,10,10,0"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Top"
                                                                IsVisible="{Binding ShowPreviewToolbar}">
                                                            <StackPanel Spacing="10">
                                                                <WrapPanel Orientation="Horizontal"
                                                                           HorizontalAlignment="Left"
                                                                           VerticalAlignment="Center"
                                                                           ItemHeight="40">
                                                                    <Button Classes="subtle compact"
                                                                            Click="OnZoomOutOverlayImageClicked"
                                                                            Margin="0,0,8,8">
                                                                        <StackPanel Classes="button-content">
                                                                            <TextBlock Classes="button-icon" Text="-"/>
                                                                        </StackPanel>
                                                                    </Button>

                                                                    <StackPanel Orientation="Horizontal"
                                                                                Spacing="8"
                                                                                VerticalAlignment="Center"
                                                                                Margin="0,0,8,8">
                                                                        <TextBlock Text="{loc:Tr compare.zoom}"
                                                                                   Classes="muted"
                                                                                   FontSize="11"
                                                                                   VerticalAlignment="Center"/>
                                                                        <Slider x:Name="OverlayZoomSlider"
                                                                                Width="150"
                                                                                Minimum="1"
                                                                                Maximum="500"
                                                                                Value="100"
                                                                                TickFrequency="10"
                                                                                ValueChanged="OnOverlayZoomSliderValueChanged"/>
                                                                        <TextBlock x:Name="OverlayZoomValueText"
                                                                                   Width="52"
                                                                                   Text="100%"
                                                                                   HorizontalAlignment="Right"
                                                                                   VerticalAlignment="Center"
                                                                                   FontWeight="SemiBold"/>
                                                                    </StackPanel>

                                                                    <Button Classes="subtle compact"
                                                                            Click="OnZoomInOverlayImageClicked"
                                                                            Margin="0,0,8,8">
                                                                        <StackPanel Classes="button-content">
                                                                            <TextBlock Classes="button-icon" Text="+"/>
                                                                        </StackPanel>
                                                                    </Button>

                                                                    <Button Classes="subtle compact"
                                                                            Click="OnFitOverlayImageToViewClicked"
                                                                            Margin="0,0,8,8">
                                                                        <StackPanel Classes="button-content">
                                                                            <TextBlock Classes="button-icon" Text="&#xE9A6;"/>
                                                                            <TextBlock Classes="button-label" Text="{loc:Tr compare.zoom_fit}"/>
                                                                        </StackPanel>
                                                                    </Button>
                                                                </WrapPanel>

                                                                <WrapPanel Orientation="Horizontal"
                                                                           HorizontalAlignment="Left"
                                                                           ItemHeight="40">
                                                                    <Button Classes="subtle compact"
                                                                            Command="{Binding SaveImageDiffPreviewCommand}"
                                                                            IsEnabled="{Binding CanSaveImageDiffPreview}"
                                                                            Margin="0,0,8,8">
                                                                        <StackPanel Classes="button-content">
                                                                            <TextBlock Classes="button-icon" Text="&#xE74E;"/>
                                                                            <TextBlock Classes="button-label" Text="{loc:Tr compare.save_diff_preview}"/>
                                                                        </StackPanel>
                                                                    </Button>

                                                                    <Button Classes="subtle compact"
                                                                            Click="OnOpenDetachedImagePreviewClicked"
                                                                            Margin="0,0,8,8">
                                                                        <StackPanel Classes="button-content">
                                                                            <TextBlock Classes="button-icon" Text="&#xE740;"/>
                                                                        </StackPanel>
                                                                    </Button>

                                                                    <Button Classes="subtle compact"
                                                                            Command="{Binding OpenSourceFileCommand}"
                                                                            IsEnabled="{Binding CanOpenSourceFileOnDisk}"
                                                                            Margin="0,0,8,8">
                                                                        <StackPanel Classes="button-content">
                                                                            <TextBlock Classes="button-icon" Text="&#xE8A7;"/>
                                                                            <TextBlock Classes="button-label" Text="{loc:Tr compare.open_file}"/>
                                                                        </StackPanel>
                                                                    </Button>

                                                                    <Button Classes="subtle compact"
                                                                            Command="{Binding OpenSourceFileInExplorerCommand}"
                                                                            IsEnabled="{Binding CanOpenSourceFileOnDisk}"
                                                                            Margin="0,0,8,8">
                                                                        <StackPanel Classes="button-content">
                                                                            <TextBlock Classes="button-icon" Text="&#xE838;"/>
                                                                            <TextBlock Classes="button-label" Text="{loc:Tr compare.show_in_explorer}"/>
                                                                        </StackPanel>
                                                                    </Button>

                                                                    <Button Classes="primary compact"
                                                                            Command="{Binding CloseCommand}"
                                                                            Margin="0,0,0,8">
                                                                        <StackPanel Classes="button-content">
                                                                            <TextBlock Classes="button-icon" Text="&#xE711;"/>
                                                                            <TextBlock Classes="button-label" Text="{loc:Tr common.close}"/>
                                                                        </StackPanel>
                                                                    </Button>
                                                                </WrapPanel>
                                                            </StackPanel>
                                                        </Border>

                                                        <Border Background="#01000000"
                                                                ZIndex="900"
                                                                IsVisible="{Binding ShowImageDiffSettings}"
                                                                PointerPressed="OnImageDiffSettingsBackdropPressed"/>

                                                        <Border Classes="popover-panel"
                                                                ZIndex="901"
                                                                Width="430"
                                                                MaxWidth="430"
                                                                Margin="0,12,12,12"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Top"
                                                                IsVisible="{Binding ShowImageDiffSettings}">
                                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                                          HorizontalScrollBarVisibility="Disabled"
                                                                          MaxHeight="520">
                                                                <StackPanel Spacing="10">
                                                                    <TextBlock Text="{loc:Tr compare.image_diff_settings_title}" FontWeight="SemiBold"/>

                                                                    <StackPanel Spacing="4">
                                                                        <TextBlock Text="{loc:Tr compare.image_mode}" Classes="muted" FontSize="11"/>
                                                                        <Border Classes="segmented-control">
                                                                            <ItemsControl ItemsSource="{Binding ImageDiffModes}">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate>
                                                                                        <WrapPanel Orientation="Horizontal"/>
                                                                                    </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate x:DataType="windows:ImageDiffModeOptionViewModel">
                                                                                        <ToggleButton Classes="segmented"
                                                                                                      Content="{Binding Label}"
                                                                                                      IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                                                                      Command="{Binding #Root.((windows:FileVersionCompareWindowViewModel)DataContext).SelectImageDiffModeCommand}"
                                                                                                      CommandParameter="{Binding}"/>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </Border>
                                                                    </StackPanel>

                                                                    <StackPanel Spacing="10">
                                                                        <StackPanel Spacing="4">
                                                                            <TextBlock Text="{loc:Tr compare.image_sensitivity}" Classes="muted" FontSize="11"/>
                                                                            <Slider Minimum="1"
                                                                                    Maximum="100"
                                                                                    Value="{Binding ImageDiffSensitivity}"
                                                                                    TickFrequency="5"
                                                                                    IsSnapToTickEnabled="False"/>
                                                                            <TextBlock Text="{Binding ImageSensitivityLabel}" Classes="muted" FontSize="11"/>
                                                                        </StackPanel>

                                                                        <StackPanel Spacing="4"
                                                                                    IsVisible="{Binding IsSplitImageDiffMode}">
                                                                            <TextBlock Text="{loc:Tr compare.image_split}" Classes="muted" FontSize="11"/>
                                                                            <Slider Minimum="{Binding MinComparisonSplitPercent}"
                                                                                    Maximum="{Binding MaxComparisonSplitPercent}"
                                                                                    Value="{Binding ComparisonSplitPercent}"/>
                                                                            <TextBlock Text="{Binding SplitPositionLabel}" Classes="muted" FontSize="11"/>
                                                                        </StackPanel>
                                                                    </StackPanel>

                                                                    <WrapPanel Orientation="Horizontal">
                                                                        <Button Classes="subtle compact"
                                                                                Margin="0,0,8,8"
                                                                                Command="{Binding ToggleShowImageDiffRegionBoxesCommand}">
                                                                            <Button.Content>
                                                                                <StackPanel Classes="button-content">
                                                                                    <TextBlock Classes="button-icon" Text="&#xE81E;"/>
                                                                                    <TextBlock Classes="button-label persistent" Text="{Binding ImageRegionBoxesLabel}"/>
                                                                                </StackPanel>
                                                                            </Button.Content>
                                                                        </Button>
                                                                        <Button Classes="subtle compact"
                                                                                Margin="0,0,0,8"
                                                                                Command="{Binding ResetImageDiffSettingsCommand}">
                                                                            <Button.Content>
                                                                                <StackPanel Classes="button-content">
                                                                                    <TextBlock Classes="button-icon" Text="&#xE72C;"/>
                                                                                    <TextBlock Classes="button-label persistent" Text="{loc:Tr compare.reset_diff_settings}"/>
                                                                                </StackPanel>
                                                                            </Button.Content>
                                                                        </Button>
                                                                    </WrapPanel>
                                                                </StackPanel>
                                                            </ScrollViewer>
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                            </Border>

                                            <TextBlock Text="{loc:Tr compare.image_preview_unavailable}"
                                                       Classes="muted"
                                                       IsVisible="{Binding HasNoImagePreviews}"
                                                       VerticalAlignment="Top"/>
                                        </Grid>

                                        <Border Grid.Row="2"
                                                ZIndex="0"
                                                Background="{DynamicResource VeyraCanvasBrush}"
                                                BorderBrush="{DynamicResource VeyraBorderSoftBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="10"
                                                IsVisible="{Binding ShowSourceImagePanelsSection}">
                                            <Grid RowDefinitions="Auto,*" RowSpacing="8">
                                                <TextBlock Grid.Row="0" Text="{loc:Tr compare.image_sources}" FontWeight="SemiBold"/>
                                                <Grid Grid.Row="1" RowDefinitions="*,8,*" RowSpacing="0">
                                                    <Border Grid.Row="0" Background="{DynamicResource VeyraCanvasBrush}" BorderBrush="{DynamicResource VeyraBorderSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="8">
                                                        <Grid RowDefinitions="Auto,*" RowSpacing="8">
                                                            <TextBlock Grid.Row="0" Text="{Binding LeftImageCaption}" FontWeight="SemiBold"/>
                                                            <ScrollViewer Grid.Row="1"
                                                                          HorizontalScrollBarVisibility="Auto"
                                                                          VerticalScrollBarVisibility="Auto"
                                                                          MaxHeight="220">
                                                                <Image Source="{Binding LeftImagePreview}"
                                                                       Stretch="Uniform"
                                                                       HorizontalAlignment="Left"
                                                                       VerticalAlignment="Top"/>
                                                            </ScrollViewer>
                                                        </Grid>
                                                    </Border>
                                                    <GridSplitter Grid.Row="1"
                                                                  Height="8"
                                                                  Background="{DynamicResource VeyraSplitBrush}"
                                                                  ResizeDirection="Rows"
                                                                  ResizeBehavior="PreviousAndNext"
                                                                  HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Stretch"/>
                                                    <Border Grid.Row="2" Background="{DynamicResource VeyraCanvasBrush}" BorderBrush="{DynamicResource VeyraBorderSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="8">
                                                        <Grid RowDefinitions="Auto,*" RowSpacing="8">
                                                            <TextBlock Grid.Row="0" Text="{Binding RightImageCaption}" FontWeight="SemiBold"/>
                                                            <ScrollViewer Grid.Row="1"
                                                                          HorizontalScrollBarVisibility="Auto"
                                                                          VerticalScrollBarVisibility="Auto"
                                                                          MaxHeight="220">
                                                                <Image Source="{Binding RightImagePreview}"
                                                                       Stretch="Uniform"
                                                                       HorizontalAlignment="Left"
                                                                       VerticalAlignment="Top"/>
                                                            </ScrollViewer>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                                <TextBlock Grid.Row="1" 
                                           Text="{Binding PreviewSummary}"
                                           Classes="muted"
                                           IsVisible="{Binding ShowNoDiffPreviewMessage}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="2"
                                           Text="{loc:Tr compare.no_full_preview}"
                                           Classes="muted"
                                           IsVisible="{Binding ShowNoFullFilePreviewMessage}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="3"
                                           Text="{loc:Tr compare.word_hint}"
                                           Classes="muted"
                                           FontSize="11"
                                           Opacity="0.82"
                                           IsVisible="{Binding IsWordDocument}"
                                           TextWrapping="Wrap"/>
                            </Grid>

                            <Border Grid.RowSpan="2"
                                    Classes="loading-overlay"
                                    IsVisible="{Binding IsBusyOverlayVisible}">
                                <Border Classes="loading-card"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Width="360"
                                        MaxWidth="420">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="{Binding LoadingTitle}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"/>
                                        <TextBlock Text="{Binding LoadingDetail}"
                                                   Classes="muted"
                                                   TextWrapping="Wrap"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"/>
                                        <ProgressBar Minimum="0"
                                                     Maximum="100"
                                                     Height="10"
                                                     Value="{Binding LoadingProgressValue}"
                                                     IsIndeterminate="{Binding IsLoadingProgressIndeterminate}"/>
                                        <TextBlock Text="{Binding LoadingStatusLabel}"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"
                                                   IsVisible="{Binding HasLoadingStatusLabel}"/>
                                    </StackPanel>
                                </Border>
                            </Border>

                            <Border Grid.RowSpan="2"
                                    Background="#01000000"
                                    IsVisible="{Binding ShowNonImagePreviewToolbar}"
                                    PointerPressed="OnImageDiffSettingsBackdropPressed"/>

                            <Border Grid.RowSpan="2"
                                    Classes="popover-panel"
                                    Width="520"
                                    MaxWidth="560"
                                    Margin="0,10,10,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    IsVisible="{Binding ShowNonImagePreviewToolbar}">
                                <WrapPanel Orientation="Horizontal"
                                           HorizontalAlignment="Left"
                                           ItemHeight="40">
                                    <Button Classes="subtle compact"
                                            Command="{Binding ToggleWrapModeCommand}"
                                            IsVisible="{Binding IsTextPreview}"
                                            Margin="0,0,8,8">
                                        <StackPanel Classes="button-content">
                                            <TextBlock Classes="button-icon" Text="&#xE8A9;"/>
                                            <TextBlock Classes="button-label" Text="{Binding WrapToggleLabel}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="subtle compact"
                                            Command="{Binding ToggleFullFilePreviewCommand}"
                                            IsEnabled="{Binding CanToggleFullFilePreview}"
                                            IsVisible="{Binding CanToggleFullFilePreview}"
                                            Margin="0,0,8,8">
                                        <StackPanel Classes="button-content">
                                            <TextBlock Classes="button-icon" Text="&#xE8A9;"/>
                                            <TextBlock Classes="button-label" Text="{Binding FullPreviewToggleLabel}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="subtle compact"
                                            Command="{Binding ToggleSvgCodePreviewCommand}"
                                            IsVisible="{Binding IsSvgFile}"
                                            IsEnabled="{Binding CanToggleSvgCodePreview}"
                                            Margin="0,0,8,8">
                                        <StackPanel Classes="button-content">
                                            <TextBlock Classes="button-icon" Text="&#xE943;"/>
                                            <TextBlock Classes="button-label" Text="{Binding SvgCodePreviewToggleLabel}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="subtle compact"
                                            Command="{Binding OpenNativeWordCompareCommand}"
                                            IsVisible="{Binding IsWordDocument}"
                                            IsEnabled="{Binding CanOpenNativeWordCompare}"
                                            Margin="0,0,8,8">
                                        <StackPanel Classes="button-content">
                                            <TextBlock Classes="button-icon" Text="&#xE70F;"/>
                                            <TextBlock Classes="button-label" Text="{loc:Tr compare.open_word_compare}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="subtle compact"
                                            Command="{Binding OpenNativeWordCompareWithFormattingCommand}"
                                            IsVisible="{Binding IsWordDocument}"
                                            IsEnabled="{Binding CanOpenNativeWordCompare}"
                                            Margin="0,0,8,8">
                                        <StackPanel Classes="button-content">
                                            <TextBlock Classes="button-icon" Text="&#xE8A7;"/>
                                            <TextBlock Classes="button-label" Text="{loc:Tr compare.word_compare_styles}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="subtle compact"
                                            Command="{Binding OpenSourceFileCommand}"
                                            IsEnabled="{Binding CanOpenSourceFileOnDisk}"
                                            Margin="0,0,8,8">
                                        <StackPanel Classes="button-content">
                                            <TextBlock Classes="button-icon" Text="&#xE8A7;"/>
                                            <TextBlock Classes="button-label" Text="{loc:Tr compare.open_file}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="subtle compact"
                                            Command="{Binding OpenSourceFileInExplorerCommand}"
                                            IsEnabled="{Binding CanOpenSourceFileOnDisk}"
                                            Margin="0,0,8,8">
                                        <StackPanel Classes="button-content">
                                            <TextBlock Classes="button-icon" Text="&#xE838;"/>
                                            <TextBlock Classes="button-label" Text="{loc:Tr compare.show_in_explorer}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="primary compact"
                                            Command="{Binding CloseCommand}"
                                            Margin="0,0,0,8">
                                        <StackPanel Classes="button-content">
                                            <TextBlock Classes="button-icon" Text="&#xE711;"/>
                                            <TextBlock Classes="button-label" Text="{loc:Tr common.close}"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </Border>
                        </Grid>
                    </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Classes="dialog-shell"
                Background="{DynamicResource VeyraSurfaceSoftBrush}"
                BorderBrush="{DynamicResource VeyraBorderBrush}"
                Padding="12"
                IsVisible="False">
            <StackPanel Spacing="10">
                <StackPanel Spacing="2"
                            IsVisible="{Binding IsImagePreview, Converter={x:Static conv:BoolInvertConverter.Instance}}">
                    <TextBlock Text="{Binding SelectedPairSummary}" Classes="muted" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding PreviewSummary}" Classes="muted" TextWrapping="Wrap" Opacity="0.86"/>
                </StackPanel>

                <WrapPanel Orientation="Horizontal"
                           HorizontalAlignment="Left"
                           ItemHeight="40">
                    <Button Classes="subtle responsive-icon" Command="{Binding ToggleWrapModeCommand}" IsVisible="{Binding IsTextPreview}" Margin="0,0,8,8">
                        <Button.Content>
                            <StackPanel Classes="button-content">
                                <TextBlock Classes="button-icon" Text="&#xE8A9;"/>
                                <TextBlock Classes="button-label" Text="{Binding WrapToggleLabel}"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <Button Classes="subtle responsive-icon"
                            Command="{Binding ToggleFullFilePreviewCommand}"
                            IsEnabled="{Binding CanToggleFullFilePreview}"
                            IsVisible="{Binding CanToggleFullFilePreview}"
                            Margin="0,0,8,8">
                        <Button.Content>
                            <StackPanel Classes="button-content">
                                <TextBlock Classes="button-icon" Text="&#xE8A9;"/>
                                <TextBlock Classes="button-label" Text="{Binding FullPreviewToggleLabel}"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <Button Classes="subtle responsive-icon"
                            Command="{Binding ToggleSvgCodePreviewCommand}"
                            IsVisible="{Binding IsSvgFile}"
                            IsEnabled="{Binding CanToggleSvgCodePreview}"
                            Margin="0,0,8,8">
                        <Button.Content>
                            <StackPanel Classes="button-content">
                                <TextBlock Classes="button-icon" Text="&#xE943;"/>
                                <TextBlock Classes="button-label" Text="{Binding SvgCodePreviewToggleLabel}"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <Button Classes="subtle responsive-icon"
                            Command="{Binding SaveImageDiffPreviewCommand}"
                            IsVisible="{Binding IsImagePreview}"
                            IsEnabled="{Binding CanSaveImageDiffPreview}"
                            Margin="0,0,8,8">
                        <Button.Content>
                            <StackPanel Classes="button-content">
                                <TextBlock Classes="button-icon" Text="&#xE74E;"/>
                                <TextBlock Classes="button-label" Text="{loc:Tr compare.save_diff_preview}"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <Button Classes="subtle responsive-icon"
                            Command="{Binding OpenNativeWordCompareCommand}"
                            IsVisible="{Binding IsWordDocument}"
                            IsEnabled="{Binding CanOpenNativeWordCompare}"
                            Margin="0,0,8,8">
                        <Button.Content>
                            <StackPanel Classes="button-content">
                                <TextBlock Classes="button-icon" Text="&#xE70F;"/>
                                <TextBlock Classes="button-label" Text="{loc:Tr compare.open_word_compare}"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <Button Classes="subtle responsive-icon"
                            Command="{Binding OpenNativeWordCompareWithFormattingCommand}"
                            IsVisible="{Binding IsWordDocument}"
                            IsEnabled="{Binding CanOpenNativeWordCompare}"
                            Margin="0,0,8,8">
                        <Button.Content>
                            <StackPanel Classes="button-content">
                                <TextBlock Classes="button-icon" Text="&#xE8A7;"/>
                                <TextBlock Classes="button-label" Text="{loc:Tr compare.word_compare_styles}"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <Button Classes="subtle responsive-icon"
                            Command="{Binding OpenSourceFileCommand}"
                            IsEnabled="{Binding CanOpenSourceFileOnDisk}"
                            Margin="0,0,8,8">
                        <Button.Content>
                            <StackPanel Classes="button-content">
                                <TextBlock Classes="button-icon" Text="&#xE8A7;"/>
                                <TextBlock Classes="button-label" Text="{loc:Tr compare.open_file}"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <Button Classes="subtle responsive-icon"
                            Command="{Binding OpenSourceFileInExplorerCommand}"
                            IsEnabled="{Binding CanOpenSourceFileOnDisk}"
                            Margin="0,0,8,8">
                        <Button.Content>
                            <StackPanel Classes="button-content">
                                <TextBlock Classes="button-icon" Text="&#xE838;"/>
                                <TextBlock Classes="button-label" Text="{loc:Tr compare.show_in_explorer}"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <Button Classes="primary responsive-icon" Command="{Binding CloseCommand}" Margin="0,0,0,8">
                        <Button.Content>
                            <StackPanel Classes="button-content">
                                <TextBlock Classes="button-icon" Text="&#xE711;"/>
                                <TextBlock Classes="button-label" Text="{loc:Tr common.close}"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
