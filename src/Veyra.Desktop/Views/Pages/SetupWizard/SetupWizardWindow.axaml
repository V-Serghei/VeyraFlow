<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Veyra.Desktop.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:Veyra.Desktop.ViewModels.Pages.SetupWizard"
        xmlns:pages="clr-namespace:Veyra.Desktop.Views.Pages.SetupWizard"
        xmlns:conv="clr-namespace:Veyra.Desktop.Converters"
        x:Class="Veyra.Desktop.Views.Pages.SetupWizard.SetupWizardWindow"
        x:DataType="vm:SetupWizardViewModel"
        Width="1020" Height="700" MinWidth="820" MinHeight="560" Title="{loc:Tr setup_wizard.window_title}"
        Background="{DynamicResource VeyraCanvasBrush}" Foreground="{DynamicResource VeyraTextPrimaryBrush}" CanResize="True"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16" ColumnDefinitions="250,8,*" ColumnSpacing="0">
        <Border Grid.Column="0" Classes="sidebar" Padding="16" MinWidth="210">
            <StackPanel Spacing="10">
                <TextBlock Text="{loc:Tr setup_wizard.title}" Classes="h2"/>
                <TextBlock Text="{loc:Tr setup_wizard.subtitle}" Classes="muted" TextWrapping="Wrap"/>

                <Border Classes="card" Padding="12" Margin="0,10,0,0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{loc:Tr setup_wizard.steps}" Classes="label"/>
                        <TextBlock Text="{loc:Tr setup_wizard.step1}"/>
                        <TextBlock Text="{loc:Tr setup_wizard.step2}"/>
                        <TextBlock Text="{loc:Tr setup_wizard.step3}"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding StepInfo}" Opacity="0.7" Margin="0,10,0,0"/>
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource VeyraDangerBrush}" TextWrapping="Wrap"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </Border>

        <GridSplitter Grid.Column="1"
                      Width="8"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"/>

        <DockPanel Grid.Column="2" Margin="12,0,0,0">
            <Border DockPanel.Dock="Bottom" Classes="toolbar" Padding="12" Margin="0,14,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="{loc:Tr common.back}" Width="120" Command="{Binding BackCommand}" Classes="subtle"/>
                    <Button Content="{Binding NextButtonText}" Width="170"
                            Command="{Binding NextCommand}" IsEnabled="{Binding CanGoNext}" Classes="primary"/>
                </StackPanel>
            </Border>

            <Border Classes="panel" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ContentControl Content="{Binding CurrentStep}">
                        <ContentControl.DataTemplates>
                            <DataTemplate DataType="vm:SelectDirectoriesViewModel">
                                <pages:SelectDirectoriesPage/>
                            </DataTemplate>
                            <DataTemplate DataType="vm:SelectFormatsViewModel">
                                <pages:SelectFormatsPage/>
                            </DataTemplate>
                            <DataTemplate DataType="vm:RepositoryNameViewModel">
                                <pages:RepositoryNamePage/>
                            </DataTemplate>
                        </ContentControl.DataTemplates>
                    </ContentControl>
                </ScrollViewer>
            </Border>
        </DockPanel>
    </Grid>
</Window>

