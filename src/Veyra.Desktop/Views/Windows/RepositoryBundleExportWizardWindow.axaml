<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Veyra.Desktop.Localization"
        xmlns:conv="clr-namespace:Veyra.Desktop.Converters"
        xmlns:windows="clr-namespace:Veyra.Desktop.ViewModels.Windows"
        x:Class="Veyra.Desktop.Views.Windows.RepositoryBundleExportWizardWindow"
        x:DataType="windows:RepositoryBundleExportWizardWindowViewModel"
        Width="760"
        Height="620"
        MinWidth="660"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        Title="{Binding WindowTitle}">

    <Grid>
        <Border Classes="dialog-shell" Margin="14" Padding="18">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
                <Border Grid.Row="0" Classes="dialog-hero">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding WindowTitle}" Classes="h2"/>
                        <TextBlock Text="{loc:Tr repo_settings.bundle_hint}" Classes="muted" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <Border Classes="card" Padding="14">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding StepOneTitle}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding StepOneDescription}" Classes="muted" TextWrapping="Wrap"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox Grid.Column="0"
                                             Text="{Binding BundlePath, Mode=TwoWay}"
                                             Watermark="{loc:Tr bundle_export.bundle_path_placeholder}"/>
                                    <Button Grid.Column="1"
                                            Classes="subtle"
                                            Command="{Binding BrowseBundlePathCommand}"
                                            Content="{loc:Tr common.browse}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Padding="14">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding StepTwoTitle}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding StepTwoDescription}" Classes="muted" TextWrapping="Wrap"/>
                                <Button Classes="primary"
                                        Command="{Binding StartExportCommand}"
                                        IsEnabled="{Binding CanStartExport}"
                                        Content="{Binding StartExportLabel}"
                                        HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding Message}"
                                           Classes="muted"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding HasMessage}"/>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Padding="14" IsVisible="{Binding HasResultDetails}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding StepThreeTitle}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding StepThreeDescription}" Classes="muted" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding ResultSummary}"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding HasResultSummary}"/>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <Border Classes="metric-card">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{loc:Tr bundle_export.snapshots_label}" Classes="caption"/>
                                            <TextBlock Text="{Binding SnapshotCount}" FontSize="18" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Classes="metric-card">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{loc:Tr bundle_export.file_versions_label}" Classes="caption"/>
                                            <TextBlock Text="{Binding FileVersionCount}" FontSize="18" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <Border Classes="metric-card">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{loc:Tr bundle_export.blocks_label}" Classes="caption"/>
                                            <TextBlock Text="{Binding BlockFileCount}" FontSize="18" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Classes="metric-card">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{loc:Tr common.size}" Classes="caption"/>
                                            <TextBlock Text="{Binding BundleSizeText}" FontSize="18" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Classes="toolbar" Padding="10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Content="{Binding CloseLabel}" Command="{Binding CloseCommand}" Classes="subtle" Width="120"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Classes="loading-overlay" IsVisible="{Binding IsBusy}">
            <Border Classes="loading-card" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                <StackPanel Classes="loading-state">
                    <TextBlock Text="{loc:Tr bundle_export.running}" FontSize="18" FontWeight="SemiBold" TextAlignment="Center"/>
                    <TextBlock Text="{loc:Tr bundle_export.running_detail}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center"/>
                    <ProgressBar Classes="loading-progress" IsIndeterminate="True"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
