<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Veyra.Desktop.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Veyra.Desktop.ViewModels.Pages.SetupWizard"
             xmlns:formatted="clr-namespace:Veyra.Desktop.Models.TrackedFormats"
             xmlns:setupWizard="clr-namespace:Veyra.Desktop.ViewModels.Pages.SetupWizard"
             x:Class="Veyra.Desktop.Views.Pages.SetupWizard.SelectFormatsPage"
             x:Name="Root"
             d:DataContext="{d:DesignInstance vm:SelectFormatsViewModel, IsDesignTimeCreatable=True}"
             x:DataType="vm:SelectFormatsViewModel">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
        <StackPanel Spacing="8">
            <TextBlock Classes="h2" Text="{loc:Tr setup.select_formats}"/>
            <TextBlock Classes="muted" Text="{loc:Tr setup.select_formats_subtitle}"/>
        </StackPanel>

        <Border Grid.Row="1" Classes="panel" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{loc:Tr setup.format_categories_title}" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:Tr setup.format_categories_hint}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                        <ItemsControl ItemsSource="{Binding FormatCategories}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="formatted:FormatCategoryItemViewModel">
                                    <Button Margin="5"
                                            Padding="12,6"
                                            Classes="subtle compact"
                                            Classes.primary="{Binding IsApplied}"
                                            Command="{Binding #Root.((vm:SelectFormatsViewModel)DataContext).ToggleCategoryCommand}"
                                            CommandParameter="{Binding .}">
                                        <TextBlock Text="{Binding DisplayName}"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding AllExtensions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="setupWizard:FileExtensionOption">
                                <ToggleButton Margin="5" Padding="12,6" IsChecked="{Binding IsSelected}">
                                    <TextBlock Text="{Binding Name}"/>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="220,Auto,*" ColumnSpacing="8">
            <TextBox Grid.Column="0" Text="{Binding CustomExt, Mode=TwoWay}" Watermark="{loc:Tr setup.add_format_placeholder}"/>
            <Button Grid.Column="1" Content="{loc:Tr common.add}" Width="100" Command="{Binding AddCustomCommand}" Classes="primary"/>
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Opacity="0.7" Text="{Binding FooterText}" TextWrapping="Wrap"/>
        </Grid>
    </Grid>
</UserControl>
