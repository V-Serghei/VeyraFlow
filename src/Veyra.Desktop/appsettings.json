{
  "CloudApi": {
    "_comment": "railway: https://veyraflow-production-0893.up.railway.app | local: http://localhost:8080",
    "BaseUrl": "https://veyraflow-production-0893.up.railway.app",
    "TokenPolicy": {
      "ExpiringSoonMinutes": 15,
      "ClockSkewSeconds": 60
    }
  },
  "SnapshotScheduler": {
    "Enabled": true,
    "PollSeconds": 60,
    "IntervalMinutes": 60,
    "QuietHoursStartHour": 0,
    "QuietHoursEndHour": 0,
    "MaxReadBytesPerSecond": 16777216,
    "MaxIoOperationsPerSecond": 128,
    "RetryCount": 2,
    "RetryDelaySeconds": 10,
    "IntegrityEnabled": true,
    "IntegrityIntervalMinutes": 720,
    "IntegrityRepairFromCloud": false,
    "IntegrityIssueSampleLimit": 200
  },
  "Storage": {
    "BlockStorePath": ""
  },
  "CloudSync": {
    "FaultInjection": {
      "Enabled": false,
      "NetworkDropEvery": 0,
      "TimeoutEvery": 0,
      "DuplicateAckOnPush": false,
      "StaleRemoteHeadOnList": false
    }
  },
  "Security": {
    "ArtifactEncryption": {
      "Enabled": true,
      "KeyBase64": "",
      "KeyPath": "",
      "MasterKeyPath": "",
      "KeyRingPath": ""
    }
  },
  "Seq": {
    "Url": "http://localhost:5341"
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "EfCommandLevel": "Warning"
  }
}
