{
  "CloudApi": {
    "BaseUrl": "http://localhost:8080",
    "TokenPolicy": {
      "ExpiringSoonMinutes": 15,
      "ClockSkewSeconds": 60
    }
  },
  "SnapshotScheduler": {
    "Enabled": true,
    "PollSeconds": 30,
    "IntervalMinutes": 15,
    "QuietHoursStartHour": 0,
    "QuietHoursEndHour": 0,
    "MaxReadBytesPerSecond": 0,
    "MaxIoOperationsPerSecond": 0,
    "RetryCount": 2,
    "RetryDelaySeconds": 10,
    "IntegrityEnabled": true,
    "IntegrityIntervalMinutes": 180,
    "IntegrityRepairFromCloud": false,
    "IntegrityIssueSampleLimit": 200
  },
  "Storage": {
    "BlockStorePath": ""
  },
  "CloudSync": {
    "FaultInjection": {
      "Enabled": false,
      "NetworkDropEvery": 0,
      "TimeoutEvery": 0,
      "DuplicateAckOnPush": false,
      "StaleRemoteHeadOnList": false
    }
  },
  "Security": {
    "ArtifactEncryption": {
      "Enabled": true,
      "KeyBase64": "",
      "KeyPath": "",
      "MasterKeyPath": "",
      "KeyRingPath": ""
    }
  },
  "Seq": {
    "Url": "http://localhost:5341"
  },
  "Serilog": {
    "MinimumLevel": "Debug",
    "EfCommandLevel": "Warning"
  }
}
