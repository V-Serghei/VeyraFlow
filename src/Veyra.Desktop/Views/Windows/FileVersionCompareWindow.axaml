<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:windows="clr-namespace:Veyra.Desktop.ViewModels.Windows"
        xmlns:explorer="clr-namespace:Veyra.Desktop.ViewModels.Pages.Explorer"
        xmlns:conv="clr-namespace:Veyra.Desktop.Converters"
        mc:Ignorable="d"
        x:Class="Veyra.Desktop.Views.Windows.FileVersionCompareWindow"
        x:Name="Root"
        x:DataType="windows:FileVersionCompareWindowViewModel"
        Width="1460"
        Height="920"
        MinWidth="1180"
        MinHeight="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource VeyraCanvasBrush}"
        Foreground="{DynamicResource VeyraTextPrimaryBrush}"
        Title="Compare Versions">

    <Grid RowDefinitions="Auto,*" Margin="16" RowSpacing="12">
        <Border Grid.Row="0" Classes="dialog-hero">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                <TextBlock Grid.Row="0" Text="{Binding WindowTitle}" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="1" Text="{Binding InstructionText}" Classes="muted" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="360,*" ColumnSpacing="12">
            <Border Grid.Column="0" Classes="dialog-shell">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                    <TextBlock Grid.Row="0" Text="Version history" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="1" Classes="muted" Text="Left click = LEFT side, Right click = RIGHT side"/>

                    <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="8">
                        <TextBlock Grid.Row="0" Text="Loading versions..." Classes="muted" IsVisible="{Binding IsVersionListLoading}"/>

                        <ListBox Grid.Row="1"
                                 Classes="clean-list"
                                 ItemsSource="{Binding Versions}"
                                 IsVisible="{Binding HasVersions}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="windows:FileVersionCompareListItemViewModel">
                                    <Border Classes="list-item"
                                            Background="{Binding CardBackground}"
                                            BorderBrush="{Binding CardBorderBrush}"
                                            PointerPressed="OnVersionItemPointerPressed">
                                        <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                <TextBlock Grid.Column="0" Text="{Binding VersionName}" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding CreatedAtDisplay}" Opacity="0.82"/>
                                                <Border Grid.Column="2"
                                                        Classes="badge"
                                                        Background="{Binding SelectionBadgeBackground}"
                                                        Padding="8,4"
                                                        IsVisible="{Binding HasSelectionBadge}">
                                                    <TextBlock Text="{Binding SelectionBadge}"
                                                               Foreground="{Binding SelectionBadgeForeground}"
                                                               FontWeight="SemiBold"
                                                               FontSize="11"/>
                                                </Border>
                                            </Grid>

                                            <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                <TextBlock Grid.Column="0" Text="{Binding SizeDisplay}" Classes="muted" FontSize="11"/>
                                                <TextBlock Grid.Column="1" Text="{Binding StateLabel}" Classes="muted" FontSize="11"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Grid.Row="1"
                                   Text="No versions found for selected file."
                                   Classes="muted"
                                   IsVisible="{Binding HasNoVersions}"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Classes="dialog-shell">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Selected pair" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedPairSummary}" Classes="muted" TextWrapping="Wrap"/>
                        </StackPanel>

                        <WrapPanel Grid.Column="1" Orientation="Horizontal" ItemHeight="34" ItemWidth="150">
                            <Button Content="{Binding WrapToggleLabel}" Classes="subtle" Command="{Binding ToggleWrapModeCommand}"/>
                            <Button Content="{Binding FullPreviewToggleLabel}"
                                    Classes="subtle"
                                    Command="{Binding ToggleFullFilePreviewCommand}"
                                    IsEnabled="{Binding CanToggleFullFilePreview}"/>
                            <Button Content="Open file"
                                    Classes="subtle"
                                    Command="{Binding OpenSourceFileCommand}"
                                    IsEnabled="{Binding CanOpenSourceFileOnDisk}"/>
                            <Button Content="Show in Explorer"
                                    Classes="subtle"
                                    Command="{Binding OpenSourceFileInExplorerCommand}"
                                    IsEnabled="{Binding CanOpenSourceFileOnDisk}"/>
                            <Button Content="Close" Classes="subtle" Command="{Binding CloseCommand}"/>
                        </WrapPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Spacing="4">
                        <TextBlock Text="{Binding PreviewSummary}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{DynamicResource VeyraDangerBrush}"
                                   IsVisible="{Binding HasErrorMessage}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="8">
                        <TextBlock Grid.Row="0" Text="Building preview..." Classes="muted" IsVisible="{Binding IsPreviewLoading}"/>

                        <Grid Grid.Row="1" RowDefinitions="*,Auto,Auto" RowSpacing="8">
                            <Border Grid.Row="0" Classes="diff-surface" IsVisible="{Binding ShowDiffRowsPanel}">
                                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                                    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
                                        <Border Grid.Column="0" Background="#1F4A3A" CornerRadius="8" Padding="8,4">
                                            <TextBlock Text="+ Added" Foreground="#98FFD2" FontWeight="SemiBold" FontSize="11"/>
                                        </Border>
                                        <Border Grid.Column="1" Background="#4A2530" CornerRadius="8" Padding="8,4">
                                            <TextBlock Text="- Removed" Foreground="#FFB1BC" FontWeight="SemiBold" FontSize="11"/>
                                        </Border>
                                        <Border Grid.Column="2" Background="#30455F" CornerRadius="8" Padding="8,4">
                                            <TextBlock Text="~ Modified" Foreground="#D6E6FF" FontWeight="SemiBold" FontSize="11"/>
                                        </Border>
                                        <Border Grid.Column="3" Background="#213B5A" CornerRadius="8" Padding="8,4">
                                            <TextBlock Text="= Context" Foreground="#C2D9F3" FontWeight="SemiBold" FontSize="11"/>
                                        </Border>
                                    </Grid>

                                    <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="8">
                                        <Grid Grid.Row="0" ColumnDefinitions="*,6,*">
                                            <Border Grid.Column="0" Background="#1E3858" CornerRadius="8" Padding="8,4">
                                                <TextBlock Text="Before" FontWeight="SemiBold"/>
                                            </Border>
                                            <Border Grid.Column="1" Background="#4E6F8E" Margin="2,2"/>
                                            <Border Grid.Column="2" Background="#1E3858" CornerRadius="8" Padding="8,4">
                                                <TextBlock Text="After" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>

                                        <Grid Grid.Row="1" ColumnDefinitions="*,6,*" ColumnSpacing="0">
                                            <ScrollViewer x:Name="LeftDiffScrollViewer"
                                                          Grid.Column="0"
                                                          VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Auto"
                                                          ScrollChanged="OnLeftDiffScrollChanged">
                                                <ItemsControl ItemsSource="{Binding PreviewRows}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="explorer:DiffPreviewRowViewModel">
                                                            <StackPanel Spacing="4" Margin="0,0,0,4">
                                                                <Border IsVisible="{Binding IsHunkHeader}"
                                                                        Background="#1A3654"
                                                                        BorderBrush="#4A78A8"
                                                                        BorderThickness="1"
                                                                        CornerRadius="8"
                                                                        Padding="8,4">
                                                                    <TextBlock Text="{Binding HunkHeader}"
                                                                               FontFamily="Cascadia Code,Consolas,Monospace"
                                                                               FontSize="12"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="#A8D1FF"/>
                                                                </Border>

                                                                <Border IsVisible="{Binding IsContentRow}" Classes="diff-side" Background="{Binding LeftBackground}" ClipToBounds="True">
                                                                    <Grid ColumnDefinitions="58,16,24,*" ColumnSpacing="6">
                                                                        <TextBlock Grid.Column="0" Text="{Binding LeftLineNumber}" Foreground="#A4BEDA" FontFamily="Cascadia Code,Consolas,Monospace" FontSize="12"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding LeftMarker}" Foreground="{Binding LeftMarkerForeground}" FontWeight="Bold" FontFamily="Cascadia Code,Consolas,Monospace" FontSize="12"/>
                                                                        <TextBlock Grid.Column="2" Text="{Binding KindBadge}" Foreground="#9BC1E8" FontWeight="SemiBold" FontFamily="Cascadia Code,Consolas,Monospace" FontSize="11"/>
                                                                        <TextBlock Grid.Column="3"
                                                                                   Text="{Binding LeftText}"
                                                                                   FontFamily="Cascadia Code,Consolas,Monospace"
                                                                                   FontSize="12"
                                                                                   TextWrapping="{Binding #Root.((windows:FileVersionCompareWindowViewModel)DataContext).IsWrapEnabled, Converter={x:Static conv:BoolToTextWrappingConverter.Instance}}"/>
                                                                    </Grid>
                                                                </Border>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>

                                            <Border Grid.Column="1" Background="#4E6F8E" Margin="2,0"/>

                                            <ScrollViewer x:Name="RightDiffScrollViewer"
                                                          Grid.Column="2"
                                                          VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Auto"
                                                          ScrollChanged="OnRightDiffScrollChanged">
                                                <ItemsControl ItemsSource="{Binding PreviewRows}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="explorer:DiffPreviewRowViewModel">
                                                            <StackPanel Spacing="4" Margin="0,0,0,4">
                                                                <Border IsVisible="{Binding IsHunkHeader}"
                                                                        Background="#1A3654"
                                                                        BorderBrush="#4A78A8"
                                                                        BorderThickness="1"
                                                                        CornerRadius="8"
                                                                        Padding="8,4">
                                                                    <TextBlock Text="{Binding HunkHeader}" FontFamily="Cascadia Code,Consolas,Monospace" FontSize="12" FontWeight="SemiBold" Foreground="#A8D1FF"/>
                                                                </Border>

                                                                <Border IsVisible="{Binding IsContentRow}" Classes="diff-side" Background="{Binding RightBackground}" ClipToBounds="True">
                                                                    <Grid ColumnDefinitions="58,16,24,*" ColumnSpacing="6">
                                                                        <TextBlock Grid.Column="0" Text="{Binding RightLineNumber}" Foreground="#A4BEDA" FontFamily="Cascadia Code,Consolas,Monospace" FontSize="12"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding RightMarker}" Foreground="{Binding RightMarkerForeground}" FontWeight="Bold" FontFamily="Cascadia Code,Consolas,Monospace" FontSize="12"/>
                                                                        <TextBlock Grid.Column="2" Text="{Binding KindBadge}" Foreground="#9BC1E8" FontWeight="SemiBold" FontFamily="Cascadia Code,Consolas,Monospace" FontSize="11"/>
                                                                        <TextBlock Grid.Column="3"
                                                                                   Text="{Binding RightText}"
                                                                                   FontFamily="Cascadia Code,Consolas,Monospace"
                                                                                   FontSize="12"
                                                                                   TextWrapping="{Binding #Root.((windows:FileVersionCompareWindowViewModel)DataContext).IsWrapEnabled, Converter={x:Static conv:BoolToTextWrappingConverter.Instance}}"/>
                                                                    </Grid>
                                                                </Border>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Row="0" Classes="diff-surface" IsVisible="{Binding ShowFullFilePreviewPanel}">
                                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                                    <TextBlock Grid.Row="0" Text="{Binding FullPreviewSummary}" Classes="muted" TextWrapping="Wrap"/>
                                    <Grid Grid.Row="1" ColumnDefinitions="*,6,*" ColumnSpacing="0">
                                        <Border Grid.Column="0" Background="#12273D" CornerRadius="8" Padding="6" ClipToBounds="True">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                                <TextBlock Text="{Binding FullPreviewBeforeText}" FontFamily="Cascadia Code,Consolas,Monospace" FontSize="12" TextWrapping="{Binding IsWrapEnabled, Converter={x:Static conv:BoolToTextWrappingConverter.Instance}}"/>
                                            </ScrollViewer>
                                        </Border>
                                        <Border Grid.Column="1" Background="#4E6F8E" Margin="2,0"/>
                                        <Border Grid.Column="2" Background="#12273D" CornerRadius="8" Padding="6" ClipToBounds="True">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                                <TextBlock Text="{Binding FullPreviewAfterText}" FontFamily="Cascadia Code,Consolas,Monospace" FontSize="12" TextWrapping="{Binding IsWrapEnabled, Converter={x:Static conv:BoolToTextWrappingConverter.Instance}}"/>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Row="0" Classes="diff-surface" IsVisible="{Binding IsBinaryPreview}">
                                <ItemsControl ItemsSource="{Binding PreviewMetrics}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="windows:SnapshotPreviewMetricItemViewModel">
                                            <Grid ColumnDefinitions="180,*" ColumnSpacing="10" Margin="0,0,0,6">
                                                <TextBlock Grid.Column="0" Text="{Binding Label}" FontWeight="SemiBold" Foreground="#A8D1FF"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <Border Grid.Row="0" Classes="diff-surface" IsVisible="{Binding IsImagePreview}">
                                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                                    <ItemsControl Grid.Row="0" ItemsSource="{Binding PreviewMetrics}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="windows:SnapshotPreviewMetricItemViewModel">
                                                <Grid ColumnDefinitions="180,*" ColumnSpacing="10" Margin="0,0,0,6">
                                                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontWeight="SemiBold" Foreground="#A8D1FF"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Grid Grid.Row="1" ColumnDefinitions="*,6,*" ColumnSpacing="0" IsVisible="{Binding HasImagePreviews}">
                                        <Border Grid.Column="0" Background="#0B172A" BorderBrush="#2D4864" BorderThickness="1" CornerRadius="10" Padding="8">
                                            <Grid RowDefinitions="Auto,*" RowSpacing="8">
                                                <TextBlock Grid.Row="0" Text="{Binding LeftImageCaption}" FontWeight="SemiBold"/>
                                                <Image Grid.Row="1" Source="{Binding LeftImagePreview}" Stretch="Uniform"/>
                                            </Grid>
                                        </Border>
                                        <Border Grid.Column="1" Background="#4E6F8E" Margin="2,0"/>
                                        <Border Grid.Column="2" Background="#0B172A" BorderBrush="#2D4864" BorderThickness="1" CornerRadius="10" Padding="8">
                                            <Grid RowDefinitions="Auto,*" RowSpacing="8">
                                                <TextBlock Grid.Row="0" Text="{Binding RightImageCaption}" FontWeight="SemiBold"/>
                                                <Image Grid.Row="1" Source="{Binding RightImagePreview}" Stretch="Uniform"/>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <TextBlock Grid.Row="1" Text="Image preview is not available for this pair." Classes="muted" IsVisible="{Binding HasNoImagePreviews}"/>
                                </Grid>
                            </Border>

                            <TextBlock Grid.Row="1" Text="{Binding PreviewSummary}" Classes="muted" IsVisible="{Binding ShowNoDiffPreviewMessage}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="2" Text="No full-file preview data available for this version pair." Classes="muted" IsVisible="{Binding ShowNoFullFilePreviewMessage}" TextWrapping="Wrap"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

