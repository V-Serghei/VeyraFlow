<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Veyra.Desktop.ViewModels.Pages.SetupWizard"
             x:Class="Veyra.Desktop.Views.Pages.SetupWizard.RepositoryNamePage"
             d:DataContext="{d:DesignInstance vm:RepositoryNameViewModel, IsDesignTimeCreatable=True}"
             x:DataType="vm:RepositoryNameViewModel">

    <StackPanel Margin="0,0,0,16" Spacing="12">
        <TextBlock FontSize="20" FontWeight="Bold" Text="{Binding Title}"/>
        <TextBlock Opacity="0.8" Text="{Binding Subtitle}" TextWrapping="Wrap"/>

        <Border Margin="0,12,0,0" Padding="16" Background="#1E1E1E" CornerRadius="8">
            <StackPanel Spacing="8">
                <TextBlock Text="Имя репозитория"/>
                <TextBox Text="{Binding RepositoryName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Watermark="Например: Мой проект"
                         Width="400" HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
