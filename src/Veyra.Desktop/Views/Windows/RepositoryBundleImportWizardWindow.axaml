<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Veyra.Desktop.Localization"
        xmlns:conv="clr-namespace:Veyra.Desktop.Converters"
        xmlns:windows="clr-namespace:Veyra.Desktop.ViewModels.Windows"
        x:Class="Veyra.Desktop.Views.Windows.RepositoryBundleImportWizardWindow"
        x:DataType="windows:RepositoryBundleImportWizardWindowViewModel"
        Width="820"
        Height="700"
        MinWidth="700"
        MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Title="{Binding WindowTitle}">

    <Grid>
        <Border Classes="dialog-shell" Margin="14" Padding="18">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
                <Border Grid.Row="0" Classes="dialog-hero">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding WindowTitle}" Classes="h2"/>
                        <TextBlock Text="{loc:Tr repo_settings.bundle_hint}" Classes="muted" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <Border Classes="card" Padding="14">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding StepOneTitle}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding StepOneDescription}" Classes="muted" TextWrapping="Wrap"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox Grid.Column="0"
                                             Text="{Binding BundlePath, Mode=TwoWay}"
                                             Watermark="{loc:Tr bundle_import.bundle_path_placeholder}"/>
                                    <Button Grid.Column="1"
                                            Classes="subtle"
                                            Command="{Binding BrowseBundlePathCommand}"
                                            Content="{loc:Tr common.browse}"/>
                                </Grid>
                                <TextBlock Text="{Binding ValidationMessage}"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding HasValidationMessage}"/>
                                <Border Classes="metric-card" IsVisible="{Binding IsBundleValidated}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0" Text="{loc:Tr bundle_import.bundle_version_label}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding BundleFormatVersion}"/>
                                    </Grid>
                                </Border>
                                <Border Classes="metric-card" IsVisible="{Binding HasValidationWarnings}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{loc:Tr repo_settings.bundle_warnings}" FontWeight="SemiBold"/>
                                        <ItemsControl ItemsSource="{Binding ValidationWarnings}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding .}" TextWrapping="Wrap"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Padding="14">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding StepTwoTitle}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding StepTwoDescription}" Classes="muted" TextWrapping="Wrap"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox Grid.Column="0"
                                             Text="{Binding TargetDirectoryPath, Mode=TwoWay}"
                                             Watermark="{loc:Tr bundle_import.target_path_placeholder}"/>
                                    <Button Grid.Column="1"
                                            Classes="subtle"
                                            Command="{Binding BrowseTargetDirectoryCommand}"
                                            Content="{loc:Tr common.browse}"/>
                                </Grid>
                                <TextBox Text="{Binding RepositoryNameOverride, Mode=TwoWay}"
                                         Watermark="{loc:Tr bundle_import.repository_name_override_placeholder}"/>
                                <Button Classes="primary"
                                        Command="{Binding StartImportCommand}"
                                        IsEnabled="{Binding CanStartImport}"
                                        Content="{Binding StartImportLabel}"
                                        HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding Message}"
                                           Classes="muted"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding HasMessage}"/>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Padding="14" IsVisible="{Binding IsCompleted}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding StepThreeTitle}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding StepThreeDescription}" Classes="muted" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding ResultSummary}"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding HasResultSummary}"/>
                                <Border Classes="metric-card">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0" Text="{loc:Tr repo_settings.bundle_imported_repository_id}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ImportedRepositoryId}"/>
                                    </Grid>
                                </Border>
                                <Border Classes="metric-card" IsVisible="{Binding HasImportWarnings}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{loc:Tr repo_settings.bundle_warnings}" FontWeight="SemiBold"/>
                                        <ItemsControl ItemsSource="{Binding ImportWarnings}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding .}" TextWrapping="Wrap"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Classes="toolbar" Padding="10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Content="{Binding CloseLabel}" Command="{Binding CloseCommand}" Classes="subtle" Width="120"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Classes="loading-overlay" IsVisible="{Binding IsBusy}">
            <Border Classes="loading-card" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                <StackPanel Classes="loading-state">
                    <TextBlock Text="{loc:Tr bundle_import.running}" FontSize="18" FontWeight="SemiBold" TextAlignment="Center"/>
                    <TextBlock Text="{loc:Tr bundle_import.running_detail}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center"/>
                    <ProgressBar Classes="loading-progress" IsIndeterminate="True"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
