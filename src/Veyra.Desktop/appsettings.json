{
  "CloudApi": {
    "BaseUrl": "http://localhost:8080"
  },
  "SnapshotScheduler": {
    "Enabled": true,
    "PollSeconds": 30,
    "IntervalMinutes": 15,
    "QuietHoursStartHour": 0,
    "QuietHoursEndHour": 0,
    "MaxReadBytesPerSecond": 0,
    "MaxIoOperationsPerSecond": 0,
    "RetryCount": 2,
    "RetryDelaySeconds": 10
  },
  "Storage": {
    "BlockStorePath": ""
  },
  "Security": {
    "ArtifactEncryption": {
      "Enabled": true,
      "KeyBase64": "",
      "KeyPath": ""
    }
  },
  "Serilog": {
    "MinimumLevel": "Information"
  }
}

